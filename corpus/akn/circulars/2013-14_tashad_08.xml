            </content>
          </subparagraph>
          <subparagraph eId="art_4__para_b__subpara_6">
            <num>4.ב.6</num>
            <content>
              <p>ניהול תיירותי</p>
            </content>
          </subparagraph>
          <subparagraph eId="art_4__para_b__subpara_7">
            <num>4.ב.7</num>
            <content>
