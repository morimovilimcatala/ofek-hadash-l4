        <tr>
          <td>
            <p>בשם <organization eId="org_15" refersTo="#state">ממשלת ישראל</organization>
            </p>
          </td>
          <td>
            <p>בשם הסתדרות מורים</p>
          </td>
        </tr>
      </table>
    </conclusions>
