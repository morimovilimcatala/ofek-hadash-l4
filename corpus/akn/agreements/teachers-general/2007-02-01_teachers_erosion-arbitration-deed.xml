            <p><organization eId="org_21" refersTo="#irgun-hamorim">ארגון המורים העל-יסודיים</organization>
            </p>
          </td>
        </tr>
        <tr>
          <td>
            <p><organization eId="org_22" refersTo="#three-cities">שלוש הערים הגדולות</organization>
