        <tr>
          <td>
            <p>בשם <organization eId="org_36" refersTo="#state">ממשלת ישראל</organization>
            </p>
          </td>
          <td>
            <p>בשם <organization eId="org_37" refersTo="#histadrut-hamorim">הסתדרות המורים</organization> בישראל</p>
          </td>
        </tr>
