                <p>36.45</p>
              </td>
              <td>
                <p>150 שיחות</p>
              </td>
            </tr>
            <tr>
              <td>
                <p>42.53</p>
              </td>
              <td>
                <p>175 שיחות</p>
              </td>
            </tr>
            <tr>
              <td>
                <p>48.60</p>
              </td>
              <td>
                <p>200 שיחות</p>
              </td>
            </tr>
          </table>
        </content>
      </article>
