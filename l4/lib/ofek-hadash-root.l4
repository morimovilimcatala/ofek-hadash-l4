-- The Ofek Hadash agreements' root (MMS-548): the agreements of the Ofek
-- Hadash reform that speak to an item of the shared vocabulary
-- (l4/lib/vocabulary.l4), each registered once as an instrument (it
-- describes itself in its own file), and what each claims for a case. The
-- agreements' root (l4/lib/agreements-root.l4) imports it beside the other
-- families' roots; precedence is left to l4/lib/precedence.l4.

IMPORT prelude
IMPORT precedence
IMPORT `2017-03-19_ofek-hadash_march-2017-amendment`
IMPORT `2022-10-19_ofek-hadash_wage-agreement`
IMPORT `2022-10-19_ofek-hadash_wage-agreement_signed-appendices`
IMPORT `base-agreement-39`
IMPORT `base-agreement-44`
IMPORT `tables-in-force-common`
IMPORT `2011-01-25_ofek-hadash_tosefet-2011-first-part_tables`
IMPORT `2013-07-22_ofek-hadash_last-phase-deferral`

§ `שורש הסכמי אופק חדש — מה ההסכמים של הרפורמה אומרים על כל פריט`

§§ `המסמכים`

-- This root includes the Ofek Hadash agreements:
`the Ofek Hadash agreements' instruments` MEANS
    LIST `the base agreement §39`, `the base agreement §44`, `the agreement of 19.3.2017`, `the agreement of 19.10.2022`,
         `the Ofek Hadash salary tables`, `the agreement of 25.1.2011`, `the completion agreement of 29.2.2012`,
         `the deferral agreement of 22.7.2013`

§§ `מה ההסכמים אומרים, לפי פריט`

GIVEN i IS A `pay item`, c IS A `teaching case`
GIVETH A LIST OF `claim`
DECIDE `the Ofek Hadash agreements' claims on` i c IS
    CONSIDER i
    WHEN `the pedagogical coordinator's allowance rate` THEN
        catMaybes (LIST `the claim of` `the agreement of 19.3.2017` (`the pedagogical coordinator's rate according to the agreement of 19.3.2017` c),
                        `the claim of` `the agreement of 19.10.2022` (`the pedagogical coordinator's rate according to the agreement of 19.10.2022` c))
    WHEN `the mentor's allowance rate` THEN
        catMaybes (LIST `the claim of` `the agreement of 19.3.2017` (`the mentor's rate according to the agreement of 19.3.2017` c))
    WHEN `the junior-division head's allowance` THEN
        catMaybes (LIST `the claim of` `the agreement of 19.10.2022` (`the junior-division head's allowance according to the agreement of 19.10.2022 and its annexes` c))
    WHEN `the role allowances counted` THEN
        catMaybes (LIST `the claim of` `the base agreement §39` (`the role allowances counted according to the base agreement` c))
    WHEN `the combined salary of a full position` THEN
        catMaybes (LIST `the claim of` `the Ofek Hadash salary tables` (`the full-position combined salary according to the Ofek Hadash tables` c))
    -- the agreement of 19.10.2022 sets it (§5) and its signed copy holds the
    -- annexes; the tables collection reads the same annexes as published
    WHEN `the Ofek 2022 supplement of a full position` THEN
        catMaybes (LIST `the claim of` `the agreement of 19.10.2022` (`the Ofek 2022 supplement according to the agreement of 19.10.2022` c),
                        `the claim of` `the Ofek Hadash salary tables` (`the full-position Ofek 2022 supplement according to the Ofek Hadash tables` c))
    WHEN `the 2008 public-sector supplement` THEN
        catMaybes (LIST `the claim of` `the base agreement §44` (`the 2008 supplement according to the base agreement §44` c))
    WHEN `the 3% supplement of 2001` THEN
        catMaybes (LIST `the claim of` `the base agreement §44` (`the 3% supplement according to the base agreement §44` c))
    WHEN `the 1994 supplement of a full position` THEN
        catMaybes (LIST `the claim of` `the base agreement §44` (`the 1994 supplement according to the base agreement §44` c))
    WHEN `the 2011 public-sector supplement` THEN
        catMaybes (LIST `the claim of` `the agreement of 25.1.2011` (`the 2011 supplement according to the agreement of 25.1.2011` c),
                        `the claim of` `the completion agreement of 29.2.2012` (`the 2011 supplement according to §92 of the completion agreement` c),
                        `the claim of` `the deferral agreement of 22.7.2013` (`the 2011 supplement according to the deferral agreement` c))
    OTHERWISE EMPTY
