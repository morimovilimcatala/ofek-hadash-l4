§§ `illustrations`

-- §3: the later of the two days, and "הסכם 93" in force through it.
#ASSERT `the extended period of the agreement of 19.9.94 ends on` (DATE_FROM_DMY 30 6 1997) EQUALS DATE_FROM_DMY 30 6 1997
#ASSERT `the extended period of the agreement of 19.9.94 ends on` (DATE_FROM_DMY 30 6 1996) EQUALS DATE_FROM_DMY 31 12 1996
#ASSERT `the agreement of 11.5.93 is in force under the agreement of 19.9.94 on` (DATE_FROM_DMY 1 6 1996) (DATE_FROM_DMY 30 6 1996)
#ASSERT `the agreement of 11.5.93 is in force under the agreement of 19.9.94 on` (DATE_FROM_DMY 1 3 1993) (DATE_FROM_DMY 30 6 1996)
#ASSERT NOT `the agreement of 11.5.93 is in force under the agreement of 19.9.94 on` (DATE_FROM_DMY 1 1 1997) (DATE_FROM_DMY 30 6 1996)

-- §4(א): the table in force through 1994–96; a teacher with an M.A. in
-- his first year, in January 1994 and in October 1995.
#ASSERT `the annex of 19.9.94 that applies on` (DATE_FROM_DMY 31 12 1993) EQUALS NOTHING
#ASSERT `the annex of 19.9.94 that applies on` (DATE_FROM_DMY 15 7 1995) EQUALS JUST `annex ד' of 19.9.94`
#ASSERT `the annex of 19.9.94 that applies on` (DATE_FROM_DMY 1 2 1996) EQUALS JUST `annex ה' of 19.9.94`
#ASSERT `the combined salary of a full position under the tables of 19.9.94 on` (DATE_FROM_DMY 1 1 1994) 1 13 0 EQUALS JUST 1910.70
#ASSERT `the combined salary of a full position under the tables of 19.9.94 on` (DATE_FROM_DMY 1 10 1995) 36 1 0 EQUALS JUST 4279.38
#ASSERT `the combined salary of a full position under the tables of 19.9.94 on` (DATE_FROM_DMY 1 10 1995) 37 1 0 EQUALS NOTHING
#ASSERT `the combined salary of a full position under the tables of 19.9.94 on` (DATE_FROM_DMY 1 2 1996) 1 1 (2%) EQUALS JUST (2165.66 TIMES 1.02)
#ASSERT `the seniority step of the tables of 19.9.94 into year` 7 EQUALS 5%
#ASSERT `the seniority step of the tables of 19.9.94 into year` 8 EQUALS 2%
#ASSERT `the seniority step of the tables of 19.9.94 into year` 26 EQUALS 1%

-- F-hh-1994-a's evidence: annex ה' is dated three ways, none the same.
`annex ה' of 19.9.94 is dated three ways` MEANS
        NOT `the day §4(א)(5) of 19.9.94 applies annex ה' from` EQUALS `the day §4(ב)(4) of 19.9.94 applies the corrected annex ה' from`
    AND NOT `the day §28 of 19.9.94 lists annex ה' from` EQUALS `the day §4(ב)(4) of 19.9.94 applies the corrected annex ה' from`
    AND NOT `the day §28 of 19.9.94 lists annex ה' from` EQUALS `the day §4(א)(5) of 19.9.94 applies annex ה' from`
    AND `the day the 19.9.94 table prints it is in force from` `annex ה' of 19.9.94` EQUALS `the day §4(ב)(4) of 19.9.94 applies the corrected annex ה' from`
#ASSERT `annex ה' of 19.9.94 is dated three ways`

-- F-hh-1994-b's evidence: §28 lists annex ד' a month after the day §4(א)(4)
-- and the table print.
`§28 of 19.9.94 dates annex ד' otherwise than §4 and the table` MEANS
        NOT `the day §28 of 19.9.94 lists annex ד' from` EQUALS `the day §4(א)(4) of 19.9.94 applies annex ד' from`
    AND `the day the 19.9.94 table prints it is in force from` `annex ד' of 19.9.94` EQUALS `the day §4(א)(4) of 19.9.94 applies annex ד' from`
    AND DATE_SERIAL `the day §28 of 19.9.94 lists annex ד' from` MINUS DATE_SERIAL `the day §4(א)(4) of 19.9.94 applies annex ד' from` EQUALS 31
#ASSERT `§28 of 19.9.94 dates annex ד' otherwise than §4 and the table`

-- F-hh-1994-d's evidence: §4(ג) updates every annex from 1.1.94, and two
-- annexes print that they already carry two of those increments; added
-- again, a cell of 1,000 would be 1,060.851 and not 1,000.
`§4(ג) of 19.9.94 would add increments annexes ד' and ה' already carry` MEANS
        `the increments the 19.9.94 table prints it includes` `annex ד' of 19.9.94` EQUALS LIST 2.3%, 3.7%
    AND `the increments the 19.9.94 table prints it includes` `annex ה' of 19.9.94` EQUALS LIST 2.3%, 3.7%
    AND `a 1994 Histadrut table amount updated by the cost of living` 1000 (`the increments the 19.9.94 table prints it includes` `annex ד' of 19.9.94`) EQUALS 1060.851
#ASSERT `§4(ג) of 19.9.94 would add increments annexes ד' and ה' already carry`

-- §4(ב): a result delivered on 1.4.96 is late, so the advances are paid;
-- one of 2% adds 2% to annex ה'.
#ASSERT `annex ה' of 19.9.94 is paid as advances with the salary of March 1996` (JUST (DATE_FROM_DMY 1 4 1996))
#ASSERT NOT `annex ה' of 19.9.94 is paid as advances with the salary of March 1996` (JUST (DATE_FROM_DMY 31 3 1996))
#ASSERT `annex ה' of 19.9.94 is paid as advances with the salary of March 1996` NOTHING
#ASSERT `the corrected annex ה' cell of 19.9.94` 2000 (2%) EQUALS 2040
#ASSERT `the corrected annex ה' cell of 19.9.94` 2000 (0 MINUS (1%)) EQUALS 1980
#ASSERT `the erosion check annex ה' of 19.9.94 waits for is made on` EQUALS DATE_FROM_DMY 1 1 1996

-- §4(ד): 11% earns nothing; 12.5%, one whole percent; 20%, four.
#ASSERT `the inflation compensation rate of 19.9.94 for` (11%) EQUALS 0
#ASSERT `the inflation compensation rate of 19.9.94 for` (12.5%) EQUALS 0.15%
#ASSERT `the inflation compensation rate of 19.9.94 for` (20%) EQUALS 0.6%

-- §4(ה): "תוספת 1993" on its own line in December 1993, not in January.
#ASSERT `the 1993 supplement rate paid on its own line under the agreement of 19.9.94 on` (DATE_FROM_DMY 1 12 1993) EQUALS 10%
#ASSERT `the 1993 supplement rate paid on its own line under the agreement of 19.9.94 on` (DATE_FROM_DMY 1 1 1994) EQUALS 0

-- §7: "הסכם 93"'s in-service supplement stops before its 9.2%; a
-- supervisor who lost two days gets one back; none deducted after 1.9.94.
#ASSERT `the school in-service supplement rate as the agreement of 19.9.94 leaves it on` (DATE_FROM_DMY 1 6 1994) EQUALS 4%
#ASSERT `the school in-service supplement rate as the agreement of 19.9.94 leaves it on` (DATE_FROM_DMY 1 9 1994) EQUALS 0
#ASSERT `the 1993 school in-service supplement rate on` (DATE_FROM_DMY 1 9 1994) EQUALS 9.2%
#ASSERT `the leave days returned to a supervisor under the agreement of 19.9.94` `the leave days an approved supervisor gives up under 1993` EQUALS 1
#ASSERT `the leave days deducted from a supervisor under the agreement of 19.9.94 on` (DATE_FROM_DMY 1 5 1994) TRUE EQUALS 1
#ASSERT `the leave days deducted from a supervisor under the agreement of 19.9.94 on` (DATE_FROM_DMY 1 5 1994) FALSE EQUALS 0
#ASSERT `the leave days deducted from a supervisor under the agreement of 19.9.94 on` (DATE_FROM_DMY 1 9 1994) TRUE EQUALS 0

-- §8: 106 shekels after increments of 2% and 3%, at half a position.
#ASSERT `"הסכם הוראה 94" paid on` (DATE_FROM_DMY 1 9 1994) (LIST 2%, 3%) 0.5 EQUALS 55.6818
#ASSERT `"הסכם הוראה 94" paid on` (DATE_FROM_DMY 31 8 1994) EMPTY 1 EQUALS 0
#ASSERT `"הסכם הוראה 94" counts for` `the hour value, for 19.9.94`
#ASSERT NOT `"הסכם הוראה 94" counts for` `the stay supplement, for 19.9.94`

-- §9: entitled in a priority locality for a teacher living elsewhere, not
-- for one living there or on a fourth period; the most is the incentives
-- and travel by the position.
#ASSERT `entitled to the reward of a required teacher of 19.9.94` `a confrontation-line locality, for 19.9.94` TRUE TRUE FALSE 3 (DATE_FROM_DMY 1 9 1996)
#ASSERT NOT `entitled to the reward of a required teacher of 19.9.94` `a confrontation-line locality, for 19.9.94` TRUE TRUE TRUE 1 (DATE_FROM_DMY 1 9 1996)
#ASSERT NOT `entitled to the reward of a required teacher of 19.9.94` `a confrontation-line locality, for 19.9.94` TRUE TRUE FALSE 4 (DATE_FROM_DMY 1 9 1996)
#ASSERT NOT `entitled to the reward of a required teacher of 19.9.94` `a confrontation-line locality, for 19.9.94` TRUE TRUE FALSE 1 (DATE_FROM_DMY 1 9 1997)
#ASSERT `the most the reward of a required teacher of 19.9.94 may be` 800 200 0.5 EQUALS 500
#ASSERT `the required teachers of 19.9.94 a year` TIMES 3 EQUALS `the required teachers of 19.9.94 in all`

-- §11: 60% at 30 years, by the position; nothing at 29.
#ASSERT `the jubilee grant of 19.9.94` 30 10000 1 EQUALS 6000
#ASSERT `the jubilee grant of 19.9.94` 31 10000 0.8 EQUALS 4800
#ASSERT `the jubilee grant of 19.9.94` 29 10000 1 EQUALS 0
#ASSERT `the jubilee grant of 19.9.94 is paid with the salary of` 1995 6
#ASSERT NOT `the jubilee grant of 19.9.94 is paid with the salary of` 1994 6

-- §12: in תשנ"ה three years completed are the fourth, 9 days; 25 completed
-- in תשנ"ו, 13.
#ASSERT `the havraa days the agreement of 19.9.94 gives in` 1994 3 EQUALS JUST 9
#ASSERT `the havraa days the agreement of 19.9.94 gives in` 1994 2 EQUALS JUST 7
#ASSERT `the havraa days the agreement of 19.9.94 gives in` 1994 25 EQUALS JUST 12
#ASSERT `the havraa days the agreement of 19.9.94 gives in` 1995 25 EQUALS JUST 13
#ASSERT `the havraa days the agreement of 19.9.94 gives in` 1993 10 EQUALS NOTHING

-- §13: 75% of 16 million; §14: four half-percents are 2%.
#ASSERT `Histadrut HaMorim's yearly share of the professional-development budget of 19.9.94` EMPTY EQUALS 12000000
#ASSERT `the share of the pension salary the agreement of 19.9.94 allocates in all` EQUALS 2%
#ASSERT `allocating for pension rights under the agreement of 19.9.94 in` 1997 EQUALS FULFILLED

-- §15: 3,000 hours by תשנ"ז.
#ASSERT `the in-service hours the agreement of 19.9.94 has added by` 1996 EQUALS 3000
#ASSERT `the in-service hours the agreement of 19.9.94 has added by` 1995 EQUALS 2000

-- §17: counselling in its fifth year and on, 9%; the degree allowances;
-- the in-service ceiling two units over "הסכם 93"'s 14; a first-grade
-- educator's 6.5% on top; the management allowances, 10% becoming 10.25%,
-- and 10.5% where the committee reached nothing.
#ASSERT `the counselling allowance rate of 19.9.94 on` (DATE_FROM_DMY 1 9 1994) 7 EQUALS JUST (9%)
#ASSERT `the counselling allowance rate of 19.9.94 on` (DATE_FROM_DMY 1 9 1994) 1 EQUALS JUST (5%)
#ASSERT `the counselling allowance rate of 19.9.94 on` (DATE_FROM_DMY 31 8 1994) 1 EQUALS NOTHING
#ASSERT `the degree allowance rate of 19.9.94` `a doctor's degree or its equivalent grade, for 19.9.94` TRUE EQUALS 10%
#ASSERT `the degree allowance rate of 19.9.94` `a master's degree or its equivalent grade, for 19.9.94` FALSE EQUALS 0
#ASSERT `the ceiling of in-service allowance units under the agreement of 19.9.94 in` 1997 EQUALS `the 1993 ceiling of in-service allowance units in` 1997 PLUS 2
#ASSERT `the ceiling of in-service allowance units under the agreement of 19.9.94 in` 1994 EQUALS 13
#ASSERT `a class educator's allowance rates under the agreement of 19.9.94` TRUE (8%) EQUALS 14.5%
#ASSERT `an allowance under §17(ז) of 19.9.94 on` (DATE_FROM_DMY 1 9 1994) `a management allowance, for 19.9.94` (10%) TRUE FALSE EQUALS JUST (10.25%)
#ASSERT `an allowance under §17(ז) of 19.9.94 on` (DATE_FROM_DMY 1 1 1995) `a management allowance, for 19.9.94` (10%) TRUE FALSE EQUALS JUST (10.25%)
#ASSERT `an allowance under §17(ז) of 19.9.94 on` (DATE_FROM_DMY 1 1 1995) `a supervision allowance, for 19.9.94` (10%) FALSE FALSE EQUALS JUST (10.5%)
#ASSERT `an allowance under §17(ז) of 19.9.94 on` (DATE_FROM_DMY 1 1 1995) `a management allowance, for 19.9.94` (10%) FALSE TRUE EQUALS NOTHING

-- §19: 4.5% on 20,000 is 900; four months to choose, the higher base,
-- from 1.3.94.
#ASSERT `the 1993 retiree's difference under the agreement of 19.9.94` 1993 20000 EQUALS 900
#ASSERT `the 1993 retiree's difference under the agreement of 19.9.94` 1994 20000 EQUALS 0
#ASSERT `the days the agreement of 19.9.94 gives a retired principal to choose` EQUALS 122
#ASSERT `a retired principal's management allowance under 19.9.94` TRUE 800 950 EQUALS 950
#ASSERT `a retired principal choosing the base under the agreement of 19.9.94` (DATE_FROM_DMY 1 9 1993) EQUALS FULFILLED
#ASSERT `the guidance allowance determines the pension under 19.9.94` (DATE_FROM_DMY 1 10 1994) TRUE
#ASSERT NOT `the guidance allowance determines the pension under 19.9.94` (DATE_FROM_DMY 1 8 1994) TRUE

-- §22 and §24: the 1993 tracks go on; ORT is in the list, an owner not
-- listed only by the committee.
#ASSERT `the early-retirement tracks of 1993 stay under the agreement of 19.9.94 on` (DATE_FROM_DMY 1 9 1996)
#ASSERT `an owner is in the sick-day continuity under the agreement of 19.9.94` "אורט ישראל" FALSE
#ASSERT NOT `an owner is in the sick-day continuity under the agreement of 19.9.94` "בעלות אחרת" FALSE

-- §26 and the first letter: the erosion formula is not exhausted.
#ASSERT NOT `the agreement of 19.9.94 exhausts the claims on` "תיקון נוסחת בדיקת השחיקה" (DATE_FROM_DMY 1 1 1995) (DATE_FROM_DMY 31 12 1996)
#ASSERT `the agreement of 19.9.94 exhausts the claims on` "גמול ניהול" (DATE_FROM_DMY 1 1 1995) (DATE_FROM_DMY 31 12 1996)

-- The sixth letter: 10% of a full position's 2,000 at 70% pension is 140,
-- whatever the weighted position; before 1.9.94 the position counted.
#ASSERT `a pensioner's educator allowance under the letter of 19.9.94 on` (DATE_FROM_DMY 1 9 1994) (10%) 2000 0.5 (70%) EQUALS 140
#ASSERT `a pensioner's educator allowance under the letter of 19.9.94 on` (DATE_FROM_DMY 1 8 1994) (10%) 2000 0.5 (70%) EQUALS 70

