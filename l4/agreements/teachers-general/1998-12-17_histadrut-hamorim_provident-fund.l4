§§ `illustrations`

-- §5: 5% and 5% on an expense reimbursement of 400; none on a tax gross-up
-- or on a reward for out-of-school activity; the jubilee grant in an
-- accrual pension but not in a budgetary one.
#ASSERT `the 1998 Histadrut provident-fund amounts on` (DATE_FROM_DMY 1 6 1998) `an expense reimbursement payment` `a budgetary pension` 400 EQUALS JUST `5% and 5% of 400`
#ASSERT `the 1998 Histadrut provident-fund amounts on` (DATE_FROM_DMY 1 6 1998) `a reward for out-of-school activity` `an accrual pension` 400 EQUALS NOTHING
#ASSERT `the 1998 Histadrut provident-fund agreement contributes on` (DATE_FROM_DMY 1 6 1998) `the jubilee grant` `an accrual pension`
#ASSERT `the Histadrut letter restates §5(ב)`
#ASSERT `the 1998 Histadrut provident-fund agreement applies to` TRUE TRUE
#ASSERT NOT `a month carries provident-fund contributions under the 1998 Histadrut agreement` TRUE FALSE

-- §9: within 0.8%. §10: retired in June 1998, a one-time sum; it sets
-- aside §5.
#ASSERT `the pension agreements take the place of the 1998 Histadrut provident-fund agreement` TRUE TRUE (0.8%)
#ASSERT NOT `the pension agreements take the place of the 1998 Histadrut provident-fund agreement` TRUE TRUE (0.9%)
#ASSERT `a 1998 retiree is paid a one-time sum in place of contributions, under the Histadrut agreement` (DATE_FROM_DMY 30 6 1998)
#ASSERT `the 1998 Histadrut retiree's one-time sum` (LIST 20, 20, 25) EQUALS 65
#ASSERT `the section §10 of the Histadrut provident-fund agreement sets aside` EQUALS 5
