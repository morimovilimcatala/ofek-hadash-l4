-- הסכם עוז לתמורה (14.8.2011), §2: whom the agreement covers — every
-- employee on the teaching employees' grade, represented by ארגון המורים,
-- employed by the employers in the three- and four-year upper divisions
-- (grades 13–14 included) that the Ministry of Education supervises; and
-- the term "עובדי הוראה" for the agreement.

IMPORT prelude
IMPORT `oz-founding-common`

§ `2 תחולת ההסכם`

-- The schools whose upper divisions the agreement and §4(ח) speak of: a
-- six-year school's upper division is three-year (grades 10–12), a
-- four-year school's is its grades 9–12, and a three-year school is one.
@desc A school, by the grades it holds, as §§2 and 4 tell schools apart.
DECLARE `kind of Oz school` IS ONE OF
    `a six-year school, grades 7 to 12`
    `a four-year school, grades 9 to 12`
    `a three-year school, grades 10 to 12`
    `a school of another kind`

@desc An employee, as far as §2 of the Oz agreement asks.
DECLARE `Oz section 2 employee` HAS
    `ranked on the teaching employees' grade`          IS A BOOLEAN @desc מדורג בדירוג עובדי הוראה
    `represented by the organisation of secondary teachers` IS A BOOLEAN @desc מיוצג על-ידי ארגון המורים
    `employed by one of the employers`                 IS A BOOLEAN @desc a local authority, or one of the three large cities (the preamble)
    `the kind of school`                               IS A `kind of Oz school`
    `employed in the school's upper division`          IS A BOOLEAN @desc grades 10 and up, or 9 and up in a four-year school, grades 13–14 included
    `the school is supervised by the Ministry`         IS A BOOLEAN @desc המפוקחות על-ידי משרד החינוך

GIVEN k IS A `kind of Oz school`
GIVETH A BOOLEAN
DECIDE `has a three- or four-year upper division` k IF
    NOT k EQUALS `a school of another kind`

-- Every condition of the clause, all of them together (convention
-- reading.lists: conditions are cumulative).
@ref akn:art_2
GIVEN e IS A `Oz section 2 employee`
GIVETH A BOOLEAN
DECIDE `the Oz agreement covers` e IF
        e's `ranked on the teaching employees' grade`
    AND e's `represented by the organisation of secondary teachers`
    AND e's `employed by one of the employers`
    AND `has a three- or four-year upper division` (e's `the kind of school`)
    AND e's `employed in the school's upper division`
    AND e's `the school is supervised by the Ministry`

`a municipal upper-division teacher in a six-year school` MEANS
    `Oz section 2 employee` WITH
        `ranked on the teaching employees' grade`          IS TRUE
        `represented by the organisation of secondary teachers` IS TRUE
        `employed by one of the employers`                 IS TRUE
        `the kind of school`                               IS `a six-year school, grades 7 to 12`
        `employed in the school's upper division`          IS TRUE
        `the school is supervised by the Ministry`         IS TRUE

`a municipal junior-high teacher in a six-year school` MEANS
    `Oz section 2 employee` WITH
        `ranked on the teaching employees' grade`          IS TRUE
        `represented by the organisation of secondary teachers` IS TRUE
        `employed by one of the employers`                 IS TRUE
        `the kind of school`                               IS `a six-year school, grades 7 to 12`
        `employed in the school's upper division`          IS FALSE
        `the school is supervised by the Ministry`         IS TRUE

#ASSERT `the Oz agreement covers` `a municipal upper-division teacher in a six-year school`
#ASSERT NOT `the Oz agreement covers` `a municipal junior-high teacher in a six-year school`
