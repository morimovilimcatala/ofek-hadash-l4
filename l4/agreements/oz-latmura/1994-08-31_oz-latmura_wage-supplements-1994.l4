§§ `illustrations`

-- §2: 9.5% in the spring of 1994, 24% in the autumn of 1995; from 1.1.96
-- the 34% table moved by the check: a nil result, an erosion of 2%, a gain
-- of 1%.
#ASSERT `the 1994 Oz supplement rate before 1996 on` (DATE_FROM_DMY 1 3 1994) EQUALS 9.5%
#ASSERT `the 1994 Oz supplement rate before 1996 on` (DATE_FROM_DMY 30 6 1994) EQUALS 9.5%
#ASSERT `the 1994 Oz supplement rate before 1996 on` (DATE_FROM_DMY 1 7 1994) EQUALS 12.5%
#ASSERT `the 1994 Oz supplement rate before 1996 on` (DATE_FROM_DMY 1 10 1995) EQUALS 24%
#ASSERT `the 1994 Oz supplement rate before 1996 on` (DATE_FROM_DMY 31 12 1993) EQUALS 0
#ASSERT `the combined salary with the 1994 Oz supplement on` (DATE_FROM_DMY 1 10 1995) 1000 0 EQUALS 1240
#ASSERT `the combined salary with the 1994 Oz supplement on` (DATE_FROM_DMY 1 2 1996) 1000 0 EQUALS 1340
#ASSERT `the combined salary with the 1994 Oz supplement on` (DATE_FROM_DMY 1 2 1996) 1000 (2%) EQUALS 1366.8
#ASSERT `the combined salary with the 1994 Oz supplement on` (DATE_FROM_DMY 1 2 1996) 1000 (0 MINUS (1%)) EQUALS 1326.6
#ASSERT `the 1994 Oz agreement pays תוספת 1993 on its own line on` (DATE_FROM_DMY 31 12 1993)
#ASSERT NOT `the 1994 Oz agreement pays תוספת 1993 on its own line on` (DATE_FROM_DMY 1 1 1994)

-- F-oz-1994-a's evidence: §2.5's first paragraph and its last name two
-- days for the one table, three months apart; the reading takes the last.
`§2.5 dates the annex ה' table twice` MEANS
        NOT `the day §2.5's first paragraph raises the supplement from` EQUALS `the day §2.5's last paragraph applies the annex ה' table from`
    AND `the annex ה' table of the 1994 Oz agreement applies on` (DATE_FROM_DMY 1 1 1996)
    AND NOT `the annex ה' table of the 1994 Oz agreement applies on` (DATE_FROM_DMY 31 12 1995)
    AND DATE_SERIAL `the day §2.5's first paragraph raises the supplement from` MINUS DATE_SERIAL `the day §2.5's last paragraph applies the annex ה' table from` EQUALS 91
#ASSERT `§2.5 dates the annex ה' table twice`

-- §5: four years of half a percent are the 2% the section sums.
#ASSERT `the share of the pension salary the 1994 Oz agreement allocates in all` EQUALS 2%
#ASSERT `allocating for accrual-pension rights in` 1997 EQUALS FULFILLED

-- §6: 106 shekels after increments of 2% and 3%; it counts for the hour
-- value and not for תוספת שהייה or the erosion check.
#ASSERT `the teaching-reinforcement supplement updated by` `the teaching-reinforcement supplement of 1.9.94` (LIST 2%, 3%) EQUALS 111.3636
#ASSERT `the teaching-reinforcement supplement counts for` `computing the hour value`
#ASSERT NOT `the teaching-reinforcement supplement counts for` `computing תוספת שהייה`
#ASSERT NOT `the teaching-reinforcement supplement counts for` `the salary components of the erosion check`

-- §7: in תשנ"ה a teacher with 3 years completed is in his fourth: 9 days;
-- 19 completed, 12; in תשנ"ו 25 completed, 13; 24 completed, 12.
#ASSERT `the havraa days the 1994 Oz agreement gives in` 1994 3 EQUALS JUST 9
#ASSERT `the havraa days the 1994 Oz agreement gives in` 1994 2 EQUALS JUST 7
#ASSERT `the havraa days the 1994 Oz agreement gives in` 1994 19 EQUALS JUST 12
#ASSERT `the havraa days the 1994 Oz agreement gives in` 1994 25 EQUALS JUST 12
#ASSERT `the havraa days the 1994 Oz agreement gives in` 1995 25 EQUALS JUST 13
#ASSERT `the havraa days the 1994 Oz agreement gives in` 1995 24 EQUALS JUST 12
#ASSERT `the havraa days the 1994 Oz agreement gives in` 1993 10 EQUALS NOTHING

-- §8: 60% of a determining salary of 10,000 at a full position, and at
-- 80%; nothing at 29 years.
#ASSERT `the jubilee grant section 8 of the 1994 Oz agreement pays` 30 10000 1 EQUALS 6000
#ASSERT `the jubilee grant section 8 of the 1994 Oz agreement pays` 31 10000 0.8 EQUALS 4800
#ASSERT `the jubilee grant section 8 of the 1994 Oz agreement pays` 29 10000 1 EQUALS 0
#ASSERT `the 1994 Oz jubilee grant is paid with the salary of` 1995 6
#ASSERT NOT `the 1994 Oz jubilee grant is paid with the salary of` 1995 7
#ASSERT NOT `the 1994 Oz jubilee grant is paid with the salary of` 1994 6

-- §9: 91 days to choose; the higher of the two bases.
#ASSERT `the days the 1994 Oz agreement gives a retired principal to choose` EQUALS 91
#ASSERT `a retired principal's management allowance from the choice` TRUE 800 950 EQUALS 950
#ASSERT `a retired principal's management allowance from the choice` FALSE 800 950 EQUALS 800
#ASSERT `a retired principal choosing the management allowance's base` (DATE_FROM_DMY 1 9 1993) EQUALS FULFILLED

-- §13: 5% for an M.A. with a licence from תשנ"ה; nothing without one.
#ASSERT `the 1994 Oz degree supplement rate on` (DATE_FROM_DMY 1 9 1994) `the M.A. grade` TRUE EQUALS 5%
#ASSERT `the 1994 Oz degree supplement rate on` (DATE_FROM_DMY 1 9 1994) `the doctor's grade` TRUE EQUALS 10%
#ASSERT `the 1994 Oz degree supplement rate on` (DATE_FROM_DMY 1 9 1994) `the doctor's grade` FALSE EQUALS 0
#ASSERT `the 1994 Oz degree supplement rate on` (DATE_FROM_DMY 31 8 1994) `the M.A. grade` TRUE EQUALS 0

-- §14: an allowance of 10% of the salary becomes 10.25%, then 10.5% — not
-- 12.5% and 15%.
#ASSERT `a management or supervision allowance under the 1994 Oz agreement on` (DATE_FROM_DMY 1 9 1994) (10%) FALSE EQUALS JUST (10.25%)
#ASSERT `a management or supervision allowance under the 1994 Oz agreement on` (DATE_FROM_DMY 1 1 1995) (10%) FALSE EQUALS JUST (10.5%)
#ASSERT `a management or supervision allowance under the 1994 Oz agreement on` (DATE_FROM_DMY 1 1 1995) (10%) TRUE EQUALS NOTHING

-- §15: 3,000 hours by 1.9.96. §16: a third of the members, a third of 2
-- million.
#ASSERT `the in-service weekly hours the 1994 Oz agreement adds by` (DATE_FROM_DMY 1 9 1996) EQUALS 3000
#ASSERT `the in-service weekly hours the 1994 Oz agreement adds by` (DATE_FROM_DMY 31 8 1995) EQUALS 1000
#ASSERT `an organisation's share of the in-service training sum` 1 4 EQUALS 500000

-- §18: 4.5% on a payment of 20,000 is 900.
#ASSERT `the 1993 retiree's difference under the 1994 Oz agreement` 1993 20000 EQUALS 900
#ASSERT `the 1993 retiree's difference under the 1994 Oz agreement` 1992 20000 EQUALS 0

-- §20: 11% earns nothing; 12.5%, one whole percent; 20%, four, the
-- ceiling's.
#ASSERT `the 1994 Oz inflation compensation rate for` (11%) EQUALS 0
#ASSERT `the 1994 Oz inflation compensation rate for` (12.5%) EQUALS 0.15%
#ASSERT `the 1994 Oz inflation compensation rate for` (15%) EQUALS 0.6%
#ASSERT `the 1994 Oz inflation compensation rate for` (20%) EQUALS 0.6%

-- §21: 100 in תשנ"ה, 200 in תשנ"ו; the four areas.
#ASSERT `the special contracts §21 of the 1994 Oz agreement allows in` 1994 EQUALS 100
#ASSERT `the special contracts §21 of the 1994 Oz agreement allows in` 1995 EQUALS 200
#ASSERT `§21 of the 1994 Oz agreement runs in` `a rehabilitation neighbourhood`
#ASSERT NOT `§21 of the 1994 Oz agreement runs in` `another place`

-- §23: the later of the two days.
#ASSERT `the extended period of the agreement of 11.5.93 ends on` (DATE_FROM_DMY 30 6 1997) EQUALS DATE_FROM_DMY 30 6 1997
#ASSERT `the extended period of the agreement of 11.5.93 ends on` (DATE_FROM_DMY 30 6 1996) EQUALS DATE_FROM_DMY 31 12 1996

-- §27.1 and the letter: the erosion formula is not exhausted.
#ASSERT NOT `the 1994 Oz agreement exhausts the claims on` "תיקון נוסחת בדיקת שחיקה" (DATE_FROM_DMY 1 1 1995) (DATE_FROM_DMY 31 12 1996)
