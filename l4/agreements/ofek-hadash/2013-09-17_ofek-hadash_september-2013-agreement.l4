     WITHIN `days from the signing to 15.10.2013`
     LEST  BREACH BY `the State` BECAUSE "§13: the negotiation on the colleges begins by 15.10.2013")
    RAND
    (PARTY `the teachers' union`
     MUST  `begin negotiating the reform for colleges and seminars`
     WITHIN `days from the signing to 15.10.2013`
     LEST  BREACH BY `the teachers' union` BECAUSE "§13: the negotiation on the colleges begins by 15.10.2013")

