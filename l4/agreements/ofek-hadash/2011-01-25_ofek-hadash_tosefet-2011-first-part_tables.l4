`annexes א1'–א22'` MEANS
    LIST `annex א1'`, `annex א2'`, `annex א3'`, `annex א4'`, `annex א5'`, `annex א6'`, `annex א7'`,
         `annex א8'`, `annex א9'`, `annex א10'`, `annex א11'`, `annex א12'`, `annex א13'`, `annex א14'`,
         `annex א15'`, `annex א16'`, `annex א17'`, `annex א18'`, `annex א19'`, `annex א20'`, `annex א21'`,
         `annex א22'`

`annexes ב1'–ב8'` MEANS
    LIST `annex ב1'`, `annex ב2'`, `annex ב3'`, `annex ב4'`, `annex ב5'`, `annex ב6'`, `annex ב7'`, `annex ב8'`

`all thirty tables` MEANS
    append `annexes א1'–א22'` `annexes ב1'–ב8'`

`the teachers' tables` MEANS
    LIST `annex א1'`, `annex א2'`, `annex א3'`, `annex א4'`, `annex א5'`, `annex א6'`, `annex א7'`

`the principals' and deputies' tables` MEANS
    LIST `annex א8'`, `annex א9'`, `annex א10'`, `annex א11'`, `annex א12'`, `annex א13'`, `annex א14'`,
         `annex א15'`, `annex א16'`, `annex א17'`, `annex א18'`, `annex א19'`, `annex א20'`, `annex א21'`,
         `annex א22'`

§§ `בדיקת הנספחים`

-- The checks: what the base agreement, and each table's own header, say a
-- cell should be, run over every cell. A check names the cell by its
-- printed row and grade.

@desc A cell of a table, by its printed row and grade.
DECLARE `cell address` HAS
    `at row`   IS A NUMBER
    `at grade` IS A NUMBER

@desc A cell set beside what a rule makes of it: the agorot the printed cell is above (or, negative, below) the rule's figure.
DECLARE `cell check` HAS
    `checked cell` IS A `cell address`
    `agorot off`   IS A NUMBER

GIVEN p IS A NUMBER, g IS A NUMBER, printed IS A NUMBER, computed IS A NUMBER
GIVETH A `cell check`
DECIDE `a check of` p g printed computed IS
    `cell check` WITH
        `checked cell` IS `cell address` p g
        `agorot off`   IS (printed MINUS computed) TIMES 100

GIVEN cs IS A LIST OF `cell check`
GIVETH A LIST OF `cell check`
DECIDE `the misses in` cs IS
    filter (GIVEN c YIELD NOT (c's `agorot off` EQUALS 0)) cs

GIVEN n IS A NUMBER, cs IS A LIST OF `cell check`
GIVETH A LIST OF `cell address`
DECIDE `the cells off by more than` n `agorot in` cs IS
    map (GIVEN c YIELD c's `checked cell`)
        (filter (GIVEN c YIELD c's `agorot off` GREATER THAN n OR c's `agorot off` LESS THAN (0 MINUS n)) cs)

-- (1) The conversion tables are the same tables with intermediate grades
-- (the base agreement's §46(א), §71(א), §98(א): "for the conversion only
-- the tables include intermediate grades"): every cell a table prints, the
-- conversion table prints at the same row and grade. The cells one table
-- prints and the other prints otherwise:
GIVEN a IS A `salary table`, b IS A `salary table`
GIVETH A LIST OF `cell address`
DECIDE `the cells printed otherwise in` a b IS
    concat (map (GIVEN r YIELD
                     map (GIVEN c YIELD `cell address` (r's `row place`) (c's grade))
                         (filter (GIVEN c YIELD NOT (`the cell of` b (r's `row place`) (c's grade) EQUALS JUST (c's pay)))
                                 (r's `row cells`)))
                (a's `rows`))

-- F-ofek-hadash-tosefet-2011-a: annex א1' prints 6,874.95 at its
-- sixteenth row, grade 1, where א3' prints 6,874.96 at seniority 16; every
-- other cell of א1' is א3''s at the same place. The reading adopted: each
-- annex is read as printed for what it is for — א1' is the salary paid,
-- א3' the conversion (§46(א)).
`annex א1' prints one cell otherwise than annex א3'` MEANS
    `the cells printed otherwise in` `annex א1'` `annex א3'` EQUALS LIST (`cell address` 16 1)
#ASSERT `annex א1' prints one cell otherwise than annex א3'`
#ASSERT `the row labelled` `annex א3'` 16 EQUALS `the cells of row` `annex א3'` 16

#ASSERT null (`the cells printed otherwise in` `annex א2'` `annex א4'`)
#ASSERT null (`the cells printed otherwise in` `annex א8'` `annex א9'`)
#ASSERT null (`the cells printed otherwise in` `annex א13'` `annex א14'`)
#ASSERT null (`the cells printed otherwise in` `annex א18'` `annex א19'`)
#ASSERT null (`the cells printed otherwise in` `annex ב1'` `annex ב2'`)
#ASSERT null (`the cells printed otherwise in` `annex ב3'` `annex ב4'`)
#ASSERT null (`the cells printed otherwise in` `annex ב5'` `annex ב6'`)
#ASSERT null (`the cells printed otherwise in` `annex ב7'` `annex ב8'`)

-- (2) The first deputies' tables are "derived at 75% of the principals'
-- table" (§92(א), and §98(ב) for the conversion table): each deputy's cell
-- beside 75% of the principal's cell at the same level and grade, rounded
-- to the agora (convention rounding.half).
GIVEN principals IS A `salary table`, deputies IS A `salary table`
GIVETH A LIST OF `cell check`
DECIDE `the deputies' cells beside 75% of the principals'` principals deputies IS
    concat (map (GIVEN r YIELD
                     concat (map (GIVEN c YIELD
                                      CONSIDER `the cell of` principals (r's `row place`) (c's grade)
                                      WHEN JUST p THEN LIST (`a check of` (r's `row place`) (c's grade) (c's pay)
                                                                (`to the agora` (`the first deputies' share of the principals' table` TIMES p)))
                                      WHEN NOTHING THEN EMPTY)
                                 (r's `row cells`)))
                (deputies's `rows`))

`the academic deputies' tables beside the principals'` MEANS
    append (`the deputies' cells beside 75% of the principals'` `annex א8'` `annex א13'`)
           (`the deputies' cells beside 75% of the principals'` `annex א9'` `annex א14'`)

-- F-ofek-hadash-tosefet-2011-c: 14 of the 44 cells of א13' and א14' are an
-- agora off 75% of the principals' cell, none more. The reading adopted:
-- the printed cell governs (convention rounding.printed-figure).
`the deputies' tables are not 75% of the principals' to the agora` MEANS
        count `the academic deputies' tables beside the principals'` EQUALS 44
    AND count (`the misses in` `the academic deputies' tables beside the principals'`) EQUALS 14
    AND null (`the cells off by more than` 1 `agorot in` `the academic deputies' tables beside the principals'`)
#ASSERT `the deputies' tables are not 75% of the principals' to the agora`

-- The non-academic deputies' tables (א15'–א17', §106) are not said to be
-- 75% of anything; they stand beside א10'–א12' within an agora too, which
-- no rule asks of them.
#ASSERT null (`the cells off by more than` 1 `agorot in` (`the deputies' cells beside 75% of the principals'` `annex א10'` `annex א15'`))

-- (3) The steps each table prints. A teachers' row prints its rise over
-- the row above (2%, then 1%); a header prints each grade's rise over the
-- grade before it (7.5%, 8.5%, a principal's 8.75%); a principals' or
-- deputies' level prints its rise in shekels over the level below. Each
-- printed cell is set beside the cell its step makes of its neighbour,
-- rounded to the agora (convention rounding.half).
GIVEN t IS A `salary table`, r IS A `table row`
GIVETH A LIST OF `cell check`
DECIDE `the row steps of` t r IS
    CONSIDER r's `row step`
    WHEN `a rate` s THEN
        concat (map (GIVEN c YIELD
                         CONSIDER `the cell of` t (r's `row place` MINUS 1) (c's grade)
                         WHEN JUST above THEN LIST (`a check of` (r's `row place`) (c's grade) (c's pay) (`to the agora` (above `increased by` s)))
                         WHEN NOTHING THEN EMPTY)
                    (r's `row cells`))
    WHEN `shekels` s THEN
        concat (map (GIVEN c YIELD
                         CONSIDER `the cell of` t (r's `row place` MINUS 1) (c's grade)
                         WHEN JUST below THEN LIST (`a check of` (r's `row place`) (c's grade) (c's pay) (below PLUS s))
                         WHEN NOTHING THEN EMPTY)
                    (r's `row cells`))
    WHEN `no step` THEN EMPTY

GIVEN t IS A `salary table`
GIVETH A LIST OF `cell check`
DECIDE `the seniority and level steps of` t IS
    concat (map (GIVEN r YIELD `the row steps of` t r) (t's `rows`))

-- A header's grade step, in a row that does not step in shekels (a
-- principals' level above the first rises by its shekels, not by the
-- header's rate, which the first level carries).
GIVEN t IS A `salary table`, r IS A `table row`
GIVETH A LIST OF `cell check`
DECIDE `the grade steps of the row` t r IS
    CONSIDER r's `row step`
    WHEN `shekels` s THEN EMPTY
    OTHERWISE
        concat (map (GIVEN st YIELD
                         CONSIDER `the pay at grade` (st's `the stepped grade`) (r's `row cells`)
                         WHEN JUST here THEN
                             CONSIDER `the pay at grade` (st's `the stepped grade` MINUS 1) (r's `row cells`)
                             WHEN JUST before THEN LIST (`a check of` (r's `row place`) (st's `the stepped grade`) here
                                                                    (`to the agora` (before `increased by` (st's `the grade's rate`))))
                             WHEN NOTHING THEN EMPTY
                         WHEN NOTHING THEN EMPTY)
                    (t's `grade steps`))

GIVEN t IS A `salary table`
GIVETH A LIST OF `cell check`
DECIDE `the grade steps of` t IS
    concat (map (GIVEN r YIELD `the grade steps of the row` t r) (t's `rows`))

GIVEN t IS A `salary table`
GIVETH A LIST OF `cell check`
DECIDE `the percentage steps of` t IS
    append (`the grade steps of` t) (`the rate steps of` t)

GIVEN t IS A `salary table`
GIVETH A LIST OF `cell check`
DECIDE `the rate steps of` t IS
    concat (map (GIVEN r YIELD
                     CONSIDER r's `row step`
                     WHEN `a rate` s THEN `the row steps of` t r
                     OTHERWISE EMPTY)
                (t's `rows`))

GIVEN t IS A `salary table`
GIVETH A LIST OF `cell check`
DECIDE `the shekel steps of` t IS
    concat (map (GIVEN r YIELD
                     CONSIDER r's `row step`
                     WHEN `shekels` s THEN `the row steps of` t r
                     OTHERWISE EMPTY)
                (t's `rows`))

-- No step in any teachers' table misses its cell by more than an agora.
-- (Annex א6' was the exception at seniority 4, grade 4 while the corpus
-- read 5,030.88; the page prints 5,030.86, its steps' figure: MMS-531.)
#ASSERT all (GIVEN t YIELD null (`the cells off by more than` 1 `agorot in` (`the percentage steps of` t))) `the teachers' tables`
#ASSERT all (GIVEN t YIELD null (`the cells off by more than` 1 `agorot in` (`the grade steps of` t))) `the teachers' tables`
#ASSERT all (GIVEN t YIELD null (`the cells off by more than` 1 `agorot in` (`the grade steps of` t))) `the principals' and deputies' tables`

-- F-ofek-hadash-tosefet-2011-d: the steps the tables print do not make
-- their cells. The percentage steps make each cell from its printed
-- neighbour only to within an agora (many cells are an agora off); and no
-- principals' or deputies' level rises by the whole shekels it prints —
-- א8' prints "₪ 1,264" and its levels rise by 1,263.81 — though each is
-- that rise rounded to the shekel. The reading adopted: the printed cells
-- govern, and the steps describe them (convention rounding.printed-figure).
GIVEN t IS A `salary table`
GIVETH A BOOLEAN
DECIDE `every level misses its printed shekels by less than half a shekel` t IF
        all (GIVEN c YIELD NOT (c's `agorot off` EQUALS 0)) (`the shekel steps of` t)
    AND null (`the cells off by more than` 49 `agorot in` (`the shekel steps of` t))

`all the teachers' percentage step checks` MEANS
    concat (map (GIVEN t YIELD `the percentage steps of` t) `the teachers' tables`)

`the printed steps do not make the cells` MEANS
        all (GIVEN t YIELD `every level misses its printed shekels by less than half a shekel` t) `the principals' and deputies' tables`
    AND count (`the misses in` `all the teachers' percentage step checks`) GREATER THAN 0
#ASSERT `the printed steps do not make the cells`
#ASSERT count `all the teachers' percentage step checks` EQUALS 5237
#ASSERT count (`the misses in` `all the teachers' percentage step checks`) EQUALS 1337
#ASSERT `the shekel steps of` `annex א8'` EQUALS
    LIST `a check of` 2 1 14112.55 (12848.74 PLUS 1264), `a check of` 2 2 15236.81 (13973.00 PLUS 1264),
         `a check of` 2 3 16459.45 (15195.64 PLUS 1264), `a check of` 2 4 17789.06 (16525.25 PLUS 1264),
         `a check of` 3 1 15376.36 (14112.55 PLUS 1264), `a check of` 3 2 16500.62 (15236.81 PLUS 1264),
         `a check of` 3 3 17723.26 (16459.45 PLUS 1264), `a check of` 3 4 19052.87 (17789.06 PLUS 1264),
         `a check of` 4 1 16640.17 (15376.36 PLUS 1264), `a check of` 4 2 17764.43 (16500.62 PLUS 1264),
         `a check of` 4 3 18987.07 (17723.26 PLUS 1264), `a check of` 4 4 20316.68 (19052.87 PLUS 1264)

-- (4) Every table rises along its grades and down its rows, so "the grade
-- nearest at or above A" (§46(ב), §71(ב)) is one cell.
GIVEN cs IS A LIST OF `grade cell`
GIVETH A BOOLEAN
DECIDE `rises along the grades` cs IF
    and (zipWith (GIVEN x, y YIELD x's grade LESS THAN y's grade AND x's pay LESS THAN y's pay) cs (drop 1 cs))

GIVEN t IS A `salary table`
GIVETH A BOOLEAN
DECIDE `rises along its grades and down its rows` t IF
        all (GIVEN r YIELD `rises along the grades` (r's `row cells`)) (t's `rows`)
    AND all (GIVEN r YIELD all (GIVEN c YIELD
                                    CONSIDER `the cell of` t (r's `row place` MINUS 1) (c's grade)
                                    WHEN JUST above THEN above LESS THAN c's pay
                                    WHEN NOTHING THEN TRUE)
                               (r's `row cells`))
            (t's `rows`)

#ASSERT all `rises along its grades and down its rows` `all thirty tables`

