-- הסכם אופק חדש (25.12.2008), §140: existing academic kindergarten
-- teachers' pay is converted as existing academic teachers' is, but with
-- the conversion coefficient Y fixed at 16% whatever the status; a teacher
-- in a young division or a teacher-and-kindergarten-teacher by her status
-- in March before the move, save one employed as a teacher in the year of
-- the move; the management and education allowances left out of X; and
-- §138 after placement.

IMPORT prelude
IMPORT common

§ `140`

-- (א): the conversion is §44's (encoded in its own section), Y fixed at 16%.
@ref akn:art_140__para_a
`a kindergarten teacher's conversion coefficient Y` MEANS 16%

DECLARE `status` IS ONE OF `a teacher`, `a kindergarten teacher`

-- (ב)–(ג): the conversion rules follow her status in March of the year
-- before her institution moved; but one employed as a teacher in the year
-- of the move, who was a kindergarten teacher that March, is converted as a
-- teacher.
@ref akn:art_140__para_b akn:art_140__para_c
GIVEN `status in March before the move` IS A `status`, `status in the year of the move` IS A `status`
GIVETH A `status`
DECIDE `converted as` `status in March before the move` `status in the year of the move` IS
    IF `status in the year of the move` EQUALS `a teacher` THEN `a teacher` ELSE `status in March before the move`

-- (ד): the management and education allowances are not in X.
@ref akn:art_140__para_d
DECLARE `kindergarten pay item` IS ONE OF `the management allowance`, `the education allowance`, `another item §44(ב) lists`

GIVEN i IS A `kindergarten pay item`
GIVETH A BOOLEAN
DECIDE `in a kindergarten teacher's salary to convert` i IF
    i EQUALS `another item §44(ב) lists`

-- (ה): after placement, §138's allowances.
@ref akn:art_140__para_e
GIVEN `placed in the table` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `section 138 applies after the conversion` `placed in the table` IF
    `placed in the table`

#ASSERT `converted as` `a kindergarten teacher` `a teacher` EQUALS `a teacher`
#ASSERT `converted as` `a teacher` `a kindergarten teacher` EQUALS `a teacher`
#ASSERT NOT `in a kindergarten teacher's salary to convert` `the management allowance`
