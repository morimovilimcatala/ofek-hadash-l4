-- הסכם אופק חדש (25.12.2008), §1: the preamble and the annexes are an
-- integral part of the agreement.

IMPORT prelude
IMPORT `base-agreement-common`
§ `1`

@ref akn:art_1
DECLARE `base agreement §1 part of the agreement` IS ONE OF
    `the preamble in base agreement §1`
    `the body of base agreement §1`
    `an annex in base agreement §1`

GIVEN p IS A `base agreement §1 part of the agreement`
GIVETH A BOOLEAN
DECIDE `binds as base agreement §1` p IF
    TRUE

#ASSERT `binds as base agreement §1` `the preamble in base agreement §1` AND `binds as base agreement §1` `an annex in base agreement §1`
