-- הסכם אופק חדש (25.12.2008), §3: whom the agreement covers — every
-- employee ranked on the teaching-staff grade employed in schools or
-- educational institutions in the civil service, the institutions it names;
-- and the terms "עובדי הוראה", "בית-ספר" and "מוסד חינוך" for the agreement.

IMPORT prelude
IMPORT common

§ `3`

@desc An employee, as far as section 3 asks about them.
DECLARE `employee under section 3` HAS
    `on the teaching-staff grade`  IS A BOOLEAN @desc ranked on the דירוג עובדי הוראה
    `in the civil service`         IS A BOOLEAN @desc employed by the State
    `institution`                  IS A `institution under section 3`

-- The institutions the clause names: kindergartens, primary schools and
-- junior high schools, special-education schools and special-education
-- classes in ordinary primary and junior high schools, regional support
-- centres, therapeutic centres, Pais clusters and teachers' centres. All of
-- them are "בית-ספר" or "מוסד חינוך" for the agreement.
@ref akn:art_3
DECLARE `institution under section 3` IS ONE OF
    `a kindergarten`
    `a primary school`
    `a junior high school`
    `a special-education school`
    `a special-education class in an ordinary primary or junior high school`
    `a regional support centre (מתי"א)`
    `a therapeutic centre`
    `a Pais cluster`
    `a teachers' centre (פסג"ה)`
    `an institution the clause does not name`

GIVEN i IS A `institution under section 3`
GIVETH A BOOLEAN
DECIDE `is a school or institution of the agreement` i IF
    NOT i EQUALS `an institution the clause does not name`

GIVEN e IS A `employee under section 3`
GIVETH A BOOLEAN
DECIDE `the agreement covers` e IF
        e's `on the teaching-staff grade`
    AND e's `in the civil service`
    AND `is a school or institution of the agreement` (e's `institution`)

#ASSERT `the agreement covers` (`employee under section 3` WITH
            `on the teaching-staff grade` IS TRUE
            `in the civil service`        IS TRUE
            `institution`                 IS `a therapeutic centre`)
#ASSERT NOT `the agreement covers` (`employee under section 3` WITH
            `on the teaching-staff grade` IS TRUE
            `in the civil service`        IS FALSE
            `institution`                 IS `a primary school`)
