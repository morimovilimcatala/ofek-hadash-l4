-- הסכם אופק חדש (25.12.2008), §53: the non-academics' combined salary
-- tables are annexes ט', י' and י"א, updated as §35(ב).

IMPORT prelude
IMPORT `base-agreement-common`
§ `53 טבלאות השכר המשולב החדשות למורים שאינם אקדמאים`
    @ref akn:art_53 akn:art_53/p2
    GIVEN `the non-academic table as annexed` IS A FUNCTION FROM `non-academic table` AND NUMBER AND NUMBER TO NUMBER

DECLARE `non-academic table` IS ONE OF
    `the senior certified teachers' table (annex ט')`
    `the certified teachers' table (annex י')`
    `the uncertified teachers' table (annex י"א)`

-- The annexes are not published with the agreement in the corpus: an input
-- by table, seniority and grade; ¶2: updated as §35(ב).
