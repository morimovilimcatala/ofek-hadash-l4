-- הסכם אופק חדש (25.12.2008), §66 קביעת רמת מורכבות לבית ספר: the
-- complexity level — 1 to 4 for primary and junior high schools, 2 to 4 for
-- special-education schools, by the clause's tables for the other
-- institutions; the notice to the union by 30 June; the parameters; the
-- shares of schools at each level; and the level fixed for the year.

IMPORT prelude
IMPORT common

§ `66 קביעת רמת מורכבות לבית ספר`

DECLARE `kind of institution` IS ONE OF
    `a primary or junior high school`
    `a special-education school`
    `a regional support centre`
    `a therapeutic centre`
    `a Pais cluster`
    `a teachers' centre`

DECLARE `section 66 action` IS ONE OF `notify the union of the complexity levels`

-- (א): the levels each kind may take, and the yearly notice to the union by
-- 30 June, a change or none. Time is in days from 1 January of the year.
@ref akn:art_66__para_a
GIVEN k IS A `kind of institution`
GIVETH A LIST OF NUMBER
DECIDE `the levels open to` k IS
    CONSIDER k
    WHEN `a primary or junior high school` THEN LIST 1, 2, 3, 4
    WHEN `a special-education school` THEN LIST 2, 3, 4
    WHEN `a regional support centre` THEN LIST 1, 2, 3
    WHEN `a therapeutic centre` THEN LIST 2
    WHEN `a Pais cluster` THEN LIST 2, 3
    WHEN `a teachers' centre` THEN LIST 1, 2, 3

GIVEN `year` IS A NUMBER
GIVETH A DEONTIC Party `section 66 action`
DECIDE `the yearly notice of the levels` `year` IS
    PARTY `the Ministry of Education`
    MUST  `notify the union of the complexity levels`
    WITHIN DATE_SERIAL (DATE_FROM_DMY 30 6 `year`) MINUS DATE_SERIAL (DATE_FROM_DMY 1 1 `year`)
    LEST BREACH BY `the Ministry of Education` BECAUSE "section 66(א): notice to the union by 30 June every year"

-- (ב), (ד): the parameters the Ministry weighs; how it weighs them is not
-- printed, so the level of a school is an input.
@ref akn:art_66__para_b akn:art_66__para_b__subpara_1 akn:art_66__para_b__subpara_2 akn:art_66__para_b__subpara_3 akn:art_66__para_b__subpara_4 akn:art_66__para_b__subpara_5 akn:art_66__para_d akn:art_66__para_d__subpara_1 akn:art_66__para_d__subpara_2 akn:art_66__para_d__subpara_3
DECLARE `complexity parameter` IS ONE OF
    `pupils in the school`
    `standard classes in the school`
    `the nurture index`
    `special classes in an ordinary school`
    `the stage of education`
    `teaching hours in the standard`

GIVEN k IS A `kind of institution`
GIVETH A LIST OF `complexity parameter`
DECIDE `the parameters weighed for` k IS
    CONSIDER k
    WHEN `a primary or junior high school` THEN
        LIST `pupils in the school`, `standard classes in the school`, `the nurture index`,
             `special classes in an ordinary school`, `the stage of education`
    WHEN `a special-education school` THEN
        LIST `standard classes in the school`, `pupils in the school`, `teaching hours in the standard`
    OTHERWISE EMPTY

-- (ג), (ה), (ו): the shares of primary and junior high schools at levels
-- 1–4 (16%, 34%, 34%, 16%, schools not yet in the reform included), and of
-- special-education schools a third at each of 2–4; the other
-- institutions are not in the division.
@ref akn:art_66__para_c akn:art_66__para_c__subpara_1 akn:art_66__para_c__subpara_2 akn:art_66__para_c__subpara_3 akn:art_66__para_c__subpara_4 akn:art_66__para_e akn:art_66__para_f
GIVEN level IS A NUMBER
GIVETH A NUMBER
DECIDE `the share of schools at level` level IS
    BRANCH IF level EQUALS 1 OR level EQUALS 4 THEN 16%
           IF level EQUALS 2 OR level EQUALS 3 THEN 34%
           OTHERWISE 0

GIVEN level IS A NUMBER
GIVETH A NUMBER
DECIDE `the share of special-education schools at level` level IS
    IF level AT LEAST 2 AND level AT MOST 4 THEN 1/3 ELSE 0

#ASSERT sum (map `the share of schools at level` (LIST 1, 2, 3, 4)) EQUALS 1
#ASSERT sum (map `the share of special-education schools at level` (LIST 2, 3, 4)) EQUALS 1

-- (ז): a regional support centre by the classes it serves — "עד 400" 1,
-- "400 - 800" 2, "800 - 1000" 2, "1000 +" 3. A bound two rows share
-- belongs to the row that opens with it (conventions thresholds.until and
-- thresholds.shared-bound): 400 is level 2 and 1,000 level 3.
@ref akn:art_66__para_g akn:art_66__para_g/p2 akn:art_66__para_g/p3 akn:art_66__para_g/p4 akn:art_66__para_g/p5 akn:art_66__para_g/p6 akn:art_66__para_g/p7 akn:art_66__para_g/p8 akn:art_66__para_g/p9 akn:art_66__para_g/p10 akn:art_66__para_g/p11 akn:art_66__para_g/p12 akn:art_66__para_g/p13 akn:art_66__para_g/p14 akn:art_66__para_g/p15
GIVEN classes IS A NUMBER
GIVETH A NUMBER
DECIDE `a support centre's level` classes IS
    BRANCH IF classes LESS THAN 400  THEN 1
           IF classes LESS THAN 1000 THEN 2
           OTHERWISE 3

-- (ח): a therapeutic centre is level 2.
@ref akn:art_66__para_h
`a therapeutic centre's level` MEANS 2

-- (ט): a Pais cluster by its weekly hours of activity — "עד 280" 2, "גדול
-- מ- 280" 3. The second row leaves 280 out, so "עד 280" holds it (an
-- exception to convention thresholds.until, recorded there).
@ref akn:art_66__para_i akn:art_66__para_i__subpara_1 akn:art_66__para_i__subpara_2
GIVEN `weekly hours of activity` IS A NUMBER
GIVETH A NUMBER
DECIDE `a Pais cluster's level` `weekly hours of activity` IS
    IF `weekly hours of activity` AT MOST 280 THEN 2 ELSE 3

-- (י): a teachers' centre by the teaching employees it serves — "עד 1,000"
-- 1, "1000- 2500" 2, "2500 – 4000" 2, "4000 +" 3, the shared bounds as in
-- (ז).
@ref akn:art_66__para_j akn:art_66__para_j/p2 akn:art_66__para_j/p3 akn:art_66__para_j/p4 akn:art_66__para_j/p5 akn:art_66__para_j/p6 akn:art_66__para_j/p7 akn:art_66__para_j/p8 akn:art_66__para_j/p9 akn:art_66__para_j/p10 akn:art_66__para_j/p11 akn:art_66__para_j/p12 akn:art_66__para_j/p13 akn:art_66__para_j/p14 akn:art_66__para_j/p15
GIVEN `teaching employees served` IS A NUMBER
GIVETH A NUMBER
DECIDE `a teachers' centre's level` `teaching employees served` IS
    BRANCH IF `teaching employees served` LESS THAN 1000 THEN 1
           IF `teaching employees served` LESS THAN 4000 THEN 2
           OTHERWISE 3

-- (יא): "רמת מורכבות" anywhere in the agreement is this section's, unless
-- said otherwise. (יב): the level set at the start of a school year does
-- not change during it.
@ref akn:art_66__para_ja akn:art_66__para_jb
GIVEN `level at the start of the year` IS A NUMBER, `level computed later in the year` IS A NUMBER
GIVETH A NUMBER
DECIDE `the level for the year` `level at the start of the year` `level computed later in the year` IS
    `level at the start of the year`

-- Every level a rule here gives is one (א) opens to its kind.
#ASSERT all (GIVEN c YIELD elem (`a support centre's level` c) (`the levels open to` `a regional support centre`)) (range 0 1500)
#ASSERT all (GIVEN h YIELD elem (`a Pais cluster's level` h) (`the levels open to` `a Pais cluster`)) (range 0 600)
#ASSERT `a support centre's level` 400 EQUALS 2
#ASSERT `a support centre's level` 1000 EQUALS 3
#ASSERT `a teachers' centre's level` 2500 EQUALS 2
#ASSERT `a Pais cluster's level` 280 EQUALS 2
#ASSERT `the level for the year` 2 3 EQUALS 2
