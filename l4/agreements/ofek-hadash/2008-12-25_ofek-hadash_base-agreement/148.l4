-- הסכם אופק חדש (25.12.2008), §148: the internship does not count for
-- seniority for pay or for the minimum period to a grade; it counts for
-- tenure, for the jubilee grant and for recuperation pay.

IMPORT prelude
IMPORT common

§ `148`

DECLARE `purpose of seniority` IS ONE OF
    `seniority for pay`
    `the minimum period for promotion`
    `tenure`
    `the jubilee grant`
    `recuperation pay`

@ref akn:art_148
GIVEN p IS A `purpose of seniority`
GIVETH A BOOLEAN
DECIDE `the internship counts for` p IF
    NOT (p EQUALS `seniority for pay` OR p EQUALS `the minimum period for promotion`)

#ASSERT `the internship counts for` `tenure`
#ASSERT NOT `the internship counts for` `seniority for pay`
