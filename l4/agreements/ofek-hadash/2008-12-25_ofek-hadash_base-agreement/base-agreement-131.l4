-- הסכם אופק חדש (25.12.2008), §131 גמול ייעוץ: the counselling allowance —
-- for at least 7 counselling hours; at most 6% with a temporary licence and
-- 9% with a permanent one; the maximum times the counselling hours over 16,
-- the hours being the position's hours in proportion to the counselling
-- share of its frontal hours, and never more than 16; the worked example;
-- one of the two role allowances; pension and study-fund contributions.

IMPORT prelude
IMPORT `base-agreement-common`
IMPORT conventions

§ `131 גמול ייעוץ`

DECLARE `counselling licence` IS ONE OF `a temporary licence`, `a permanent licence`

-- ¶1: at least 7 counselling hours.
@ref akn:art_131
`counselling hours an allowance asks at least` MEANS 7

-- (א)–(ב): the maximum rates.
@ref akn:art_131__para_a akn:art_131__para_b
GIVEN l IS A `counselling licence`
GIVETH A NUMBER
DECIDE `the maximum counselling rate` l IS
    IF l EQUALS `a permanent licence` THEN 9% ELSE 6%

@desc A counsellor's hours, as §131(ג) counts them.
DECLARE `counsellor's hours` HAS
    X IS A NUMBER @desc frontal teaching hours in fact
    Y IS A NUMBER @desc counselling hours in fact
    Z IS A NUMBER @desc all the hours of the position, individual and stay hours included (by annexes א' and ב')

-- (ג): "מספר שעות הייעוץ" = Z × Y / (X + Y), and the rate is the maximum
-- times that number over 16, the number never above 16. No rounding is
-- stated for the rule (convention rounding.default).
@ref akn:art_131__para_c akn:art_131__para_c/p2 akn:art_131__para_c/p3 akn:art_131__para_c/p4 akn:art_131__para_c/p5 akn:art_131__para_c/p6 akn:art_131__para_c/p7 akn:art_131__para_c/p8 akn:art_131__para_c/p9 akn:art_131__para_c/p10 akn:art_131__para_c/p11
GIVEN h IS A `counsellor's hours`
GIVETH A NUMBER
DECIDE `the number of counselling hours` h IS
    IF h's X PLUS h's Y GREATER THAN 0
    THEN min 16 (h's Z TIMES h's Y DIVIDED BY (h's X PLUS h's Y))
    ELSE 0

GIVEN l IS A `counselling licence`, h IS A `counsellor's hours`
GIVETH A NUMBER
DECIDE `the counselling rate` l h IS
    IF h's Y AT LEAST `counselling hours an allowance asks at least`
    THEN `the maximum counselling rate` l TIMES `the number of counselling hours` h DIVIDED BY 16
    ELSE 0

-- The worked example (¶12–(2)): a permanent licence, a primary school, 14
-- frontal and 10 counselling hours, X + Y = 24 (a 93% position by annex
-- א'), Z = 34. The text prints the number as 14.16 (34 × 10 / 24 is
-- 14.1666…, cut at the second place) and the rate as 7.97% (14.16 × 9 / 16
-- is 7.965, to the nearer hundredth); the exact rule gives 7.96875%, which
-- prints as the same 7.97 (convention rounding.printed-figure: the check
-- rounds, the rule does not).
@ref akn:art_131__para_c/p12 akn:art_131__para_c/p13 akn:art_131__para_c/p14 akn:art_131__para_c/p15 akn:art_131__para_c/p16 akn:art_131__para_c/p17 akn:art_131__para_c/p18 akn:art_131__para_c__subpara_1 akn:art_131__para_c__subpara_1/p2 akn:art_131__para_c__subpara_1/p3 akn:art_131__para_c__subpara_2 akn:art_131__para_c__subpara_2/p2 akn:art_131__para_c__subpara_2/p3
`the example's counsellor` MEANS
    `counsellor's hours` WITH
        X IS 14
        Y IS 10
        Z IS 34

#ASSERT TRUNC (`the number of counselling hours` `the example's counsellor`) 2 EQUALS 14.16
#ASSERT `to the agora` (100 TIMES `the counselling rate` `a permanent licence` `the example's counsellor`) EQUALS 7.97
#ASSERT `to the agora` (14.16 TIMES 9 DIVIDED BY 16) EQUALS 7.97

-- (ד): "לעניין סעיף 39(ג)" the counselling allowance is one of the two role
-- allowances a counsellor may have. F-ofek-hadash-base-131-a: the two-role
-- cap is §39(ב); §39(ג) is the special-education position. The reading
-- adopted (convention reading.misprint): §39(ב).
@ref akn:art_131__para_d
`the counselling allowance counts among the two of §39(ב)` MEANS TRUE

DECLARE `clause of section 39` IS ONE OF `39(א) the rates`, `39(ב) the two-role cap`, `39(ג) the special-education position`, `39(ד) the old rules`

`the clause 131(ד) names` MEANS `39(ג) the special-education position`
`131(ד) names §39(ג) for the two-role cap of §39(ב)` MEANS
    NOT (`the clause 131(ד) names` EQUALS `39(ב) the two-role cap`)
#ASSERT `131(ד) names §39(ג) for the two-role cap of §39(ב)`

DECLARE `section 131 action` IS ONE OF
    `act to have the counselling allowance recognised as permanent for the pension law`
    `make accrual-pension contributions on the counselling allowance`
    `make study-fund contributions on the counselling allowance`

-- (ה): the State undertakes to act for its recognition in the pension; for
-- one in an accrual pension, contributions are made on it. (ו): study fund.
@ref akn:art_131__para_e
GIVEN `insured in an accrual pension` IS A BOOLEAN
GIVETH A DEONTIC Party `section 131 action`
DECIDE `the pension on the counselling allowance` `insured in an accrual pension` IS
    IF `insured in an accrual pension`
    THEN PARTY `the State` MUST `make accrual-pension contributions on the counselling allowance`
         LEST BREACH BY `the State` BECAUSE "section 131(ה): accrual-pension contributions on the allowance"
    ELSE PARTY `the State` MUST `act to have the counselling allowance recognised as permanent for the pension law`
         LEST BREACH BY `the State` BECAUSE "section 131(ה): the State acts for the allowance's recognition"

@ref akn:art_131__para_f
GIVETH A DEONTIC Party `section 131 action`
DECIDE `the study fund on the counselling allowance` IS
    PARTY `the State` MUST `make study-fund contributions on the counselling allowance`
    LEST BREACH BY `the State` BECAUSE "section 131(ו): study-fund contributions on the allowance"

-- Over every split of a primary full position's 26 frontal hours (Z = 36):
-- the rate never passes the maximum, and grows with the counselling hours.
#ASSERT all (GIVEN y YIELD
                    `the counselling rate` `a permanent licence` (`counsellor's hours` WITH X IS 26 MINUS y, Y IS y, Z IS 36) AT MOST 9%
                AND `the counselling rate` `a permanent licence` (`counsellor's hours` WITH X IS 26 MINUS y, Y IS y, Z IS 36)
                    AT MOST `the counselling rate` `a permanent licence` (`counsellor's hours` WITH X IS 25 MINUS y, Y IS y PLUS 1, Z IS 36))
            (range 0 25)
