#ASSERT `the advance on the pension supplement` (DATE_FROM_DMY 1 7 2001) 120 FALSE EQUALS 0
#ASSERT `the advance on the pension supplement` (DATE_FROM_DMY 1 3 2001) (0 MINUS 30) FALSE EQUALS 0
#ASSERT `the advance on the pension supplement` (DATE_FROM_DMY 1 5 2001) 120 TRUE EQUALS 0
#ASSERT `the group's data meets the criteria` (85%) (5%)
#ASSERT NOT `the group's data meets the criteria` (84.9%) (5%)
#ASSERT NOT `the group's data meets the criteria` (90%) (5.1%)
#ASSERT `the commissioner verifies the group's data` (85%)
#ASSERT NOT `the commissioner verifies the group's data` (84%)
#ASSERT `an error in the insured's data` (1.5%)
#ASSERT NOT `an error in the insured's data` (1%)
#ASSERT `the full-data rate` 81 100 10 EQUALS 0.9
#ASSERT `the pensioners' arrears run from` (DATE_FROM_DMY 1 6 1997) EQUALS DATE_FROM_DMY 1 1 1998
#ASSERT `the pensioners' arrears run from` (DATE_FROM_DMY 1 6 1999) EQUALS DATE_FROM_DMY 1 6 1999
#ASSERT `the salary-ratio pension supplement, capped` 900 100 100 EQUALS 650
#ASSERT `the salary-ratio pension supplement, capped` 900 110 100 EQUALS 715
#ASSERT `entitled to the salary-ratio pension supplement for` TRUE (DATE_FROM_DMY 20 3 1996) (DATE_FROM_DMY 1 1 1998)
#ASSERT NOT `entitled to the salary-ratio pension supplement for` TRUE (DATE_FROM_DMY 19 3 1996) (DATE_FROM_DMY 1 1 1998)
#ASSERT NOT `entitled to the salary-ratio pension supplement for` TRUE (DATE_FROM_DMY 1 6 1996) (DATE_FROM_DMY 1 12 1997)
#ASSERT `the group the interim insured are paid with` TRUE TRUE EQUALS `the interim group, of 2001`
#ASSERT `the group the interim insured are paid with` TRUE FALSE EQUALS `the active group, of 2001`
