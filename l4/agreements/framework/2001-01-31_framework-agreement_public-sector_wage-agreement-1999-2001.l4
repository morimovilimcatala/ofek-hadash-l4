`one missing 40 of 300 months` MEANS `2001 summary insured without full data` WITH
    `full data for his last three years` IS TRUE
    `months of membership` IS 300
    `months without data` IS 40
`one missing 50 of 300 months` MEANS `2001 summary insured without full data` WITH
    `full data for his last three years` IS TRUE
    `months of membership` IS 300
    `months without data` IS 50
`one without his last three years' data` MEANS `2001 summary insured without full data` WITH
    `full data for his last three years` IS FALSE
    `months of membership` IS 300
    `months without data` IS 40

#ASSERT `how §15 computes his supplement` TRUE `one missing 40 of 300 months` EQUALS `the general formula, of 2001`
#ASSERT `how §15 computes his supplement` TRUE `one missing 50 of 300 months` EQUALS `formula 4 for the missing part-time, of 2001`
#ASSERT `how §15 computes his supplement` TRUE `one without his last three years' data` EQUALS `formula 5 for the rest, of 2001`
#ASSERT `how §15 computes his supplement` FALSE `one missing 40 of 300 months` EQUALS `the agreed formula still to be negotiated, of 2001`
#ASSERT `a fund's change applies to his supplement` (DATE_FROM_DMY 1 1 2002) (DATE_FROM_DMY 1 7 2003)
#ASSERT NOT `a fund's change applies to his supplement` (DATE_FROM_DMY 1 1 2002) (DATE_FROM_DMY 1 7 2001)
