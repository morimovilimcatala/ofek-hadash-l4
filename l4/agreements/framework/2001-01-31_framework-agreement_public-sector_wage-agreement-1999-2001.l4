-- teaching scale is in neither.
#ASSERT `the bill's supplement to the pension` (DATE_FROM_DMY 1 6 1998) "הדירוג המנהלי" FALSE (DATE_FROM_DMY 1 1 2001) 5000 EQUALS 160
#ASSERT `the bill's supplement to the pension` (DATE_FROM_DMY 1 6 2000) "הדירוג המנהלי" FALSE (DATE_FROM_DMY 1 1 2001) 5000 EQUALS 0
#ASSERT `the bill's supplement to the pension` (DATE_FROM_DMY 1 6 1998) "הדירוג המנהלי" TRUE (DATE_FROM_DMY 1 1 2001) 5000 EQUALS 0
#ASSERT `the letter of 31.1.2001 exhausts the erosion claim` (DATE_FROM_DMY 1 6 1998) (DATE_FROM_DMY 1 6 1999)
#ASSERT NOT `the letter of 31.1.2001 exhausts the erosion claim` (DATE_FROM_DMY 1 6 1998) (DATE_FROM_DMY 1 6 2000)
#ASSERT elem "אחיות" `the scales the erosion compensation reaches`
#ASSERT count `the scales the erosion compensation reaches` EQUALS 24
#ASSERT NOT elem "עובדי הוראה" `the scales the erosion compensation reaches`
#ASSERT NOT elem "דירוג עובדי ההוראה" `the scales of the bill's schedule`

-- The pension summary: the groups by retirement; the advances in
-- February–June 2001 only, never negative, stopping when the general
-- formula starts; the criteria at 85% and 5% exactly, failed at 84.9% or
-- 5.1%; an error above 1% only; arrears from 1.1.1998 for one who retired
-- in 1997; a cap of 650 at the base index and 715 at 110; one missing 40
