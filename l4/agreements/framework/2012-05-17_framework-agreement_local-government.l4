    WHEN `the first management level, of 17.5.2012` THEN 5%
    WHEN `the second management level, of 17.5.2012` THEN 7.5%
    WHEN `the third management level, of 17.5.2012` THEN 10%
    WHEN `no management level, of 17.5.2012` THEN 0

