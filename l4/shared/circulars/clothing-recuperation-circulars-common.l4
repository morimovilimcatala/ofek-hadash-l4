-- What the yearly clothing-allowance circulars and the yearly circulars on
-- recuperation pay and the jubilee grant print in the same words (MMS-775):
-- each such declaration is declared here once and imported by every circular
-- that prints it. A circular cites the rows a declaration encodes in a note
-- where the declaration stood; above each one here is where it is printed.

IMPORT prelude
IMPORT vocabulary

-- circular תשס"ח/4 and circular תשס"ט/3
`the framework-87 supplement from 1.1.2007` MEANS 150.52

-- circular תשס"ח/4 and circular תשס"ט/3
`the agreement-94 supplement from 1.1.2007` MEANS 135.35

-- circular תשע"ג/7 and circular תשע"ד/7
DECLARE `fraction by stage` HAS
    `stage`          IS A `stage of education`
    `stage fraction` IS A NUMBER

-- circular תשע"ג/7 and circular תשע"ד/7
GIVEN s IS A `stage of education`
GIVETH A NUMBER
DECIDE `the qualifying seniority for the stage` s IS
    CONSIDER s
    WHEN `the junior-high stage`    THEN 25
    WHEN `the upper-division stage` THEN 25
    OTHERWISE 30

-- circular תשע"ה/4, circular תשע"ו/7 and circular תשע"ז/5
`the shares §1ו pays at two employers` MEANS 0.7 PLUS 0.6

-- circular תשע"ה/4, circular תשע"ו/7 and circular תשע"ז/5
`the share §1ה allows` MEANS min (`the shares §1ו pays at two employers`) 1

-- circular תשע"ה/4, circular תשע"ו/7 and circular תשע"ז/5
`§1ה and §1ו give a two-employer teacher different totals` MEANS
    NOT (`the shares §1ו pays at two employers` EQUALS `the share §1ה allows`)

-- circular תשע"ה/4, circular תשע"ו/7 and circular תשע"ז/5
@desc One part of the employee's position, by the stage of education it is in.
DECLARE `position part` HAS
    `part stage`    IS A `stage of education`
    `part fraction` IS A NUMBER @desc the share of a full position this part is (1 = a full position)

-- circular תשע"ה/4, circular תשע"ו/7 and circular תשע"ז/5
GIVEN `position with this employer` IS A NUMBER, `position with all employers` IS A NUMBER
GIVETH A NUMBER
DECIDE `the jubilee share at one of several employers` `position with this employer` `position with all employers` IS
    IF `position with all employers` GREATER THAN 1
    THEN `position with this employer`
    ELSE min `position with this employer` 1

-- circular תשע"ה/4, circular תשע"ו/7 and circular תשע"ז/5
`the position alone` MEANS 1

-- circular תשע"ה/4, circular תשע"ה/7, circular תשע"ו/7, circular תשע"ו/8, circular תשע"ז/5, circular תשע"ז/6, circular תשע"ח/4, circular תשע"ח/7, circular תשע"ט/6, circular תשע"ט/8, circular תש"ף/9, circular תש"ף/11, circular תשפ"א/8 and circular תשפ"ב/7
`every track` MEANS
    LIST `a teacher outside the reforms`, `a principal outside the reforms`,
         `a teacher in Oz LaTmura in full implementation`, `a teacher in Ofek Hadash`

-- circular תשע"ה/7, circular תשע"ו/8 and circular תשע"ז/6
GIVEN c IS A `clothing case`
GIVETH A NUMBER
DECIDE `clothing position share` c IS
    min (c's `position with this employer`) 1

-- circular תשע"ה/7, circular תשע"ו/8 and circular תשע"ז/6
`the clothing shares §1ה pays at two employers` MEANS 0.7 PLUS 0.6

-- circular תשע"ה/7, circular תשע"ו/8 and circular תשע"ז/6
`§1ד and §1ה give a two-employer teacher different totals` MEANS
    NOT (`the clothing shares §1ה pays at two employers` EQUALS min (`the clothing shares §1ה pays at two employers`) 1)

-- circular תשע"ה/7, circular תשע"ו/8, circular תשע"ז/6, circular תשע"ח/7 and circular תשע"ט/8
GIVEN t IS AN `employment track`
GIVETH A LIST OF NUMBER
DECIDE `the limits §1ו sets` t IS
    CONSIDER t
    WHEN `a teacher outside the reforms` THEN LIST 1.4
    WHEN `a principal outside the reforms` THEN LIST 1.4, 1.5
    WHEN `a teacher in Oz LaTmura in full implementation` THEN LIST 1.4, 1.25
    WHEN `a teacher in Ofek Hadash` THEN LIST 1.4, 1.17

-- circular תשע"ה/7, circular תשע"ו/8 and circular תשע"ז/6
`the physical-education allowance is in addition to the general one` MEANS TRUE

-- circular תשע"ה/7, circular תשע"ו/8 and circular תשע"ז/6
`the professions with shoes and two coats` MEANS
    LIST "מערכות תעופה", "מכטרוניקה", "טרמודינמיקה טכנית ימית", "מערכות סיב\"מ ותיב\"מ",
         "תחזוקת מערכות מכניות", "מערכות מכונאות רכב", "מערכות ממוחשבות ברכב",
         "מערכות הספק, פיקוד ובקרה", "מערכות בקרת אקלים", "אומנות הבישול והאפיה המלונאית",
         "ימאות – ספינות", "מערכות טלוויזיה וקולנוע", "מערכות צילום"

-- circular תשע"ה/7, circular תשע"ו/8 and circular תשע"ז/6
`the professions with two coats` MEANS
    LIST "מערכות אלקטרוניות", "מערכות מחשוב ובקרה", "מערכות מחשבים", "תכנון ותכנות מערכות",
         "מערכות ביוטכנולוגיה", "ניהול תיירותי", "ניהול מלונאי", "חינוך לגיל הרך", "עיצוב",
         "אופנה ותלבושות", "עיצוב שיער, וטיפוח החן", "סיעוד", "אומנות שימושית"

-- circular תשע"ה/7, circular תשע"ו/8 and circular תשע"ז/6
`the technological allowance is in addition to the general one` MEANS TRUE

-- circular תשע"ה/7, circular תשע"ו/8 and circular תשע"ז/6
`a full-position teacher at one employer` MEANS
    `clothing case` WITH
        `graded as a teaching employee`   IS TRUE
        `employed by a supervised owner`  IS TRUE
        `position with this employer`     IS 1
        `position with all the employers` IS 1

-- circular תשע"ה/7, circular תשע"ו/8 and circular תשע"ז/6
`a half-position teacher` MEANS
    `clothing case` WITH
        `graded as a teaching employee`   IS TRUE
        `employed by a supervised owner`  IS TRUE
        `position with this employer`     IS 0.5
        `position with all the employers` IS 0.5

-- circular תשע"ח/4 and circular תשע"ט/6
@desc One part of the employee's position, by stage of education.
DECLARE `jubilee position` HAS
    `stage` IS A `stage of education`
    `fraction of the position` IS A NUMBER

-- circular תשע"ח/4 and circular תשע"ט/6
`a twelve-month year read literally` MEANS 12 TIMES (1 DIVIDED BY 10)

-- circular תשע"ח/4 and circular תשע"ט/6
`one tenth a month passes the full allowance in a twelve-month year` MEANS
    `a twelve-month year read literally` GREATER THAN 1

-- circular תשע"ח/4 and circular תשע"ט/6
`both stages` MEANS `every stage of education`

-- circular תשפ"א/7 and circular תשפ"א/8
GIVEN t IS AN `employment track`
GIVETH A NUMBER
DECIDE `employment ceiling` t IS
    CONSIDER t
    WHEN `a teacher outside the reforms` THEN 1.40
    WHEN `a principal outside the reforms` THEN 1.50
    WHEN `a teacher in Oz LaTmura in full implementation` THEN 1.25
    WHEN `a teacher in Ofek Hadash` THEN 1.17

-- circular תשפ"ה/11 and circular תשפ"ו/7
`1/10 for each month uncapped passes the whole allowance in a twelve-month year` MEANS
    12 DIVIDED BY 10 GREATER THAN 1

-- circular תשפ"ה/11, circular תשפ"ה/12, circular תשפ"ו/7 and circular תשפ"ו/8
GIVEN t IS AN `employment track`
GIVETH A NUMBER
DECIDE `the position limit across all employers` t IS
    CONSIDER t
    WHEN `a teacher outside the reforms` THEN 1.4
    WHEN `a principal outside the reforms` THEN 1.5
    WHEN `a teacher in Oz LaTmura in full implementation` THEN 1.315
    WHEN `a teacher in Ofek Hadash` THEN 1.17

-- circular תשפ"ה/11 and circular תשפ"ו/7
@desc One part of the teacher's employment, by the stage of education it is in (2.ו.3).
DECLARE `employment part` HAS
    `part stage`     IS A `stage of education`
    `part fraction`  IS A NUMBER  @desc the share of a full position this part is

-- circular תשפ"ה/11 and circular תשפ"ו/7
GIVEN s IS A `stage of education`
GIVETH A NUMBER
DECIDE `the entitling seniority` s IS
    CONSIDER s
    WHEN `the junior-high stage` THEN 25
    WHEN `the upper-division stage` THEN 25
    WHEN `recognised unofficial special education in Ofek Hadash` THEN 25
    WHEN `the academic teachers' college stage` THEN 25
    OTHERWISE 30

-- circular תשפ"ה/11 and circular תשפ"ו/7
GIVEN s IS A `stage of education`
GIVETH A BOOLEAN
DECIDE `named by the 25-year list` s IF
    `the entitling seniority` s EQUALS 25

-- circular תשפ"ה/11 and circular תשפ"ו/7
GIVEN s IS A `stage of education`
GIVETH A BOOLEAN
DECIDE `named by the 30-year list read as a genus` s IF
    CONSIDER s
    WHEN `the kindergarten stage` THEN TRUE
    WHEN `the primary stage` THEN TRUE
    WHEN `the teachers' college stage` THEN TRUE
    WHEN `the academic teachers' college stage` THEN TRUE
    OTHERWISE FALSE

-- circular תשפ"ה/11 and circular תשפ"ו/7
`an academic teacher-training college is named by both lists` MEANS
        `named by the 25-year list` `the academic teachers' college stage`
    AND `named by the 30-year list read as a genus` `the academic teachers' college stage`

-- circular תשפ"ה/11 and circular תשפ"ו/7
GIVEN `unpaid-leave year purchased for pension` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the unpaid-leave year counts towards the jubilee seniority` `unpaid-leave year purchased for pension` IF
    `unpaid-leave year purchased for pension`

-- circular תשפ"ה/11 and circular תשפ"ו/7
GIVEN `position fraction with this employer` IS A NUMBER
GIVETH A NUMBER
DECIDE `jubilee position share with one of several employers` `position fraction with this employer` IS
    min `position fraction with this employer` 1

-- circular תשפ"ה/12 and circular תשפ"ו/8
`1.ו's limit for every teaching employee` MEANS 1.4

-- circular תשפ"ה/12 and circular תשפ"ו/8
`1.ו gives a principal outside the reform two limits` MEANS
    NOT `1.ו's limit for every teaching employee` EQUALS `the position limit across all employers` `a principal outside the reforms`

-- circular תשפ"ה/12 and circular תשפ"ו/8
`the professions with shoes and two robes` MEANS
    LIST "מערכות תעופה", "מכטרוניקה", "טרמודינמיקה טכנית ימית", "מערכות סיב\"מ ותיב\"מ",
         "תחזוקת מערכות מכניות", "מערכות מכונאות רכב", "מערכות ממוחשבות ברכב",
         "מערכות הספק, פיקוד ובקרה", "מערכות בקרת אקלים", "אומנות הבישול והאפיה המלונאית",
         "ימאות – ספינות", "מערכות טלוויזיה וקולנוע", "מערכות צילום"

-- circular תשפ"ה/12 and circular תשפ"ו/8
`the professions with two robes` MEANS
    LIST "מערכות אלקטרוניות", "מערכות מחשוב ובקרה", "מערכות מחשבים", "תכנון ותכנות מערכות",
         "מערכות ביוטכנולוגיה", "ניהול תיירותי", "ניהול מלונאי",
         "חינוך לגיל הרך", "עיצוב", "אופנה ותלבושות", "עיצוב שיער, וטיפוח החן", "סיעוד", "אומנות שימושית"

-- circular תשפ"ה/12 and circular תשפ"ו/8
`the full-time physiotherapists' allowance` MEANS 800
