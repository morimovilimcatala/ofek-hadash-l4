@ref akn:att_4__hc_1__para_3__subpara_c/p20 akn:att_4__hc_1__para_3__subpara_c/p21 akn:att_4__hc_1__para_3__subpara_c/p22 akn:att_4__hc_1__para_3__subpara_c/p23
