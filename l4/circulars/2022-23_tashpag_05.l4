-- חוזר לבעלויות תשפ"ג/5 (4.12.2022): הסכם שכר חדש מיום 19.10.2022 לתקופה
-- 1.1.2020 - 31.12.2026.
-- For teaching employees in pre-reform ("עולם ישן") conditions in the
-- recognized-unofficial institutions it lists: the 2022 shekel supplement,
-- and the two salary advances, their deduction and the notices that go with them.

IMPORT prelude
IMPORT common

-- Time in this file is counted in SCHOOL MONTHS from September 2022
-- (common.l4's `month number`: September 2022 = 1, December 2022 = 4,
-- January 2023 = 5, February 2023 = 6).
`September 2022` MEANS `month number` September
`November 2022`  MEANS `month number` November
`December 2022`  MEANS `month number` December
`January 2023`   MEANS `month number` January

§ `חוזר לבעלויות תשפ"ג/5`

-- akn:preamble The letterhead, address, privacy notice, date, reference number, addressees, greeting and subject line; no rule.
-- akn:preamble/p21 The recital that the wage agreement between the State and the Teachers' Union was signed, for teaching employees in Ofek Hadash and in pre-reform conditions; no rule. (It dates the signing 29.10.2022 where the subject line and section 3 say 19.10.2022.)
-- akn:preamble/p22 The circular's purpose: to set out the agreement's terms for employees in pre-reform conditions; the rules are sections 1-3.
-- akn:preamble/p23 The heading "תחולה"; no rule.

DECLARE `circular 5 action` IS ONE OF
    `pay the 2022 shekel supplement from September 2022` HAS `retroactive amount paid` IS A NUMBER
    `pay advance A` HAS `advance A paid` IS A NUMBER
    `pay advance B` HAS `advance B paid` IS A NUMBER
    `deduct the advance from salary` HAS `advance deducted` IS A NUMBER
    `deduct the advance in the final settlement` HAS `advance settled` IS A NUMBER
    `pay an advance to an employee who has not signed the notice`


@desc The stages of education ¶24 lists; all are recognized-unofficial (מוכש"ר).
DECLARE `stage of education` IS ONE OF
    `regular-education kindergartens`
    `special-education kindergartens not yet in Ofek Hadash`
    `regular-education primary and junior-high schools`
    `special-education schools not yet in Ofek Hadash`
    `another stage`

@desc A teaching employee, as far as this circular asks about one.
DECLARE `circular 5 employee` HAS
    `graded in the teaching employees' grading`        IS A BOOLEAN
    `employed by an owner of a supervised institution` IS A BOOLEAN
    `stage employed in`                                IS A `stage of education`
    `in Ofek Hadash`                                   IS A BOOLEAN @desc employed under the conditions of the Ofek Hadash reform
    `position fraction`                                IS A NUMBER  @desc the share of a full position (1 = 100%)
    `signed the advance notice`                        IS A BOOLEAN @desc signed annex A's "הודעה על קבלת מקדמה" before the advance is paid

-- ¶24-¶28: every employee graded as a teaching employee, employed by the
-- owners of institutions the Ministry supervises, in one of four stages.
@ref akn:preamble/p24 akn:preamble/p25 akn:preamble/p26 akn:preamble/p27 akn:preamble/p28
GIVEN e IS A `circular 5 employee`
GIVETH A BOOLEAN
DECIDE `the circular applies to` e IF
        e's `graded in the teaching employees' grading`
    AND e's `employed by an owner of a supervised institution`
    AND NOT e's `stage employed in` EQUALS `another stage`

§§ `1 תוספת שקלית אחידה לעובדי הוראה שאינם ברפורמת אופק חדש`

-- akn:art_1 The heading of section 1, which limits it to employees not in Ofek Hadash.

`the 2022 shekel supplement for a full position` MEANS 500

-- 1.1: from 1.9.2022, ₪500 for a full position (100%), "תוספת שקלית 2022".
-- 1.2: pro-rated to the position fraction.
@ref akn:art_1__para_1-1 akn:art_1__para_1-2
GIVEN e IS A `circular 5 employee`, m IS A NUMBER @desc the school month the supplement is for (September 2022 = 1)
GIVETH A NUMBER
DECIDE `the 2022 shekel supplement` e m IS
    IF `the circular applies to` e AND (NOT e's `in Ofek Hadash`) AND m AT LEAST `September 2022`
    THEN `the 2022 shekel supplement for a full position` TIMES e's `position fraction`
    ELSE 0

-- 1.3: salary for every purpose, and counted in every percentage
-- supplement on the combined salary except supplements 2001, 2008 and
-- 2011. 1.4: not counted in the completion to the minimum wage; an
-- "excluded supplement" under the 2015 temporary-provision law.
@ref akn:art_1__para_1-3 akn:art_1__para_1-4
GIVEN p IS A `purpose`
GIVETH A BOOLEAN
DECIDE `the 2022 shekel supplement counts for` p IF
    CONSIDER p
    WHEN `supplement 2001` THEN FALSE
    WHEN `supplement 2008` THEN FALSE
    WHEN `supplement 2011` THEN FALSE
    WHEN `completion to the minimum wage under the Minimum Wage Law 1987` THEN FALSE
    OTHERWISE TRUE

@desc What a pay component is taken into account FOR (1.3, 1.4).
DECLARE `purpose` IS ONE OF
    `salary for every purpose`
    `percentage supplements computed on the combined salary`
    `supplement 2001`
    `supplement 2008`
    `supplement 2011`
    `the hourly value`
    `severance pay under the Severance Pay Law 1963`
    `pension-fund contributions for an employee in an accumulating pension`
    `training-fund contributions`
    `other contributions and deductions customary for the combined salary`
    `completion to the minimum wage under the Minimum Wage Law 1987`

-- 1.1: paid from January 2023's salary, retroactive to 1.9.2022: by then
-- the months September 2022 to January 2023 are owed.
@ref akn:art_1__para_1-1/p1
GIVEN e IS A `circular 5 employee`
GIVETH A DEONTIC Party `circular 5 action`
DECIDE `the 2022 supplement is paid with January 2023's salary` e IS
    IF `the 2022 shekel supplement` e `January 2023` GREATER THAN 0
    THEN PARTY `the employer`
         MUST  `pay the 2022 shekel supplement from September 2022` `paid`
               PROVIDED `paid` AT LEAST `the 2022 shekel supplement` e `January 2023` TIMES `January 2023`
         WITHIN `January 2023`
         LEST BREACH BY `the employer` BECAUSE "circular תשפ\"ג/5 1.1: the 2022 shekel supplement is paid from January 2023's salary, retroactive to 1.9.2022"
    ELSE FULFILLED

§§ `2 מקדמות שכר`

`an advance for a full position` MEANS 500

-- 2.1א-ב: ₪500 for a full-position employee in pre-reform conditions (each
-- of advance A and advance B); 2.1ג: pro-rated to the position fraction.
@ref akn:art_2__para_2-1 akn:art_2__para_2-1__subpara_a/p2 akn:art_2__para_2-1__subpara_a/p3 akn:art_2__para_2-1__subpara_b/p2 akn:art_2__para_2-1__subpara_b/p3 akn:art_2__para_2-1__subpara_c
GIVEN e IS A `circular 5 employee`
GIVETH A NUMBER
DECIDE `the advance` e IS
    IF `the circular applies to` e AND NOT e's `in Ofek Hadash`
    THEN `an advance for a full position` TIMES e's `position fraction`
    ELSE 0

-- 2.2: advance A is deducted with the salary in which the first payment
-- under the collective agreement is made, or December 2022's, whichever
-- is earlier. 2.3: advance B with the salary AFTER that one, or January
-- 2023's, whichever is earlier.
@ref akn:art_2__para_2-2
GIVEN `first agreement payment` IS A NUMBER @desc the school month of the salary carrying the first payment under the collective agreement
GIVETH A NUMBER
DECIDE `advance A is deducted in` `first agreement payment` IS
    min `first agreement payment` `December 2022`

@ref akn:art_2__para_2-3
GIVEN `first agreement payment` IS A NUMBER
GIVETH A NUMBER
DECIDE `advance B is deducted in` `first agreement payment` IS
    min (`first agreement payment` PLUS 1) `January 2023`

-- 2.2-2.3: the advance is deducted from salary in its deduction month.
-- 2.4 (and annex A ¶5): an employee who leaves before the advance's
-- deduction month has it deducted in the final settlement. F-2022-23_tashpag_05-a:
-- the clause cites "20.1א, 20.1ב, 20.2, 20.3", read as this circular's 2.1-2.3.
@ref akn:art_2__para_2-4 akn:att_1__hc_1__para_5 akn:art_2__para_2-2 akn:art_2__para_2-3
GIVEN e IS A `circular 5 employee`
      `deduction month` IS A NUMBER @desc the month the advance is due to be deducted (2.2 or 2.3)
      `leaves in` IS A NUMBER @desc the school month the employment ends
GIVETH A DEONTIC Party `circular 5 action`
DECIDE `the advance is recovered` e `deduction month` `leaves in` IS
    IF `leaves in` LESS THAN `deduction month`
    THEN PARTY `the employer`
         MUST  `deduct the advance in the final settlement` `settled`
               PROVIDED `settled` EQUALS `the advance` e
         WITHIN `leaves in`
    ELSE PARTY `the employer`
         MUST  `deduct the advance from salary` `deducted`
               PROVIDED `deducted` EQUALS `the advance` e
         WITHIN `deduction month`

-- 2.1א with 2.2 and 2.5: advance A is paid with November 2022's salary and
-- at the latest December 2022's, only to an employee who signed annex A's
-- notice first. Its deduction is `the advance is recovered` above, with
-- 2.2's month (WITHIN counts from the start of the trace, so the two
-- are separate rules on one timeline rather than a HENCE).
@ref akn:art_2__para_2-1__subpara_a/p1 akn:art_2__para_2-5
GIVEN e IS A `circular 5 employee`
GIVETH A DEONTIC Party `circular 5 action`
DECIDE `advance A` e IS
    IF `the advance` e GREATER THAN 0 AND e's `signed the advance notice`
    THEN PARTY `the employer`
         MUST  `pay advance A` `paid`
               PROVIDED `paid` EQUALS `the advance` e
         WITHIN `December 2022`
         LEST BREACH BY `the employer` BECAUSE "circular תשפ\"ג/5 2.1א: advance A is paid at the latest with December 2022's salary"
    ELSE PARTY `the employer`
         SHANT `pay an advance to an employee who has not signed the notice`
         LEST BREACH BY `the employer` BECAUSE "circular תשפ\"ג/5 2.5: the advance is paid only to an employee who signed the notice first"

-- 2.1ב with 2.3: advance B with December 2022's salary and at the latest
-- January 2023's; deducted under 2.3 by `the advance is recovered`.
@ref akn:art_2__para_2-1__subpara_b/p1
GIVEN e IS A `circular 5 employee`
GIVETH A DEONTIC Party `circular 5 action`
DECIDE `advance B` e IS
    IF `the advance` e GREATER THAN 0 AND e's `signed the advance notice`
    THEN PARTY `the employer`
         MUST  `pay advance B` `paid`
               PROVIDED `paid` EQUALS `the advance` e
         WITHIN `January 2023`
         LEST BREACH BY `the employer` BECAUSE "circular תשפ\"ג/5 2.1ב: advance B is paid at the latest with January 2023's salary"
    ELSE FULFILLED

-- 2.6: every payslip that carries an advance carries the notice below; the
-- notice and annex A's form are data: the years they print are what
-- F-2022-23_tashpag_05-b and -c are about.
@ref akn:art_2__para_2-6 akn:art_2__para_2-6/p2
`the payslip notice's blanks` MEANS
    LIST `printed blank` "the month the advance was paid" 2022,
         `printed blank` "advance A's latest deduction month" 2022,
         `printed blank` "advance B's latest deduction month" 2023

DECLARE `printed blank` HAS
    `what the blank is for` IS A STRING
    `year printed`          IS A NUMBER

@ref akn:att_1__hc_1__para_1 akn:att_1__hc_1__para_2 akn:att_1__hc_1__para_3 akn:att_1__hc_1__para_4
`annex A's blanks` MEANS
    LIST `printed blank` "the month advance A is paid" 2022,
         `printed blank` "advance A's latest deduction month" 2023,
         `printed blank` "the month advance B is paid" 2022,
         `printed blank` "advance B's latest deduction month" 2023

-- akn:att_1__hc_1 The employee's acknowledgement and the lines for name, identity number, date and signature on annex A's form; the duty to have it signed is 2.5.
-- akn:att_1__hc_1/p2 akn:att_1__hc_1/p3 akn:att_1__hc_1/p4 akn:att_1__hc_1/p5 Blank lines of annex A's form; no rule.

GIVEN what IS A STRING
      blanks IS A LIST OF `printed blank`
GIVETH A LIST OF NUMBER
DECIDE `the year printed for` what `in` blanks IS
    map (GIVEN b YIELD b's `year printed`) (filter (GIVEN b YIELD b's `what the blank is for` EQUALS what) blanks)

-- The calendar year of a school month of 2022-23 (September 2022 = 1).
GIVEN m IS A NUMBER
GIVETH A NUMBER
DECIDE `the calendar year of` m IS
    IF m AT MOST `December 2022` THEN 2022 ELSE 2023

-- F-2022-23_tashpag_05-b: under 2.2, advance A is deducted at the latest
-- with December 2022's salary; annex A's form prints its deduction month
-- in 2023.
`annex A dates advance A's deduction in a year 2.2 excludes` MEANS
    NOT (`the year printed for` "advance A's latest deduction month" `in` `annex A's blanks`
         EQUALS LIST (`the calendar year of` (`advance A is deducted in` `January 2023`)))
#ASSERT `annex A dates advance A's deduction in a year 2.2 excludes`

-- F-2022-23_tashpag_05-c: 2.1ב lets advance B be paid with January 2023's
-- salary; the notice 2.6 requires on that payslip, and annex A's form,
-- print the payment month in 2022 only.
`the notices cannot state advance B paid in January 2023` MEANS
        NOT elem (`the calendar year of` `January 2023`) (`the year printed for` "the month the advance was paid" `in` `the payslip notice's blanks`)
    AND NOT elem (`the calendar year of` `January 2023`) (`the year printed for` "the month advance B is paid" `in` `annex A's blanks`)
#ASSERT `the notices cannot state advance B paid in January 2023`

-- F-2022-23_tashpag_05-a: 2.4 cites clauses 20.1-20.3 "above"; the
-- circular's sections are 1-3 and its advances clauses 2.1-2.3.
`the clauses the circular numbers` MEANS
    LIST "1.1", "1.2", "1.3", "1.4", "2.1", "2.2", "2.3", "2.4", "2.5", "2.6", "3"
`the clauses 2.4 cites` MEANS LIST "20.1", "20.2", "20.3"
`2.4 cites clauses the circular does not have` MEANS
    all (GIVEN c YIELD NOT elem c `the clauses the circular numbers`) `the clauses 2.4 cites`
#ASSERT `2.4 cites clauses the circular does not have`

§§ `3 The agreement prevails`

DECLARE `instrument` IS ONE OF
    `this circular`
    `the collective agreement of 19.10.2022`

-- 3: the circular collects the agreement's rules; where the two conflict,
-- the agreement governs.
@ref akn:art_3
GIVEN `the circular says` IS A NUMBER, `the agreement says` IS A NUMBER
GIVETH AN `instrument`
DECIDE `which governs` `the circular says` `the agreement says` IS
    IF `the circular says` EQUALS `the agreement says`
    THEN `this circular`
    ELSE `the collective agreement of 19.10.2022`

-- akn:conclusions The sign-off, signatories and list of copies; no rule.

§§ `Worked examples`

-- The employees are made up.
`a pre-reform teacher at 80%` MEANS
    `circular 5 employee` WITH
        `graded in the teaching employees' grading`        IS TRUE
        `employed by an owner of a supervised institution` IS TRUE
        `stage employed in`                                IS `regular-education primary and junior-high schools`
        `in Ofek Hadash`                                   IS FALSE
        `position fraction`                                IS 0.8
        `signed the advance notice`                        IS TRUE

`an unsigned pre-reform teacher` MEANS
    `circular 5 employee` WITH
        `graded in the teaching employees' grading`        IS TRUE
        `employed by an owner of a supervised institution` IS TRUE
        `stage employed in`                                IS `regular-education kindergartens`
        `in Ofek Hadash`                                   IS FALSE
        `position fraction`                                IS 1
        `signed the advance notice`                        IS FALSE

#ASSERT `the 2022 shekel supplement` `a pre-reform teacher at 80%` `September 2022` EQUALS 400
#ASSERT `the advance` `a pre-reform teacher at 80%` EQUALS 400
#ASSERT NOT `the 2022 shekel supplement counts for` `supplement 2008`
#ASSERT `the 2022 shekel supplement counts for` `the hourly value`
#ASSERT `advance A is deducted in` `January 2023` EQUALS `December 2022`
#ASSERT `advance B is deducted in` `January 2023` EQUALS `January 2023`
#ASSERT `advance B is deducted in` `November 2022` EQUALS `December 2022`

-- Advance A paid in November; with the first agreement payment in January
-- 2023 it is deducted in December. An employee leaving in November has it
-- recovered in the final settlement.
#TRACE `advance A` `a pre-reform teacher at 80%` AT 0 WITH
    PARTY `the employer` DOES `pay advance A` 400 AT 3
#TRACE `the advance is recovered` `a pre-reform teacher at 80%` (`advance A is deducted in` `January 2023`) 99 AT 0 WITH
    PARTY `the employer` DOES `deduct the advance from salary` 400 AT 4
#TRACE `the advance is recovered` `a pre-reform teacher at 80%` (`advance A is deducted in` `January 2023`) `November 2022` AT 0 WITH
    PARTY `the employer` DOES `deduct the advance in the final settlement` 400 AT 3
-- Advance B not paid by January 2023: breached.
#TRACE `advance B` `a pre-reform teacher at 80%` AT 0 WITH
    PARTY `the employer` DOES `pay advance B` 400 AT 6
-- Paying an employee who never signed the notice is a breach of 2.5.
#TRACE `advance A` `an unsigned pre-reform teacher` AT 0 WITH
    PARTY `the employer` DOES `pay an advance to an employee who has not signed the notice` AT 3
-- The supplement for September 2022 to January 2023 paid with January's salary.
#TRACE `the 2022 supplement is paid with January 2023's salary` `a pre-reform teacher at 80%` AT 0 WITH
    PARTY `the employer` DOES `pay the 2022 shekel supplement from September 2022` 2000 AT 5
