-- חוזר לבעלויות תשפ"ג/4 (4.12.2022): הסכם שכר חדש מיום 19.10.2022 לתקופה
-- 1.1.2020 - 31.12.2026.
-- The 19.10.2022 wage agreement as it applies to the recognized-unofficial
-- special-education institutions in Ofek Hadash and the official junior
-- highs of six-year schools: chapter 1 for Ofek Hadash employees (tables,
-- the Ofek 2022 supplement, role-allowance rates and minimums, the
-- preparation day, the colleague kindergarten teacher, school activities,
-- clothing, non-academic teachers, the school-role allowance, part-time);
-- chapter 2 for pre-reform employees (the 2022 shekel supplement); chapter
-- 3 for all (global salary of principals, the advances, precedence).

IMPORT prelude
IMPORT common

-- Time in this file is counted in SALARY MONTHS from September 2022
-- (month 1). A date "1.9.YYYY" is the first month of that school year.
`1 September 2022` MEANS 1
`November 2022`    MEANS 3
`December 2022`    MEANS 4
`January 2023`     MEANS 5
`July 2023`        MEANS 11
`1 September 2023` MEANS 13
`1 September 2024` MEANS 25
`1 September 2025` MEANS 37

GIVEN m IS A NUMBER
GIVETH A NUMBER
DECIDE `the calendar year of` m IS
    IF m AT MOST `December 2022` THEN 2022
    ELSE IF m AT MOST 16 THEN 2023
         ELSE 2024

§ `חוזר לבעלויות תשפ"ג/4`

-- akn:preamble The letterhead, address, privacy notice, date, reference number, addressees, greeting and subject line; no rule.
-- akn:preamble/p20 The recital that the wage agreement between the State and the Teachers' Union was signed, for employees in Ofek Hadash and in pre-reform conditions; no rule. (It dates the signing 29.10.2022 where the subject line and section 22 say 19.10.2022.)
-- akn:preamble/p21 The circular's purpose: to set out each of the agreement's components for the employees it concerns and from the date it sets; the rules are the three chapters.
-- akn:preamble/p22 The heading "תחולה"; no rule.

@desc The stages of education ¶24 lists.
DECLARE `stage of education` IS ONE OF
    `recognized-unofficial special-education schools`
    `recognized-unofficial special-education kindergartens`
    `official junior highs of six-year schools`
    `another stage`

DECLARE `employment terms` IS ONE OF
    `Ofek Hadash terms`
    `pre-reform terms`

@desc A teaching employee, as far as this circular asks about one.
DECLARE `circular 4 employee` HAS
    `graded in the teaching employees' grading`        IS A BOOLEAN
    `employed by an owner of a supervised institution` IS A BOOLEAN
    `stage employed in`                                IS A `stage of education`
    `terms`                                            IS AN `employment terms`
    `position fraction`                                IS A NUMBER  @desc the share of a full position (1 = 100%)
    `signed the advance notice`                        IS A BOOLEAN @desc signed annex A's "הודעה על קבלת מקדמה" before the advance is paid

-- ¶23-¶24: employees graded as teaching employees, employed by the owners
-- of supervised institutions, in the three stages listed.
@ref akn:preamble/p23 akn:preamble/p24
GIVEN e IS A `circular 4 employee`
GIVETH A BOOLEAN
DECIDE `the circular applies to` e IF
        e's `graded in the teaching employees' grading`
    AND e's `employed by an owner of a supervised institution`
    AND NOT e's `stage employed in` EQUALS `another stage`

-- ¶25-¶27 and the chapters' own first lines: chapter 1 for Ofek Hadash
-- terms only, chapter 2 for pre-reform terms only (in institutions that
-- moved to Ofek Hadash where the employee has not), chapter 3 for both.
@ref akn:preamble/p25 akn:preamble/p26 akn:preamble/p27 akn:chp_1/p1 akn:chp_2/p1
GIVEN c IS A `chapter`, e IS A `circular 4 employee`
GIVETH A BOOLEAN
DECIDE `chapter` c `applies to` e IF
    `the circular applies to` e
    AND (CONSIDER c
         WHEN `chapter 1` THEN e's `terms` EQUALS `Ofek Hadash terms`
         WHEN `chapter 2` THEN e's `terms` EQUALS `pre-reform terms`
         WHEN `chapter 3` THEN TRUE)

DECLARE `chapter` IS ONE OF
    `chapter 1`
    `chapter 2`
    `chapter 3`

§ `פרק ראשון — עו"ה המועסקים בתנאי רפורמת אופק חדש`

-- akn:chp_1 The heading of chapter 1; its scope is the rule above.

§§ `1 עדכון טבלאות שכר משולב`

-- akn:art_1 The heading of section 1.

DECLARE `salary table` IS ONE OF
    `the tables on the eve of the agreement`
    `annex tables A1 to A8`
    `annex table A9 in place of A8`

-- 1.1: from 1.9.2022 the new combined-salary tables of annexes A1-A8
-- replace those in force on the eve of the agreement, paid from January
-- 2023's salary retroactive to 1.9.2022. 1.2: from 1.9.2023 annex A9
-- replaces A8. The tables themselves are the agreement's annexes, which
-- this circular links to (section 21) and does not print: inputs.
@ref akn:art_1__para_1-1 akn:art_1__para_1-2
GIVEN m IS A NUMBER @desc the salary month the salary is for (September 2022 = 1)
GIVETH A `salary table`
DECIDE `the combined-salary tables in force in` m IS
    IF m AT LEAST `1 September 2023` THEN `annex table A9 in place of A8`
    ELSE IF m AT LEAST `1 September 2022` THEN `annex tables A1 to A8`
         ELSE `the tables on the eve of the agreement`

-- akn:art_1/p1 The proviso that nothing else in the combined-salary rules changes; no rule beyond section 1's.

DECLARE `circular 4 action` IS ONE OF
    `pay the retroactive differences from September 2022` HAS `component paid` IS A STRING
    `pay advance A` HAS `advance A paid` IS A NUMBER
    `pay advance B` HAS `advance B paid` IS A NUMBER
    `deduct the advance from salary` HAS `advance deducted` IS A NUMBER
    `deduct the advance in the final settlement` HAS `advance settled` IS A NUMBER
    `pay an advance to an employee who has not signed the notice`
    `pay the physiotherapists' clothing supplement` HAS `clothing paid` IS A NUMBER
    `set the school roles and their units`
    `set the allocation key of allowance units`

-- 1.1, 2.1 and 18.1: each is paid from January 2023's salary,
-- retroactive to 1.9.2022.
@ref akn:art_1__para_1-1/p1
GIVEN `component` IS A STRING @desc the component paid retroactively: "the new tables", "the Ofek 2022 supplement" or "the 2022 shekel supplement"
GIVETH A DEONTIC Party `circular 4 action`
DECIDE `paid with January 2023's salary, retroactive to 1.9.2022` `component` IS
    PARTY `the employer`
    MUST  `pay the retroactive differences from September 2022` `what`
          PROVIDED `what` EQUALS `component`
    WITHIN `January 2023`
    LEST BREACH BY `the employer` BECAUSE "circular תשפ\"ג/4: payment from January 2023's salary, retroactive to 1.9.2022"

§§ `2 תוספת אופק 2022`

-- 2.1: from 1.9.2022 a full-position employee is entitled to a shekel
-- supplement by grade, per annexes B1-B7 ("תוספת אופק 2022"); 2.2: from
-- 1.9.2023 per annexes C1-C7. The annexes are not printed here: the
-- full-position amount for the grade is an input. 2.3: pro-rated to the
-- position fraction.
@ref akn:art_2__para_2-1 akn:art_2__para_2-2 akn:art_2__para_2-3
GIVEN e IS A `circular 4 employee`
      m IS A NUMBER @desc the salary month (September 2022 = 1)
      `full-position amount by the annexes` IS A NUMBER @desc the grade's full-position amount in annexes B1-B7 (from 1.9.2022) or C1-C7 (from 1.9.2023) of the agreement
GIVETH A NUMBER
DECIDE `the Ofek 2022 supplement` e m `full-position amount by the annexes` IS
    IF `chapter` `chapter 1` `applies to` e AND m AT LEAST `1 September 2022`
    THEN `full-position amount by the annexes` TIMES e's `position fraction`
    ELSE 0

GIVEN m IS A NUMBER
GIVETH A STRING
DECIDE `the annexes that price the Ofek 2022 supplement in` m IS
    IF m AT LEAST `1 September 2023` THEN "C1-C7" ELSE "B1-B7"

-- 2.4: salary for every purpose, counted in percentage supplements on the
-- combined salary, the hourly value for substitution hours and school
-- activities, the reduction for absence, section 33(d)'s pay, severance,
-- pension (accumulating pension) and training-fund contributions and all
-- customary contributions and deductions. Unlike 18.3-18.4, 2.4 makes no
-- exception, so the supplement counts for every purpose listed.
@ref akn:art_2__para_2-4
GIVEN p IS A `purpose`
GIVETH A BOOLEAN
DECIDE `the Ofek 2022 supplement counts for` p IF
    TRUE

@desc What a pay component is taken into account FOR (2.4, 11.3, 16.11, 16.12, 18.3, 18.4).
DECLARE `purpose` IS ONE OF
    `salary for every purpose`
    `percentage supplements computed on the combined salary`
    `supplement 2001`
    `supplement 2008`
    `supplement 2011`
    `the hourly value`
    `pay for substitution hours or school activities`
    `salary reduction for an hour of absence`
    `the pay under section 33(d) of the Ofek Hadash agreement`
    `severance pay under the Severance Pay Law 1963`
    `pension-fund contributions`
    `training-fund contributions`
    `other contributions and deductions customary for the combined salary`
    `completion to the minimum wage under the Minimum Wage Law 1987`
    `part of the combined salary, the base of other supplements`

-- akn:art_2__para_2-5 The proviso that the Ofek 2022 supplement changes nothing in the shekel supplement of the 19.3.2017 agreement; no rule of its own.

§§ `3 תוספת אישית אחוזית למנהלים`

-- 3: at each date the tables are updated (1.1, 1.2) the rate of the
-- principal's personal percentage supplement under section 72 of the
-- Ofek Hadash agreement is updated so that its shekel amount is kept:
-- C = A / B, A the shekel amount paid on the eve of the update, B the new
-- tabular salary for the principal's grade and complexity level.
@ref akn:art_3/p1 akn:art_3/p2 akn:art_3/p3 akn:art_3/p4 akn:art_3/p5 akn:art_3/p6 akn:art_3/p7
GIVEN `A` IS A NUMBER @desc the shekel amount of the personal supplement paid to the principal on the eve of the table update
      `B` IS A NUMBER @desc the principal's new tabular salary, by grade and complexity level, after the update
GIVETH A NUMBER
DECIDE `the updated personal-supplement rate` `A` `B` IS
    `A` DIVIDED BY `B`

GIVEN `rate on the eve` IS A NUMBER, `combined salary on the eve` IS A NUMBER
GIVETH A NUMBER
DECIDE `the shekel amount of the personal supplement` `rate on the eve` `combined salary on the eve` IS
    `rate on the eve` TIMES `combined salary on the eve`

-- 3(1), the worked example as printed: 15% of ₪16,664.9 (grade ב',
-- complexity 3) is stated as ₪2,499.6; the salary updated to ₪20,436.7;
-- C = 2,499.6 / 20,436.7 = 12.23%.
@ref akn:art_3/p8 akn:art_3__para_1 akn:art_3__para_1/p2 akn:art_3__para_1/p3
`the example's rate on the eve`            MEANS 0.15
`the example's combined salary on the eve` MEANS 16664.9
`the example's stated shekel amount`       MEANS 2499.6
`the example's new salary`                 MEANS 20436.7
`the example's stated new rate`            MEANS 0.1223

GIVEN x IS A NUMBER, `units` IS A NUMBER
GIVETH A NUMBER
DECIDE `rounded` x `to` `units` IS
    ROUND (x DIVIDED BY `units`) TIMES `units`

-- The formula reproduces the example's 12.23% from its stated amount.
`the formula reproduces the example's rate` MEANS
    `rounded` (`the updated personal-supplement rate` `the example's stated shekel amount` `the example's new salary`) `to` 0.0001
    EQUALS `the example's stated new rate`
#ASSERT `the formula reproduces the example's rate`

-- F-2022-23_tashpag_04-a: but 15% of 16,664.9 is 2,499.735, which is not
-- the stated 2,499.6 to the shekel's tenth (it is 15% of 16,664.0).
`the example's shekel amount is not 15% of its salary` MEANS
    NOT (`rounded` (`the shekel amount of the personal supplement` `the example's rate on the eve` `the example's combined salary on the eve`) `to` 0.1
         EQUALS `the example's stated shekel amount`)
#ASSERT `the example's shekel amount is not 15% of its salary`

-- 3(2): the update replaces the way section 72 computes the rate; nothing
-- changes the 2016 shekel supplement. 3(3): no other rule changes.
@ref akn:art_3__para_2
`the section 72 computation of the rate is replaced by C = A / B` MEANS TRUE
-- akn:art_3__para_2/p2 The proviso that nothing changes the rules of the 2016 shekel supplement; no rule of its own.
-- akn:art_3__para_3 The proviso that no other rule of the principals' personal supplement changes; no rule of its own.

§§ `4-8, 13 Role-allowance rates from 1.9.2023`

-- akn:art_4 The heading of section 4 (counseling allowance).
-- akn:art_5 The heading of section 5 (deputy allowance).
-- akn:art_7 The heading of section 7 (social-education coordinator).
-- akn:art_8 The heading of section 8 (pedagogical coordinator).
-- akn:art_13 The heading of section 13 (special-education allowance).

DECLARE `rate change` HAS
    `allowance`       IS A STRING
    `rate on the eve` IS A NUMBER
    `rate from 1.9.2023` IS A NUMBER

-- 4.1: the counseling allowance of section 131 of the Ofek Hadash
-- agreement: its maximal rate rises, temporary licence 8% → 12%,
-- permanent licence 12% → 18%. 5.1: the deputy allowance of section
-- 117(ב) 13% → 20%. 7.1: the social-education coordinator in a primary
-- school (39(א)(8)) 6% → 8%; 7.2: in a junior high it stays 10%. 8.1: the
-- pedagogical coordinator (39ג) 6% → 8%. 13.1: the special-education
-- allowance (39(א)(3)) 9% → 10% and 14% → 15%; 13.1.3: 14% → 17% for the
-- hours taught in a class the Ministry defines as autism or severe
-- psychiatric disorder (circular נח/8(ב)).
@ref akn:art_4__para_4-1 akn:art_4__para_4-1__subpara_4-1-1 akn:art_4__para_4-1__subpara_4-1-2 akn:art_5__para_5-1 akn:art_7__para_7-1 akn:art_7__para_7-2 akn:art_8__para_8-1 akn:art_13__para_13-1 akn:art_13__para_13-1__subpara_13-1-1 akn:art_13__para_13-1__subpara_13-1-2 akn:art_13__para_13-1__subpara_13-1-3
`the rate changes from 1.9.2023` MEANS
    LIST `rate change` "counseling, temporary licence (maximal rate)"   0.08 0.12,
         `rate change` "counseling, permanent licence (maximal rate)"   0.12 0.18,
         `rate change` "deputy"                                         0.13 0.20,
         `rate change` "social-education coordinator, primary school"   0.06 0.08,
         `rate change` "social-education coordinator, junior high"     0.10 0.10,
         `rate change` "pedagogical coordinator"                        0.06 0.08,
         `rate change` "special education at 9%"                        0.09 0.10,
         `rate change` "special education at 14%"                       0.14 0.15,
         `rate change` "special education at 14%, autism or severe psychiatric class hours" 0.14 0.17

GIVEN `which` IS A STRING
      m IS A NUMBER @desc the salary month (September 2022 = 1)
GIVETH A LIST OF NUMBER
DECIDE `the rate of` `which` `in` m IS
    map (GIVEN r YIELD IF m AT LEAST `1 September 2023` THEN r's `rate from 1.9.2023` ELSE r's `rate on the eve`)
        (filter (GIVEN r YIELD r's `allowance` EQUALS `which`) `the rate changes from 1.9.2023`)

-- 4.2, 5.2, 7.3, 8.2, 13.2: nothing else changes, and an employee not
-- in Ofek Hadash keeps the old rate — which chapter 1's scope already says.
@ref akn:art_4__para_4-2 akn:art_5__para_5-2 akn:art_7__para_7-3 akn:art_8__para_8-2 akn:art_13__para_13-2
GIVEN e IS A `circular 4 employee`, m IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the new rates apply to` e `in` m IF
    `chapter` `chapter 1` `applies to` e AND m AT LEAST `1 September 2023`

§§ `6 סכום שקלי מינימלי לגמולי תפקיד`

-- akn:art_6 The heading of section 6.

DECLARE `allowance with a minimum` IS ONE OF
    `class education, not first grade`
    `class education, first grade`
    `grade coordinator, up to four classes`
    `grade coordinator, more than four classes`
    `deputy`
    `kindergarten management`

-- 6.1.1 (notwithstanding 39(א)(1)-(2)): class education is the higher of
-- 10% of the combined salary (11.5% for a first-grade class) and ₪1,000.
-- 6.2.1 (notwithstanding 39(א)(9)): grade coordinator, 7% up to four
-- classes in the grade, 6% above four, or ₪1,100. 6.3.1 (notwithstanding
-- 117(ב)): deputy, 13%/20% "by the date of the increase" — 20%, since
-- section 5 raises it on the same 1.9.2023 — or ₪1,100.
-- 6.4.1 (notwithstanding 138(א)(1)): kindergarten management, the rate of
-- 138(א)(1) (an input), or ₪1,500. All from 1.9.2023.
@ref akn:art_6__para_6-1 akn:art_6__para_6-1__subpara_6-1-1 akn:art_6__para_6-1__subpara_6-1-1__cls_6-1-1-1 akn:art_6__para_6-1__subpara_6-1-1__cls_6-1-1-2 akn:art_6__para_6-2 akn:art_6__para_6-2__subpara_6-2-1 akn:art_6__para_6-2__subpara_6-2-1__cls_6-2-1-1 akn:art_6__para_6-2__subpara_6-2-1__cls_6-2-1-2 akn:art_6__para_6-3 akn:art_6__para_6-3__subpara_6-3-1 akn:art_6__para_6-3__subpara_6-3-1__cls_6-3-1-1 akn:art_6__para_6-3__subpara_6-3-1__cls_6-3-1-2 akn:art_6__para_6-4 akn:art_6__para_6-4__subpara_6-4-1 akn:art_6__para_6-4__subpara_6-4-1__cls_6-4-1-1 akn:art_6__para_6-4__subpara_6-4-1__cls_6-4-1-2
GIVEN a IS AN `allowance with a minimum`
      `kindergarten management rate` IS A NUMBER @desc the rate of section 138(א)(1) of the Ofek Hadash agreement (not printed here)
GIVETH A NUMBER
DECIDE `the rate part of` a `kindergarten management rate` IS
    CONSIDER a
    WHEN `class education, not first grade`          THEN 0.10
    WHEN `class education, first grade`              THEN 0.115
    WHEN `grade coordinator, up to four classes`     THEN 0.07
    WHEN `grade coordinator, more than four classes` THEN 0.06
    WHEN `deputy`                                    THEN 0.20
    WHEN `kindergarten management`                   THEN `kindergarten management rate`

GIVEN a IS AN `allowance with a minimum`
GIVETH A NUMBER
DECIDE `the shekel minimum of` a IS
    CONSIDER a
    WHEN `class education, not first grade`          THEN 1000
    WHEN `class education, first grade`              THEN 1000
    WHEN `kindergarten management`                   THEN 1500
    OTHERWISE 1100

-- 6.4.3: the same rules apply to the shekel amount as applied on the eve
-- of the agreement to the percentage one (its pro-rating among them,
-- which is an input here); 6.1.2, 6.2.2, 6.3.2, 6.4.2: nothing else changes.
@export The monthly class-education, grade-coordinator, deputy or kindergarten-management role allowance of an Ofek Hadash teaching employee from 1 September 2023 under circular תשפ"ג/4 section 6: the higher of the percentage and the shekel minimum, before the share the existing rules apply
GIVEN a IS AN `allowance with a minimum` @desc which role allowance
      `combined salary` IS A NUMBER @desc the monthly combined salary (שכר משולב) the percentage is computed on
      `kindergarten management rate` IS A NUMBER @desc the rate of section 138(א)(1) of the Ofek Hadash agreement; used only for kindergarten management
      `share under the existing rules` IS A NUMBER @desc the share the rules in force on the eve of the agreement apply to the percentage allowance (1 = in full)
GIVETH A NUMBER
DECIDE `the role allowance with its minimum` a `combined salary` `kindergarten management rate` `share under the existing rules` IS
    max (`the rate part of` a `kindergarten management rate` TIMES `combined salary`)
        (`the shekel minimum of` a)
    TIMES `share under the existing rules`

-- F-2022-23_tashpag_04-b: 6.3.1 cites section 117(ב) "as amended in
-- section 8 of this chapter"; the amendment of 117(ב) is section 5, and
-- section 8 is the pedagogical coordinator's.
DECLARE `chapter 1 section` HAS
    `section number` IS A NUMBER
    `what it amends` IS A STRING

`chapter 1's sections that amend role-allowance rates` MEANS
    LIST `chapter 1 section` 4  "section 131 (counseling)",
         `chapter 1 section` 5  "section 117(ב) (deputy)",
         `chapter 1 section` 7  "section 39(א)(8) (social-education coordinator)",
         `chapter 1 section` 8  "section 39ג (pedagogical coordinator)",
         `chapter 1 section` 13 "section 39(א)(3) (special education)"

GIVEN n IS A NUMBER
GIVETH A LIST OF STRING
DECIDE `what chapter 1 section amends` n IS
    map (GIVEN s YIELD s's `what it amends`)
        (filter (GIVEN s YIELD s's `section number` EQUALS n) `chapter 1's sections that amend role-allowance rates`)

`6.3.1 cites as amending 117(ב) a section that does not` MEANS
    NOT (`what chapter 1 section amends` 8 EQUALS LIST "section 117(ב) (deputy)")
    AND `what chapter 1 section amends` 5 EQUALS LIST "section 117(ב) (deputy)"
#ASSERT `6.3.1 cites as amending 117(ב) a section that does not`

@ref akn:art_6__para_6-1__subpara_6-1-2 akn:art_6__para_6-2__subpara_6-2-2 akn:art_6__para_6-3__subpara_6-3-2 akn:art_6__para_6-4__subpara_6-4-2 akn:art_6__para_6-4__subpara_6-4-3
`the shekel minimum follows the percentage allowance's rules` MEANS TRUE

-- 6.5: "the provisions of this section 10" do not apply to an employee
-- outside Ofek Hadash. F-2022-23_tashpag_04-c: read as section 6, the
-- section it closes; chapter 1's scope gives the same answer.
@ref akn:art_6__para_6-5
GIVEN e IS A `circular 4 employee`
GIVETH A BOOLEAN
DECIDE `section 6 applies to` e IF
    `chapter` `chapter 1` `applies to` e

`the section 6.5 names`     MEANS 10
`the section 6.5 sits in`   MEANS 6
`6.5 names "this section 10" from inside section 6` MEANS
    NOT (`the section 6.5 names` EQUALS `the section 6.5 sits in`)
#ASSERT `6.5 names "this section 10" from inside section 6`

§§ `9 גמול ליווי טיולים ופעילות חוץ בית ספרית`

-- akn:art_9 The heading of section 9.

-- 9.1.1: from 1.9.2023, section 4ג of the trips agreement (8.9.1998) is
-- amended: the pay is in activity units, each worth 0.7% of the full-
-- position monthly combined salary (not by the employee's position).
@ref akn:art_9__para_9-1 akn:art_9__para_9-1__subpara_9-1-1 akn:art_9__para_9-1__subpara_9-1-1/p2
GIVEN `full-position combined salary` IS A NUMBER @desc the monthly combined salary of a FULL position, whatever the employee's own position
      m IS A NUMBER @desc the salary month (September 2022 = 1)
GIVETH A NUMBER
DECIDE `the value of an activity unit` `full-position combined salary` m IS
    IF m AT LEAST `1 September 2023`
    THEN 0.007 TIMES `full-position combined salary`
    ELSE 0

-- 9.1.2: section 4ח of the trips agreement and section 40(ד) of the Ofek
-- Hadash agreement read "less than 7 hours" for "less than 4 hours". 9.1.3:
-- the trips agreement's annex A (pay on the basis of substitution hours for
-- escorting a trip on a free day or a day of work shorter than that) is
-- replaced by annex ה' of the agreement — which this circular does not print.
@ref akn:art_9__para_9-1__subpara_9-1-2 akn:art_9__para_9-1__subpara_9-1-3
GIVEN `hours employed that day` IS A NUMBER, m IS A NUMBER
GIVETH A BOOLEAN
DECIDE `a short day for trip escort pay` `hours employed that day` m IF
    IF m AT LEAST `1 September 2023`
    THEN `hours employed that day` LESS THAN 7
    ELSE `hours employed that day` LESS THAN 4

-- akn:art_9__para_9-2 The proviso that no other rule of the trips allowance changes; no rule of its own.

§§ `10 יום היערכות`

-- akn:art_10 The heading of section 10.

-- 10.1: a teacher who took part in the school's preparation day (of no
-- more than six hours) may not perform, up to the hours worked that day:
-- up to two individual hours in the first week (10.1.1) and up to four
-- stay hours, devoted to work meetings, in the first two months (10.1.2);
-- in all up to six, and never more than the hours worked that day.
@ref akn:art_10__para_10-1 akn:art_10__para_10-1/p2 akn:art_10__para_10-1__subpara_10-1-1 akn:art_10__para_10-1__subpara_10-1-2 akn:art_10__para_10-1/p3
GIVEN `hours worked on the preparation day` IS A NUMBER
      `individual hours not performed` IS A NUMBER @desc in the first week of work in the school year
      `stay hours not performed` IS A NUMBER @desc in the first two months of work, of those devoted to work meetings
GIVETH A BOOLEAN
DECIDE `the teacher may leave unperformed` `hours worked on the preparation day` `individual hours not performed` `stay hours not performed` IF
        `hours worked on the preparation day` AT MOST 6
    AND `individual hours not performed` AT MOST 2
    AND `stay hours not performed` AT MOST 4
    AND `individual hours not performed` PLUS `stay hours not performed` AT MOST `hours worked on the preparation day`

-- 10.2: for a kindergarten teacher the preparation day is held as one
-- professional-development meeting with the supervisor in August, counted
-- among the meetings of the school year that begins the following
-- September. No other pay for taking part; travel refunds unaffected.
@ref akn:art_10__para_10-2 akn:art_10__para_10-2/p2 akn:art_10__para_10-2/p3
GIVEN `took part in the preparation day` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `professional-development meetings the preparation day counts for` `took part in the preparation day` IS
    IF `took part in the preparation day` THEN 1 ELSE 0

`the extra pay for taking part in the preparation day` MEANS 0

§§ `11 תוספת לגננת עמיתה`

-- akn:art_11 The heading of section 11.
-- akn:art_11__para_11-1 The words "לעניין סעיף זה", which introduce the definitions.

@desc A kindergarten teacher, as far as section 11 asks.
DECLARE `kindergarten teacher` HAS
    `placed on a fixed day the head of the kindergarten does not work` IS A BOOLEAN
    `in charge of the kindergarten that day, with all its duties`      IS A BOOLEAN
    `receives kindergarten management (138(א))`                        IS A BOOLEAN
    `receives kindergarten education (138(ב))`                         IS A BOOLEAN
    `receives a trailing management or counseling allowance (50א, 140(ו))` IS A BOOLEAN
    `receives cluster management (144ג(א))`                            IS A BOOLEAN
    `receives any salary-preservation component (38ב, 38ג)`            IS A BOOLEAN
    `kindergarten teacher's position fraction`                         IS A NUMBER

-- 11.1: "גננת עמיתה" (complementary teacher): placed as the teacher on a
-- fixed weekday the head of the kindergarten does not work, and in charge
-- of it that day.
@ref akn:art_11__para_11-1/p2
GIVEN k IS A `kindergarten teacher`
GIVETH A BOOLEAN
DECIDE `is a colleague kindergarten teacher` k IF
        k's `placed on a fixed day the head of the kindergarten does not work`
    AND k's `in charge of the kindergarten that day, with all its duties`

-- 11.1: an ELIGIBLE one receives none of the allowances 11.1.1-11.1.5 list.
@ref akn:art_11__para_11-1/p3 akn:art_11__para_11-1__subpara_11-1-1 akn:art_11__para_11-1__subpara_11-1-2 akn:art_11__para_11-1__subpara_11-1-3 akn:art_11__para_11-1__subpara_11-1-4 akn:art_11__para_11-1__subpara_11-1-5
GIVEN k IS A `kindergarten teacher`
GIVETH A BOOLEAN
DECIDE `is an eligible colleague kindergarten teacher` k IF
        `is a colleague kindergarten teacher` k
    AND NOT k's `receives kindergarten management (138(א))`
    AND NOT k's `receives kindergarten education (138(ב))`
    AND NOT k's `receives a trailing management or counseling allowance (50א, 140(ו))`
    AND NOT k's `receives cluster management (144ג(א))`
    AND NOT k's `receives any salary-preservation component (38ב, 38ג)`

-- 11.2: from 1.9.2023, 10% of her combined salary, pro-rated below a full
-- position and no more than a full position's above it.
@ref akn:art_11__para_11-2 akn:art_11__para_11-2/p2
GIVEN k IS A `kindergarten teacher`
      `combined salary of a full position` IS A NUMBER @desc her monthly combined salary for a full position
      m IS A NUMBER @desc the salary month (September 2022 = 1)
GIVETH A NUMBER
DECIDE `the colleague kindergarten teacher supplement` k `combined salary of a full position` m IS
    IF `is an eligible colleague kindergarten teacher` k AND m AT LEAST `1 September 2023`
    THEN 0.10 TIMES `combined salary of a full position` TIMES min (k's `kindergarten teacher's position fraction`) 1
    ELSE 0

-- 11.3: counted for the hourly value, severance, substitution hours and
-- school activities, the reduction for absence, 33(d)'s pay, the training
-- fund and (in an accumulating pension) pension contributions; NOT part of
-- the combined salary or the base of any other supplement.
@ref akn:art_11__para_11-3
GIVEN p IS A `purpose`
GIVETH A BOOLEAN
DECIDE `the colleague supplement counts for` p IF
    CONSIDER p
    WHEN `the hourly value` THEN TRUE
    WHEN `severance pay under the Severance Pay Law 1963` THEN TRUE
    WHEN `pay for substitution hours or school activities` THEN TRUE
    WHEN `salary reduction for an hour of absence` THEN TRUE
    WHEN `the pay under section 33(d) of the Ofek Hadash agreement` THEN TRUE
    WHEN `training-fund contributions` THEN TRUE
    WHEN `pension-fund contributions` THEN TRUE
    OTHERWISE FALSE

§§ `12 פעילויות בית ספריות`

-- akn:art_12 The heading of section 12.

-- 12.1: section 30(ג) of the Ofek Hadash agreement: the maximum hours per
-- activity of 30(ג)(1)-(3) is deleted; 30(ג)(4) is added (a meeting of role
-- holders or with students shortly before the year opens, up to 3 hours);
-- 30(ג)א: the principal divides the hours among the activities by the
-- school's needs. 12.2: section 6(ד) of the 17.9.2013 agreement gains
-- 6(ד)(4), a meeting with students shortly before the year opens (up to 3 hours).
@ref akn:art_12__para_12-1 akn:art_12__para_12-1__subpara_12-1-1 akn:art_12__para_12-1__subpara_12-1-1/p2 akn:art_12__para_12-1__subpara_12-1-2 akn:art_12__para_12-1__subpara_12-1-3 akn:art_12__para_12-2 akn:art_12__para_12-2/p2
`the hours of the pre-opening meeting, at most` MEANS 3
`a per-activity maximum applies to 30(ג)(1)-(3)` MEANS FALSE

-- 12.3: from 1.9.2023 the maximum school-activity hours rise from 18 in
-- each half of the year to 40 for the whole year; the division by halves
-- is cancelled.
@ref akn:art_12__para_12-3
GIVEN m IS A NUMBER @desc the salary month (September 2022 = 1)
GIVETH A NUMBER
DECIDE `the maximum school-activity hours a year in` m IS
    IF m AT LEAST `1 September 2023` THEN 40 ELSE 18 TIMES 2

GIVEN m IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the hours are capped per half-year in` m IF
    m LESS THAN `1 September 2023`

-- akn:art_12__para_12-4 The proviso that no other rule of school-activity hours changes; no rule of its own.

§§ `14 ביגוד`

-- akn:art_14 The heading of section 14.

-- 14: "פיזיותרפיסט" — a health-professions teaching employee (section 20
-- of the Ofek Hadash agreement) with a physiotherapy certificate who treats
-- by physiotherapy in the role.
@ref akn:art_14/p1
GIVEN `health-professions employee` IS A BOOLEAN, `physiotherapy certificate` IS A BOOLEAN, `treats by physiotherapy` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `is a physiotherapist` `health-professions employee` `physiotherapy certificate` `treats by physiotherapy` IF
    `health-professions employee` AND `physiotherapy certificate` AND `treats by physiotherapy`

-- 14.1: from 1.9.2023 a full-position physiotherapist gets, once a year
-- with July's salary, ₪800, besides the clothing allowance. 14.2: the
-- rules of the PE teachers' clothing allowance (17.11.2011) apply.
@ref akn:art_14__para_14-1 akn:art_14__para_14-2
GIVEN `a full-position physiotherapist` IS A BOOLEAN
      `year starts` IS A NUMBER @desc the salary month the school year starts (September 2023 = 13); July is ten months on
GIVETH A DEONTIC Party `circular 4 action`
DECIDE `the physiotherapists' clothing supplement with July's salary` `a full-position physiotherapist` `year starts` IS
    IF `a full-position physiotherapist` AND `year starts` AT LEAST `1 September 2023`
    THEN PARTY `the employer`
         MUST  `pay the physiotherapists' clothing supplement` `paid`
               PROVIDED `paid` EQUALS `the physiotherapists' clothing supplement`
         WITHIN `year starts` PLUS 10
         LEST BREACH BY `the employer` BECAUSE "circular תשפ\"ג/4 14.1: ₪800 with July's salary"
    ELSE FULFILLED

`the physiotherapists' clothing supplement` MEANS 800

§§ `15 מורים המשובצים להעסקה באופן חריג טרם היותם אקדמאים`

-- akn:art_15 The heading of section 15.

DECLARE `salary table kind` IS ONE OF
    `senior (בכיר)`
    `qualified (מוסמך)`
    `unqualified (בלתי מוסמך)`

DECLARE `placement` HAS
    `placed grade`     IS A NUMBER
    `placed seniority` IS A NUMBER
    `placed table`     IS A `salary table kind`

-- 15.1 (new section 36(ז) of the Ofek Hadash agreement, from 1.9.2023):
-- where the Ministry approves, exceptionally and for a set time, a new
-- non-academic teacher not entitled to intern pay (145-148), the teacher
-- is placed at grade 1, seniority 1 — or the recognized seniority from
-- army or national service in teaching — in the table his education sets.
@ref akn:art_15__para_15-1
GIVEN `recognized seniority from service in teaching` IS A NUMBER @desc years recognized from army or national service in teaching (0 if none)
      `table by education` IS A `salary table kind`
GIVETH A `placement`
DECIDE `the placement of a non-academic new teacher` `recognized seniority from service in teaching` `table by education` IS
    `placement` WITH
        `placed grade`     IS 1
        `placed seniority` IS max 1 `recognized seniority from service in teaching`
        `placed table`     IS `table by education`

-- 15.2: from 1.9.2023 sections 51, 59, 60 and 61 of the Ofek Hadash
-- agreement are cancelled, except for employees who signed, before
-- 30.6.2023, an undertaking to complete an academic education within four years.
@ref akn:art_15__para_15-2
GIVEN m IS A NUMBER, `signed the undertaking before 30.6.2023` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `sections 51, 59, 60 and 61 still apply` m `signed the undertaking before 30.6.2023` IF
    m LESS THAN `1 September 2023` OR `signed the undertaking before 30.6.2023`

§§ `16 גמול תפקיד בית ספרי`

-- akn:art_16 The heading of section 16.

@desc A teacher filling a school role, as far as section 16 asks.
DECLARE `school-role holder` HAS
    `role year starts` IS A NUMBER  @desc the salary month the school year of the role begins (September 2025 = 37)
    `role units`       IS A NUMBER  @desc the allowance units the principal set for the role
    `role holder's position fraction` IS A NUMBER
    `is the principal` IS A BOOLEAN
    `the role carries an Ofek Hadash allowance` IS A BOOLEAN @desc the role is one for which the Ofek Hadash agreement sets an allowance
    `fills the role this month` IS A BOOLEAN

-- 16.1, 16.5: from the school year 2025-26 (1.9.2025), each year, the
-- principal of a primary, junior high, special-education school, gifted
-- centre, agricultural farm or marine centre MAY set school roles, at the
-- beginning of the year, by the school's needs and the Ministry's guidance.
@ref akn:art_16__para_16-1 akn:art_16__para_16-5 akn:art_16__para_16-5/p2
GIVEN `year starts` IS A NUMBER
GIVETH A DEONTIC Party `circular 4 action`
DECIDE `the principal may set school roles` `year starts` IS
    IF `year starts` AT LEAST `1 September 2025`
    THEN PARTY `the school principal`
         MAY   `set the school roles and their units`
         WITHIN 1
    ELSE FULFILLED

-- 16.2: 2 to 5 units, whole units, within the quota the Ministry allots
-- (16.2 ¶2); 16.3: not a role the Ofek Hadash agreement already pays.
@ref akn:art_16__para_16-2 akn:art_16__para_16-2/p2 akn:art_16__para_16-3
GIVEN r IS A `school-role holder`, `units left in the quota` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the role is validly set` r `units left in the quota` IF
        r's `role year starts` AT LEAST `1 September 2025`
    AND r's `role units` AT LEAST 2
    AND r's `role units` AT MOST 5
    AND TRUNC (r's `role units`) 0 EQUALS r's `role units`
    AND r's `role units` AT MOST `units left in the quota`
    AND NOT r's `the role carries an Ofek Hadash allowance`

-- 16.4: ₪200 a unit a month. 16.6, 16.9, 16.10: a teacher at a third of a
-- position or more, while filling the role, gets the full shekel value
-- (above a full position, a full position's). 16.8: never a principal.
@ref akn:art_16__para_16-4 akn:art_16__para_16-6 akn:art_16__para_16-8 akn:art_16__para_16-9 akn:art_16__para_16-10
GIVEN r IS A `school-role holder`, `units left in the quota` IS A NUMBER
GIVETH A NUMBER
DECIDE `the school-role allowance` r `units left in the quota` IS
    IF  `the role is validly set` r `units left in the quota`
        AND r's `fills the role this month`
        AND r's `role holder's position fraction` AT LEAST (1 DIVIDED BY 3)
        AND NOT r's `is the principal`
    THEN r's `role units` TIMES `the value of an allowance unit a month`
    ELSE 0

`the value of an allowance unit a month` MEANS 200

-- 16.6 ¶2, 16.7: the role and its allowance are set anew each year; the
-- appointment is, as a rule, for a full year; no right to continue.
@ref akn:art_16__para_16-7
`an appointment to a school role is, as a rule, for a full school year` MEANS TRUE
`a teacher who held a school role has a right to continue in it next year` MEANS FALSE

-- 16.11-16.12: counted for the hourly value (substitution hours, school
-- activities), the reduction for absence, 33(d)'s pay, severance and
-- pension contributions; not part of the combined salary nor a base of
-- other supplements; no training-fund contributions.
@ref akn:art_16__para_16-11 akn:art_16__para_16-12
GIVEN p IS A `purpose`
GIVETH A BOOLEAN
DECIDE `the school-role allowance counts for` p IF
    CONSIDER p
    WHEN `the hourly value` THEN TRUE
    WHEN `pay for substitution hours or school activities` THEN TRUE
    WHEN `salary reduction for an hour of absence` THEN TRUE
    WHEN `the pay under section 33(d) of the Ofek Hadash agreement` THEN TRUE
    WHEN `severance pay under the Severance Pay Law 1963` THEN TRUE
    WHEN `pension-fund contributions` THEN TRUE
    OTHERWISE FALSE

-- 16.13: section 39(ב)'s limit applies; but a third role-allowance where
-- one of the three is a school role needs no district manager's approval.
@ref akn:art_16__para_16-13
GIVEN `role allowances` IS A NUMBER, `one of them is a school role` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the district manager's approval is needed for three` `role allowances` `one of them is a school role` IF
    `role allowances` EQUALS 3 AND NOT `one of them is a school role`

-- 16.14: the Ministry sets each school's allocation key every school
-- year. The text sets no deadline.
@ref akn:art_16__para_16-14
GIVEN `year starts` IS A NUMBER
GIVETH A DEONTIC Party `circular 4 action`
DECIDE `the Ministry sets the allocation key` `year starts` IS
    IF `year starts` AT LEAST `1 September 2025`
    THEN PARTY `the Ministry of Education`
         MUST  `set the allocation key of allowance units`
    ELSE FULFILLED

§§ `17 מורה במשרה חלקית`

-- akn:art_17 The heading of section 17.

-- 17.1: section 27(ג) of the Ofek Hadash agreement reads "a position
-- fraction below 70%" for "below 50%" from 1.9.2023, and "below 80%" from
-- 1.9.2024. What 27(ג) provides is not in this circular.
@ref akn:art_17__para_17-1 akn:art_17__para_17-1/p2 akn:art_17__para_17-1/p3
GIVEN m IS A NUMBER @desc the salary month (September 2022 = 1)
GIVETH A NUMBER
DECIDE `the part-time threshold of section 27(ג) in` m IS
    IF m AT LEAST `1 September 2024` THEN 0.8
    ELSE IF m AT LEAST `1 September 2023` THEN 0.7
         ELSE 0.5

-- akn:art_17__para_17-2 The proviso that no other rule of part-time teachers changes; no rule of its own.

§ `פרק שני — תנאי העסקה טרום רפורמה`

-- akn:chp_2 The heading of chapter 2; its scope is the rule at the top.
-- akn:art_18 The heading of section 18.

`the 2022 shekel supplement for a full position` MEANS 500

-- 18.1: from 1.9.2022, ₪500 for a full position, "תוספת שקלית 2022",
-- paid from January 2023's salary retroactively; 18.2: pro-rated.
@ref akn:art_18__para_18-1 akn:art_18__para_18-2
GIVEN e IS A `circular 4 employee`, m IS A NUMBER @desc the salary month (September 2022 = 1)
GIVETH A NUMBER
DECIDE `the 2022 shekel supplement` e m IS
    IF `chapter` `chapter 2` `applies to` e AND m AT LEAST `1 September 2022`
    THEN `the 2022 shekel supplement for a full position` TIMES e's `position fraction`
    ELSE 0

-- 18.3: salary for every purpose, except in supplements 2001, 2008 and
-- 2011; 18.4: not in the completion to the minimum wage.
@ref akn:art_18__para_18-3 akn:art_18__para_18-4
GIVEN p IS A `purpose`
GIVETH A BOOLEAN
DECIDE `the 2022 shekel supplement counts for` p IF
    CONSIDER p
    WHEN `supplement 2001` THEN FALSE
    WHEN `supplement 2008` THEN FALSE
    WHEN `supplement 2011` THEN FALSE
    WHEN `completion to the minimum wage under the Minimum Wage Law 1987` THEN FALSE
    OTHERWISE TRUE

§ `פרק שלישי — כלל עובדי ההוראה`

-- akn:chp_3 The heading of chapter 3, which applies to all.
-- akn:art_19 The heading of section 19.

-- 19: the salary of principals and first deputy principals is a global
-- salary for all the work of the managerial role, whenever done.
@ref akn:art_19/p1
GIVEN `is a principal or first deputy` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `no separate pay for managerial work out of hours` `is a principal or first deputy` IF
    `is a principal or first deputy`

-- akn:art_20 The heading of section 20.

-- 20.1: advances on account of salary, (א) "מקדמה א'" with November 2022's
-- salary and at the latest December's, (ב) "מקדמה ב'" with December 2022's
-- and at the latest January 2023's: ₪1,000 each for a full position in
-- Ofek Hadash, ₪500 in pre-reform terms; (ג) pro-rated by position.
@ref akn:art_20__para_20-1 akn:art_20__para_20-1__subpara_a/p2 akn:art_20__para_20-1__subpara_a/p3 akn:art_20__para_20-1__subpara_a/p4 akn:art_20__para_20-1__subpara_b/p2 akn:art_20__para_20-1__subpara_b/p3 akn:art_20__para_20-1__subpara_b/p4 akn:art_20__para_20-1__subpara_c
GIVEN e IS A `circular 4 employee`
GIVETH A NUMBER
DECIDE `the advance` e IS
    IF `chapter` `chapter 3` `applies to` e
    THEN (CONSIDER e's `terms`
          WHEN `Ofek Hadash terms` THEN 1000
          WHEN `pre-reform terms`  THEN 500)
         TIMES e's `position fraction`
    ELSE 0

-- 20.2: advance A is deducted with the salary carrying the first payment
-- under the collective agreement, or December 2022's, whichever is
-- earlier. 20.3: advance B with the salary AFTER that, or January 2023's.
@ref akn:art_20__para_20-2
GIVEN `first agreement payment` IS A NUMBER @desc the salary month carrying the first payment under the agreement
GIVETH A NUMBER
DECIDE `advance A is deducted in` `first agreement payment` IS
    min `first agreement payment` `December 2022`

@ref akn:art_20__para_20-3
GIVEN `first agreement payment` IS A NUMBER
GIVETH A NUMBER
DECIDE `advance B is deducted in` `first agreement payment` IS
    min (`first agreement payment` PLUS 1) `January 2023`

-- 20.2-20.3: the advance is deducted from salary in its deduction month.
-- 20.4 (and annex A ¶5): leaving before the deduction month, the advance
-- is deducted in the final settlement.
@ref akn:art_20__para_20-4 akn:att_1__hc_1__para_5 akn:art_20__para_20-2 akn:art_20__para_20-3
GIVEN e IS A `circular 4 employee`
      `deduction month` IS A NUMBER @desc the month the advance is due to be deducted (20.2 or 20.3)
      `leaves in` IS A NUMBER @desc the salary month the employment ends
GIVETH A DEONTIC Party `circular 4 action`
DECIDE `the advance is recovered` e `deduction month` `leaves in` IS
    IF `leaves in` LESS THAN `deduction month`
    THEN PARTY `the employer`
         MUST  `deduct the advance in the final settlement` `settled`
               PROVIDED `settled` EQUALS `the advance` e
         WITHIN `leaves in`
    ELSE PARTY `the employer`
         MUST  `deduct the advance from salary` `deducted`
               PROVIDED `deducted` EQUALS `the advance` e
         WITHIN `deduction month`

-- 20.1א with 20.5: advance A, by December 2022's salary, only to an
-- employee who signed annex A's notice first. (WITHIN counts from the
-- trace's start, so payment and deduction are two rules on one timeline.)
@ref akn:art_20__para_20-1__subpara_a/p1 akn:art_20__para_20-5
GIVEN e IS A `circular 4 employee`
GIVETH A DEONTIC Party `circular 4 action`
DECIDE `advance A` e IS
    IF `the advance` e GREATER THAN 0 AND e's `signed the advance notice`
    THEN PARTY `the employer`
         MUST  `pay advance A` `paid`
               PROVIDED `paid` EQUALS `the advance` e
         WITHIN `December 2022`
         LEST BREACH BY `the employer` BECAUSE "circular תשפ\"ג/4 20.1א: advance A is paid at the latest with December 2022's salary"
    ELSE PARTY `the employer`
         SHANT `pay an advance to an employee who has not signed the notice`
         LEST BREACH BY `the employer` BECAUSE "circular תשפ\"ג/4 20.5: the advance is paid only to an employee who signed the notice first"

@ref akn:art_20__para_20-1__subpara_b/p1
GIVEN e IS A `circular 4 employee`
GIVETH A DEONTIC Party `circular 4 action`
DECIDE `advance B` e IS
    IF `the advance` e GREATER THAN 0 AND e's `signed the advance notice`
    THEN PARTY `the employer`
         MUST  `pay advance B` `paid`
               PROVIDED `paid` EQUALS `the advance` e
         WITHIN `January 2023`
         LEST BREACH BY `the employer` BECAUSE "circular תשפ\"ג/4 20.1ב: advance B is paid at the latest with January 2023's salary"
    ELSE FULFILLED

-- 20.6: the notice attached to every payslip carrying an advance, and
-- annex A's form: the years their blanks print, as data.
@ref akn:art_20__para_20-6 akn:art_20__para_20-6/p2
`the payslip notice's blanks` MEANS
    LIST `printed blank` "the month the advance was paid" 2022,
         `printed blank` "advance A's latest deduction month" 2022,
         `printed blank` "advance B's latest deduction month" 2023

DECLARE `printed blank` HAS
    `what the blank is for` IS A STRING
    `year printed`          IS A NUMBER

@ref akn:att_1__hc_1__para_1 akn:att_1__hc_1__para_2 akn:att_1__hc_1__para_3 akn:att_1__hc_1__para_4
`annex A's blanks` MEANS
    LIST `printed blank` "the month advance A is paid" 2022,
         `printed blank` "advance A's latest deduction month" 2023,
         `printed blank` "the month advance B is paid" 2022,
         `printed blank` "advance B's latest deduction month" 2023

-- akn:att_1__hc_1 The employee's acknowledgement and the lines for name, identity number, date and signature on annex A's form; the duty to have it signed is 20.5.
-- akn:att_1__hc_1/p2 akn:att_1__hc_1/p3 akn:att_1__hc_1/p4 akn:att_1__hc_1/p5 Blank lines of annex A's form; no rule.

GIVEN what IS A STRING
      blanks IS A LIST OF `printed blank`
GIVETH A LIST OF NUMBER
DECIDE `the year printed for` what `in` blanks IS
    map (GIVEN b YIELD b's `year printed`) (filter (GIVEN b YIELD b's `what the blank is for` EQUALS what) blanks)

-- F-2022-23_tashpag_04-d: 20.2 deducts advance A by December 2022 at the
-- latest; annex A's form prints its deduction month in 2023.
`annex A dates advance A's deduction in a year 20.2 excludes` MEANS
    NOT (`the year printed for` "advance A's latest deduction month" `in` `annex A's blanks`
         EQUALS LIST (`the calendar year of` (`advance A is deducted in` `January 2023`)))
#ASSERT `annex A dates advance A's deduction in a year 20.2 excludes`

-- F-2022-23_tashpag_04-e: 20.1ב lets advance B be paid with January
-- 2023's salary; the notice and the form print its payment month in 2022.
`the notices cannot state advance B paid in January 2023` MEANS
        NOT elem (`the calendar year of` `January 2023`) (`the year printed for` "the month the advance was paid" `in` `the payslip notice's blanks`)
    AND NOT elem (`the calendar year of` `January 2023`) (`the year printed for` "the month advance B is paid" `in` `annex A's blanks`)
#ASSERT `the notices cannot state advance B paid in January 2023`

-- akn:art_21 A link to the salary-table annexes (A1-A9, B1-B7, C1-C7); the annexes are not in the corpus's text of this circular, so the amounts they carry are inputs above.

DECLARE `instrument` IS ONE OF
    `this circular`
    `the collective agreement of 19.10.2022`

-- 22: the circular collects the agreement's rules; where they conflict,
-- the agreement governs.
@ref akn:art_22
GIVEN `the circular and the agreement conflict` IS A BOOLEAN
GIVETH AN `instrument`
DECIDE `which governs` `the circular and the agreement conflict` IS
    IF `the circular and the agreement conflict`
    THEN `the collective agreement of 19.10.2022`
    ELSE `this circular`

-- akn:conclusions The sign-off, signatories and list of copies; no rule.

§§ `Worked examples`

-- The employees and salaries are made up; rates and amounts are the circular's.
`an Ofek Hadash teacher at 75%` MEANS
    `circular 4 employee` WITH
        `graded in the teaching employees' grading`        IS TRUE
        `employed by an owner of a supervised institution` IS TRUE
        `stage employed in`                                IS `recognized-unofficial special-education schools`
        `terms`                                            IS `Ofek Hadash terms`
        `position fraction`                                IS 0.75
        `signed the advance notice`                        IS TRUE

`a pre-reform teacher at full position` MEANS
    `circular 4 employee` WITH
        `graded in the teaching employees' grading`        IS TRUE
        `employed by an owner of a supervised institution` IS TRUE
        `stage employed in`                                IS `official junior highs of six-year schools`
        `terms`                                            IS `pre-reform terms`
        `position fraction`                                IS 1
        `signed the advance notice`                        IS TRUE

#ASSERT `the combined-salary tables in force in` `January 2023` EQUALS `annex tables A1 to A8`
#ASSERT `the combined-salary tables in force in` `1 September 2023` EQUALS `annex table A9 in place of A8`
#ASSERT `the Ofek 2022 supplement` `an Ofek Hadash teacher at 75%` `January 2023` 400 EQUALS 300
#ASSERT `the Ofek 2022 supplement` `a pre-reform teacher at full position` `January 2023` 400 EQUALS 0
#ASSERT `the 2022 shekel supplement` `a pre-reform teacher at full position` `January 2023` EQUALS 500
#ASSERT `the 2022 shekel supplement` `an Ofek Hadash teacher at 75%` `January 2023` EQUALS 0
#ASSERT `the advance` `an Ofek Hadash teacher at 75%` EQUALS 750
#ASSERT `the advance` `a pre-reform teacher at full position` EQUALS 500
#ASSERT `the rate of` "deputy" `in` `1 September 2023` EQUALS LIST 0.20
#ASSERT `the rate of` "social-education coordinator, junior high" `in` `1 September 2023` EQUALS LIST 0.10
-- 6.1.1: on ₪8,000 the 10% is ₪800, so the ₪1,000 minimum governs; on ₪12,000 the 10% does.
#ASSERT `the role allowance with its minimum` `class education, not first grade` 8000 0 1 EQUALS 1000
#ASSERT `the role allowance with its minimum` `class education, not first grade` 12000 0 1 EQUALS 1200
#ASSERT `the role allowance with its minimum` `grade coordinator, up to four classes` 10000 0 1 EQUALS 1100
#ASSERT `the value of an activity unit` 15000 `1 September 2023` EQUALS 105
#ASSERT `a short day for trip escort pay` 5 `1 September 2023`
#ASSERT NOT `a short day for trip escort pay` 5 `January 2023`
#ASSERT `the teacher may leave unperformed` 6 2 4
#ASSERT NOT `the teacher may leave unperformed` 5 2 4
#ASSERT `the maximum school-activity hours a year in` `1 September 2023` EQUALS 40
#ASSERT `the part-time threshold of section 27(ג) in` `1 September 2024` EQUALS 0.8
#ASSERT `the placement of a non-academic new teacher` 0 `unqualified (בלתי מוסמך)` EQUALS (`placement` 1 1 `unqualified (בלתי מוסמך)`)

`a colleague kindergarten teacher at 60%` MEANS
    `kindergarten teacher` WITH
        `placed on a fixed day the head of the kindergarten does not work` IS TRUE
        `in charge of the kindergarten that day, with all its duties`      IS TRUE
        `receives kindergarten management (138(א))`                        IS FALSE
        `receives kindergarten education (138(ב))`                         IS FALSE
        `receives a trailing management or counseling allowance (50א, 140(ו))` IS FALSE
        `receives cluster management (144ג(א))`                            IS FALSE
        `receives any salary-preservation component (38ב, 38ג)`            IS FALSE
        `kindergarten teacher's position fraction`                         IS 0.6
#ASSERT `the colleague kindergarten teacher supplement` `a colleague kindergarten teacher at 60%` 10000 `1 September 2023` EQUALS 600

-- 16.4's own example: four units are ₪800 a month.
`a four-unit school role at a third of a position` MEANS
    `school-role holder` WITH
        `role year starts` IS `1 September 2025`
        `role units`       IS 4
        `role holder's position fraction` IS 1 DIVIDED BY 3
        `is the principal` IS FALSE
        `the role carries an Ofek Hadash allowance` IS FALSE
        `fills the role this month` IS TRUE
#ASSERT `the school-role allowance` `a four-unit school role at a third of a position` 10 EQUALS 800

-- The advances on a timeline of salary months.
#TRACE `advance A` `an Ofek Hadash teacher at 75%` AT 0 WITH
    PARTY `the employer` DOES `pay advance A` 750 AT 3
#TRACE `the advance is recovered` `an Ofek Hadash teacher at 75%` (`advance A is deducted in` `January 2023`) 99 AT 0 WITH
    PARTY `the employer` DOES `deduct the advance from salary` 750 AT 4
#TRACE `advance B` `a pre-reform teacher at full position` AT 0 WITH
    PARTY `the employer` DOES `pay advance B` 500 AT 6
#TRACE `paid with January 2023's salary, retroactive to 1.9.2022` "the Ofek 2022 supplement" AT 0 WITH
    PARTY `the employer` DOES `pay the retroactive differences from September 2022` "the Ofek 2022 supplement" AT 5
#TRACE `the physiotherapists' clothing supplement with July's salary` TRUE `1 September 2023` AT 0 WITH
    PARTY `the employer` DOES `pay the physiotherapists' clothing supplement` 800 AT 23
