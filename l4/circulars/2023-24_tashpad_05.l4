-- חוזר לבעלויות תשפ"ד/5 (14.2.2024), עדכון תוספת שקלית 2016 לעובדי הוראה
-- בחטיבה העליונה ובכיתות יג'-יד' ועדכון תוספת 87' מעבר לרפורמה למנהלים
-- The 2016 shekel supplement of upper-secondary (and 13th–14th grade)
-- teaching employees, re-indexed from 1.1.2024, and the '87 reform
-- transition supplement of principals under Oz LaTmura, likewise.

IMPORT prelude
IMPORT daydate
IMPORT common

-- Time for the payment duty is counted in calendar MONTHS from December
-- 2023 (0): January 2024's salary is 1, February 2024's is 2.
`January 2024`  MEANS 1
`February 2024` MEANS 2

§ `חוזר לבעלויות תשפ"ד/5 — עדכון תוספת שקלית 2016 ותוספת 87' מעבר לרפורמה למנהלים`

-- akn:preamble/p1 akn:preamble/p2 akn:preamble/p3 akn:preamble/p4 akn:preamble/p5 akn:preamble/p6 akn:preamble/p7 akn:preamble/p8 akn:preamble/p9 akn:preamble/p10 akn:preamble/p11 akn:preamble/p12 The letterhead, date, reference number, addressees (the owners of educational institutions), greeting and subject line; no rule.

-- The preamble's own rule: the 2016 shekel supplement is linked to the
-- consumer price index (agreements of 14.3.2018 §§5א(ב), 5ב(ב) and of
-- 23.3.2017 §4ד; circular תשפ"ב/4), and this circular re-indexes it from
-- 1.1.2024 to the index of December 2023 (published January 2024) against
-- that of December 2022 (published January 2023).
DECLARE `consumer price index` HAS
    `index month` IS A STRING
    `published in` IS A STRING

@desc A teaching employee, as far as this circular asks.
DECLARE `employee under circular 5` HAS
    `graded on the teaching employees' scale`    IS A BOOLEAN @desc graded on the teaching employees' grading (דירוג עובדי הוראה)
    `employed by an owner under Ministry supervision` IS A BOOLEAN @desc employed by an owner of an educational institution the Ministry of Education supervises
    `employed in upper-secondary or 13th–14th grades` IS A BOOLEAN @desc employed in the upper-secondary divisions (חטיבות עליונות) or in grades 13–14
    `in the Oz LaTmura reform`                  IS A BOOLEAN @desc employed under the terms of the Oz LaTmura reform
    `is a principal`                            IS A BOOLEAN

@ref akn:preamble/p13 akn:preamble/p14 akn:preamble/p15
`the index this circular links to` MEANS
    `consumer price index` WITH `index month` IS "December 2023", `published in` IS "January 2024"

@ref akn:preamble/p15
`the index it replaces` MEANS
    `consumer price index` WITH `index month` IS "December 2022", `published in` IS "January 2023"

@ref akn:preamble/p14
GIVEN `the day` IS A DATE
GIVETH A BOOLEAN
DECIDE `the re-indexed amounts apply on` `the day` IF
    `the day` AT LEAST Date 1 1 2024

-- Applicability: every employee graded as a teaching employee, employed by
-- an owner of a Ministry-supervised institution, in upper-secondary or
-- grades 13–14 — in the reform or not (the last paragraph, "למען הסר ספק").
@ref akn:preamble/p16 akn:preamble/p17 akn:preamble/p18
GIVEN e IS AN `employee under circular 5`
GIVETH A BOOLEAN
DECIDE `the circular applies to` e IF
        e's `graded on the teaching employees' scale`
    AND e's `employed by an owner under Ministry supervision`
    AND e's `employed in upper-secondary or 13th–14th grades`

§§ `א עדכון תוספת שקלית 2016`

DECLARE `amount change` HAS
    `new monthly amount`      IS A NUMBER
    `previous monthly amount` IS A NUMBER

@ref akn:art_a/p2
`the shekel supplement for teachers in the reform` MEANS
    `amount change` WITH `new monthly amount` IS 1554.68, `previous monthly amount` IS 1509.98

@ref akn:art_a/p3
`the shekel supplement for teachers not in the reform and principals` MEANS
    `amount change` WITH `new monthly amount` IS 1314.65, `previous monthly amount` IS 1276.85

-- F-2023-24_tashpad_05-a: the second row reads "מורים שאינם ברפורמת עוז
-- לתמורה ומנהלים". Read as "(teachers not in the reform) and principals",
-- every principal takes it; read as "teachers and principals not in the
-- reform", a principal IN the reform is in neither row and has no amount,
-- though the circular applies to him. The reading adopted: "ומנהלים"
-- stands alone, so every principal takes the second row.
-- "מורים" in the rows is read as every teaching employee who is not a
-- principal, the population of the circular's applicability.
@ref akn:art_a/p2 akn:art_a/p3
GIVEN e IS AN `employee under circular 5`
GIVETH A `supplement row`
DECIDE `the row of` e IS
    IF NOT `the circular applies to` e
    THEN `no row`
    ELSE IF e's `is a principal`
         THEN `the row for teachers not in the reform and principals`
         ELSE IF e's `in the Oz LaTmura reform`
              THEN `the row for teachers in the reform`
              ELSE `the row for teachers not in the reform and principals`

-- The other reading of the row: "teachers and principals not in the reform".
GIVEN e IS AN `employee under circular 5`
GIVETH A `supplement row`
DECIDE `the row if "not in the reform" governs both` e IS
    IF NOT `the circular applies to` e
    THEN `no row`
    ELSE IF e's `in the Oz LaTmura reform`
         THEN IF e's `is a principal`
              THEN `no row`
              ELSE `the row for teachers in the reform`
         ELSE `the row for teachers not in the reform and principals`

DECLARE `supplement row` IS ONE OF
    `the row for teachers in the reform`
    `the row for teachers not in the reform and principals`
    `no row`

@ref akn:art_a/p1
GIVEN e IS AN `employee under circular 5`, `the day` IS A DATE
GIVETH A NUMBER
DECIDE `the monthly 2016 shekel supplement` e `the day` IS
    CONSIDER `the row of` e
    WHEN `the row for teachers in the reform` THEN
        IF `the re-indexed amounts apply on` `the day`
        THEN `the shekel supplement for teachers in the reform`'s `new monthly amount`
        ELSE `the shekel supplement for teachers in the reform`'s `previous monthly amount`
    WHEN `the row for teachers not in the reform and principals` THEN
        IF `the re-indexed amounts apply on` `the day`
        THEN `the shekel supplement for teachers not in the reform and principals`'s `new monthly amount`
        ELSE `the shekel supplement for teachers not in the reform and principals`'s `previous monthly amount`
    OTHERWISE 0

`a principal in the reform` MEANS
    `employee under circular 5` WITH
        `graded on the teaching employees' scale`         IS TRUE
        `employed by an owner under Ministry supervision` IS TRUE
        `employed in upper-secondary or 13th–14th grades` IS TRUE
        `in the Oz LaTmura reform`                        IS TRUE
        `is a principal`                                  IS TRUE

`the two readings of the second row differ for a principal in the reform` MEANS
        `the circular applies to` `a principal in the reform`
    AND `the row if "not in the reform" governs both` `a principal in the reform` EQUALS `no row`
    AND NOT (`the row of` `a principal in the reform` EQUALS `no row`)
#ASSERT `the two readings of the second row differ for a principal in the reform`

-- The owners are reimbursed in the relevant hour costs in the payment system.
@ref akn:art_a/p4
`the reimbursement of the shekel supplement` MEANS
    `reimbursement` WITH
        `reimbursed to` IS `the local authority or owning body`
        `through`       IS "the relevant hour costs in the payment system"

DECLARE `reimbursement` HAS
    `reimbursed to` IS A Party
    `through`       IS A STRING

§§ `ב עדכון סכום תוספת 87' מעבר רפורמה למנהלים`

-- Section ב: under the agreement above and §18 of circular תשע"ח/9, the
-- '87 reform transition supplement of principals employed under the Oz
-- LaTmura terms is updated by the same index.
@ref akn:art_b/p1
GIVEN e IS AN `employee under circular 5`
GIVETH A BOOLEAN
DECIDE `entitled to the updated '87 transition supplement` e IF
        `the circular applies to` e
    AND e's `is a principal`
    AND e's `in the Oz LaTmura reform`

@ref akn:art_b/p2
`the '87 reform transition supplement for principals` MEANS
    `amount change` WITH `new monthly amount` IS 1134.20, `previous monthly amount` IS 1101.60

@ref akn:art_b/p2
GIVEN e IS AN `employee under circular 5`, `the day` IS A DATE
GIVETH A NUMBER
DECIDE `the monthly '87 transition supplement` e `the day` IS
    IF NOT `entitled to the updated '87 transition supplement` e
    THEN 0
    ELSE IF `the re-indexed amounts apply on` `the day`
         THEN `the '87 reform transition supplement for principals`'s `new monthly amount`
         ELSE `the '87 reform transition supplement for principals`'s `previous monthly amount`

-- Payable from January 2024's salary and no later than February 2024's,
-- with the retroactive difference for January 2024.
@ref akn:art_b/p3
GIVETH A DEONTIC Party `supplement action`
DECIDE `the updated '87 supplement is paid by February 2024` IS
    PARTY `the employer`
    MUST  `pay the updated '87 supplement, January 2024 included`
    WITHIN `February 2024`
    LEST BREACH BY `the employer` BECAUSE "section ב: pay from January 2024's salary and no later than February 2024's, with January's arrears"

DECLARE `supplement action` IS ONE OF
    `pay the updated '87 supplement, January 2024 included`

@ref akn:art_b/p3
GIVEN `paid from month` IS A NUMBER @desc the month (from December 2023 = 0) whose salary first carries the updated amount
GIVETH A NUMBER
DECIDE `the months of retroactive difference owed` `paid from month` IS
    max 0 (`paid from month` MINUS `January 2024`)

@ref akn:art_b/p4
`the reimbursement of the '87 supplement` MEANS
    `reimbursement` WITH
        `reimbursed to` IS `the local authority or owning body`
        `through`       IS "subject 558 of the payment system"

-- akn:conclusions The sign-off: the signatures and the copies list; no rule.

§§ `Worked examples`

-- Examples, on the circular's own amounts.
`a teacher in the reform` MEANS
    `employee under circular 5` WITH
        `graded on the teaching employees' scale`         IS TRUE
        `employed by an owner under Ministry supervision` IS TRUE
        `employed in upper-secondary or 13th–14th grades` IS TRUE
        `in the Oz LaTmura reform`                        IS TRUE
        `is a principal`                                  IS FALSE

`a teacher in a middle school` MEANS
    `employee under circular 5` WITH
        `graded on the teaching employees' scale`         IS TRUE
        `employed by an owner under Ministry supervision` IS TRUE
        `employed in upper-secondary or 13th–14th grades` IS FALSE
        `in the Oz LaTmura reform`                        IS TRUE
        `is a principal`                                  IS FALSE

#ASSERT `the monthly 2016 shekel supplement` `a teacher in the reform` (Date 1 1 2024) EQUALS 1554.68
#ASSERT `the monthly 2016 shekel supplement` `a teacher in the reform` (Date 31 12 2023) EQUALS 1509.98
#ASSERT `the monthly 2016 shekel supplement` `a principal in the reform` (Date 1 2 2024) EQUALS 1314.65
#ASSERT `the monthly 2016 shekel supplement` `a teacher in a middle school` (Date 1 2 2024) EQUALS 0
#ASSERT `the monthly '87 transition supplement` `a principal in the reform` (Date 1 1 2024) EQUALS 1134.20
#ASSERT `the monthly '87 transition supplement` `a teacher in the reform` (Date 1 1 2024) EQUALS 0
#ASSERT `the months of retroactive difference owed` `February 2024` EQUALS 1
#ASSERT `the months of retroactive difference owed` `January 2024` EQUALS 0

#TRACE `the updated '87 supplement is paid by February 2024` AT 0 WITH
    PARTY `the employer` DOES `pay the updated '87 supplement, January 2024 included` AT 2
