-- akn:att_2__hc_1 Annex ב': the employee's undertaking that the Ofek Hadash component is an advance to be deducted in full with the grade's pay, and that no claim will be raised — the content of item 3ג, encoded at `the owner's undertakings on the advance`.
-- akn:att_3__hc_1 Annex ג': the form for an academic without a teaching certificate to join by exception (last day 31.12.2023; no promotion until certified) — the content of 3.2.1 and 11.2.2, encoded there.
-- akn:att_4__hc_1 Annex ד': the form for a request to the exceptions committee not to join (last day 31.12.2023) — the content of 3.6, encoded there.
-- akn:att_6__hc_1 Annex ו': the addresses for inquiries (districts, portals, the service centre, the Ofek hotline, the Ministry mailboxes); no rule.

-- Annex ה': the work-week examples by position base. Each row: the base,
-- the scope printed, and the weekly hours actually worked; a day of
-- 7:55–14:00 (6.08 hours), five days a week (30.4 hours).
DECLARE `annex example` HAS
    `example number`       IS A NUMBER
    `example base`         IS A NUMBER
    `printed scope`        IS A NUMBER  @desc the scope of the position the annex prints, as a share (1 = 100%)
    `printed hours worked` IS A NUMBER

@ref akn:att_5__hc_1
`annex ה's examples` MEANS
    LIST `annex example` 1  30.4 1    30.4,
         `annex example` 4  33.8 0.9  30.8,
         `annex example` 7  28.4 1.07 30.4,
         `annex example` 8  26.4 1.0363 30.4,
         `annex example` 10 31.8 0.955 30.4,
         `annex example` 11 29.8 1.02 30.4,
         `annex example` 13 30.4 1    30.4,
         `annex example` 14 34   1    34

`five days of 6.08 hours` MEANS 5 TIMES `the working day ending at 14:00, in hours`

-- The annex's figures, where they follow from the 6.08-hour day: a manager
-- under 50 works the whole base; at 55, an existing manager's five days are
-- 115.15% of 26.4 and one day off a fortnight 103.63%.
#ASSERT `five days of 6.08 hours` EQUALS 30.4
#ASSERT TRUNC (`five days of 6.08 hours` DIVIDED BY 26.4 TIMES 100) 2 EQUALS 115.15
#ASSERT TRUNC ((`five days of 6.08 hours` MINUS 3.04) DIVIDED BY 26.4 TIMES 100) 2 EQUALS 103.63
#ASSERT TRUNC ((`five days of 6.08 hours` MINUS 6.08) DIVIDED BY 26.4 TIMES 100) 2 EQUALS 92.12

-- F-2023-24_tashpad_03-j: example 4 (a colleague teacher working five
-- days of 6.08 hours, "up to 90%") prints 30.8 hours worked, where five
-- days of 6.08 are 30.4 (and 30.4/33.8 is the 90%); examples 5 and 6 build
-- on the 30.8. Examples 10 and 12 print 86.2% for one day off a fortnight
-- on a base of 31.8, where the method of examples 7–9 and 11 (a day off a
-- fortnight is 3.04 hours a week) gives 86.0%.
`example 4's hours are not five days of 6.08` MEANS
    NOT (30.8 EQUALS `five days of 6.08 hours`)
`examples 10 and 12 do not follow the fortnight method` MEANS
    NOT (TRUNC ((`five days of 6.08 hours` MINUS 3.04) DIVIDED BY 31.8 TIMES 1000) 0 EQUALS 862)
`annex ה's examples do not all follow from the 6.08-hour day` MEANS
    `example 4's hours are not five days of 6.08` AND `examples 10 and 12 do not follow the fortnight method`
#ASSERT `annex ה's examples do not all follow from the 6.08-hour day`

-- Examples on the encoding.
`an existing manager aged 56 at a full position` MEANS
    `kindergarten employee` WITH
        `post`                                  IS `kindergarten manager teacher`
        `has recognised years of actual teaching` IS TRUE
        `is academic`                           IS TRUE
        `holds a teaching certification`        IS TRUE
        `seniority in teaching`                 IS 30
        `age on 31 December`                    IS 56
        `position fraction`                     IS 1
        `is an intern`                          IS FALSE
        `holds a special-education certification` IS TRUE
        `entitled to the nursing hour`          IS FALSE
        `mother of a child under 14`            IS FALSE

`an existing uncertified academic at a half position` MEANS
    `kindergarten employee` WITH
        `post`                                  IS `colleague kindergarten teacher`
        `has recognised years of actual teaching` IS TRUE
        `is academic`                           IS TRUE
        `holds a teaching certification`        IS FALSE
        `seniority in teaching`                 IS 10
        `age on 31 December`                    IS 40
        `position fraction`                     IS 0.5
        `is an intern`                          IS FALSE
        `holds a special-education certification` IS FALSE
        `entitled to the nursing hour`          IS FALSE
        `mother of a child under 14`            IS TRUE

#ASSERT `the position base of` `an existing manager aged 56 at a full position` EQUALS 26.4
#ASSERT `the age hours` `an existing manager aged 56 at a full position` EQUALS 4
#ASSERT `joins Ofek Hadash` `an existing manager aged 56 at a full position`
#ASSERT NOT `joins Ofek Hadash` `an existing uncertified academic at a half position`
#ASSERT `joins Ofek Hadash with` `an existing uncertified academic at a half position` TRUE
#ASSERT `cannot advance until certified` `an existing uncertified academic at a half position`
#ASSERT `the position base of` `a nursing kindergarten teacher` EQUALS 30.4
#ASSERT `the scope of employment` 30.4 33.8 LESS THAN 0.9 PLUS 0.001
#ASSERT `the end of the school day, Sunday to Thursday` `autism` EQUALS Time 16 0 0
#ASSERT `the end of the school day, Sunday to Thursday` `blind and visually impaired` EQUALS Time 15 10 0
#ASSERT `the cluster management rate` 6 EQUALS 0.25
#ASSERT `the cluster management rate` 7 EQUALS 0.28
#ASSERT `the mentor's rate` 5 EQUALS 0.072
#ASSERT `the special-education rate if certified` 0.14 `autism` EQUALS 0.17
#ASSERT `the special-education rate if certified` 0.09 `mild intellectual disability` EQUALS 0.10
#ASSERT `the management rate` TRUE 4 0 EQUALS 0.20
#ASSERT `the management rate` FALSE 0 12 EQUALS 0.21
#ASSERT `the management allowance` 12000 0.17 1 EQUALS 2040
#ASSERT `the management allowance` 8000 0.17 1 EQUALS 1500
#ASSERT `the advance rate` `academic kindergarten teacher` EQUALS JUST 0.16
#ASSERT `the internship year is recognised` 0.4 6
#ASSERT NOT `the internship year is recognised` 0.3 10
#ASSERT `the activity hours paid` 55 EQUALS 40
#ASSERT `within the weekly cap` 42 AND NOT `within the weekly cap` 42.5
#ASSERT `is a grade a conversion may give` 4.5 AND NOT `is a grade a conversion may give` 4.25
#ASSERT `the mother's position` `an existing uncertified academic at a half position` `not absent at all, by consent` EQUALS 0.5

#TRACE `the owner signs the undertaking by 31.8.2023` AT 0 WITH
    PARTY `the employer` DOES `sign and send the undertaking` AT 10
#TRACE `the owner signs the undertaking by 31.8.2023` AT 0 WITH
    PARTY `the employer` DOES `sign and send the undertaking` AT 20
#TRACE `stage ד: the owner reports every position` FALSE AT 0 WITH
    PARTY `the employer` DOES `report the positions` AT 30
#TRACE `the owner appoints one reporting officer` AT 0 WITH
    PARTY `the employer` DOES `appoint a reporting officer` TRUE 1 AT 5
#TRACE `a request not to join by 31.12.2023` AT 0 WITH
    PARTY `the teaching employee` DOES `submit an exceptions request` "not to join" AT 100
#TRACE `the owner pays by the grade and deducts the advances` 6 3000 AT 0 WITH
    PARTY `the employer` DOES `pay by the grade` 6 AT 1
    PARTY `the employer` DOES `deduct the advances` 3000 AT 2
