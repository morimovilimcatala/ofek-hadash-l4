§§ `Worked examples`

-- Examples (teachers, positions and salaries are placeholders).
`an existing certified academic at 40%` MEANS
    `kindergarten teacher` WITH
        `has prior recognised teaching seniority` IS TRUE
        `academic`                IS TRUE
        `certified to teach`      IS TRUE
        `seniority in years`      IS 8
        `position fraction`       IS 0.4
#ASSERT `joins Ofek Hadash` `an existing certified academic at 40%`

#ASSERT `the age status for the year` 55 TRUE EQUALS `55 and over, existing`
#ASSERT `the age status for the year` 54 TRUE EQUALS `50 to 55`
#ASSERT `age hours off a part-time base` `55 and over, existing` 0.5 EQUALS 2
#ASSERT `a mother's position` 1 TRUE EQUALS 1.1
#ASSERT `the management allowance rate` TRUE 4 7 EQUALS 0.2
#ASSERT `the kindergarten management allowance` 0.17 8000 0 EQUALS 1500
#ASSERT `the associate's supplement` TRUE 10000 0.5 EQUALS 500
#ASSERT `the cluster management rate` 7 EQUALS 0.28
#ASSERT `the Ofek Hadash advance` `academic kindergarten teacher` 10000 1 EQUALS 1600
#ASSERT `the code to report` TRUE "123" "999" EQUALS "999"
#ASSERT `the end of the school day, Sunday to Thursday` `autism` EQUALS 16.75

