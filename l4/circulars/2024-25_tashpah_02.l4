-- akn:att_4__hc_1/p2 akn:att_4__hc_1/p3 akn:att_4__hc_1/p4 akn:att_4__hc_1/p5 akn:att_4__hc_1/p6 akn:att_4__hc_1/p7 akn:att_4__hc_1/p8 akn:att_4__hc_1/p9 akn:att_4__hc_1/p10 akn:att_4__hc_1/p11 akn:att_4__hc_1/p12 akn:att_4__hc_1/p13 akn:att_4__hc_1/p14 akn:att_4__hc_1/p15 akn:att_4__hc_1/p16 akn:att_4__hc_1/p17 akn:att_4__hc_1/p18 akn:att_4__hc_1/p19 akn:att_4__hc_1/p20 akn:att_4__hc_1/p21 akn:att_4__hc_1/p22 The body of annex ד's form: details, the request, the owner's comment and where to send it.

-- Annex ה: the work week by post and base, with worked positions. Each row
-- as printed: base, the position column and the weekly hours worked.
@desc A row of annex ה: a post, its base, the position the annex states, and the hours it says she works.
DECLARE `annex row` HAS
    `annex serial`        IS A NUMBER
    `annex base`          IS A NUMBER
    `annex position`      IS A NUMBER  @desc percent, as printed
    `annex hours worked`  IS A NUMBER  @desc 0 where the row prints none

