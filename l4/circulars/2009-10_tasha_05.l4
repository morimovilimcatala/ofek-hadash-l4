-- חוזר לבעלויות תש"ע/5: קצובת ביגוד לשנת הלימודים תש"ע
-- The clothing allowance for school year 2009/10 (תש"ע): who is entitled,
-- the amount by teaching seniority, the extra allowance for physical-education
-- teachers and for technological-education staff, pro-rating by position, and
-- the month it is paid in.

IMPORT prelude
IMPORT common

§ `תש"ע/5 קצובת ביגוד לשנת הלימודים תש"ע`

-- akn:preamble The letterhead, the circular's title, date (25.7.2010), addressee, subject line and the opening words "according to the Treasury's instructions on the clothing allowance, act as follows"; the rules are sections א–ג.

@desc A teaching employee's school year 2009/10, as far as this circular asks about it.
DECLARE `clothing year` HAS
    `in the teaching-staff grade`        IS A BOOLEAN @desc the employee is graded in the teaching-staff grade (דירוג עובדי הוראה)
    `years of teaching seniority`        IS A NUMBER  @desc seniority in teaching (ותק בהוראה), in years
    `position fraction`                  IS A NUMBER  @desc the share of a full position held (1 = one full position)
    `teaches physical education`         IS A BOOLEAN
    `physical-education employment rate` IS A NUMBER  @desc the employment rate (שיעור העסקה) section ב's table is read by; see F-2009-10_tasha_05-c
    `in technological education`         IS A BOOLEAN @desc a teaching employee in technological education or a professional instructor (מדריך מקצועי)
    `technological professions taught`   IS A LIST OF STRING @desc the professions taught, as section ג's lists print them
    `value of two robes`                 IS A NUMBER  @desc the value of two robes, which section ג.1ב grants and this circular does not price (F-2009-10_tasha_05-d); set elsewhere

@desc The things section ג grants in kind.
DECLARE `clothing item` IS ONE OF
    `a pair of shoes`
    `a robe`

DECLARE `clothing action` IS ONE OF
    `pay the clothing allowance` HAS `amount of clothing allowance paid` IS A NUMBER

§§ `א קצובת ביגוד – כללי`

-- "יש לשלמה במלואה": the allowance is paid whole, in one payment, with the
-- July 2010 salary; "במלואה" is read as one payment, not as setting aside
-- section א.5's pro-rating, which the same section states in the same breath.
-- Time is counted in school months of 2009/10 (common.l4: September = 1).
@ref akn:art_a__para_1
GIVEN y IS A `clothing year`
GIVETH A DEONTIC Party `clothing action`
DECIDE `payment with July's salary` y IS
    PARTY `the local authority or owning body`
    MUST  `pay the clothing allowance` `amount paid`
          PROVIDED `amount paid` AT LEAST `clothing allowance` y
    WITHIN `month number` July
    LEST BREACH BY `the local authority or owning body` BECAUSE "section א.1: the clothing allowance is paid in full with the July 2010 salary"

-- "כנהוג כלפי מקבלי קהל בשירות המדינה": the measure is the civil service's
-- for staff who receive the public; this circular prints the amounts itself.
@ref akn:art_a__para_2
GIVEN y IS A `clothing year`
GIVETH A BOOLEAN
DECIDE `entitled to the clothing allowance` y IF
    y's `in the teaching-staff grade`

`the school year this circular prices` MEANS "תש\"ע (September 2009 to August 2010)"

-- Section א.3: the payment is by the employee's seniority. The reading
-- adopted (F-2009-10_tasha_05-a) counts the year being served, so a
-- first-year employee is in year 1 of section א.4's table.
@ref akn:art_a__para_3
GIVEN y IS A `clothing year`
GIVETH A NUMBER
DECIDE `full-position amount by seniority` y IS
    IF y's `years of teaching seniority` AT LEAST 26
    THEN 1961
    ELSE 1406

-- Section א.4's table, in the printed order: shekels by years of teaching
-- seniority.
@ref akn:art_a__para_4
`the seniority table` MEANS
    LIST `seniority band` 1  25  1406,
         `seniority band` 26 999 1961

DECLARE `seniority band` HAS
    `from seniority year` IS A NUMBER
    `to seniority year`   IS A NUMBER  @desc 999 stands for "ומעלה", with no upper bound
    `band amount`         IS A NUMBER  @desc shekels for a full position

GIVEN n IS A NUMBER
GIVETH A LIST OF NUMBER
DECIDE `the amounts the seniority table gives for` n IS
    map (GIVEN b YIELD b's `band amount`)
        (filter (GIVEN b YIELD n AT LEAST b's `from seniority year` AND n AT MOST b's `to seniority year`)
                `the seniority table`)

-- Section א.5: the allowance is paid in proportion to the employee's
-- position, and for no more than one full position (100%).
@ref akn:art_a__para_5
GIVEN y IS A `clothing year`
GIVETH A NUMBER
DECIDE `general clothing allowance` y IS
    IF `entitled to the clothing allowance` y
    THEN `full-position amount by seniority` y TIMES `position share` y
    ELSE 0

GIVEN y IS A `clothing year`
GIVETH A NUMBER
DECIDE `position share` y IS
    min (y's `position fraction`) 1

§§ `ב קצובת ביגוד נוספת למורה לחינוך גופני`

-- Section ב's table ("סכום נכון ל-1/8/10"), the amount by employment rate:
-- "עד 0.3" 0, "מ-0.3 עד 0.5" 242, "מ-0.5 ומעלה" 481. Its bounds meet at
-- 0.3 and at 0.5 (F-2009-10_tasha_05-b), and "employment rate" is not said
-- to be of what (F-2009-10_tasha_05-c).
@ref akn:art_b
`the physical-education table` MEANS
    LIST `employment band` 0   0.3 0,
         `employment band` 0.3 0.5 242,
         `employment band` 0.5 999 481

DECLARE `employment band` HAS
    `from employment rate` IS A NUMBER
    `to employment rate`   IS A NUMBER  @desc 999 stands for "ומעלה"
    `employment band amount` IS A NUMBER

GIVEN r IS A NUMBER
GIVETH A LIST OF NUMBER
DECIDE `the amounts the physical-education table gives for` r IS
    map (GIVEN b YIELD b's `employment band amount`)
        (filter (GIVEN b YIELD r AT LEAST b's `from employment rate` AND r AT MOST b's `to employment rate`)
                `the physical-education table`)

-- The reading adopted (F-2009-10_tasha_05-b): the band that OPENS at a
-- bound ("מ-") governs it, so 0.3 takes 242 and 0.5 takes 481.
GIVEN y IS A `clothing year`
GIVETH A NUMBER
DECIDE `physical-education allowance` y IS
    IF y's `teaches physical education`
    THEN BRANCH IF y's `physical-education employment rate` AT LEAST 0.5 THEN 481
                IF y's `physical-education employment rate` AT LEAST 0.3 THEN 242
                OTHERWISE 0
    ELSE 0

§§ `ג קצובת ביגוד בחינוך הטכנולוגי`

GIVEN professions IS A LIST OF STRING
      y IS A `clothing year`
GIVETH A BOOLEAN
DECIDE `teaches a profession on` professions y IF
        y's `in technological education`
    AND any (GIVEN p YIELD elem p professions) (y's `technological professions taught`)

-- Section ג: a teaching employee in technological education or a
-- professional instructor is paid a clothing allowance for 2009/10 by the
-- list of professions below. ג.1א: one teaching one of these thirteen
-- professions is entitled every year to a pair of shoes and two robes,
-- valued "ערך זוג נעליים ושני חלוקים: 514 ₪".
@ref akn:art_c/p1 akn:art_c__para_1__subpara_a
GIVEN y IS A `clothing year`
GIVETH A NUMBER
DECIDE `the shoes and two robes of section ג.1א, by value` y IS
    IF `teaches a profession on` `the professions granted shoes and two robes` y
    THEN `the value of shoes and two robes`
    ELSE 0

`the value of shoes and two robes` MEANS 514

`the professions granted shoes and two robes` MEANS
    LIST "מערכות תעופה",
         "מכטרוניקה",
         "טרמודינמיקה טכנית ימית",
         "מערכות סיב\"מ ותיב\"מ",
         "תחזוקת מערכות מכניות",
         "מערכות מכונאות רכב",
         "מערכות ממוחשבות ברכב",
         "מערכות הספק, פיקוד ובקרה",
         "מערכות בקרת אקלים",
         "אומנות הבישול והאפיה המלונאית",
         "ימאות – ספינות",
         "מערכות טלוויזיה וקולנוע",
         "מערכות צילום"

-- Section ג.1ב: one teaching one of these thirteen professions is entitled
-- to two robes a year. Unlike ג.1א it prints no value for them
-- (F-2009-10_tasha_05-d); the reading adopted: the value of two robes is an
-- input, set elsewhere.
@ref akn:art_c__para_1__subpara_b
GIVEN y IS A `clothing year`
GIVETH A NUMBER
DECIDE `the two robes of section ג.1ב, by value` y IS
    IF `teaches a profession on` `the professions granted two robes` y
    THEN y's `value of two robes`
    ELSE 0

`the professions granted two robes` MEANS
    LIST "מערכות אלקטרוניות",
         "מערכות מחשוב ובקרה",
         "מערכות מחשבים",
         "תכנון ותכנות מערכות",
         "מערכות ביוטכנולוגיה",
         "ניהול תיירותי",
         "ניהול מלונאי",
         "חינוך לגיל הרך",
         "עיצוב",
         "אופנה ותלבושות",
         "עיצוב שיער, וטיפוח החן",
         "סיעוד",
         "אומנות שימושית"

@desc A grant in kind section ג makes.
DECLARE `technological grant` IS ONE OF
    `shoes and two robes`
    `two robes`

`the grants section ג makes` MEANS LIST `shoes and two robes`, `two robes`
`the grants section ג prices` MEANS LIST `shoes and two robes`

-- Section ג.2: this allowance is in addition to the clothing allowance of
-- every teaching employee (section א). Section ב's is likewise an addition.
@ref akn:art_c__para_2
@export default The clothing allowance a teaching employee is owed for school year 2009/10 under circular תש"ע/5, the general allowance plus the physical-education and technological-education additions
GIVEN y IS A `clothing year` @desc the employee's school year 2009/10
GIVETH A NUMBER
DECIDE `clothing allowance` y IS
    `general clothing allowance` y
    PLUS `physical-education allowance` y
    PLUS `technological clothing allowance` y

-- Section ג.3: the technological allowance is paid in proportion to the
-- position, for no more than one full position. Each subparagraph grants on
-- its own words; an employee teaching on both lists meets both, and the
-- text grants both.
@ref akn:art_c__para_3
GIVEN y IS A `clothing year`
GIVETH A NUMBER
DECIDE `technological clothing allowance` y IS
    (    `the shoes and two robes of section ג.1א, by value` y
     PLUS `the two robes of section ג.1ב, by value` y)
    TIMES `position share` y

-- akn:art_d The contact line for questions (the conditions-of-service unit's telephone numbers); no rule.

-- akn:conclusions The sign-off and signature; no rule.

§§ `Worked examples`

-- F-2009-10_tasha_05-a: the table opens at year 1.
`a first-year employee has no row if seniority counts completed years` MEANS
    `the amounts the seniority table gives for` 0 EQUALS EMPTY
#ASSERT `a first-year employee has no row if seniority counts completed years`

#ASSERT all (GIVEN n YIELD count (`the amounts the seniority table gives for` n) EQUALS 1)
            (LIST 1, 2, 10, 25, 26, 30, 40)

-- F-2009-10_tasha_05-b: the bounds meet.
`the physical-education table gives 0.3 and 0.5 two amounts each` MEANS
        `the amounts the physical-education table gives for` 0.3 EQUALS LIST 0, 242
    AND `the amounts the physical-education table gives for` 0.5 EQUALS LIST 242, 481
#ASSERT `the physical-education table gives 0.3 and 0.5 two amounts each`

#ASSERT all (GIVEN r YIELD count (`the amounts the physical-education table gives for` r) EQUALS 1)
            (LIST 0, 0.1, 0.29, 0.31, 0.49, 0.51, 1)

-- F-2009-10_tasha_05-c: "שיעור העסקה" is not said to be the share of the
-- position in physical education or the employee's whole position.
`a full-position teacher with a fifth in physical education` MEANS
    `clothing year` WITH
        `in the teaching-staff grade`        IS TRUE
        `years of teaching seniority`        IS 10
        `position fraction`                  IS 1
        `teaches physical education`         IS TRUE
        `physical-education employment rate` IS 0.2
        `in technological education`         IS FALSE
        `technological professions taught`   IS EMPTY
        `value of two robes`                 IS 300

`the two readings of the employment rate differ` MEANS
    NOT (`the amounts the physical-education table gives for` 0.2
         EQUALS `the amounts the physical-education table gives for` 1)
#ASSERT `the two readings of the employment rate differ`

-- F-2009-10_tasha_05-d: section ג.1ב's grant is made and not priced.
`section ג.1ב's grant has no printed value` MEANS
        (NOT (elem `two robes` `the grants section ג prices`))
    AND elem `two robes` `the grants section ג makes`
#ASSERT `section ג.1ב's grant has no printed value`

-- On the circular's own amounts; the value of two robes (300) is a
-- placeholder, the circular printing none.
`a half-position teacher in year 30` MEANS
    `clothing year` WITH
        `in the teaching-staff grade`        IS TRUE
        `years of teaching seniority`        IS 30
        `position fraction`                  IS 0.5
        `teaches physical education`         IS FALSE
        `physical-education employment rate` IS 0
        `in technological education`         IS FALSE
        `technological professions taught`   IS EMPTY
        `value of two robes`                 IS 300

#ASSERT `clothing allowance` `a half-position teacher in year 30` EQUALS 980.5

`a full-position mechatronics teacher in year 5` MEANS
    `clothing year` WITH
        `in the teaching-staff grade`        IS TRUE
        `years of teaching seniority`        IS 5
        `position fraction`                  IS 1
        `teaches physical education`         IS FALSE
        `physical-education employment rate` IS 0
        `in technological education`         IS TRUE
        `technological professions taught`   IS LIST "מכטרוניקה"
        `value of two robes`                 IS 300

#ASSERT `clothing allowance` `a full-position mechatronics teacher in year 5` EQUALS 1920

#ASSERT `clothing allowance` `a full-position teacher with a fifth in physical education` EQUALS 1406

#TRACE `payment with July's salary` `a half-position teacher in year 30` AT 0 WITH
    PARTY `the local authority or owning body` DOES `pay the clothing allowance` 980.5 AT 11
#TRACE `payment with July's salary` `a half-position teacher in year 30` AT 0 WITH
    PARTY `the local authority or owning body` DOES `pay the clothing allowance` 980.5 AT 12
