-- חוזר לבעלויות תשע"ז/3 (5.4.2017): תוספת שקלית לעובדי הוראה החל מיום 1.9.2016
-- The 2016 shekel supplement for teaching staff of owners in kindergartens,
-- elementary schools, junior high schools and teacher-training colleges
-- (Ofek Hadash or not), under the agreements of 30.9.2016 and 19.3.2017:
-- the monthly amounts by period and Ofek Hadash rank, pro-rating, the yearly
-- update by the consumer price index, and its treatment for pay purposes.

IMPORT prelude
IMPORT daydate
IMPORT common

§ `חוזר לבעלויות תשע"ז/3 — תוספת שקלית 2016`

-- akn:preamble The letterhead, the date (5.4.2017), the reference number, the addressee and the subject; the recitals (the collective agreements of 30.9.2016 and 19.3.2017 with the Teachers' Union), the purpose and the "תחולה" heading carry no rule of their own. The application paragraphs are encoded below.

DECLARE `supplement action` IS ONE OF
    `pay the shekel supplement` HAS `supplement paid` IS A NUMBER
    `indemnify the owner at the hourly cost` HAS `supplement indemnity` IS A NUMBER

DECLARE `supplement stage` IS ONE OF
    `kindergarten`
    `elementary school`
    `junior high school`
    `teacher-training college`
    `another stage`

@desc A teaching employee in a month, as far as the shekel supplement asks.
DECLARE `supplement case` HAS
    `graded as a teaching employee of a supervised owner` IS A BOOLEAN
    `supplement stage of the employee`                    IS A `supplement stage`
    `employed under Ofek Hadash`                          IS A BOOLEAN
    `on the academic teachers' tables`                    IS A BOOLEAN @desc placed on the Ofek Hadash salary tables for academic teachers (not the non-academic ones)
    `Ofek Hadash rank`                                    IS A NUMBER  @desc the rank (דרגה) on the Ofek Hadash tables: 1, 1.5, 2 … 4.5; 0 if none
    `position fraction for the supplement`                IS A NUMBER  @desc the share of a full position (1 = 100%)

DECLARE `who a row is for` IS ONE OF
    `everyone covered`
    `the rank on the academic Ofek Hadash tables`
    `the rank on the academic or non-academic Ofek Hadash tables`
    `every other employee covered`

DECLARE `supplement row` HAS
    `row from`    IS A DATE
    `row to`      IS A DATE
    `row for`     IS A `who a row is for`
    `row rank`    IS A NUMBER @desc 0 where the row is not for a rank
    `row amount`  IS A NUMBER

`the open end` MEANS Date 31 12 9999

DECLARE `supplement purpose` IS ONE OF
    `the minimum-wage top-up`
    `salary for any purpose`
    `the hourly value for substitution hours and school activities`
    `the deduction for an hour of absence`
    `the payment under section 33(ד) of the Ofek Hadash agreement`
    `severance pay`
    `pension-fund contributions for an employee in an accumulating pension on the determining salary`
    `training-fund contributions`
    `other contributions and deductions made on the combined salary`
    `the base of percentage and shekel supplements`
    `annual supplements and grants on the overtime hourly-value base`

-- Application: teaching employees of supervised owners in kindergartens,
-- elementary schools, junior high schools and teacher-training colleges,
-- under Ofek Hadash or not.
@ref akn:preamble/p16 akn:preamble/p17
GIVEN c IS A `supplement case`
GIVETH A BOOLEAN
DECIDE `covered by the circular` c IF
        c's `graded as a teaching employee of a supervised owner`
    AND NOT c's `supplement stage of the employee` EQUALS `another stage`

§§ `1 תוספת שקלית לעובדי הוראה החל מיום 1.9.2016`

-- §1א: from 1.9.2016 the teaching employees are entitled to a monthly
-- shekel supplement, as §1ב–§1ג set it.
@ref akn:art_1__para_a
GIVEN c IS A `supplement case`, `the day` IS A DATE
GIVETH A BOOLEAN
DECIDE `entitled to the monthly shekel supplement` c `the day` IF
    `covered by the circular` c AND `the day` AT LEAST `the first day of the supplement`

`the first day of the supplement` MEANS Date 1 9 2016

-- §1ב(1)–(5) as printed: the full-position amount by period and rank.
@ref akn:art_1__para_b
`the supplement table` MEANS
    LIST `supplement row` (Date 1 9 2016) (Date 28 2 2017) `everyone covered` 0 108.18,
         `supplement row` (Date 1 3 2017) (Date 31 5 2019) `the rank on the academic Ofek Hadash tables` 1 340.17,
         `supplement row` (Date 1 3 2017) (Date 31 5 2019) `the rank on the academic Ofek Hadash tables` 1.5 319.78,
         `supplement row` (Date 1 3 2017) (Date 31 5 2019) `the rank on the academic Ofek Hadash tables` 2 299.39,
         `supplement row` (Date 1 3 2017) (Date 31 5 2019) `the rank on the academic Ofek Hadash tables` 2.5 246.52,
         `supplement row` (Date 1 3 2017) (Date 31 5 2019) `every other employee covered` 0 193.64,
         `supplement row` (Date 1 6 2019) (Date 31 8 2019) `the rank on the academic Ofek Hadash tables` 1 648.48,
         `supplement row` (Date 1 6 2019) (Date 31 8 2019) `the rank on the academic Ofek Hadash tables` 1.5 628.09,
         `supplement row` (Date 1 6 2019) (Date 31 8 2019) `the rank on the academic Ofek Hadash tables` 2 607.70,
         `supplement row` (Date 1 6 2019) (Date 31 8 2019) `the rank on the academic Ofek Hadash tables` 2.5 554.83,
         `supplement row` (Date 1 6 2019) (Date 31 8 2019) `every other employee covered` 0 501.96,
         `supplement row` (Date 1 9 2019) (Date 31 8 2020) `the rank on the academic or non-academic Ofek Hadash tables` 1 730.83,
         `supplement row` (Date 1 9 2019) (Date 31 8 2020) `the rank on the academic or non-academic Ofek Hadash tables` 1.5 703.73,
         `supplement row` (Date 1 9 2019) (Date 31 8 2020) `the rank on the academic or non-academic Ofek Hadash tables` 2 676.64,
         `supplement row` (Date 1 9 2019) (Date 31 8 2020) `the rank on the academic or non-academic Ofek Hadash tables` 2.5 643.85,
         `supplement row` (Date 1 9 2019) (Date 31 8 2020) `the rank on the academic or non-academic Ofek Hadash tables` 3 611.07,
         `supplement row` (Date 1 9 2019) (Date 31 8 2020) `the rank on the academic or non-academic Ofek Hadash tables` 3.5 593.51,
         `supplement row` (Date 1 9 2019) (Date 31 8 2020) `the rank on the academic or non-academic Ofek Hadash tables` 4 575.96,
         `supplement row` (Date 1 9 2019) (Date 31 8 2020) `the rank on the academic or non-academic Ofek Hadash tables` 4.5 538.96,
         `supplement row` (Date 1 9 2019) (Date 31 8 2020) `every other employee covered` 0 501.96,
         `supplement row` (Date 1 9 2020) `the open end` `the rank on the academic or non-academic Ofek Hadash tables` 1 1074.37,
         `supplement row` (Date 1 9 2020) `the open end` `the rank on the academic or non-academic Ofek Hadash tables` 1.5 1011.48,
         `supplement row` (Date 1 9 2020) `the open end` `the rank on the academic or non-academic Ofek Hadash tables` 2 948.59,
         `supplement row` (Date 1 9 2020) `the open end` `the rank on the academic or non-academic Ofek Hadash tables` 2.5 872.47,
         `supplement row` (Date 1 9 2020) `the open end` `the rank on the academic or non-academic Ofek Hadash tables` 3 796.36,
         `supplement row` (Date 1 9 2020) `the open end` `the rank on the academic or non-academic Ofek Hadash tables` 3.5 755.61,
         `supplement row` (Date 1 9 2020) `the open end` `the rank on the academic or non-academic Ofek Hadash tables` 4 714.86,
         `supplement row` (Date 1 9 2020) `the open end` `the rank on the academic or non-academic Ofek Hadash tables` 4.5 628.96,
         `supplement row` (Date 1 9 2020) `the open end` `every other employee covered` 0 543.33

GIVEN r IS A `supplement row`, `the day` IS A DATE
GIVETH A BOOLEAN
DECIDE `the row runs on` r `the day` IF
    `the day` AT LEAST r's `row from` AND `the day` AT MOST r's `row to`

GIVEN r IS A `supplement row`, c IS A `supplement case`
GIVETH A BOOLEAN
DECIDE `the rank row fits` r c IF
    CONSIDER r's `row for`
    WHEN `the rank on the academic Ofek Hadash tables` THEN
        c's `employed under Ofek Hadash` AND c's `on the academic teachers' tables` AND c's `Ofek Hadash rank` EQUALS r's `row rank`
    WHEN `the rank on the academic or non-academic Ofek Hadash tables` THEN
        c's `employed under Ofek Hadash` AND c's `Ofek Hadash rank` EQUALS r's `row rank`
    OTHERWISE FALSE

GIVEN r IS A `supplement row`
GIVETH A BOOLEAN
DECIDE `a row for everyone else` r IF
    CONSIDER r's `row for`
    WHEN `everyone covered` THEN TRUE
    WHEN `every other employee covered` THEN TRUE
    OTHERWISE FALSE

GIVEN c IS A `supplement case`, `the day` IS A DATE
GIVETH A NUMBER
DECIDE `the full-position supplement` c `the day` IS
    IF count (`the fitting rank rows`) GREATER THAN 0
    THEN sum (map (GIVEN r YIELD r's `row amount`) `the fitting rank rows`)
    ELSE sum (map (GIVEN r YIELD r's `row amount`)
                  (filter (GIVEN r YIELD `the row runs on` r `the day` AND `a row for everyone else` r) `the supplement table`))
    WHERE
        `the fitting rank rows` MEANS
            filter (GIVEN r YIELD `the row runs on` r `the day` AND `the rank row fits` r c) `the supplement table`

-- The table is a function of the day: on every day from 1.9.2016 exactly one
-- row is for everyone else, and the periods neither overlap nor leave a gap.
`the period bounds` MEANS
    LIST Date 1 9 2016, Date 28 2 2017, Date 1 3 2017, Date 31 5 2019, Date 1 6 2019,
         Date 31 8 2019, Date 1 9 2019, Date 31 8 2020, Date 1 9 2020, Date 1 1 2030
#ASSERT all (GIVEN d YIELD count (filter (GIVEN r YIELD `the row runs on` r d AND `a row for everyone else` r) `the supplement table`) EQUALS 1)
            `the period bounds`

-- §1ג: pro rata to the position against a full position.
@ref akn:art_1__para_c
@export default The monthly 2016 shekel supplement a teaching employee (kindergarten to junior high, colleges) is owed on a day under owners' circular 2016-17/3, before the yearly index update
GIVEN c IS A `supplement case` @desc the employee
      `the day` IS A DATE @desc a day of the month the supplement is for
GIVETH A NUMBER
DECIDE `shekel supplement` c `the day` IS
    IF `entitled to the monthly shekel supplement` c `the day`
    THEN `the full-position supplement` c `the day` TIMES c's `position fraction for the supplement`
    ELSE 0

-- §1ד: from January 2017, every January the supplement "as set above" is
-- updated by the rise of the new index (December of the year before the
-- update) over the previous one (December before the previous update; for
-- the first, December 2015). A fall in the index brings no update; the
-- update waits for one that is positive after offsetting the fall, measured
-- against the last index used. F-2016-17_tashaz_03-a: whether the printed
-- amounts of the later periods are updated too is not said; the reading
-- adopted applies each update to the amount in force on its date only.
@ref akn:art_1__para_d
GIVEN `amount` IS A NUMBER
      `the new index` IS A NUMBER @desc the consumer price index for December of the year before the update
      `the last index used` IS A NUMBER @desc the index of the last update made (December 2015 for the first)
GIVETH A NUMBER
DECIDE `the indexed amount` `amount` `the new index` `the last index used` IS
    IF `the new index` GREATER THAN `the last index used`
    THEN `amount` TIMES `the new index` DIVIDED BY `the last index used`
    ELSE `amount`

GIVEN `the new index` IS A NUMBER, `the last index used` IS A NUMBER
GIVETH A NUMBER
DECIDE `the index the next update measures from` `the new index` `the last index used` IS
    IF `the new index` GREATER THAN `the last index used`
    THEN `the new index`
    ELSE `the last index used`

#ASSERT `the indexed amount` 100 99 100 EQUALS 100
#ASSERT `the index the next update measures from` 99 100 EQUALS 100

-- §1ה: not counted for the minimum-wage top-up, and an "excluded supplement"
-- under the Minimum Wage (Raising the Amounts — Temporary Provision) Law
-- 2015. §1ו: salary for every purpose — the hourly value for substitution
-- hours and school activities, the deduction for an hour of absence, the
-- payment under section 33(ד) of the Ofek Hadash agreement, severance,
-- pension contributions (accumulating pension on the determining salary),
-- the training fund and every other contribution or deduction made on the
-- combined salary. §1ז: not in the base of any wage supplement, percentage
-- or shekel; §1ח: except annual supplements and grants computed on the
-- salary that sets the overtime hourly value.
@ref akn:art_1__para_e akn:art_1__para_f akn:art_1__para_g akn:art_1__para_h
GIVEN p IS A `supplement purpose`
GIVETH A BOOLEAN
DECIDE `the shekel supplement counts for` p IF
    CONSIDER p
    WHEN `the minimum-wage top-up` THEN FALSE
    WHEN `the base of percentage and shekel supplements` THEN FALSE
    OTHERWISE TRUE

-- §2: the owners are indemnified at the relevant hourly costs in the
-- payment system; the circular names no date.
@ref akn:art_2
GIVEN `the indemnity at the relevant hourly costs` IS A NUMBER @desc the relevant hourly costs in the payment system; the circular does not set them (an input)
GIVETH A DEONTIC Party `supplement action`
DECIDE `indemnifying the owner` `the indemnity at the relevant hourly costs` IS
    PARTY `the Ministry of Education`
    MUST  `indemnify the owner at the hourly cost` `amount`
          PROVIDED `amount` AT LEAST `the indemnity at the relevant hourly costs`

-- akn:conclusions The signature (Sonia Peretz) and the list of copies; no rule.

§§ `Later amounts against the index update (finding a)`

-- F-2016-17_tashaz_03-a: read as bases indexed by every update since
-- January 2017, the amount printed for 1.9.2020 on is not the amount paid;
-- read as fixed amounts, it is. With a 2% rise the two differ.
`the 1.9.2020 rank-1 amount read as a base indexed by 2%` MEANS `the indexed amount` 1074.37 102 100
`§1ב's later amounts and §1ד's update give two readings` MEANS
    NOT (`the 1.9.2020 rank-1 amount read as a base indexed by 2%` EQUALS 1074.37)
#ASSERT `§1ב's later amounts and §1ד's update give two readings`

§§ `No date for the months already past (finding b)`

-- The supplement is monthly; each month's is paid with that month's salary.
-- F-2016-17_tashaz_03-b: the circular, issued on 5.4.2017, sets the
-- supplement from 1.9.2016 and names no date for paying the months already
-- past. The reading adopted owes them with the first salary after the
-- circular.
GIVEN c IS A `supplement case`, `the day` IS A DATE, `days to the salary` IS A NUMBER
GIVETH A DEONTIC Party `supplement action`
DECIDE `paying the month's supplement` c `the day` `days to the salary` IS
    PARTY `the employer`
    MUST  `pay the shekel supplement` `amount`
          PROVIDED `amount` AT LEAST `shekel supplement` c `the day`
    WITHIN `days to the salary`
    LEST BREACH BY `the employer` BECAUSE "circular 2016-17/3: the shekel supplement is a monthly supplement from 1.9.2016"

`the circular's date` MEANS Date 5 4 2017
`the payment dates the circular states` MEANS EMPTY
`months of supplement past when the circular issued, unpaid by any stated date` MEANS
        DATE_SERIAL `the circular's date` MINUS DATE_SERIAL `the first day of the supplement` GREATER THAN 180
    AND count `the payment dates the circular states` EQUALS 0
#ASSERT `months of supplement past when the circular issued, unpaid by any stated date`

§§ `Worked examples`

`an academic Ofek Hadash teacher at rank 2, 80%` MEANS
    `supplement case` WITH
        `graded as a teaching employee of a supervised owner` IS TRUE
        `supplement stage of the employee`                    IS `elementary school`
        `employed under Ofek Hadash`                          IS TRUE
        `on the academic teachers' tables`                    IS TRUE
        `Ofek Hadash rank`                                    IS 2
        `position fraction for the supplement`                IS 0.8

`a non-academic Ofek Hadash teacher at rank 2` MEANS
    `supplement case` WITH
        `graded as a teaching employee of a supervised owner` IS TRUE
        `supplement stage of the employee`                    IS `kindergarten`
        `employed under Ofek Hadash`                          IS TRUE
        `on the academic teachers' tables`                    IS FALSE
        `Ofek Hadash rank`                                    IS 2
        `position fraction for the supplement`                IS 1

#ASSERT `shekel supplement` `a non-academic Ofek Hadash teacher at rank 2` (Date 1 10 2016) EQUALS 108.18
#ASSERT `shekel supplement` `a non-academic Ofek Hadash teacher at rank 2` (Date 1 1 2018) EQUALS 193.64
#ASSERT `shekel supplement` `a non-academic Ofek Hadash teacher at rank 2` (Date 1 1 2020) EQUALS 676.64
#ASSERT `shekel supplement` `an academic Ofek Hadash teacher at rank 2, 80%` (Date 1 1 2018) EQUALS 299.39 TIMES 0.8
#ASSERT `shekel supplement` `an academic Ofek Hadash teacher at rank 2, 80%` (Date 1 1 2021) EQUALS 948.59 TIMES 0.8
#ASSERT `shekel supplement` `an academic Ofek Hadash teacher at rank 2, 80%` (Date 1 8 2016) EQUALS 0
#ASSERT NOT `the shekel supplement counts for` `the minimum-wage top-up`

#TRACE `paying the month's supplement` `a non-academic Ofek Hadash teacher at rank 2` (Date 1 1 2018) 30 AT 0 WITH
    PARTY `the employer` DOES `pay the shekel supplement` 193.64 AT 30
