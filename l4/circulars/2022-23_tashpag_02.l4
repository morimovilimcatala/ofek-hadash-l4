-- Examples of the main rules. The employees are made up.
`an existing academic at 40%` MEANS
    `school employee` WITH
        `recognized teaching seniority`       IS 12
        `academic`                            IS TRUE
        `teaching certificate`                IS TRUE
        `employee's position fraction`        IS 0.4
        `signed the academic-completion undertaking` IS FALSE
        `approved by the exceptions committee` IS FALSE
        `in regular education`                IS FALSE
        `health professions or arts therapist` IS FALSE

`an existing non-academic of 20 years, unsigned` MEANS
    `school employee` WITH
        `recognized teaching seniority`       IS 20
        `academic`                            IS FALSE
        `teaching certificate`                IS TRUE
        `employee's position fraction`        IS 1
        `signed the academic-completion undertaking` IS FALSE
        `approved by the exceptions committee` IS FALSE
        `in regular education`                IS FALSE
        `health professions or arts therapist` IS FALSE

#ASSERT `joins Ofek Hadash` `an existing academic at 40%`
#ASSERT NOT `joins Ofek Hadash` `an existing non-academic of 20 years, unsigned`
#ASSERT `the position base for age` 56 TRUE EQUALS 32
#ASSERT `the position base for age` 56 FALSE EQUALS 34
#ASSERT `the weekly reduction` TRUE 0.85 FALSE EQUALS `hours reduction` 1 1
#ASSERT `the weekly reduction` TRUE 0.95 TRUE EQUALS `hours reduction` 0 5
#ASSERT `the counseling allowance rate` 8 TRUE EQUALS 0.12
#ASSERT `the advance rate of` `post-primary teacher` EQUALS 0.27
#ASSERT `work counts from` (7 TIMES 60 PLUS 30) EQUALS 465
#ASSERT `the position may be approved` 1.2 FALSE TRUE TRUE 8 42 TRUE
#ASSERT NOT `the position may be approved` 1.1 TRUE TRUE TRUE 8 40 FALSE

