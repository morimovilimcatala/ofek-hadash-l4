@ref akn:att_5__hc_1__para_3__subpara_c/p19 akn:att_5__hc_1__para_3__subpara_c/p20 akn:att_5__hc_1__para_3__subpara_c/p21 akn:att_5__hc_1__para_3__subpara_c/p22
