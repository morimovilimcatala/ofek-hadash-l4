-- תקנון שירות עובדי הוראה, פרק 14, עו"ה בחינוך מבוגרים
-- Teachers in adult education (Tehila centres and Hebrew ulpanim): the work
-- unit, hiring, terms of employment and the training fund, annual leave,
-- the education allowance, and the principal's appointment, duties and
-- management allowance.

IMPORT prelude
IMPORT common

§ `14 עו"ה בחינוך מבוגרים`

@desc The actors chapter 14 names that the takanon's common vocabulary does not.
DECLARE `14 party` IS ONE OF
    `a takanon party`  HAS `who` IS A Party
    `the adult-education department`   @desc המחלקה (האגף) לחינוך מבוגרים
    `the training fund`                 @desc the management of the teachers' training fund (קרן ההשתלמות)
    `the selection committee`

@desc The two frameworks of adult education the chapter distinguishes.
DECLARE `adult-education framework` IS ONE OF
    `Tehila`    @desc מוסדות תהיל"ה
    `ulpan`     @desc the ulpanim for teaching Hebrew

DECLARE `14 action` IS ONE OF
    `complete pre-service training` HAS `pre-service hours` IS A NUMBER
    `complete in-service training`  HAS `in-service hours` IS A NUMBER
    `consult the adult-education department on a pedagogical dismissal`
    `dismiss on pedagogical grounds`
    `offer work in another ulpan`
    `dismiss administratively` HAS `at the end of the ulpan cycle` IS A BOOLEAN
    `request in writing to move to the regular fund`
    `refund the employer's share` HAS `refund rate` IS A NUMBER, `refund month` IS A `school month`
    `decide a committee dispute`
    `coordinate the deductions with Bank Massad`

§§ `14.1 יחידת עבודה`

@ref akn:chp_14__ssec_14_1/p1
GIVETH A NUMBER
DECIDE `adult-education work unit` IS 28

-- akn:chp_14__ssec_14_1/p2 Heading of the source list (אסמכתא).
-- akn:chp_14__ssec_14_1/p3 Source: a special director-general's circular.

§§ `14.2 קבלה לעבודה`

DECLARE `adult-education candidate` HAS
    `trained at a teachers' seminary`           IS A BOOLEAN
    `academic degree with a teaching certificate` IS A BOOLEAN
    `meets the primary-education hiring conditions` IS A BOOLEAN @desc the conditions customary in primary education, which section 14.2.2 adopts for ulpanim; an input

@ref akn:chp_14__ssec_14_2__para_1/p1
GIVEN c IS AN `adult-education candidate`
GIVETH A BOOLEAN
DECIDE `may be hired for Tehila` c IF
    c's `trained at a teachers' seminary` OR c's `academic degree with a teaching certificate`

-- F-14-a: the two training figures as printed: "כ-24" and "כ-80" — about
-- 24 and about 80 hours. The text sets no exact threshold; the rule below
-- reads each figure as its stated number.
@desc A number of hours as section 14.2.1 prints it.
DECLARE `printed hours` HAS
    `printed figure`     IS A NUMBER
    `printed as "about"` IS A BOOLEAN

@ref akn:chp_14__ssec_14_2__para_1/p1
`the pre-service figure` MEANS `printed hours` 24 TRUE
`the in-service figure`  MEANS `printed hours` 80 TRUE

GIVETH A DEONTIC `14 party` `14 action`
DECIDE `Tehila pre-service and in-service training` IS
    PARTY `a takanon party` `the teaching employee`
    MUST  `complete pre-service training` h PROVIDED h AT LEAST `the pre-service figure`'s `printed figure`
    WITHIN 1
    HENCE (PARTY `a takanon party` `the teaching employee`
           MUST  `complete in-service training` k PROVIDED k AT LEAST `the in-service figure`'s `printed figure`
           WITHIN 12
           LEST BREACH BY `a takanon party` `the teaching employee` BECAUSE "section 14.2.1: about 80 hours of in-service training during the year")
    LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "section 14.2.1: about 24 hours of training before starting work"

`both training duties are printed as approximate figures` MEANS
    `the pre-service figure`'s `printed as "about"` AND `the in-service figure`'s `printed as "about"`
#ASSERT `both training duties are printed as approximate figures`

@ref akn:chp_14__ssec_14_2__para_2/p1
GIVEN c IS AN `adult-education candidate`
GIVETH A BOOLEAN
DECIDE `may be hired for an ulpan` c IF
    c's `meets the primary-education hiring conditions`

-- akn:chp_14__ssec_14_2/p1 Heading of the source list (אסמכתא).
-- akn:chp_14__ssec_14_2/p2 Source: a special director-general's circular.
-- akn:chp_14__ssec_14_2/p3 Source: a parity committee decision of 20.12.71.

§§ `14.4 תנאי העסקה`

§§§ `14.4.1 במוסדות תהיל"ה`

@ref akn:chp_14__ssec_14_4__para_1/p1
DECLARE `Tehila employment` HAS
    `by special contract`                  IS A BOOLEAN @desc employment in Tehila is by a special contract
    `pedagogical supervisor`               IS A Party   @desc the body supervising the work pedagogically: the Ministry of Education

@ref akn:chp_14__ssec_14_4__para_1/p1
`Tehila's terms` MEANS
    `Tehila employment` WITH
        `by special contract`    IS TRUE
        `pedagogical supervisor` IS `the Ministry of Education`

-- A pedagogical dismissal is done in consultation with the adult-education department.
@ref akn:chp_14__ssec_14_4__para_1/p1
GIVETH A DEONTIC `14 party` `14 action`
DECIDE `a pedagogical dismissal in Tehila` IS
    PARTY `a takanon party` `the employer`
    MUST  `consult the adult-education department on a pedagogical dismissal`
    WITHIN 1
    HENCE (PARTY `a takanon party` `the employer` MAY `dismiss on pedagogical grounds`)
    LEST  (PARTY `a takanon party` `the employer`
           SHANT `dismiss on pedagogical grounds`
           LEST BREACH BY `a takanon party` `the employer` BECAUSE "section 14.4.1: a pedagogical dismissal is made in consultation with the adult-education department")

§§§ `14.4.2 באולפנים`

-- akn:chp_14__ssec_14_4__para_2/p1 Sub-heading ("סדרי העסקה") of the rules below.

DECLARE `ulpan teacher` HAS
    `year in the ulpan system` IS A NUMBER @desc 1 for the first year
    `work in the ulpan shrank` IS A BOOLEAN
    `work found in another ulpan` IS A BOOLEAN

DECLARE `ulpan terms` IS ONE OF
    `by contract`
    `by referral, without contract, under the ministry's teacher rules`

@ref akn:chp_14__ssec_14_4__para_2/p2
GIVEN t IS AN `ulpan teacher`
GIVETH AN `ulpan terms`
DECIDE `an ulpan teacher is employed` t IS
    IF t's `year in the ulpan system` EQUALS 1
    THEN `by contract`
    ELSE `by referral, without contract, under the ministry's teacher rules`

-- If the ulpan's work shrinks, work in another ulpan is offered; if none is
-- found, the teacher is dismissed administratively at the end of the cycle,
-- with the customary retirement terms.
@ref akn:chp_14__ssec_14_4__para_2/p2
GIVEN t IS AN `ulpan teacher`
GIVETH A DEONTIC `14 party` `14 action`
DECIDE `when an ulpan's work shrinks` t IS
    IF NOT t's `work in the ulpan shrank`
    THEN FULFILLED
    ELSE IF t's `work found in another ulpan`
         THEN PARTY `the adult-education department`
              MUST  `offer work in another ulpan`
              WITHIN 1
              LEST  BREACH BY `the adult-education department` BECAUSE "section 14.4.2: work in another ulpan is offered"
         ELSE PARTY `a takanon party` `the employer`
              MAY   `dismiss administratively` atEnd PROVIDED atEnd
              WITHIN 12

@ref akn:chp_14__ssec_14_4__para_2/p2
GIVEN `dismissed administratively` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `entitled to the customary retirement terms` `dismissed administratively` IF
    `dismissed administratively`

-- akn:chp_14__ssec_14_4__para_2/p3 Sub-heading ("חברות בקרן ההשתלמות") of the rules below.

DECLARE `training fund` IS ONE OF `the regular fund`, `the Makor fund`

@ref akn:chp_14__ssec_14_4__para_2/p4
GIVEN `chosen fund` IS A `training fund`
GIVETH A BOOLEAN
DECIDE `a state-employee ulpan teacher may join` `chosen fund` IF
    CONSIDER `chosen fund`
    WHEN `the regular fund` THEN TRUE
    WHEN `the Makor fund`   THEN TRUE

-- A teacher who stays past one year and joined Makor may move to the
-- regular fund retroactively, on a written request by 30 June of that year.
-- Time in school months from 1 September: June is the tenth.
@ref akn:chp_14__ssec_14_4__para_2/p4
GIVEN `stayed beyond one year` IS A BOOLEAN, `joined Makor` IS A BOOLEAN
GIVETH A DEONTIC `14 party` `14 action`
DECIDE `moving retroactively to the regular fund` `stayed beyond one year` `joined Makor` IS
    IF `stayed beyond one year` AND `joined Makor`
    THEN PARTY `a takanon party` `the teaching employee`
         MAY   `request in writing to move to the regular fund`
         WITHIN `month number` June
    ELSE FULFILLED

@ref akn:chp_14__ssec_14_4__para_2/p5
GIVEN `a retroactive joining was requested` IS A BOOLEAN
GIVETH A DEONTIC `14 party` `14 action`
DECIDE `the fund coordinates a retroactive joining` `a retroactive joining was requested` IS
    IF `a retroactive joining was requested`
    THEN PARTY `the training fund`
         MUST  `coordinate the deductions with Bank Massad`
         WITHIN 12
         LEST  BREACH BY `the training fund` BECAUSE "section 14.4.2: the fund coordinates a retroactive joining with Bank Massad"
    ELSE FULFILLED

-- Teachers who joined the regular fund and stop working for the ministry
-- at the end of a year: the fund returns 0.9% of the employer's share
-- (the difference between 8.4 and 7.5) once a year, in October or November.
@ref akn:chp_14__ssec_14_4__para_2/p6
GIVETH A NUMBER
DECIDE `employer's share refunded` IS 8.4 MINUS 7.5

GIVEN m IS A `school month`
GIVETH A BOOLEAN
DECIDE `a refund month` m IF
    m EQUALS October OR m EQUALS November

@ref akn:chp_14__ssec_14_4__para_2/p6
GIVEN `left at the end of a year in the regular fund` IS A BOOLEAN
GIVETH A DEONTIC `14 party` `14 action`
DECIDE `the fund's refund` `left at the end of a year in the regular fund` IS
    IF `left at the end of a year in the regular fund`
    THEN PARTY `the training fund`
         MUST  `refund the employer's share` r m PROVIDED r EQUALS `employer's share refunded` AND `a refund month` m
         WITHIN `month number` November
         LEST  BREACH BY `the training fund` BECAUSE "section 14.4.2: the refund is made once a year, in October and November"
    ELSE FULFILLED

#ASSERT `employer's share refunded` EQUALS 0.9

-- akn:chp_14__ssec_14_4__para_2/p7 Effective date of the arrangement (from 1.9.91); the file encodes the rule in force and carries no dates.
-- akn:chp_14__ssec_14_4/p1 Heading of the source list (אסמכתא).
-- akn:chp_14__ssec_14_4/p2 Source: a special director-general's circular.
-- akn:chp_14__ssec_14_4/p3 Source: a director-general's circular.

§§ `14.5 חופשה שנתית`

-- Tehila follows the primary-education calendar; the recess days may move
-- if the year's total of school days still equals primary education's.
@ref akn:chp_14__ssec_14_5__para_1/p1
GIVEN `Tehila school days` IS A NUMBER, `primary-education school days that year` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `Tehila's changed recesses are allowed` `Tehila school days` `primary-education school days that year` IF
    `Tehila school days` EQUALS `primary-education school days that year`

-- 60 days a year besides the holidays, pro rata to the position.
@ref akn:chp_14__ssec_14_5__para_2/p1
GIVEN `position fraction` IS A NUMBER
GIVETH A NUMBER
DECIDE `ulpan teacher's annual leave days` `position fraction` IS
    60 TIMES `position fraction`

-- An unused balance carries to the next year, up to 65 days.
@ref akn:chp_14__ssec_14_5__para_2/p1
GIVEN `unused balance` IS A NUMBER
GIVETH A NUMBER
DECIDE `days carried to the next year` `unused balance` IS
    min `unused balance` 65

DECLARE `period at one position` HAS
    `period position fraction` IS A NUMBER
    `share of the year`        IS A NUMBER @desc the part of the year worked at that position fraction

@ref akn:chp_14__ssec_14_5__para_2/p2
GIVEN ps IS A LIST OF `period at one position`
GIVETH A NUMBER
DECIDE `leave days for a changing position` ps IS
    sum (map (GIVEN p YIELD `ulpan teacher's annual leave days` (p's `period position fraction`) TIMES p's `share of the year`) ps)

-- A permanent full-time teacher whose position was reduced with consent may
-- have the salary topped up to one full position by charging unused leave.
@ref akn:chp_14__ssec_14_5__para_2/p3
GIVEN `permanent` IS A BOOLEAN, `was full-time` IS A BOOLEAN, `reduced with consent` IS A BOOLEAN,
      `unused leave days` IS A NUMBER, `days needed to top up` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the salary may be topped up from unused leave` `permanent` `was full-time` `reduced with consent` `unused leave days` `days needed to top up` IF
        `permanent` AND `was full-time` AND `reduced with consent`
    AND `days needed to top up` AT MOST `unused leave days`

-- On separation, unused leave is redeemed under the civil-service
-- regulations (the תקשי"ר), whose rules are an input here.
@ref akn:chp_14__ssec_14_5__para_2/p4
GIVEN `employment relation ended` IS A BOOLEAN, `unused leave days` IS A NUMBER
GIVETH A NUMBER
DECIDE `days to redeem` `employment relation ended` `unused leave days` IS
    IF `employment relation ended` THEN `unused leave days` ELSE 0

-- akn:chp_14__ssec_14_5/p1 Heading of the source list (אסמכתא).
-- akn:chp_14__ssec_14_5/p2 Source: a special director-general's circular.
-- akn:chp_14__ssec_14_5/p3 Source: a parity committee decision of 7.11.84.

§§ `14.6 גמול חינוך`

@desc A framework an adult-education teacher may be "in charge of a class" for.
DECLARE `adult class` HAS
    `days a week`         IS A NUMBER
    `hours a day`         IS A NUMBER
    `students`            IS A NUMBER
    `on the department's list` IS A BOOLEAN @desc the teacher is on the list of those in charge of classes the adult-education department gives the treasury

@ref akn:chp_14__ssec_14_6/p3
GIVEN c IS AN `adult class`
GIVETH A BOOLEAN
DECIDE `in charge of a class` c IF
    c's `days a week` AT LEAST 5 AND c's `hours a day` AT LEAST 4 AND c's `students` AT LEAST 15

@ref akn:chp_14__ssec_14_6/p1 akn:chp_14__ssec_14_6/p4
GIVEN c IS AN `adult class`
GIVETH A BOOLEAN
DECIDE `entitled to the class-education allowance` c IF
    `in charge of a class` c AND c's `on the department's list`

-- akn:chp_14__ssec_14_6/p2 Effective date (from 12.9.86) and a pointer to section 1.12, which sets the allowance.

@ref akn:chp_14__ssec_14_6/p5
GIVEN c IS AN `adult class`
GIVETH A NUMBER
DECIDE `education hours for an adult class` c IS 0

-- akn:chp_14__ssec_14_6/p6 Heading of the source list (אסמכתא).
-- akn:chp_14__ssec_14_6/p7 Source: a director-general's circular and annex B of the collective agreement of 16.11.83.
-- akn:chp_14__ssec_14_6/p8 Source: a meeting decision of 29.8.86.

§§ `14.10 מנהל`

§§§ `14.10.2 מינוי`

-- A Tehila principal is appointed after a tender and a selection committee
-- that recommends to the director-general.
@ref akn:chp_14__ssec_14_10_2__para_1__subpara_a
DECLARE `committee seat` IS ONE OF
    `adult-education department representative`
    `owners' representative`
    `teachers' union representative`

@ref akn:chp_14__ssec_14_10_2__para_1__subpara_a/p2 akn:chp_14__ssec_14_10_2__para_1__subpara_a/p3 akn:chp_14__ssec_14_10_2__para_1__subpara_a/p4 akn:chp_14__ssec_14_10_2__para_1__subpara_a/p5
`the Tehila selection committee` MEANS
    LIST `adult-education department representative`, `adult-education department representative`,
         `owners' representative`, `owners' representative`,
         `teachers' union representative`

`the chair's seat` MEANS `adult-education department representative`

-- A dispute between the department and the owners is decided by the head
-- of the adult-education department AND the deputy director-general of the
-- Centre of Local Government, jointly. F-14-b: the text does not say what
-- happens when those two disagree.
DECLARE `who decides` IS ONE OF
    `the two deciders agree`
    `no decision`

@ref akn:chp_14__ssec_14_10_2__para_1__subpara_a/p6
GIVEN `department head's view` IS A BOOLEAN, `local-government deputy's view` IS A BOOLEAN
GIVETH A `who decides`
DECIDE `a department-owners dispute is decided` `department head's view` `local-government deputy's view` IS
    IF `department head's view` EQUALS `local-government deputy's view`
    THEN `the two deciders agree`
    ELSE `no decision`

`the two deciders of a dispute can deadlock` MEANS
    `a department-owners dispute is decided` TRUE FALSE EQUALS `no decision`
#ASSERT `the two deciders of a dispute can deadlock`

@ref akn:chp_14__ssec_14_10_2__para_1__subpara_b akn:chp_14__ssec_14_10_2__para_1__subpara_b/p2
GIVEN `senior-teacher education at least` IS A BOOLEAN, `years of teaching` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `qualified to be a Tehila principal` `senior-teacher education at least` `years of teaching` IF
    `senior-teacher education at least` AND `years of teaching` AT LEAST 5

-- "Preferably in adult education": a preference, not a condition.
@ref akn:chp_14__ssec_14_10_2__para_1__subpara_b/p2 akn:chp_14__ssec_14_10_2__para_2/p2
GIVEN `experience in adult education` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `preference weight` `experience in adult education` IS
    IF `experience in adult education` THEN 1 ELSE 0

@ref akn:chp_14__ssec_14_10_2__para_2/p1
GIVEN `appointed as customary in primary education, adapted to adult learners` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `an ulpan principal is validly appointed` `appointed as customary in primary education, adapted to adult learners` IF
    `appointed as customary in primary education, adapted to adult learners`

-- akn:chp_14__ssec_14_10_2/p1 Heading of the source list (אסמכתא).
-- akn:chp_14__ssec_14_10_2/p2 Source: a special director-general's circular.
-- akn:chp_14__ssec_14_10_2/p3 Source: a parity committee decision and a clarification.

§§§ `14.10.3 הגדרת תפקידים`

@ref akn:chp_14__ssec_14_10_3/p1 akn:chp_14__ssec_14_10_3/p2 akn:chp_14__ssec_14_10_3/p3
DECLARE `adult-education principal's duty` IS ONE OF
    `recruit learners`
    `follow absences and drop-out`
    `guide the teaching staff`
    `sort learners into classes`
    `prepare study material`
    `organise enrichment, trips and parties`
    `organise and run a learners' council, volunteering included`
    `develop ties with public institutions in the community`
    `administration: forms, buying books and equipment`
    `take part in the community centre's team, in a community centre`

DECLARE `principal action` IS ONE OF
    `perform` HAS `duty performed` IS AN `adult-education principal's duty`

GIVEN d IS AN `adult-education principal's duty`
GIVETH A DEONTIC Party `principal action`
DECIDE `the adult-education principal's duty` d IS
    PARTY `the school principal`
    MUST  `perform` done PROVIDED done EQUALS d
    WITHIN 12
    LEST  BREACH BY `the school principal` BECAUSE "section 14.10.3: the duties of a principal in adult education"

-- The principal is administratively subordinate to the owners.
@ref akn:chp_14__ssec_14_10_3/p3
GIVETH A Party
DECIDE `the adult-education principal's administrative superior` IS `the local authority or owning body`

-- akn:chp_14__ssec_14_10_3/p4 Heading of the source list (אסמכתא).
-- akn:chp_14__ssec_14_10_3/p5 Source: a special director-general's circular.

§§§ `14.10.6 גמול ניהול`

DECLARE `adult-education institution` IS ONE OF
    `ulpan`                    @desc an ulpan for teaching Hebrew
    `ulpanit`                  @desc an ulpanit for teaching Hebrew
    `Tehila centre`

DECLARE `adult institution` HAS
    `kind of institution`     IS AN `adult-education institution`
    `classes at the start`    IS A NUMBER @desc classes when the principal started, at the start of the year or the opening of the cycle
    `classes now`             IS A NUMBER
    `primary-school rate for these classes` IS A NUMBER @desc the rate section 7.6.6.1 sets for a primary-school principal with this number of classes; an input
    `ulpanit table rate for these classes`  IS A NUMBER @desc the rate the ulpanit table of section 14.10.6.2 gives (in force from 1.1.98); the table is not part of the text this file encodes, so an input

@ref akn:chp_14__ssec_14_10_6__para_1
GIVEN i IS AN `adult institution`
GIVETH A NUMBER
DECIDE `ulpan principal's rate` i IS
    i's `primary-school rate for these classes`

@ref akn:chp_14__ssec_14_10_6__para_2
GIVEN i IS AN `adult institution`
GIVETH A NUMBER
DECIDE `ulpanit principal's rate` i IS
    i's `ulpanit table rate for these classes`

-- akn:chp_14__ssec_14_10_6__para_2/p2 Effective date of the ulpanit table (from 1.1.98); the file encodes the rate in force and carries no dates.

-- F-14-c: a Tehila centre's principal gets the allowance "set for an
-- evening ulpanit principal"; no clause sets one by that name. Reading
-- adopted: the ulpanit table of 14.10.6.2.
@ref akn:chp_14__ssec_14_10_6__para_3
GIVEN i IS AN `adult institution`
GIVETH A NUMBER
DECIDE `Tehila centre principal's rate` i IS
    `ulpanit principal's rate` i

GIVEN i IS AN `adult institution`
GIVETH A NUMBER
DECIDE `adult-education management allowance rate` i IS
    CONSIDER i's `kind of institution`
    WHEN `ulpan`         THEN `ulpan principal's rate` i
    WHEN `ulpanit`       THEN `ulpanit principal's rate` i
    WHEN `Tehila centre` THEN `Tehila centre principal's rate` i

`the kinds of institution section 14.10.6 sets an allowance for` MEANS
    LIST "ulpan for teaching Hebrew", "ulpanit for teaching Hebrew"
`no clause sets an allowance for an "evening ulpanit"` MEANS
    NOT (elem "evening ulpanit" `the kinds of institution section 14.10.6 sets an allowance for`)
#ASSERT `no clause sets an allowance for an "evening ulpanit"`

-- The allowance is fixed when the principal starts; it rises if the
-- classes grow, and does not fall before the end of the year if they shrink.
@ref akn:chp_14__ssec_14_10_6__para_4
GIVEN i IS AN `adult institution`, `rate for a number of classes` IS A FUNCTION FROM NUMBER TO NUMBER
GIVETH A NUMBER
DECIDE `the rate paid during the year` i `rate for a number of classes` IS
    `rate for a number of classes` (max (i's `classes at the start`) (i's `classes now`))

-- Management seniority (section 7.6.10) is added to the allowance amount,
-- itself the rate times the personal combined salary.
@ref akn:chp_14__ssec_14_10_6__para_4/p2
GIVEN rate IS A NUMBER, `personal combined salary` IS A NUMBER,
      `management-seniority addition` IS A NUMBER @desc the addition for management seniority, as a fraction of the allowance, from section 7.6.10; an input
GIVETH A NUMBER
DECIDE `adult-education management allowance` rate `personal combined salary` `management-seniority addition` IS
    rate TIMES `personal combined salary` TIMES (1 PLUS `management-seniority addition`)

-- akn:chp_14__ssec_14_10_6/p1 Heading of the source list (אסמכתא).
-- akn:chp_14__ssec_14_10_6/p2 Source: a director-general's circular and annex C of the special collective agreement of 10.3.83.
-- akn:chp_14__ssec_14_10_6/p3 Source: circulars and the collective agreement of 23.12.90.
-- akn:chp_14__ssec_14_10_6/p4 Source: collective agreement of 8.9.98.
-- akn:chp_14__ssec_14_10_6/p5 Source: collective agreement of 11.5.93.
-- akn:chp_14__ssec_14_10_6/p6 Source: a special director-general's circular.
-- akn:chp_14__ssec_14_10_6/p7 Source: a clarification of 16.3.83.

-- Examples. Rates and salary are placeholders.
`an ulpanit that shrank` MEANS
    `adult institution` WITH
        `kind of institution`  IS `ulpanit`
        `classes at the start` IS 8
        `classes now`          IS 6
        `primary-school rate for these classes` IS 0.1
        `ulpanit table rate for these classes`  IS 0.12

GIVEN n IS A NUMBER
GIVETH A NUMBER
`a placeholder rate table` n MEANS n DIVIDED BY 100

