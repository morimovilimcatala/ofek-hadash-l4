-- תקנון שירות עובדי הוראה, פרק 3, §3.12 מורה - יועץ
-- The school counsellor: work unit and the counselling-teaching split; the
-- licensing rules (permanent and temporary licences, the transition, the
-- procedure); the approved goals and functions, with the confidentiality
-- rules; the counselling allowance; and the organisational framework.

IMPORT prelude
IMPORT daydate
IMPORT common

§ `3.12 מורה - יועץ`

@desc The parties of section 3.12: the takanon's common ones and the counselling bodies common.l4 does not name.
DECLARE `3.12 party` IS ONE OF
    `a takanon party` HAS `who` IS A Party
    `the counsellor`
    `the senior counsellor`
    `the grading and certification branch`
    `the district personnel department`

DECLARE `kind of licence` IS ONE OF
    `a permanent counselling licence`
    `a temporary counselling licence`
    `no counselling licence`

@desc A candidate for a counselling licence, as section 3.12.2 asks about them.
DECLARE `licence candidate` HAS
    `master's degree in educational counselling, recognised institution` IS A BOOLEAN
    `bachelor's degree in educational counselling, recognised institution` IS A BOOLEAN
    `an academic degree in counselling, recognised in Israel` IS A BOOLEAN
    `teaching certification from Israel (2(b))` IS A BOOLEAN @desc any of the four alternatives of 3.12.2.2(b): an Israeli teaching certificate, a certified-teacher certificate, a permanent teaching licence, or a recognised foreign one with Hebrew education completed
    `permanent teaching licence`                         IS A BOOLEAN
    `years employed as a counsellor under שפ"י, to its satisfaction` IS A NUMBER
    `employed as a counsellor under שפ"י, to its satisfaction` IS A BOOLEAN
    `regular student of a counselling master's, second year, in Israel` IS A BOOLEAN
    `regular student of a counselling bachelor's, third year, or a counselling master's, second year` IS A BOOLEAN
    `certificate studies in counselling at an institution once approved for them` IS A BOOLEAN @desc a counsellor with a certificate who finished certificate studies in counselling at an institution previously approved for them (Beit Berl, Jerusalem College for Women)
    `MA in psychology, social work, behavioural sciences or special education` IS A BOOLEAN
    `completed supplementary counselling courses approved by שפ"י` IS A BOOLEAN
    `recommended by the senior counsellor`               IS A BOOLEAN

@desc One goal or function of the counsellor, as the approved list states it.
DECLARE `counselling function` HAS
    `area of the function` IS A STRING
    `what the function is` IS A STRING

DECLARE `who may refer a pupil` IS ONE OF
    `the pupil`
    `the pupil's parents`
    `the homeroom teacher and the educational staff`
    `the counsellor, of their own initiative`

DECLARE `form of counselling` IS ONE OF `individual`, `in a group`, `with the whole class`

DECLARE `recipient of counselling material` IS ONE OF
    `the counsellor or psychologist of the pupil's new school`
    `another person in the pupil's new school`
    `a body outside the pupil's school`

DECLARE `counselling action` IS ONE OF
    `employ as a counsellor` HAS `licence held` IS A `kind of licence`
    `make efforts to employ only permanent licence holders`
    `see that the temporary licence holder completes the permanent licence`
    `apply for a counselling licence` HAS `copies on form 050.207` IS A NUMBER
    `issue the licence`
    `give a copy of the licence to the principal and the senior counsellor`
    `collect information on a pupil` HAS `for a defined purpose that helps the pupil` IS A BOOLEAN
    `disclose confidential information` HAS `needed for the pupil's treatment, in the counsellor's view` IS A BOOLEAN
    `conduct a test restricted to psychologists`
    `explain test results orally to the parents`
    `pass the pupil's material on` HAS `to whom` IS A `recipient of counselling material`, `with the parents' approval` IS A BOOLEAN
    `assign the veteran counsellor to teaching`
    `bring the matter before the counselling supervisor`
    `recommend on continued employment`
    `set the counsellor's timetable`
    `bring the annual plan's main topics to the principal`
    `provide a suitable room`
    `take part in guidance and training`
    `schedule more than 5 standard counselling hours in one day`
    `set times for receiving parents and pupils in the afternoon`

DECLARE `primary school kind` IS ONE OF
    `a primary school of grades 1-8`
    `a primary school of grades 1-6 only`

-- akn:chp_3__sec_3_12/p2 Table of contents: the title of 3.12.1.
-- akn:chp_3__sec_3_12/p3 Table of contents: the title of 3.12.2.
-- akn:chp_3__sec_3_12/p4 Table of contents: the title of 3.12.3.
-- akn:chp_3__sec_3_12/p5 Table of contents: the title of 3.12.6.
-- akn:chp_3__sec_3_12/p6 Table of contents: the title of 3.12.7.

§§ `3.12.1 יחידת עבודה`

@ref akn:chp_3__sec_3_12__ssec_3_12_1__para_1/p1
GIVEN `the work unit of a teacher in that kind of institution` IS A NUMBER @desc weekly hours of a teacher's work unit in an institution of the same kind; an input, set by the section on that kind
GIVETH A NUMBER
DECIDE `the counsellor's work unit` `the work unit of a teacher in that kind of institution` IS
    `the work unit of a teacher in that kind of institution`

@ref akn:chp_3__sec_3_12__ssec_3_12_1__para_1/p2
GIVEN `counselling share of the position` IS A NUMBER, `teaching share of the position` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the counselling-teaching split is lawful` `counselling share of the position` `teaching share of the position` IF
    `counselling share of the position` AT MOST 2/3 AND `teaching share of the position` AT LEAST 1/3

-- (2): in a primary school of grades 1-8, 60% of the counselling hours are
-- reckoned by 24 weekly hours and 40% by 30; in a school of grades 1-6
-- only, all by 30. The result is the share of a position the hours make.
@ref akn:chp_3__sec_3_12__ssec_3_12_1__para_2/p1 akn:chp_3__sec_3_12__ssec_3_12_1__para_2__subpara_a akn:chp_3__sec_3_12__ssec_3_12_1__para_2__subpara_b/p1 akn:chp_3__sec_3_12__ssec_3_12_1__para_2__subpara_b/p2
GIVEN k IS A `primary school kind`, `weekly counselling hours` IS A NUMBER
GIVETH A NUMBER
DECIDE `position share of counselling hours in a primary school` k `weekly counselling hours` IS
    CONSIDER k
    WHEN `a primary school of grades 1-8` THEN
           (60% TIMES `weekly counselling hours`) DIVIDED BY 24
         PLUS (40% TIMES `weekly counselling hours`) DIVIDED BY 30
    WHEN `a primary school of grades 1-6 only` THEN `weekly counselling hours` DIVIDED BY 30

-- akn:chp_3__sec_3_12__ssec_3_12_1/p1 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_12__ssec_3_12_1/p2 Source (אסמכתא): a Director-General's circular.
-- akn:chp_3__sec_3_12__ssec_3_12_1/p3 Source (אסמכתא): a special Director-General's circular.
-- akn:chp_3__sec_3_12__ssec_3_12_1/p4 Source (אסמכתא): a special Director-General's circular.

§§ `3.12.2 תקנון למתן רשיונות לייעוץ`

-- akn:chp_3__sec_3_12__ssec_3_12_2/p1 An amendment note: the sub-section was updated on 26.5.2002.

-- 1(a), with 3.12.7(1): no one serves as a counsellor in an official or
-- recognised institution without a Ministry licence, permanent or temporary.
@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_1__subpara_a
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `no counsellor without a licence` IS
    PARTY `a takanon party` `the employer`
    SHANT `employ as a counsellor` l PROVIDED l EQUALS `no counselling licence`

-- 1(b): the district personnel departments (and principals of recognised
-- unofficial schools) make efforts to employ only permanent licence
-- holders. 1(c): where posts are hard to fill, temporary licence holders may
-- be employed, and the senior counsellors see that they complete the
-- permanent licence within 2-3 years at most (the encoding takes 3, the
-- outer bound of "3-2 שנים לכל היותר").
@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_1__subpara_b
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `efforts to employ permanent licence holders` IS
    PARTY `the district personnel department` MUST `make efforts to employ only permanent licence holders`

@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_1__subpara_c
GIVEN `difficulty filling the posts with permanent licence holders` IS A BOOLEAN, l IS A `kind of licence`
GIVETH A BOOLEAN
DECIDE `may be employed as a counsellor` `difficulty filling the posts with permanent licence holders` l IF
    CONSIDER l
    WHEN `a permanent counselling licence` THEN TRUE
    WHEN `a temporary counselling licence` THEN `difficulty filling the posts with permanent licence holders`
    WHEN `no counselling licence` THEN FALSE

@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_1__subpara_c
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `the temporary licence holder completes the permanent licence` IS
    PARTY `the senior counsellor`
    MUST  `see that the temporary licence holder completes the permanent licence`
    WITHIN 3
    LEST BREACH BY `the senior counsellor` BECAUSE "section 3.12.2.1(c): temporary licence holders complete the permanent licence within 2-3 years at most"

-- (2): from תשס"א, a permanent licence to one who meets ALL of (a)-(c).
@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_2 akn:chp_3__sec_3_12__ssec_3_12_2__para_2__subpara_a akn:chp_3__sec_3_12__ssec_3_12_2__para_2__subpara_c
GIVEN c IS A `licence candidate`
GIVETH A BOOLEAN
DECIDE `meets the conditions of a permanent licence` c IF
        c's `master's degree in educational counselling, recognised institution`
    AND `holds a teaching certification as in 2(b)` c
    AND c's `years employed as a counsellor under שפ"י, to its satisfaction` AT LEAST 2

@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_2__subpara_b/p1 akn:chp_3__sec_3_12__ssec_3_12_2__para_2__subpara_b/p2 akn:chp_3__sec_3_12__ssec_3_12_2__para_2__subpara_b/p3 akn:chp_3__sec_3_12__ssec_3_12_2__para_2__subpara_b/p4
GIVEN c IS A `licence candidate`
GIVETH A BOOLEAN
DECIDE `holds a teaching certification as in 2(b)` c IF
    c's `teaching certification from Israel (2(b))`

-- (3): a temporary licence to one who meets (a)-(c); for three years at most.
@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_3 akn:chp_3__sec_3_12__ssec_3_12_2__para_3__subpara_a akn:chp_3__sec_3_12__ssec_3_12_2__para_3__subpara_b akn:chp_3__sec_3_12__ssec_3_12_2__para_3__subpara_c/p1
GIVEN c IS A `licence candidate`
GIVETH A BOOLEAN
DECIDE `meets the conditions of a temporary licence` c IF
        c's `regular student of a counselling master's, second year, in Israel`
    AND `holds a teaching certification as in 2(b)` c
    AND c's `employed as a counsellor under שפ"י, to its satisfaction`

@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_3__subpara_c/p2
GIVETH A NUMBER
DECIDE `years a temporary licence may be approved for, at most` IS 3

-- (4): until 31.8.2004 (the end of תשס"ד), further routes. (a) a permanent
-- licence on any one of (1)-(4) — the rows "או" between them say so;
-- (b) a temporary licence on (1)-(3) together.
`the end of the transition period` MEANS Date 31 8 2004

@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_4 akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_a akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_a__cls_1/p1 akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_a__cls_1/p2 akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_a__cls_2/p1 akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_a__cls_2/p2 akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_a__cls_3/p1 akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_a__cls_3/p2 akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_a__cls_4
GIVEN c IS A `licence candidate`
GIVETH A BOOLEAN
DECIDE `meets a transitional route to a permanent licence` c IF
       (c's `bachelor's degree in educational counselling, recognised institution` AND `holds a teaching certification as in 2(b)` c)
    OR c's `certificate studies in counselling at an institution once approved for them`
    OR (    c's `MA in psychology, social work, behavioural sciences or special education`
        AND (`holds a teaching certification as in 2(b)` c OR c's `permanent teaching licence`)
        AND c's `completed supplementary counselling courses approved by שפ"י`)
    OR c's `years employed as a counsellor under שפ"י, to its satisfaction` AT LEAST 2

@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_b akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_b__cls_1 akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_b__cls_2 akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_b__cls_3/p1
GIVEN c IS A `licence candidate`
GIVETH A BOOLEAN
DECIDE `meets the transitional route to a temporary licence` c IF
        (c's `an academic degree in counselling, recognised in Israel` OR c's `regular student of a counselling bachelor's, third year, or a counselling master's, second year`)
    AND `holds a teaching certification as in 2(b)` c
    AND c's `recommended by the senior counsellor`

-- 4(b), the note: a transitional temporary licence is for the first two
-- years of counselling work, extendable to a third; after two years the
-- holder applies for a permanent one.
@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_b__cls_3/p2 akn:chp_3__sec_3_12__ssec_3_12_2__para_4__subpara_b__cls_3/p3
GIVEN `years of counselling work` IS A NUMBER, `extended to a third year` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the transitional temporary licence is in force` `years of counselling work` `extended to a third year` IF
    `years of counselling work` AT MOST 2 OR (`extended to a third year` AND `years of counselling work` AT MOST 3)

@export The counselling licence a teaching employee may be granted on a given day under section 3.12.2 of the takanon
GIVEN c IS A `licence candidate` @desc the candidate
      , d IS A DATE @desc the day of the decision (from תשס"א on)
GIVETH A `kind of licence`
DECIDE `the licence that may be granted` c d IS
    IF `meets the conditions of a permanent licence` c
       OR (d AT MOST `the end of the transition period` AND `meets a transitional route to a permanent licence` c)
    THEN `a permanent counselling licence`
    ELSE IF `meets the conditions of a temporary licence` c
            OR (d AT MOST `the end of the transition period` AND `meets the transitional route to a temporary licence` c)
         THEN `a temporary counselling licence`
         ELSE `no counselling licence`

-- akn:chp_3__sec_3_12__ssec_3_12_2__para_5 A heading ("הוראות נוהל וביצוע", procedure).

@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_5__subpara_a akn:chp_3__sec_3_12__ssec_3_12_2__para_5__subpara_b
GIVEN `copies` IS A NUMBER, `section A filled by the employee` IS A BOOLEAN,
      `section B signed by the senior counsellor` IS A BOOLEAN, `certificates attached` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the licence application is in order` `copies` `section A filled by the employee` `section B signed by the senior counsellor` `certificates attached` IF
    `copies` EQUALS 4 AND `section A filled by the employee` AND `section B signed by the senior counsellor` AND `certificates attached`

@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_5__subpara_c
GIVEN c IS A `licence candidate`, d IS A DATE
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `examining the application` c d IS
    IF `the licence that may be granted` c d EQUALS `no counselling licence`
    THEN PARTY `the grading and certification branch` SHANT `issue the licence`
    ELSE PARTY `the grading and certification branch` MUST `issue the licence`

-- (d)-(e): who receives the licence and its copies. The employee keeps the
-- original of a permanent licence and gives one copy to the principal and
-- one to the senior counsellor.
DECLARE `holder of a licence copy` IS ONE OF
    `the employee (the original)`, `the principal`, `the senior counsellor`, `the district personnel department`

@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_5__subpara_d akn:chp_3__sec_3_12__ssec_3_12_2__para_5__subpara_e/p1
`who ends up with the licence or a copy` MEANS
    LIST `the employee (the original)`, `the principal`, `the senior counsellor`, `the district personnel department`

@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_5__subpara_d
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `copies of a permanent licence` IS
    PARTY `a takanon party` `the teaching employee` MUST `give a copy of the licence to the principal and the senior counsellor`

-- (e), the note: in the Haredi sector the Ministry's supervisor fills the
-- senior counsellor's functions.
@ref akn:chp_3__sec_3_12__ssec_3_12_2__para_5__subpara_e/p2
GIVEN `the Haredi sector` IS A BOOLEAN
GIVETH A `3.12 party`
DECIDE `who fills the senior counsellor's functions` `the Haredi sector` IS
    IF `the Haredi sector` THEN `a takanon party` `the supervisor` ELSE `the senior counsellor`

-- akn:chp_3__sec_3_12__ssec_3_12_2/p2 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_12__ssec_3_12_2/p3 Source (אסמכתא): a Director-General's circular.
-- akn:chp_3__sec_3_12__ssec_3_12_2/p4 Source (אסמכתא): a Director-General's circular.
-- akn:chp_3__sec_3_12__ssec_3_12_2/p5 Source (אסמכתא): a Director-General's circular.

§§ `3.12.3 הגדרת תפקידים`

-- akn:chp_3__sec_3_12__ssec_3_12_3/p1 The opening words: the pedagogical secretariat approved the functions that follow.

@ref akn:chp_3__sec_3_12__ssec_3_12_3/p2
`the goals of counselling` MEANS
    LIST
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p3
        -- Goal 1.
        `counselling function` "goal" "fostering conditions and a climate in which pupils develop by their ability and inclination, in study, society and emotional life",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p4
        -- Goal 2.
        `counselling function` "goal" "developing awareness of individual needs, of the social and emotional problems typical of the pupils' age and of special needs",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p5
        -- Goal 3.
        `counselling function` "goal" "counselling the system on conditions and frameworks that let pupils realise their ability",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p6
        -- Goal 4.
        `counselling function` "goal" "helping pupils who struggle to adjust, and counselling their teachers and parents",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p7
        -- Goal 5.
        `counselling function` "goal" "helping all pupils adjust to new study and social frameworks",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p8
        -- Goal 6.
        `counselling function` "goal" "developing a counselling process of self-knowledge, as ground for choosing study and work"

@ref akn:chp_3__sec_3_12__ssec_3_12_3/p9
`the functions of the primary-school counsellor` MEANS
    LIST
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p10 akn:chp_3__sec_3_12__ssec_3_12_3/p11
        -- Function 1, educational-therapeutic counselling of the pupil: intervening in adjustment difficulties.
        `counselling function` "educational-therapeutic counselling" "intervening where a pupil has difficulties of adjustment: under-achievement, social problems, behaviour disorders, emotional difficulties",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p16
        -- 1: early detection, gathering relevant information, its fitting use and its confidentiality.
        `counselling function` "educational-therapeutic counselling" "early detection of problems, gathering the relevant information, using it fittingly and keeping it confidential",
-- akn:chp_3__sec_3_12__ssec_3_12_3/p18 akn:chp_3__sec_3_12__ssec_3_12_3/p19 Function 2, counselling parents: helping the homeroom teacher with the school's ties to parents, in these ways.
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p20
        -- 2(a) individual contact with parents when needed.
        `counselling function` "counselling parents, with the homeroom teacher" "individual contact with the pupils' parents when needed",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p21
        -- 2(b) guiding parents' groups.
        `counselling function` "counselling parents, with the homeroom teacher" "guiding groups of parents on adolescence, moving between frameworks, homework problems and the like",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p22
        -- 2(c) running a parents' circle.
        `counselling function` "counselling parents, with the homeroom teacher" "running a parents' circle as a means of treating the child's problems",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p23
        -- 2(d) helping the staff involve the parents.
        `counselling function` "counselling parents, with the homeroom teacher" "helping the school staff involve the parents in helping the school",
-- akn:chp_3__sec_3_12__ssec_3_12_3/p24 Heading of function 3 (counselling toward further studies).
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p25
        -- 3(a) realistic self-understanding.
        `counselling function` "counselling toward further studies" "helping the pupil to a good, realistic self-understanding",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p26
        -- 3(b) knowledge of the world of work and the choices open.
        `counselling function` "counselling toward further studies" "widening the pupil's knowledge of the world of work and of study options, and awareness of choice and decision",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p27
        -- 3(c) a realistic plan of action.
        `counselling function` "counselling toward further studies" "helping the pupil and parents form a realistic, fitting plan of action",
-- akn:chp_3__sec_3_12__ssec_3_12_3/p28 Heading of function 4 (ways of working in grades 7-8).
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p29
        -- 4(a) gathering information on all pupils.
        `counselling function` "grades 7-8" "gathering information on all pupils from various sources",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p30
        -- 4(b) class, group and personal talks.
        `counselling function` "grades 7-8" "class, group and personal talks on self-knowledge, adolescence, the world of work and other problems",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p31
        -- 4(c) visits to post-primary schools and industrial plants.
        `counselling function` "grades 7-8" "visits with pupils to post-primary schools and industrial plants",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p32
        -- 4(d) personal counselling of pupils and parents.
        `counselling function` "grades 7-8" "personal counselling of pupils and their parents",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p33
        -- 4(e) contact with the receiving institutions and follow-up.
        `counselling function` "grades 7-8" "contact with the institutions receiving the pupils, and following their adjustment",
-- akn:chp_3__sec_3_12__ssec_3_12_3/p34 akn:chp_3__sec_3_12__ssec_3_12_3/p35 Function 5, preparing the move to the middle school, with the homeroom teacher and staff, in these fields.
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p36
        -- 5(a) talks on the middle school's structure and adjustment.
        `counselling function` "preparing the move to the middle school" "class and group talks on the middle school's structure and adjusting to a new place",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p37
        -- 5(b) personal talks; preparing candidates for boarding schools and special frameworks.
        `counselling function` "preparing the move to the middle school" "personal talks with pupils and parents needing help; special preparation for boarding and special frameworks",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p38
        -- 5(c) passing information to the receiving middle-school staff.
        `counselling function` "preparing the move to the middle school" "gathering information on the pupils and passing it to the receiving middle-school staff",
-- akn:chp_3__sec_3_12__ssec_3_12_3/p39 Heading of function 6 (coordinating the interdisciplinary team).
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p40
        -- 6(a) linking the school's services.
        `counselling function` "the interdisciplinary team" "handling the link between the school's services",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p43
        -- 6(c) the team's discussions of general and particular problems.
        `counselling function` "the interdisciplinary team" "the team discusses the school's or a class's problems and those of exceptional children",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p44
        -- 6(d) the team acts by the Director-General's procedures for it.
        `counselling function` "the interdisciplinary team" "the team acts by the procedures for running it published in the Director-General's circular",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p45
        -- 6(e) following up the team's recommendations.
        `counselling function` "the interdisciplinary team" "following up the team's recommendations and bringing a problem back when needed",
-- akn:chp_3__sec_3_12__ssec_3_12_3/p46 Heading of function 7 (counselling the system).
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p47
        -- 7(a) discussions with the staff on transitions between frameworks.
        `counselling function` "counselling the system" "individual and group discussions with the staff on study, educational and social matters and on transitions",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p48
        -- 7(b) developing auxiliary frameworks.
        `counselling function` "counselling the system" "counselling on developing auxiliary frameworks and integrating them",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p49
        -- 7(c) special projects.
        `counselling function` "counselling the system" "counselling on running special projects",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p50
        -- 7(d) ties with community institutions.
        `counselling function` "counselling the system" "encouraging interaction between the school and community institutions",
        @ref akn:chp_3__sec_3_12__ssec_3_12_3/p51
        -- 7(e) alertness to what is new in mental health.
        `counselling function` "counselling the system" "alertness to what is new in mental health and fitting it to the school"

@ref akn:chp_3__sec_3_12__ssec_3_12_3/p11 akn:chp_3__sec_3_12__ssec_3_12_3/p12 akn:chp_3__sec_3_12__ssec_3_12_3/p13 akn:chp_3__sec_3_12__ssec_3_12_3/p14 akn:chp_3__sec_3_12__ssec_3_12_3/p15
`who may initiate a referral to the counsellor` MEANS
    LIST `the pupil`, `the pupil's parents`, `the homeroom teacher and the educational staff`, `the counsellor, of their own initiative`

@ref akn:chp_3__sec_3_12__ssec_3_12_3/p17
`the forms counselling may take` MEANS LIST `individual`, `in a group`, `with the whole class`

-- 6(b): the principal (or a representative) heads the team; the counsellor
-- coordinates it; its members are the listed role-holders "and the like";
-- each discussion invites all or some of them by its subject.
@ref akn:chp_3__sec_3_12__ssec_3_12_3/p41 akn:chp_3__sec_3_12__ssec_3_12_3/p42
`the interdisciplinary team's members` MEANS
    LIST "the principal or a representative, at its head", "the counsellor, coordinating", "a psychologist", "a social worker",
         "a truant officer", "a doctor", "a nurse", "a probation officer", "homeroom and subject teachers", "teachers of auxiliary frameworks"

-- 8: confidentiality.
-- akn:chp_3__sec_3_12__ssec_3_12_3/p52 A heading ("שמירה על סודיות של מידע").

@ref akn:chp_3__sec_3_12__ssec_3_12_3/p53
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `collecting information on a pupil` IS
    PARTY `the counsellor` SHANT `collect information on a pupil` p PROVIDED NOT p

-- (b): confidential; disclosed only where the counsellor judges it needed
-- for the pupil's treatment, on the counsellor's professional judgement
-- and responsibility.
@ref akn:chp_3__sec_3_12__ssec_3_12_3/p54 akn:chp_3__sec_3_12__ssec_3_12_3/p55
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `confidential counselling information` IS
    PARTY `the counsellor` SHANT `disclose confidential information` n PROVIDED NOT n

-- (c): tests the counsellor was trained for, never those restricted to
-- psychologists; tests, results and other professionals' recommendations
-- are confidential; parents, on request, get an oral explanation.
@ref akn:chp_3__sec_3_12__ssec_3_12_3/p56
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `no psychologists' tests` IS
    PARTY `the counsellor` SHANT `conduct a test restricted to psychologists`

@ref akn:chp_3__sec_3_12__ssec_3_12_3/p57
GIVEN `the parents asked` IS A BOOLEAN
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `explaining results to parents` `the parents asked` IS
    IF `the parents asked`
    THEN PARTY `the counsellor` MUST `explain test results orally to the parents`
    ELSE FULFILLED

-- (d)-(e): material goes, on a move of school, only to the new school's
-- counsellor or psychologist; results go outside the school only with the
-- parents' approval.
@ref akn:chp_3__sec_3_12__ssec_3_12_3/p58 akn:chp_3__sec_3_12__ssec_3_12_3/p59
GIVEN r IS A `recipient of counselling material`, `with the parents' approval` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the material may be passed on` r `with the parents' approval` IF
    CONSIDER r
    WHEN `the counsellor or psychologist of the pupil's new school` THEN TRUE
    WHEN `another person in the pupil's new school`                 THEN FALSE
    WHEN `a body outside the pupil's school`                        THEN `with the parents' approval`

@ref akn:chp_3__sec_3_12__ssec_3_12_3/p58 akn:chp_3__sec_3_12__ssec_3_12_3/p59
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `passing counselling material on` IS
    PARTY `the counsellor`
    SHANT `pass the pupil's material on` r a PROVIDED NOT `the material may be passed on` r a

-- akn:chp_3__sec_3_12__ssec_3_12_3/p60 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_12__ssec_3_12_3/p61 Source (אסמכתא): a Director-General's circular.
-- akn:chp_3__sec_3_12__ssec_3_12_3/p62 Source (אסמכתא): a Director-General's circular.

§§ `3.12.6 גמול ייעוץ`

@ref akn:chp_3__sec_3_12__ssec_3_12_6/p1
GIVEN `serves as a counsellor` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `entitled to the counselling allowance` `serves as a counsellor` IF `serves as a counsellor`

-- akn:chp_3__sec_3_12__ssec_3_12_6/p2 A pointer: the allowance's terms are section 1.12's, encoded there.

§§ `3.12.7 המסגרת הארגונית`

@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_1
GIVEN l IS A `kind of licence`, d IS A DATE
GIVETH A BOOLEAN
DECIDE `may serve as a counsellor from 1.9.86` l d IF
    d LESS THAN Date 1 9 1986 OR NOT (l EQUALS `no counselling licence`)

@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_2/p1
GIVEN `teaching share of the position` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `teaches at least a third of a position` `teaching share of the position` IF
    `teaching share of the position` AT LEAST 1/3

-- (2), ¶2-¶3: a veteran counsellor — a permanent teacher, over 5 years a
-- counsellor — without a third of a position in teaching is assigned to
-- teaching at once by the owner; if that cannot be done, the owner brings it
-- before the counselling supervisor ("the senior counsellor"), who examines
-- it and recommends to the conditions-of-service department.
@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_2/p2 akn:chp_3__sec_3_12__ssec_3_12_7__para_2/p3
GIVEN `a permanent teacher` IS A BOOLEAN, `years as a counsellor` IS A NUMBER,
      `teaching share of the position` IS A NUMBER, `the owner can assign teaching` IS A BOOLEAN
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `the veteran counsellor's teaching` `a permanent teacher` `years as a counsellor` `teaching share of the position` `the owner can assign teaching` IS
    IF `a permanent teacher` AND `years as a counsellor` GREATER THAN 5 AND `teaching share of the position` LESS THAN 1/3
    THEN IF `the owner can assign teaching`
         THEN PARTY `a takanon party` `the local authority or owning body`
              MUST  `assign the veteran counsellor to teaching`
              WITHIN 0
         ELSE PARTY `a takanon party` `the local authority or owning body`
              MUST  `bring the matter before the counselling supervisor`
              HENCE (PARTY `the senior counsellor`
                     MUST `recommend on continued employment`)
    ELSE FULFILLED

@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_2/p4
`the exceptions and appeals committee` MEANS
    LIST "the head of the conditions-of-service department, chairing", "the head of שפ\"י", "representatives of the professional organisations"

@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_2/p5
`the day 3.12.7(1)-(2) apply from` MEANS Date 1 9 1986

-- (3)-(4): no vested claim to a number of hours or an age layer; the
-- timetable, and the division of work between two middle-school
-- counsellors, set by the principal with the senior counsellor.
@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_3
GIVETH A BOOLEAN
DECIDE `the counsellor has a vested claim to hours or an age layer` IS FALSE

@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_3 akn:chp_3__sec_3_12__ssec_3_12_7__para_4
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `setting the counsellor's timetable` IS
    PARTY `a takanon party` `the school principal` MUST `set the counsellor's timetable`

-- (5): "desirable" — a recommendation, not a duty: a counsellor attached
-- to an age layer for its 3 middle-school years, other arrangements allowed.
@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_5
GIVEN `attached to one age layer for 3 years` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the recommended middle-school arrangement` `attached to one age layer for 3 years` IF
    `attached to one age layer for 3 years`

-- (6): two consecutive hours are desirable; more than 5 standard
-- counselling hours in one school day are forbidden.
@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_6
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `no more than 5 counselling hours a day` IS
    PARTY `a takanon party` `the school principal` SHANT `schedule more than 5 standard counselling hours in one day`

@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_6
GIVEN `counselling hours in the day` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `a lawful counselling day` `counselling hours in the day` IF
    `counselling hours in the day` AT MOST 5

-- (7): presence once a week in the late hours is "proper" (a
-- recommendation); arrangements for receiving parents and pupils in the
-- afternoon "are to be set" (a duty).
@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_7
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `afternoon reception` IS
    PARTY `the counsellor` MUST `set times for receiving parents and pupils in the afternoon`

@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_8
DECLARE `the counsellor's standing` HAS
    `a member of the teaching staff`              IS A BOOLEAN
    `in regular contact with management, teachers and treating bodies` IS A BOOLEAN
    `appears as a professional, not as an authority of the management` IS A BOOLEAN

@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_9
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `the annual plan` IS
    PARTY `the counsellor` MUST `bring the annual plan's main topics to the principal`

@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_10
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `a counselling room` IS
    PARTY `a takanon party` `the school principal` MUST `provide a suitable room`

-- (11): only part of the work is in the timetable; recording,
-- correspondence, outside contacts and preparation are outside it, unless
-- they can only be done in school hours.
@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_11
GIVEN `recording, correspondence, outside contact or preparation` IS A BOOLEAN, `possible only in school hours` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `done within the timetable` `recording, correspondence, outside contact or preparation` `possible only in school hours` IF
    (NOT `recording, correspondence, outside contact or preparation`) OR `possible only in school hours`

@ref akn:chp_3__sec_3_12__ssec_3_12_7__para_12
GIVETH A DEONTIC `3.12 party` `counselling action`
DECIDE `guidance and training` IS
    PARTY `the counsellor` MUST `take part in guidance and training`

-- akn:chp_3__sec_3_12__ssec_3_12_7/p1 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_12__ssec_3_12_7/p2 Source (אסמכתא): a Director-General's circular.
-- akn:chp_3__sec_3_12__ssec_3_12_7/p3 Source (אסמכתא): a special Director-General's circular of 24.6.86.

-- Examples.
#ASSERT `position share of counselling hours in a primary school` `a primary school of grades 1-8` 12 EQUALS (0.3 PLUS 0.16)
#ASSERT `the counselling-teaching split is lawful` (2/3) (1/3)
#ASSERT `the material may be passed on` `a body outside the pupil's school` TRUE
#ASSERT count `the functions of the primary-school counsellor` EQUALS 26
-- A disclosure the counsellor does not judge needed for the pupil's
-- treatment breaches the prohibition.
#TRACE `confidential counselling information` AT 0 WITH
    PARTY `the counsellor` DOES `disclose confidential information` FALSE AT 2

-- F-3.12-a: after the transition (31.8.2004) a candidate with every
-- qualification — a counselling master's, an Israeli teaching certificate —
-- who has not yet worked as a counsellor can get no licence: both the
-- permanent and the temporary licence require work as a counsellor, and
-- no one may work as a counsellor without a licence.
`a fully qualified newcomer` MEANS
    `licence candidate` WITH
        `master's degree in educational counselling, recognised institution` IS TRUE
        `bachelor's degree in educational counselling, recognised institution` IS TRUE
        `an academic degree in counselling, recognised in Israel` IS TRUE
        `teaching certification from Israel (2(b))` IS TRUE
        `permanent teaching licence`                         IS TRUE
        `years employed as a counsellor under שפ"י, to its satisfaction` IS 0
        `employed as a counsellor under שפ"י, to its satisfaction` IS FALSE
        `regular student of a counselling master's, second year, in Israel` IS FALSE
        `regular student of a counselling bachelor's, third year, or a counselling master's, second year` IS FALSE
        `certificate studies in counselling at an institution once approved for them` IS FALSE
        `MA in psychology, social work, behavioural sciences or special education` IS FALSE
        `completed supplementary counselling courses approved by שפ"י` IS FALSE
        `recommended by the senior counsellor`               IS TRUE

`after the transition a newcomer can neither be licensed nor work unlicensed` MEANS
        `the licence that may be granted` `a fully qualified newcomer` (Date 1 9 2005) EQUALS `no counselling licence`
    AND NOT `may serve as a counsellor from 1.9.86` `no counselling licence` (Date 1 9 2005)
#ASSERT `after the transition a newcomer can neither be licensed nor work unlicensed`

-- In the transition the same newcomer could be licensed.
#ASSERT `the licence that may be granted` `a fully qualified newcomer` (Date 1 9 2003) EQUALS `a permanent counselling licence`
