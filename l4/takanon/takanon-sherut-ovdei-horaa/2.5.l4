-- תקנון שירות עובדי הוראה, פרק 2, §2.5 גננת מאמנת
-- A training (coaching) kindergarten teacher is entitled to the training
-- allowance, whose terms are in section 1.12.

IMPORT prelude
IMPORT common

§ `2.5 גננת מאמנת`

DECLARE `kindergarten post` IS ONE OF
    `training kindergarten teacher`
    `other kindergarten post`

§§ `2.5.6 Training allowance`

@ref akn:chp_2__sec_2_5__ssec_2_5_6/p1
GIVEN p IS A `kindergarten post`
GIVETH A BOOLEAN
DECIDE `entitled to the training allowance under 2.5.6` p IF
    p EQUALS `training kindergarten teacher`

-- The allowance's amount and terms are section 1.12's: a named input until
-- that section is imported.
@ref akn:chp_2__sec_2_5__ssec_2_5_6/p2
@desc The training allowance (גמול אימון) of section 1.12 for the employee's salary, an input until section 1.12 is imported
ASSUME `the training allowance of section 1.12` IS A FUNCTION FROM NUMBER TO NUMBER

#ASSERT `entitled to the training allowance under 2.5.6` `training kindergarten teacher`
#ASSERT NOT `entitled to the training allowance under 2.5.6` `other kindergarten post`
