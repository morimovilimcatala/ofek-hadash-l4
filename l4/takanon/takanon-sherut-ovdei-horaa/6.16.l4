-- תקנון שירות עובדי הוראה, פרק 6, §6.16 מדריך מקצועי
-- The vocational instructor in a post-primary school: the work unit, the
-- duties and prohibitions of the post, pay for theoretical teaching, the
-- yearly clothing, and the terms of accompanying pupils to industry.

IMPORT prelude
IMPORT daydate
IMPORT common

§ `6.16 מדריך מקצועי`

@desc When a duty of the post falls due.
DECLARE `instructor timing` IS ONE OF
    `throughout the year`
    `every week`
    `every term`
    `at the start of the year`
    `at the end of the year`

@desc The school calendar the deadlines are counted in, in days. Its figures are inputs; the takanon does not set them here.
DECLARE `instructor calendar` HAS
    `days in the school year`               IS A NUMBER
    `days in a term`                        IS A NUMBER @desc a שליש
    `days counted as the start of the year` IS A NUMBER

GIVEN c IS A `instructor calendar`, t IS A `instructor timing`
GIVETH A NUMBER
DECIDE `days to perform` c t IS
    CONSIDER t
    WHEN `throughout the year`      THEN c's `days in the school year`
    WHEN `every week`               THEN 7
    WHEN `every term`               THEN c's `days in a term`
    WHEN `at the start of the year` THEN c's `days counted as the start of the year`
    WHEN `at the end of the year`   THEN c's `days in the school year`

DECLARE `instructor action` IS ONE OF
    `perform` HAS `the duty` IS A `instructor duty`
    `do` HAS `the forbidden act` IS A `forbidden act`
    `be ready in the workshop`
    `notify the principal of an absence`
    `assign the instructor's classes and subjects`

@desc The scales a vocational instructor may be paid by.
DECLARE `pay scale` IS ONE OF
    `the certified vocational instructor's grade`
    `the academic teachers' scale`
    `the instructor's own grade`

@desc A vocational instructor's employment, as far as section 6.16.5 asks.
DECLARE `instructor employment` HAS
    `is a certified vocational instructor` IS A BOOLEAN @desc of the grade "מדריך מקצועי מוסמך"
    `is an academic vocational instructor` IS A BOOLEAN
    `teaches theoretical subjects he is certified in, in the middle or upper division` IS A BOOLEAN
    `also instructs vocationally`        IS A BOOLEAN

@desc One year's clothing under section 6.16.6.
DECLARE `instructor clothing` HAS
    `pairs of shoes`            IS A NUMBER
    `pairs of high white shoes` IS A NUMBER
    `coats`                     IS A NUMBER

`no clothing` MEANS `instructor clothing` WITH `pairs of shoes` IS 0, `pairs of high white shoes` IS 0, `coats` IS 0

@desc A person section 6.16.6 may give clothing to.
DECLARE `clothing claimant` HAS
    `is a vocational instructor`              IS A BOOLEAN
    `is a teacher in the track`               IS A BOOLEAN @desc a teacher (not an instructor) in the nursing, dental-technician or dental-assistant track, for section 6.16.6ד
    `trade`                                   IS A `vocational trade`
    `must wear high white shoes in hospitals` IS A BOOLEAN
    `is a woman`                              IS A BOOLEAN @desc 6.16.6ד.1 gives the shoes to "מורות" (women teachers)

DECLARE `laundry payer` IS ONE OF `the institution`, `the instructor`

§§ `6.16.1 יחידת עבודה`

@ref akn:chp_6__sec_6_16__ssec_6_16_1__para_1
GIVEN `teaches in a post-primary school` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `vocational instructor's work unit in weekly hours` `teaches in a post-primary school` IS
    IF `teaches in a post-primary school` THEN 24 ELSE 0

-- akn:chp_6__sec_6_16__ssec_6_16_1/p1 akn:chp_6__sec_6_16__ssec_6_16_1/p2 The sources (אסמכתא) of section 6.16.1.

§§ `6.16.3 הגדרת תפקידים`

@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_1
GIVEN `holds an instruction licence from the Ministry` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `may be employed in instruction duties in a vocational school` `holds an instruction licence from the Ministry` IF
    `holds an instruction licence from the Ministry`

@desc The instructor's duties, one or more per paragraph of section 6.16.3.
@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_2
DECLARE `instructor duty` IS ONE OF
    `imparting the trade and good work habits, by planned means and personal example`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_4
    `instructing each subject by the general or an approved special curriculum`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_5__subpara_a
    `submitting the term work plan and lesson plans for the principal's approval`
    `planning each lesson to the subject's didactic demands`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_5__subpara_b
    `explaining the instruction and educating for safety and care of materials and tools`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_6
    `submitting a detailed written report on carrying out the curriculum`
    `reporting faults in carrying out the work plan as they occur`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_7
    `keeping a work diary and the class register, and seeing pupils keep their workbooks`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_8__subpara_a
    `giving the principal the grades in writing and assessments on request`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_8__subpara_b
    `keeping records of achievement and the required registers`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_10
    `doing the utmost to take part in the pupils' promotion examinations`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_11
    `attending the pedagogical council and any meeting the principal calls`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_12
    `taking the supervision duties the principal sets`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_13
    `substituting for missing teachers or instructors when the principal asks`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_14__subpara_a
    `receiving parents and pupils one hour a week outside working hours`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_14__subpara_b
    `setting times to receive parents and pupils as needed`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_16
    `starting and ending the workshop lesson with the bell`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_17
    `keeping the equipment, furniture, tools and materials whole and making running repairs`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_18
    `ensuring safety means and conditions and that pupils keep the safety rules`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_19
    `making the preparations for arrangements and summaries`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_25
    `taking part in in-service training in free time`

-- Which duties bind which instructor: §6.16.3(14) splits on whether the
-- instructor is a class educator.
@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_14__subpara_a akn:chp_6__sec_6_16__ssec_6_16_3__para_14__subpara_b
GIVEN d IS A `instructor duty`, `is a class educator` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `binds the instructor` d `is a class educator` IF
    CONSIDER d
    WHEN `receiving parents and pupils one hour a week outside working hours` THEN `is a class educator`
    WHEN `setting times to receive parents and pupils as needed` THEN NOT `is a class educator`
    OTHERWISE TRUE

-- When each duty falls due: "בראשית שנת הלימודים" (5א), "בתום כל שליש"
-- (6), "שעה אחת בשבוע" (14א); the rest throughout the year.
@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_5__subpara_a akn:chp_6__sec_6_16__ssec_6_16_3__para_6
GIVEN d IS A `instructor duty`
GIVETH A `instructor timing`
DECIDE `timing of` d IS
    CONSIDER d
    WHEN `submitting the term work plan and lesson plans for the principal's approval` THEN `at the start of the year`
    WHEN `submitting a detailed written report on carrying out the curriculum` THEN `every term`
    WHEN `receiving parents and pupils one hour a week outside working hours` THEN `every week`
    OTHERWISE `throughout the year`

@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_2
GIVEN d IS A `instructor duty`, c IS A `instructor calendar`, `is a class educator` IS A BOOLEAN
GIVETH A DEONTIC Party `instructor action`
DECIDE `the instructor's duty` d c `is a class educator` IS
    IF `binds the instructor` d `is a class educator`
    THEN PARTY `the teaching employee`
         MUST  `perform` done PROVIDED done EQUALS d
         WITHIN `days to perform` c (`timing of` d)
         LEST  BREACH BY `the teaching employee` BECAUSE "section 6.16.3: a duty of the vocational instructor was not performed in its time"
    ELSE FULFILLED

@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_3
GIVETH A DEONTIC Party `instructor action`
DECIDE `arranging the instructor's work` IS
    PARTY `the school principal`
    MAY   `assign the instructor's classes and subjects`

-- §6.16.3(13), second sentence: an instructor freed by pupils' trip or work
-- camp stays at school for those hours and substitutes without pay.
@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_13
GIVEN `freed because the pupils are away` IS A BOOLEAN, `pay for a substitution hour` IS A NUMBER
GIVETH A NUMBER
DECIDE `pay for substituting` `freed because the pupils are away` `pay for a substitution hour` IS
    IF `freed because the pupils are away` THEN 0 ELSE `pay for a substitution hour`

@desc What the instructor must not do (section 6.16.3).
DECLARE `forbidden act` IS ONE OF
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_9
    `lowering a grade to punish a pupil`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_20
    `telling a non-member about the pedagogical council's deliberations without the principal's consent`
    `giving a certificate or document on the school's behalf without the principal's consent`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_21
    `giving details about pupils to anyone but the principal, the class educator, parents or guardians`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_22
    `inviting outside guests to the school or class without the principal's approval`
    @ref akn:chp_6__sec_6_16__ssec_6_16_3__para_24
    `any corporal punishment`

@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_9 akn:chp_6__sec_6_16__ssec_6_16_3__para_20 akn:chp_6__sec_6_16__ssec_6_16_3__para_21 akn:chp_6__sec_6_16__ssec_6_16_3__para_22 akn:chp_6__sec_6_16__ssec_6_16_3__para_24
GIVEN f IS A `forbidden act`
GIVETH A DEONTIC Party `instructor action`
DECIDE `the instructor's prohibition` f IS
    PARTY `the teaching employee`
    SHANT `do` act PROVIDED act EQUALS f
    LEST  BREACH BY `the teaching employee` BECAUSE "section 6.16.3: a prohibited act"

-- §6.16.3(24), second half: a pupil removed for a grave breach of
-- discipline is referred to the class educator or the school management.
@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_24
`whom a removed pupil is referred to` MEANS LIST "the class educator", "the school management"

-- §6.16.3(15): in the workshop, ready, at least 5 minutes before the bell.
-- Time in minutes from when the instructor's day starts.
@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_15
GIVEN `minutes until the bell` IS A NUMBER
GIVETH A DEONTIC Party `instructor action`
DECIDE `ready before the bell` `minutes until the bell` IS
    PARTY `the teaching employee`
    MUST  `be ready in the workshop`
    WITHIN `minutes until the bell` MINUS 5
    LEST  BREACH BY `the teaching employee` BECAUSE "section 6.16.3(15): in the workshop at least 5 minutes before the bell"

-- §6.16.3(23): an absence is reported as soon as possible and at the latest
-- on the morning of its first day, before lessons start. Time in hours from
-- when the instructor knows of it.
@ref akn:chp_6__sec_6_16__ssec_6_16_3__para_23
GIVEN `hours until lessons start on the first day of absence` IS A NUMBER
GIVETH A DEONTIC Party `instructor action`
DECIDE `reporting an absence` `hours until lessons start on the first day of absence` IS
    PARTY `the teaching employee`
    MUST  `notify the principal of an absence`
    WITHIN `hours until lessons start on the first day of absence`
    LEST  BREACH BY `the teaching employee` BECAUSE "section 6.16.3(23): an absence is reported before lessons start on its first day"

-- akn:chp_6__sec_6_16__ssec_6_16_3/p1 akn:chp_6__sec_6_16__ssec_6_16_3/p2 The source (אסמכתא) of section 6.16.3.

§§ `6.16.5 שכר להוראה`

-- §6.16.5.2 runs from the start of 5734 (1.9.1973).
@ref akn:chp_6__sec_6_16__ssec_6_16_5__para_2/p2
GIVEN `the day` IS A DATE
GIVETH A BOOLEAN
DECIDE `the academic arrangement is in force on` `the day` IF
    `the day` AT LEAST Date 1 9 1973

@ref akn:chp_6__sec_6_16__ssec_6_16_5__para_1 akn:chp_6__sec_6_16__ssec_6_16_5__para_2
GIVEN e IS A `instructor employment`, `the day` IS A DATE
GIVETH A `pay scale`
DECIDE `scale for the instructor's work` e `the day` IS
    BRANCH
        IF     e's `is an academic vocational instructor`
           AND e's `also instructs vocationally`
           AND e's `teaches theoretical subjects he is certified in, in the middle or upper division`
           AND `the academic arrangement is in force on` `the day`
        THEN `the academic teachers' scale`
        IF e's `is a certified vocational instructor` AND e's `teaches theoretical subjects he is certified in, in the middle or upper division`
        THEN `the certified vocational instructor's grade`
        OTHERWISE `the instructor's own grade`

-- akn:chp_6__sec_6_16__ssec_6_16_5/p1 akn:chp_6__sec_6_16__ssec_6_16_5/p2 akn:chp_6__sec_6_16__ssec_6_16_5/p3 The sources (אסמכתא) of section 6.16.5.

§§ `6.16.6 קצובת ביגוד`

@desc The trades of section 6.16.6א and ב, one per paragraph, and the tracks of 6.16.6ד.
@ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a/p1
DECLARE `vocational trade` IS ONE OF
    `mechanics`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_2
    `metalwork, piping and structures`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_3
    `motor mechanics`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_4
    `motor electrics`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_5
    `aircraft mechanics`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_6
    `agricultural machinery`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_7
    `marine mechanics`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_8
    `equipment and ground mechanics`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_9
    `electricity`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_10
    `refrigeration and air conditioning`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_11
    `woodworking`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_12
    `cookery`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_13
    `printing`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_14
    `deckhands`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_15
    `building: building site`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_16
    `photography`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_17
    `ceramics`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_1
    `instrumentation and control`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_2
    `electronics`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_3
    `automatic data processing`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_4
    `hospitality and housekeeping`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_5
    `nursery nurses`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_6
    `industrial laboratory technicians`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_7
    `laboratory technicians for schools`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_8
    `literature`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_9
    `applied art`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_10
    `fashion`
    @ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b__subpara_11
    `nursing`
    `dental technicians`
    `dental assistants`
    `another trade`

-- The first trade's own paragraph (א.1) is cited with the list it opens.
@ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a/p1 akn:chp_6__sec_6_16__ssec_6_16_6__para_a__subpara_1
`the shoes-and-two-coats trades` MEANS
    LIST `mechanics`, `metalwork, piping and structures`, `motor mechanics`, `motor electrics`,
         `aircraft mechanics`, `agricultural machinery`, `marine mechanics`,
         `equipment and ground mechanics`, `electricity`, `refrigeration and air conditioning`,
         `woodworking`, `cookery`, `printing`, `deckhands`, `building: building site`,
         `photography`, `ceramics`

@ref akn:chp_6__sec_6_16__ssec_6_16_6__para_b/p1
`the two-coats trades` MEANS
    LIST `instrumentation and control`, `electronics`, `automatic data processing`,
         `hospitality and housekeeping`, `nursery nurses`, `industrial laboratory technicians`,
         `laboratory technicians for schools`, `literature`, `applied art`, `fashion`, `nursing`

@ref akn:chp_6__sec_6_16__ssec_6_16_6__para_a/p1 akn:chp_6__sec_6_16__ssec_6_16_6__para_b/p1
GIVEN c IS A `clothing claimant`
GIVETH A `instructor clothing`
DECIDE `an instructor's clothing` c IS
    BRANCH
        IF c's `is a vocational instructor` AND elem (c's `trade`) `the shoes-and-two-coats trades`
        THEN `instructor clothing` WITH `pairs of shoes` IS 1, `pairs of high white shoes` IS 0, `coats` IS 2
        IF c's `is a vocational instructor` AND elem (c's `trade`) `the two-coats trades`
        THEN `instructor clothing` WITH `pairs of shoes` IS 0, `pairs of high white shoes` IS 0, `coats` IS 2
        OTHERWISE `no clothing`

@ref akn:chp_6__sec_6_16__ssec_6_16_6__para_c
`who pays for laundering the coats` MEANS `the institution`

-- §6.16.6ד, with its start date 1.9.1982.
@ref akn:chp_6__sec_6_16__ssec_6_16_6__para_d__subpara_1 akn:chp_6__sec_6_16__ssec_6_16_6__para_d__subpara_2 akn:chp_6__sec_6_16__ssec_6_16_6__para_d__subpara_2/p2
GIVEN c IS A `clothing claimant`, `the year begins on` IS A DATE
GIVETH A `instructor clothing`
DECIDE `a track teacher's clothing` c `the year begins on` IS
    BRANCH
        IF NOT (c's `is a teacher in the track` AND `the year begins on` AT LEAST Date 1 9 1982)
        THEN `no clothing`
        IF c's `trade` EQUALS `nursing` AND c's `is a woman` AND c's `must wear high white shoes in hospitals`
        THEN `instructor clothing` WITH `pairs of shoes` IS 0, `pairs of high white shoes` IS 1, `coats` IS 0
        IF c's `trade` EQUALS `dental technicians` OR c's `trade` EQUALS `dental assistants`
        THEN `instructor clothing` WITH `pairs of shoes` IS 0, `pairs of high white shoes` IS 0, `coats` IS 2
        OTHERWISE `no clothing`

-- akn:chp_6__sec_6_16__ssec_6_16_6/p1 akn:chp_6__sec_6_16__ssec_6_16_6/p2 akn:chp_6__sec_6_16__ssec_6_16_6/p3 akn:chp_6__sec_6_16__ssec_6_16_6/p4 The sources (אסמכתא) of section 6.16.6.

§§ `6.16.7 ליווי תלמידים לתעשייה`

@desc An arrangement for accompanying pupils to work in industry.
@ref akn:chp_6__sec_6_16__ssec_6_16_7/p1
DECLARE `industry escort` HAS
    `escort is an instructor of the pupils' own trade`       IS A BOOLEAN
    `school workshops are kept free for the pupils' return`  IS A BOOLEAN
    `work groups kept as they are, flexibly`                 IS A BOOLEAN
    `escorting rotates among the instructors`                IS A BOOLEAN

@ref akn:chp_6__sec_6_16__ssec_6_16_7__para_1 akn:chp_6__sec_6_16__ssec_6_16_7__para_2 akn:chp_6__sec_6_16__ssec_6_16_7__para_4 akn:chp_6__sec_6_16__ssec_6_16_7__para_5
GIVEN e IS A `industry escort`
GIVETH A BOOLEAN
DECIDE `the escort meets the conditions` e IF
        e's `escort is an instructor of the pupils' own trade`
    AND e's `school workshops are kept free for the pupils' return`
    AND e's `work groups kept as they are, flexibly`
    AND e's `escorting rotates among the instructors`

@ref akn:chp_6__sec_6_16__ssec_6_16_7__para_3
GIVEN `hours in industry` IS A NUMBER
GIVETH A NUMBER
DECIDE `workshop hours counted` `hours in industry` IS
    `hours in industry`

-- Examples. The calendar's figures and the substitution rate are placeholders.
`a placeholder calendar` MEANS
    `instructor calendar` WITH
        `days in the school year`               IS 300
        `days in a term`                        IS 100
        `days counted as the start of the year` IS 30

`a motor mechanics instructor` MEANS
    `clothing claimant` WITH
        `is a vocational instructor`              IS TRUE
        `is a teacher in the track`               IS FALSE
        `trade`                                   IS `motor mechanics`
        `must wear high white shoes in hospitals` IS FALSE
        `is a woman`                              IS FALSE

`an academic instructor who also teaches theory` MEANS
    `instructor employment` WITH
        `is a certified vocational instructor` IS FALSE
        `is an academic vocational instructor` IS TRUE
        `teaches theoretical subjects he is certified in, in the middle or upper division` IS TRUE
        `also instructs vocationally`          IS TRUE

#ASSERT `an instructor's clothing` `a motor mechanics instructor` EQUALS `instructor clothing` WITH `pairs of shoes` IS 1, `pairs of high white shoes` IS 0, `coats` IS 2
#ASSERT `scale for the instructor's work` `an academic instructor who also teaches theory` (Date 1 9 1990) EQUALS `the academic teachers' scale`
#ASSERT `pay for substituting` TRUE 50 EQUALS 0

-- The term report handed in within the term: fulfilled. Corporal
-- punishment: the prohibition is breached. Ready 6 minutes before a bell
-- 30 minutes away: fulfilled; 2 minutes after the bell: breached.
#TRACE `the instructor's duty` `submitting a detailed written report on carrying out the curriculum` `a placeholder calendar` FALSE AT 0 WITH
    PARTY `the teaching employee` DOES `perform` `submitting a detailed written report on carrying out the curriculum` AT 90
