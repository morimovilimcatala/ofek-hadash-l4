-- תקנון שירות עובדי הוראה, פרק 3, §3.18 ביגוד
-- The clothing supplement of crafts-and-technology, art and home-economics
-- teachers in grades 7-8 of a primary school.

IMPORT prelude
IMPORT common

§ `3.18 ביגוד`

@desc The subjects section 3.18 names.
DECLARE `subject of section 3.18` IS ONE OF
    `crafts and technology`
    `art`
    `home economics`
    `another subject`

@desc A teacher as far as section 3.18 asks about them.
DECLARE `grade 7-8 teacher` HAS
    `subject taught`                         IS A `subject of section 3.18`
    `teaches grades 7-8 in a primary school` IS A BOOLEAN
    `the middle-school supplement for the subject` IS A NUMBER @desc the clothing supplement paid to middle-school teachers of the same subject under section 5.11.6; an input, set there and by the amounts the Treasury publishes

GIVEN s IS A `subject of section 3.18`
GIVETH A BOOLEAN
DECIDE `a subject section 3.18 names` s IF
    CONSIDER s
    WHEN `another subject` THEN FALSE
    OTHERWISE TRUE

-- F-3.18-a: section 5.11.6, which this clause equates to, grants clothing to
-- the TECHNOLOGICAL-subject teachers of the middle school and names neither
-- art nor home economics. The reading adopted: the supplement is the one
-- section 5.11.6 pays, as section 3.18 itself asserts that middle-school
-- teachers of these subjects are paid one; its amount is an input.
@ref akn:chp_3__sec_3_18__hc_2/p1 akn:chp_3__sec_3_18__hc_2/p2
GIVEN t IS A `grade 7-8 teacher`
GIVETH A NUMBER
DECIDE `clothing supplement in grades 7-8 of a primary school` t IS
    IF `a subject section 3.18 names` (t's `subject taught`) AND t's `teaches grades 7-8 in a primary school`
    THEN t's `the middle-school supplement for the subject`
    ELSE 0

-- F-3.18-a evidence: section 5.11.6 names "the technological teachers" and
-- workshop instructors; of the three subjects section 3.18 equates to the
-- middle school, only crafts and technology is named there in its own words.

GIVEN s IS A `subject of section 3.18`
GIVETH A BOOLEAN
DECIDE `section 5.11.6 names the subject in its own words` s IF
    CONSIDER s
    WHEN `crafts and technology` THEN TRUE
    OTHERWISE FALSE

`section 5.11.6 names neither art nor home economics` MEANS
        (NOT `section 5.11.6 names the subject in its own words` `art`)
    AND (NOT `section 5.11.6 names the subject in its own words` `home economics`)
#ASSERT `section 5.11.6 names neither art nor home economics`

-- akn:chp_3__sec_3_18__hc_3/p1 Source (אסמכתא): the collective agreement of 11.5.93.

-- Example with a placeholder figure: 500 stands for whatever section 5.11.6 pays.
`an art teacher in grade 8` MEANS
    `grade 7-8 teacher` WITH
        `subject taught`                         IS `art`
        `teaches grades 7-8 in a primary school` IS TRUE
        `the middle-school supplement for the subject` IS 500
#ASSERT `clothing supplement in grades 7-8 of a primary school` `an art teacher in grade 8` EQUALS 500

§§ `Property checks`

-- The rule over its whole finite space: every subject, grades 7-8 of a
-- primary school or not, and a middle-school supplement of 0 or 500 (a
-- placeholder).

`both booleans` MEANS LIST TRUE, FALSE
`every subject of section 3.18` MEANS LIST `crafts and technology`, `art`, `home economics`, `another subject`

GIVEN s IS A `subject of section 3.18`, g IS A BOOLEAN, m IS A NUMBER
GIVETH A NUMBER
DECIDE `the supplement checked` s g m IS
    `clothing supplement in grades 7-8 of a primary school`
        (`grade 7-8 teacher` WITH
            `subject taught`                         IS s
            `teaches grades 7-8 in a primary school` IS g
            `the middle-school supplement for the subject` IS m)

-- The supplement is the middle school's exactly for a subject the section
-- names, taught in grades 7-8 of a primary school, and nothing otherwise.
#ASSERT all (GIVEN s YIELD
                all (GIVEN g YIELD
                        all (GIVEN m YIELD
                                `the supplement checked` s g m
                                EQUALS (IF `a subject section 3.18 names` s AND g THEN m ELSE 0))
                            (LIST 0, 500))
                    `both booleans`)
            `every subject of section 3.18`

-- F-3.18-a over every subject: of those section 3.18 pays for, exactly two
-- are not named by section 5.11.6 in its own words.
`subjects section 3.18 pays for that section 5.11.6 does not name` MEANS
    filter (GIVEN s YIELD `a subject section 3.18 names` s AND NOT `section 5.11.6 names the subject in its own words` s)
           `every subject of section 3.18`
#ASSERT count `subjects section 3.18 pays for that section 5.11.6 does not name` EQUALS 2
