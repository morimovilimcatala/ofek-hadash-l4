        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p33 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p34
        `seniority item` "16" "compulsory service of a woman soldier serving the full term as soldier-teacher, guiding teacher or nature guide; from 1.9.23 also the listed Education Corps posts" `in force` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p35
        `seniority item` "17" "teaching in national service in a school the supervision approved, on the principal's confirmation, counted as item 16" `in force` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p36 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p37
