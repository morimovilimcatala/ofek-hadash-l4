        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p38
        `seniority item` "19" "work in one's academic profession by a degree holder teaching that subject, for the years after the degree; half without a degree in the profession" `in force` TRUE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p39 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p40 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p41
        `seniority item` "20" "teacher instruction (appointed by the Ministry to an instruction post) or supervision (appointed supervisor), 6 full months in a school year at a third of a position" `in force` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p42
        `seniority item` "21" "an administrative-educational post held as a certified teacher or with a permanent licence; half without teaching certification" `in force` TRUE,
