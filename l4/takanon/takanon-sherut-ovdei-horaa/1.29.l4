    @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_1__para_a__subpara_17
    `uncertified professional instructor`

-- akn:chp_1ב__sec_1_29__ssec_1_29_2_1/p1 The heading "אסמכתא".
-- akn:chp_1ב__sec_1_29__ssec_1_29_2_1/p2 Source (אסמכתא).

§§ `1.29.2.2–1.29.2.7 Who is entitled to each grade`

@desc A teaching employee's file, as far as the grade routes of 1.29.2 ask about it.
DECLARE `grading file` HAS
    `clauses found met`                       IS A LIST OF STRING @desc the clauses below (e.g. "ב(1)", "י(29)(א)") whose stated facts the grading authority has found true of the employee; a clause's facts are recorded, not computed, where the text gives no arithmetic
    `recognised seniority in teaching`        IS A NUMBER  @desc years of recognised teaching seniority (section 1.29.3)
    `years in the certificated post at sea`   IS A NUMBER  @desc years served in the post the sea certificate is for, after receiving it
    `years commanding a ship or instructing in the Navy` IS A NUMBER @desc for (י)(29)(ו): years a Navy major served as a ship's commander or in instruction in the Navy
    `years of professional work at sea or in sea instruction` IS A NUMBER @desc for (יז)(10)(ח)
    `Hebrew University points`                IS A NUMBER  @desc points earned at the Hebrew University under (ד)(13): main-subject exam 2, secondary-subject exam 1, approved thesis 1
    `years as a general teacher`              IS A NUMBER  @desc years worked as a general (כולל) teacher in an elementary school, for (י)(6)
    `registered nurse`                        IS A BOOLEAN
    `permanent teaching licence`              IS A BOOLEAN
    `teaches nursing`                         IS A BOOLEAN
    `Israeli matriculation or pre-academic preparatory` IS A BOOLEAN
    `a professional instructor`               IS A BOOLEAN @desc employed as a professional instructor rather than a teacher or kindergarten teacher

DECLARE `grade route` HAS
    `route grade`   IS A `salary grade`
    `route clause`  IS A STRING @desc the clause as the takanon letters it
    `route summary` IS A STRING
    `route reach`   IS A STRING @desc where the text limits the grade ("for adult teaching only", "as a minimum grade" and the like); empty where it does not
    `route test`    IS A FUNCTION FROM `grading file` TO BOOLEAN

GIVEN f IS A `grading file`, c IS A STRING
GIVETH A BOOLEAN
DECIDE `found met` f c IF
    elem c (f's `clauses found met`)

-- A route whose facts the grading authority records.
GIVEN g IS A `salary grade`, c IS A STRING, s IS A STRING, r IS A STRING
GIVETH A `grade route`
DECIDE `route` g c s r IS
    `grade route` g c s r (GIVEN file YIELD `found met` file c)

GIVEN r IS A `grade route`, file IS A `grading file`
GIVETH A BOOLEAN
DECIDE `the route is met` r file IF
    LET t MEANS r's `route test` IN t file
`routes to the doctorate grade` MEANS
    LIST
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p1 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p2
        `route` `academic grade, doctorate` "ב(1)" "a third academic degree from a recognised institution of higher education in Israel" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p3
        `route` `academic grade, doctorate` "ב(2)" "a third academic degree from a recognised institution abroad, after the Ministry recognised it" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p4
        `route` `academic grade, doctorate` "ב(3)" "a degree the committee for evaluating foreign degrees and diplomas decided is equivalent to a doctorate" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p5
        `route` `academic grade, doctorate` "ב(4)" "entitled to an equivalent grade, as the committee for equivalent grades determined (section 1.29.6)" ""

§§ `1.29.2.2ג`

`routes to the MA grade` MEANS
    LIST
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p6 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p7
        `route` `academic grade, MA` "ג(1)" "a second academic degree from a recognised institution in Israel, a Technion \"Magister\" included" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p8
        `route` `academic grade, MA` "ג(2)" "a second academic degree from a recognised institution abroad, after the Ministry recognised it" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p9
        `route` `academic grade, MA` "ג(3)" "a degree the committee for evaluating degrees and diplomas recognised as equivalent to a second degree" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p10
        `route` `academic grade, MA` "ג(4)" "admitted as a direct-track research student towards a doctorate without an MA at one of the five named universities, met their special conditions and grades, and proved two years of such studies" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p11
        `route` `academic grade, MA` "ג(5)" "the \"Oman\" degree in music from Tel Aviv University or the Jerusalem Academy of Music" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p12
        `route` `academic grade, MA` "ג(6)" "entitled to an equivalent grade, as the committee for equivalent grades determined (section 1.29.6)" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p13 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p14
        `route` `academic grade, MA` "ג(6) note" "recognised for an equivalent grade in the teacher-training system and now teaching in a secondary school (middle school included) or as an instructor, in the same subject the grade was given for; owners' approval by the grading and certification department; from 1.9.91" "only while employed in the subject the equivalent grade was given for",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p15 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p16
        `route` `academic grade, MA` "ג(7)(א)" "a sea-studies teacher holding a recognised certificate under the Shipping (Seamen) Law, 1973 as senior master" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p17
        `grade route` `academic grade, MA` "ג(7)(ב)" "a sea-studies teacher certificated as master, after 3 years commanding a ship since the certificate" ""
            (GIVEN file YIELD `found met` file "ג(7)(ב)" AND file's `years in the certificated post at sea` AT LEAST 3),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p18
        `route` `academic grade, MA` "ג(7)(ג)" "a sea-studies teacher certificated as senior chief engineer" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p19
        `grade route` `academic grade, MA` "ג(7)(ד)" "a sea-studies teacher certificated as chief engineer, after 3 years in that post on a ship since the certificate" ""
            (GIVEN file YIELD `found met` file "ג(7)(ד)" AND file's `years in the certificated post at sea` AT LEAST 3),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p20 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p21 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p22
        `grade route` `academic grade, MA` "ג(8)" "a sea-studies teacher who was an IDF officer of lieutenant-colonel rank at least, and served in the Navy as a ship's commander or in instruction" ""
            (GIVEN file YIELD `found met` file "ג(8)(א)" AND `found met` file "ג(8)(ב)")

§§ `1.29.2.2ד`

`routes to the BA grade` MEANS
    LIST
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p23 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p24
        `route` `academic grade, BA` "ד(1)" "a first academic degree from a recognised institution in Israel, a B.Ed. from a recognised teacher-training institution and the Technion's \"engineer\" degree included" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p25
        `route` `academic grade, BA` "ד(2)" "a first academic degree from a recognised institution abroad, after the Ministry recognised it" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p26
        `route` `academic grade, BA` "ד(3)" "a music \"graduation certificate\" from Tel Aviv University or the Jerusalem Academy of Music" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p27
        `route` `academic grade, BA` "ד(4)" "a degree the committee for evaluating foreign degrees recognised as equivalent to a first degree" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p28
        `route` `academic grade, BA` "ד(5)" "entitled to an equivalent grade, as the committee for equivalent grades determined (section 1.29.6)" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p29 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p30
        `route` `academic grade, BA` "ד(5) note" "recognised for an equivalent grade in the teacher-training system and teaching in a secondary school or as an instructor in the same subject; owners' approval by the grading and certification department; from 1.9.91" "only while employed in the subject the equivalent grade was given for",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p31
        `route` `academic grade, BA` "ד(6)" "a Bezalel graduate from before its recognition as an institution of higher education, with matriculation and an \"artist\" or \"designer\" diploma, employed in the field of the specialisation" "only while employed in the field studied at Bezalel",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p32
        `route` `academic grade, BA` "ד(7)" "a graduate of the Rubin Academy in Jerusalem or the Tel Aviv music academy from before their recognition, with matriculation" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p33
        `route` `academic grade, BA` "ד(8)" "examined by the Council of Accountants and licensed as a certified public accountant" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p34
        `route` `academic grade, BA` "ד(9)" "a coordinator of instruction in an approved teacher-training institution" "a minimum grade, for the hours of instruction",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p35 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p36
        `route` `academic grade, BA` "ד(10)(א)" "a sea-studies teacher certificated as master who is not entitled to the MA grade under ג(7)" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p37
        `route` `academic grade, BA` "ד(10)(ב)" "a sea-studies teacher certificated as chief engineer who is not entitled to the MA grade under ג(7)" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p38
        `route` `academic grade, BA` "ד(11)" "a teacher of music, art, crafts or physical education without a degree who began in a secondary institution by the start of 5708 and has worked continuously in secondary schools at half a position or more every year, breaks of up to two years in all not counting" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p39
        `route` `academic grade, BA` "ד(12)" "entitled under ד(11), also for work in institutions that are not secondary" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p40 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p41 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p42 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p43
        `grade route` `academic grade, BA` "ד(13)" "at least 3 years' study at the Hebrew University when the BA was not yet awarded (or in a department without it, or admitted to second-degree study without a first), with exams or work worth 3 points" ""
            (GIVEN file YIELD `found met` file "ד(13)" AND file's `Hebrew University points` AT LEAST 3),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p44
        `grade route` `academic grade, BA` "ד(14)" "a graduate of an approved or recognised teacher-training institution with at least 2 years at the Hebrew University before the BA existed, and 3 points under ד(13)" ""
            (GIVEN file YIELD `found met` file "ד(14)" AND file's `Hebrew University points` AT LEAST 3),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p45
        `route` `academic grade, BA` "ד(15)" "matriculation, and studies completed with a diploma at the \"Beit Zvi\" stage school or Nissan Nativ's studio" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p46
        `route` `academic grade, BA` "ד(16)" "completed 3 years on the direct track to a second degree at a recognised institution" ""

§§ `1.29.2.2ה–ח`

`routes to the intermediate grades and supplement` MEANS
    LIST
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p47 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p48
        `route` `intermediate academic grade C` "ה" "in secondary institutions in Israel, began in one by the start of 5712 already certified and with 3 years of higher education but no degree, and employed continuously since in secondary institutions at half a position or more" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p49 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p50
        `route` `intermediate academic grade B` "ו" "in secondary institutions in Israel, began in one by the start of 5712 already certified and with 2 years of higher education, and employed continuously since in secondary institutions at half a position or more" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p51 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p52
        `route` `intermediate academic grade A` "ז" "in secondary institutions in Israel, began in one by the start of 5712 already certified and with one year of higher education, and employed since in secondary institutions at half a position or more" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p53 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p54
        `grade route` `academic intermediate supplement` "ח(1)" "entitled to a permanent secondary-school teaching licence, other than one given for seniority or for a two-year seminary, the licence not limited to one kind of institution (for a limited one, the note below)" ""
            (GIVEN file YIELD `found met` file "ח(1)" AND (NOT `found met` file "ח(1) note: licence limited to one kind of institution")),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p55 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p56
        `grade route` `academic intermediate supplement` "ח(1) note" "as ח(1), the permanent licence limited to one kind of institution: entitled only if working in that kind of institution" "only while working in the kind of institution the licence is limited to"
            (GIVEN file YIELD `found met` file "ח(1)" AND `found met` file "ח(1) note: licence limited to one kind of institution" AND `found met` file "ח(1) note: works in that kind of institution"),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p57
        `route` `academic intermediate supplement` "ח(2)" "a certified professional instructor whose inter-ministerial certificate also certifies him to teach" ""

§§ `1.29.2.3ט`

`routes to the senior certified teacher grade` MEANS
    LIST
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p1 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p2
        `route` `senior certified teacher` "ט(1)" "a graduate of a three-year teacher-training institution (or its third class, or the teachers' union's central school) holding a senior certified teacher's certificate, a certificate for middle and secondary school, or the institution's confirmation of entitlement to one" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p3
        `route` `senior certified teacher` "ט(2)" "as ט(1), having sat all exams and met all duties of the third year, with confirmation, results not yet in" "only in the first year after finishing the third year",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p4
        `route` `senior certified teacher` "ט(3)" "a certified teacher who graduated the yearly principals' course of the school for senior teaching staff with its certificate" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p5
        `route` `senior certified teacher` "ט(3)א" "a certified teacher who graduated the academic principals' training course of the senior-staff training unit" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p6
        `route` `senior certified teacher` "ט(4)" "a two-year teacher-training graduate with a teaching certificate who completed the yearly remedial-pedagogy course at the Gordon seminary in Haifa with its certificate" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p7
        `route` `senior certified teacher` "ט(5)" "completed the course certifying for middle-school teaching" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p8
        `route` `senior certified teacher` "ט(6)" "a practical engineer's (הנדסאי) diploma and a teaching certificate for technological subjects in middle or upper secondary school" "for hours as a classroom teacher, not hours of instruction",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p9
        `route` `senior certified teacher` "ט(7)" "a third-year graduate of the Wingate physical-education seminary, a special third year included" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p10
        `route` `senior certified teacher` "ט(8)" "a teacher certified abroad by a recognised three-year teacher-training institution, with matriculation or a high-school completion certificate, the pedagogical studies after high school" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p11
        `route` `senior certified teacher` "ט(8)א" "a senior certified teacher's certificate from a recognised Hebrew teacher-training institution abroad" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p12
        `route` `senior certified teacher` "ט(9)" "a graduate of Tel Aviv University's diploma course for senior youth workers, with matriculation and an instructors' institute certificate, and 5 years in supplementary education" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p13
        `route` `senior certified teacher` "ט(10)" "a kindergarten teacher with the title of senior kindergarten teacher and matriculation" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p14
        `grade route` `senior certified teacher` "ט(11)" "a nursing teacher who is a registered nurse and holds a permanent teaching licence" ""
            (GIVEN file YIELD file's `registered nurse` AND file's `permanent teaching licence` AND file's `teaches nursing`),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p15 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p16
        `route` `senior certified teacher` "ט(12)" "completed all duties in a second department towards a BA with a secondary-school teaching certificate at an institution of higher education" "on confirmations issued until September 1996, when institutions stopped issuing them",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p17
        `route` `senior certified teacher` "ט(13)" "matriculation and a past diploma from the \"Peto\" institute, without teaching certification" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p18 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p19
        `route` `senior certified teacher` "ט(14)" "in the fourth year at a college and interning alongside, on the college's confirmation that the third year's tasks are done" "an intern who interns after finishing is paid by the degree he holds"

§§ `1.29.2.4י`

`routes to the certified teacher grade` MEANS
    LIST
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p1 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p3 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p4
        `route` `certified teacher` "י(2)" "a graduate of Bezalel, the Rubin Academy or the Tel Aviv music academy without matriculation" "the teacher's certificate itself only after completing the reserve exams",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p5
        `route` `certified teacher` "י(3)" "a graduate of an approved two-year teacher-training institution, teachers' track" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p6
        `route` `certified teacher` "י(4)" "a graduate of an approved teacher-training institution, teacher-kindergarten track" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p7
        `route` `certified teacher` "י(5)" "a third-year student at an approved institution, sent to teach by the teaching-manpower division, with confirmation that all first- and second-year duties are met" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p8 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p9 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p10 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p11
        `grade route` `certified teacher` "י(6)" "an elementary teacher graded certified for one subject only, with recognised matriculation or a teachers' seminary diploma; after two years as a general teacher, from the start of the third, whatever the conditions" ""
            (GIVEN file YIELD `found met` file "י(6)" AND (`found met` file "י(6)(א)" OR `found met` file "י(6)(ב)" OR file's `years as a general teacher` AT LEAST 2)),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p12
        `route` `certified teacher` "י(7)" "a graduate of the Rabbi Gold institute for diaspora teachers who completed its second stage (the extra year of training in Israel)" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p13
        `route` `certified teacher` "י(8)" "a certified kindergarten teacher who graduated an approved two-year institution, with matriculation at the start of the studies or later" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p14
        `route` `certified teacher` "י(9)" "a certified kindergarten teacher without matriculation who graduated an approved three-year institution" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p15
        `route` `certified teacher` "י(10)" "a permanent secondary licence given for seniority, or limited to one kind of institution while working in another kind" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p16
        `route` `certified teacher` "י(11)" "a supervisor, an instructor of supervisory grade or a teacher-instructor at any level of supervision" "a minimum grade",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p17
        `route` `certified teacher` "י(12)" "in a secondary institution (middle school included), a Shelah instructor, a youth centre coordinator and the like" "a minimum grade",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p18
        `route` `certified teacher` "י(13)" "a crafts teacher who graduated the government institute of technological training and holds the inter-ministerial instructors' certificate" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p19
        `route` `certified teacher` "י(14)" "passed (or was exempted from) all the reserve exams and in-service training required, and found entitled to a teacher's certificate after a positive evaluation of practical work" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p20
        `route` `certified teacher` "י(15)" "a certified kindergarten teacher moving, at the supervision's suggestion, to a kindergarten-type first grade, undertaking to pass the reserve exams" "only for the first two years of that work",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p21
        `route` `certified teacher` "י(16)" "sat all the seminary's final exams at a two-year institution, results not yet in" "only in the first year after finishing the institution",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p22
        `route` `certified teacher` "י(17)" "a teacher certified abroad (general or subject) after at least two years at a recognised seminary after high school" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p23
        `route` `certified teacher` "י(18)" "a teacher certified abroad with 13 years of schooling" "while employed in general teaching in Israel",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p24
        `route` `certified teacher` "י(19)" "a certified teacher's certificate from a recognised Hebrew teacher-training institution abroad" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p25
        `route` `certified teacher` "י(20)" "a graduate of the National Council's adult-teachers course or of the folk-teachers' seminary, or teaching adults since 5708 for the named bodies and continuing, breaks of up to two years not counting" "for adult teaching only",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p26
        `route` `certified teacher` "י(21)" "a Hebrew-language (Ulpan) teacher who completed all reserve exams and training, on a positive opinion of practical work" "for language teaching and basic adult education only; for elementary schools too on a positive opinion of the elementary supervision",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p27
        `route` `certified teacher` "י(22)" "a graduate of the adult-teachers course at the \"Oranim\" seminary with its certificate" "for adult teaching only",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p28 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p29
        `route` `certified teacher` "י(23)" "teaching since the start of 5708 in an Israeli school under the trends' supervision, or of Agudat Israel or Alliance, and continuing; those paid by local committees, the trends, the institution or a youth society included; breaks of up to two years not counting" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p30 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p31
        `route` `certified teacher` "י(24)" "rabbinical ordination, hired by the end of 5709 as a teacher of sacred studies on a teaching permit, and teaching them continuously since, breaks of up to two years not counting" "for teaching sacred studies only",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p32
        `route` `certified teacher` "י(25)" "a Kibbutz seminary graduate trained for continuation classes, or holding a permanent licence on seniority or exemption" "for elementary-school teaching",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p33
        `route` `certified teacher` "י(26)" "a subject teacher of English, French or Arabic with a teaching certificate from a country of that language requiring 13 or 14 years of schooling" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p34
        `route` `certified teacher` "י(27)" "a graduate of a government vocational seminary abroad" "for teaching the subject certified for abroad",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p35
        `route` `certified teacher` "י(28)" "a graduate of the two-year fashion college in Tel Aviv" "for teaching crafts only",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p36 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p37
        `grade route` `certified teacher` "י(29)(א)" "a sea-studies teacher certificated as first mate, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "י(29)(א)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p38
        `grade route` `certified teacher` "י(29)(ב)" "certificated as first engineer, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "י(29)(ב)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p39
        `grade route` `certified teacher` "י(29)(ג)" "certificated as first skipper, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "י(29)(ג)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p40
        `grade route` `certified teacher` "י(29)(ד)" "certificated as chief radio officer, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "י(29)(ד)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p41
        `grade route` `certified teacher` "י(29)(ה)" "certificated as chief electrical officer, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "י(29)(ה)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p42
        `grade route` `certified teacher` "י(29)(ו)" "a Navy major who commanded a ship or instructed in the Navy for at least two years" ""
            (GIVEN file YIELD `found met` file "י(29)(ו)" AND file's `years commanding a ship or instructing in the Navy` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p43
        `route` `certified teacher` "י(30)" "a sea-studies teacher holding a certified sea instructor's certificate" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p44
        `route` `certified teacher` "י(31)" "a music-teachers' seminary or rhythmic-music teacher with 12 years' schooling who finished the named courses by 5728, or a Dalcroze-method graduate from 5728 on, or a rhythmic-music teacher with matriculation who finished such a course by 5728 and taught rhythmics 7 years" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p45 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p46 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p47 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p48 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p49
        `grade route` `certified teacher` "י(32)" "graded uncertified stage AA, with 15 years' recognised seniority, a positive supervision opinion, lacking one exam in a subject not taught, and having passed the Ministry's exams in Hebrew, history and Bible" ""
            (GIVEN file YIELD `found met` file "י(32)" AND file's `recognised seniority in teaching` AT LEAST 15 AND `found met` file "י(32)(ב)" AND `found met` file "י(32)(ג)" AND `found met` file "י(32)(ד)"),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p50
        `grade route` `certified teacher` "י(33)" "an uncertified teacher with 20 years or more of teaching" ""
            (GIVEN file YIELD `found met` file "י(33)" AND file's `recognised seniority in teaching` AT LEAST 20),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p51
        `grade route` `certified teacher` "י(34)" "a certified kindergarten teacher with 20 years or more, teaching in schools from first grade up" ""
            (GIVEN file YIELD `found met` file "י(34)" AND file's `recognised seniority in teaching` AT LEAST 20),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p52
        `grade route` `certified teacher` "י(35)" "an uncertified professional instructor with 20 years or more of teaching" ""
            (GIVEN file YIELD `found met` file "י(35)" AND file's `recognised seniority in teaching` AT LEAST 20),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p53
        `grade route` `certified teacher` "י(36)" "a nursing teacher who is a registered nurse without a teaching licence" ""
            (GIVEN file YIELD file's `registered nurse` AND (NOT file's `permanent teaching licence`) AND file's `teaches nursing`),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p54
        `route` `certified teacher` "י(37)" "a para-medical worker (speech therapist, occupational therapist and the like) certified in the profession, without pedagogical education" ""

§§ `1.29.2.5יא`

`routes to the certified kindergarten teacher grade` MEANS
    LIST
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_5/p1 akn:chp_1ב__sec_1_29__ssec_1_29_2_5__para_1
        `route` `certified kindergarten teacher` "יא(1)" "a kindergarten teacher certified by an approved and recognised two-year institution" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_5__para_2
        `route` `certified kindergarten teacher` "יא(2)" "a kindergarten teacher who passed (or was exempted from) all reserve exams and training, found entitled to the certificate after a positive evaluation" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_5__para_3
        `route` `certified kindergarten teacher` "יא(3)" "a graduate of the East Jerusalem kindergarten course with matriculation, after the external final exams" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_5__para_4
        `route` `certified kindergarten teacher` "יא(4)" "a track-B seminary graduate who must submit a pedagogical paper after a year of teaching" "in the first year after finishing the seminary",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_5__para_5
        `route` `certified kindergarten teacher` "יא(5)" "an early-childhood track graduate who sat all the final exams, results not yet in" "in the first year after finishing the institution",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_5__para_6
        `route` `certified kindergarten teacher` "יא(6)" "working since the start of 5708 in an Israeli kindergarten under the trends, Agudat Israel or Alliance, and continuing; those paid by local committees or the trends included" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_5__para_7
        `grade route` `certified kindergarten teacher` "יא(7)" "an uncertified kindergarten teacher with 20 years or more, employed in kindergartens; from 5746" ""
            (GIVEN file YIELD `found met` file "יא(7)" AND file's `recognised seniority in teaching` AT LEAST 20),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_5__para_8
        `route` `certified kindergarten teacher` "יא(8)" "a kindergarten teacher certified abroad after at least two years at a recognised seminary after high school" ""

§§ `1.29.2.6יב–טו`

`routes to the uncertified grades` MEANS
    LIST
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p1 akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p2
        `route` `uncertified teacher or kindergarten teacher, stage AA` "יב(1)" "a general teacher or kindergarten teacher owing only one exam not in Hebrew, or owing in-service training, or both" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p3
        `route` `uncertified teacher or kindergarten teacher, stage AA` "יב(2)" "a general teacher or kindergarten teacher who passed all reserve exams with a negative opinion of practical work" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p4
        `route` `uncertified teacher or kindergarten teacher, stage AA` "יב(3)" "a subject teacher owing only one exam (Hebrew included) or training or both, the exam not in the subject taught, with Hebrew rated 3 or more by the general supervisor" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p5
        `route` `uncertified teacher or kindergarten teacher, stage AA` "יב(4)" "hired at 50 or older with one exam left, Hebrew included" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p6
        `route` `uncertified teacher or kindergarten teacher, stage AA` "יב(5)" "a diaspora teacher's certificate without being a teacher-training graduate" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p7 akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p8
        `grade route` `uncertified teacher or kindergarten teacher, stage A+` "יג" "Israeli matriculation or a pre-academic preparatory course, not entitled to a higher grade" ""
            (GIVEN file YIELD file's `Israeli matriculation or pre-academic preparatory`),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p9 akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p10
        `route` `uncertified teacher or kindergarten teacher, stage A` "יד(1)" "passed exams in two Hebrew subjects and one other" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p11
        `route` `uncertified teacher or kindergarten teacher, stage A` "יד(2)" "rabbinical ordination by a recognised authority, the teaching permit approved by the Chief Rabbinate, without the exams of (1)" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p12
        `route` `uncertified teacher or kindergarten teacher, stage A` "יד(3)" "hired at 50 or older, from the second year of teaching, without the exams of (1)" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p13
        `route` `uncertified teacher or kindergarten teacher, stage A` "יד(4)" "a teacher-training graduate still owing matriculation, completion or final exams in Hebrew or in at least 2 other subjects" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p14
        `route` `uncertified teacher or kindergarten teacher, stage A` "יד(5)" "a graduate of the 5710 accelerated kindergarten course with the certificate, without matriculation; owes two reserve exams" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p15
        `route` `uncertified teacher or kindergarten teacher, stage A` "יד(6)" "a subject teacher with eleven grades, training the subject supervisor finds suitable, examined (or exempted) in the subject taught" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p16
        `route` `uncertified teacher or kindergarten teacher, stage A` "יד(7)" "a graduate of the Buenos Aires community seminary with government matriculation" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p17
        `route` `uncertified teacher or kindergarten teacher, stage A` "יד(8)" "a graduate of the Buenos Aires institute's two-year track or of the Moisés Ville seminary, with government matriculation" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p18
        `route` `uncertified teacher or kindergarten teacher, stage A` "יד(9)" "matriculation from a recognised Hebrew high school abroad" ""

§§ `1.29.2.7טז–יח`

`routes to the instructor grades` MEANS
    LIST
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p1 akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p2
        `route` `certified professional instructor` "טז(1)" "the inter-ministerial committee's instructors' certificate" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p3
        `route` `certified professional instructor` "טז(2)" "a professional instructor with a permanent instruction licence" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p4
        `route` `certified professional instructor` "טז(3)" "a nutrition instructor who graduated a three-year nutrition and home-economics seminary with a secondary teaching certificate" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p5
        `grade route` `certified professional instructor` "טז(4)" "a nursing teacher who is a registered nurse with a permanent licence for nursing subjects" ""
            (GIVEN file YIELD file's `registered nurse` AND file's `permanent teaching licence` AND file's `teaches nursing`),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p6
        `route` `certified professional instructor` "טז(5)" "a certified professional instructor (the limit to middle and upper secondary school cancelled)" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p7 akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p8
        `route` `de facto certified professional instructor` "יז(1)" "a certificate of the government instructors' institute" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p9
        `route` `de facto certified professional instructor` "יז(2)" "a certificate of the \"Anières\" institution in Switzerland (ORT)" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p10
        `route` `de facto certified professional instructor` "יז(3)" "a certified teacher of crafts, clerical, technological subjects and the like" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p11
        `route` `de facto certified professional instructor` "יז(4)" "a practical engineer's (הנדסאי) certificate" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p12
        `grade route` `de facto certified professional instructor` "יז(5)" "a nursing teacher who is a registered nurse without a teaching licence" ""
            (GIVEN file YIELD file's `registered nurse` AND (NOT file's `permanent teaching licence`) AND file's `teaches nursing`),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p13
        `route` `de facto certified professional instructor` "יז(6)" "a technician's certificate" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p14
        `route` `de facto certified professional instructor` "יז(7)" "a senior teacher of crafts, clerical, technological subjects and the like" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p15
        `route` `de facto certified professional instructor` "יז(8)" "education abroad equivalent to (6) or (1)" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p16
        `route` `de facto certified professional instructor` "יז(9)" "a sea instructor who met the conditions for certification and has not finished the year of instruction experience" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p17 akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p18
        `grade route` `de facto certified professional instructor` "יז(10)(א)" "a sea instructor certificated as first, second or third mate, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "יז(10)(א)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p19
        `grade route` `de facto certified professional instructor` "יז(10)(ב)" "a sea instructor certificated as first, second or third engineering officer, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "יז(10)(ב)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p20
        `grade route` `de facto certified professional instructor` "יז(10)(ג)" "a sea instructor certificated as skipper, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "יז(10)(ג)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p21
        `grade route` `de facto certified professional instructor` "יז(10)(ד)" "a sea instructor certificated as chief or first radio officer, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "יז(10)(ד)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p22
        `grade route` `de facto certified professional instructor` "יז(10)(ה)" "a sea instructor certificated as chief or first electrical officer, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "יז(10)(ה)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p23
        `grade route` `de facto certified professional instructor` "יז(10)(ו)" "a sea instructor certificated as chief steward, after 2 years in that post at sea" ""
            (GIVEN file YIELD `found met` file "יז(10)(ו)" AND file's `years in the certificated post at sea` AT LEAST 2),
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p24
        `route` `de facto certified professional instructor` "יז(10)(ז)" "a sea instructor who is a Navy major or captain with professional training the supervision finds suitable" "",
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p25
        `grade route` `de facto certified professional instructor` "יז(10)(ח)" "a sea instructor who graduated a sea school of three years or more, with 5 years of professional work at sea or in sea instruction" ""
            (GIVEN file YIELD `found met` file "יז(10)(ח)" AND file's `years of professional work at sea or in sea instruction` AT LEAST 5)

-- akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p2 Item י(1): "this clause is cancelled".

-- akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p58 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p59 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p60 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p61 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p62 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p63 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p64 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p65 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p66 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p67 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p68 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p69 akn:chp_1ב__sec_1_29__ssec_1_29_2_2/p70 Sources (אסמכתא) of 1.29.2.2.
-- akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p20 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p21 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p22 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p23 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p24 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p25 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p26 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p27 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p28 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p29 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p30 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p31 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p32 akn:chp_1ב__sec_1_29__ssec_1_29_2_3/p33 Sources (אסמכתא) of 1.29.2.3.
-- akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p55 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p56 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p57 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p58 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p59 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p60 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p61 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p62 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p63 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p64 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p65 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p66 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p67 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p68 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p69 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p70 akn:chp_1ב__sec_1_29__ssec_1_29_2_4/p71 Sources (אסמכתא) of 1.29.2.4.
-- akn:chp_1ב__sec_1_29__ssec_1_29_2_5/p2 akn:chp_1ב__sec_1_29__ssec_1_29_2_5/p3 akn:chp_1ב__sec_1_29__ssec_1_29_2_5/p4 akn:chp_1ב__sec_1_29__ssec_1_29_2_5/p5 Sources (אסמכתא) of 1.29.2.5.
-- akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p28 akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p29 akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p30 akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p31 akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p32 akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p33 Sources (אסמכתא) of 1.29.2.7.

-- (טו) and (יח) are residual: less education than the grade above needs.
-- They apply where no route above is met.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p19 akn:chp_1ב__sec_1_29__ssec_1_29_2_6/p20 akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p26 akn:chp_1ב__sec_1_29__ssec_1_29_2_7/p27
GIVEN file IS A `grading file`
GIVETH A `salary grade`
DECIDE `the residual grade` file IS
    IF file's `a professional instructor`
    THEN `uncertified professional instructor`
    ELSE `uncertified teacher or kindergarten teacher, stage B`

§§ `1.29.2 Which grade an employee is paid by`

-- The routes of 1.29.2.2–1.29.2.7 together, and the rank the order of
-- 1.29.2.1(א) is read as giving the grades (F-1.29-a).
GIVEN g IS A `salary grade`
GIVETH A NUMBER
DECIDE `rank of` g IS
    CONSIDER g
    WHEN `academic grade, doctorate`                              THEN 1
    WHEN `academic grade, MA`                                     THEN 2
    WHEN `academic grade, BA`                                     THEN 3
    WHEN `intermediate academic grade C`                          THEN 4
    WHEN `intermediate academic grade B`                          THEN 5
    WHEN `intermediate academic grade A`                          THEN 6
    WHEN `academic intermediate supplement`                       THEN 7
    WHEN `senior certified teacher`                               THEN 8
    WHEN `certified teacher`                                      THEN 9
    WHEN `certified kindergarten teacher`                         THEN 10
    WHEN `uncertified teacher or kindergarten teacher, stage AA`  THEN 11
    WHEN `uncertified teacher or kindergarten teacher, stage A+`  THEN 12
    WHEN `uncertified teacher or kindergarten teacher, stage A`   THEN 13
    WHEN `uncertified teacher or kindergarten teacher, stage B`   THEN 14
    WHEN `certified professional instructor`                      THEN 15
    WHEN `de facto certified professional instructor`             THEN 16
    WHEN `uncertified professional instructor`                    THEN 17

GIVEN n IS A NUMBER
GIVETH A `salary grade`
DECIDE `the grade of rank` n IS
    BRANCH IF n EQUALS 1  THEN `academic grade, doctorate`
           IF n EQUALS 2  THEN `academic grade, MA`
           IF n EQUALS 3  THEN `academic grade, BA`
           IF n EQUALS 4  THEN `intermediate academic grade C`
           IF n EQUALS 5  THEN `intermediate academic grade B`
           IF n EQUALS 6  THEN `intermediate academic grade A`
           IF n EQUALS 7  THEN `academic intermediate supplement`
           IF n EQUALS 8  THEN `senior certified teacher`
           IF n EQUALS 9  THEN `certified teacher`
           IF n EQUALS 10 THEN `certified kindergarten teacher`
           IF n EQUALS 11 THEN `uncertified teacher or kindergarten teacher, stage AA`
           IF n EQUALS 12 THEN `uncertified teacher or kindergarten teacher, stage A+`
           IF n EQUALS 13 THEN `uncertified teacher or kindergarten teacher, stage A`
           IF n EQUALS 14 THEN `uncertified teacher or kindergarten teacher, stage B`
           IF n EQUALS 15 THEN `certified professional instructor`
           IF n EQUALS 16 THEN `de facto certified professional instructor`
           OTHERWISE `uncertified professional instructor`

`all grade routes` MEANS
    concat (LIST `routes to the doctorate grade`,
                 `routes to the MA grade`,
                 `routes to the BA grade`,
                 `routes to the intermediate grades and supplement`,
                 `routes to the senior certified teacher grade`,
                 `routes to the certified teacher grade`,
                 `routes to the certified kindergarten teacher grade`,
                 `routes to the uncertified grades`,
                 `routes to the instructor grades`)

GIVEN file IS A `grading file`
GIVETH A LIST OF `salary grade`
DECIDE `grades the routes give` file IS
    nub (map (GIVEN r YIELD r's `route grade`) (filter (GIVEN r YIELD `the route is met` r file) `all grade routes`))

-- F-1.29-a: where several routes are met, the highest grade by the order
-- of 1.29.2.1(א) is read as governing.
GIVEN file IS A `grading file`
GIVETH A `salary grade`
DECIDE `the salary grade` file IS
    IF null (`grades the routes give` file)
    THEN `the residual grade` file
    ELSE `the grade of rank` (minimum1 99 (map (GIVEN g YIELD `rank of` g) (`grades the routes give` file)))

-- F-1.29-a: a nursing teacher who is a registered nurse without a teaching
-- licence is given the certified-teacher grade by (י)(36) and the de facto
-- certified instructor grade by (יז)(5); with a permanent licence, senior
-- certified teacher by (ט)(11) and certified instructor by (טז)(4).
`a nursing teacher, registered nurse, no licence` MEANS
    `grading file` WITH
        `clauses found met`                     IS EMPTY
        `recognised seniority in teaching`      IS 5
        `years in the certificated post at sea` IS 0
        `years commanding a ship or instructing in the Navy` IS 0
        `years of professional work at sea or in sea instruction` IS 0
        `Hebrew University points`              IS 0
        `years as a general teacher`            IS 0
        `registered nurse`                      IS TRUE
        `permanent teaching licence`            IS FALSE
        `teaches nursing`                       IS TRUE
        `Israeli matriculation or pre-academic preparatory` IS FALSE
        `a professional instructor`             IS FALSE

`a nursing teacher, registered nurse, permanent licence` MEANS
    `grading file` WITH
        `clauses found met`                     IS EMPTY
        `recognised seniority in teaching`      IS 5
        `years in the certificated post at sea` IS 0
        `years commanding a ship or instructing in the Navy` IS 0
        `years of professional work at sea or in sea instruction` IS 0
        `Hebrew University points`              IS 0
        `years as a general teacher`            IS 0
        `registered nurse`                      IS TRUE
        `permanent teaching licence`            IS TRUE
        `teaches nursing`                       IS TRUE
        `Israeli matriculation or pre-academic preparatory` IS FALSE
        `a professional instructor`             IS FALSE

`the nursing teacher is given two grades by two lists` MEANS
        `grades the routes give` `a nursing teacher, registered nurse, no licence`
            EQUALS LIST `certified teacher`, `de facto certified professional instructor`
    AND `grades the routes give` `a nursing teacher, registered nurse, permanent licence`
            EQUALS LIST `senior certified teacher`, `certified professional instructor`
#ASSERT `the nursing teacher is given two grades by two lists`

#ASSERT `the salary grade` `a nursing teacher, registered nurse, no licence` EQUALS `certified teacher`

§§ `1.29.3.1 הוראות כלליות — counting professional seniority`

-- akn:chp_1ב__sec_1_29__ssec_1_29_3_1/p1 An amendment note ("updated 5.2.03").

@desc One school year of a teaching employee's past work, as far as seniority under 1.29.3 asks about it.
DECLARE `year of work` HAS
    `months teaching`                      IS A NUMBER  @desc full months of paid teaching in the school year, after the employee turned 18
    `teaching position fraction`           IS A NUMBER  @desc the share of a position taught, hours in all institutions added together (1.29.3.1(5))
    `months in instruction or other work`  IS A NUMBER  @desc full months of paid instruction or other qualifying work, after 18
    `other work position fraction`         IS A NUMBER
    `months of paid sick leave`            IS A NUMBER  @desc the sick-day fund's grants included
    `months of maternity or accident leave paid by National Insurance` IS A NUMBER
    `months of reserve duty`               IS A NUMBER
    `suspended for legal proceedings`      IS A BOOLEAN
    `paid without working at all`          IS A BOOLEAN @desc stopped work for any reason, or received salary without working at all (1.29.3.1(9))
    `the Ofek Hadash internship year`      IS A BOOLEAN @desc the year was the internship year of an employee under the Ofek Hadash reform (1.29.3.2)

-- (1) and (2): the increment follows the salary tables in force, applies
-- from 1 September of each school year, up to 36 years. The table's amount
-- is an input.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_1__para_1 akn:chp_1ב__sec_1_29__ssec_1_29_3_1__para_2
GIVEN `professional seniority` IS A NUMBER
GIVETH A NUMBER
DECIDE `years the seniority increment is paid for` `professional seniority` IS
    min `professional seniority` 36

-- The increment is fixed on 1 September and does not move during the year.
GIVEN `seniority on 1 September` IS A NUMBER, m IS A `school month`
GIVETH A NUMBER
DECIDE `seniority for the increment in month` `seniority on 1 September` m IS
    `years the seniority increment is paid for` `seniority on 1 September`

-- (3): fewer than 6 full months in the year — the listed absences counted
-- as work — and the year does not count.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_1__para_3
GIVEN y IS A `year of work`
GIVETH A NUMBER
DECIDE `months counted as work` y IS
        y's `months teaching`
    PLUS y's `months in instruction or other work`
    PLUS y's `months of paid sick leave`
    PLUS y's `months of maternity or accident leave paid by National Insurance`
    PLUS y's `months of reserve duty`

GIVEN y IS A `year of work`
GIVETH A BOOLEAN
DECIDE `the year is left out under (3)` y IF
    `months counted as work` y LESS THAN 6

-- 1.29.3.2's opening: paid work in one school year, 6 months at least, at
-- a third of a position in teaching, or at half in instruction or other
-- work; and each criterion stands alone, never combined in one year. The
-- absences (3) counts as work are counted with teaching.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p1 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p2
GIVEN y IS A `year of work`
GIVETH A BOOLEAN
DECIDE `the year meets the work conditions` y IF
        (`months counted as work` y MINUS y's `months in instruction or other work` AT LEAST 6
         AND y's `teaching position fraction` AT LEAST 1/3)
    OR  (y's `months in instruction or other work` AT LEAST 6
         AND y's `other work position fraction` AT LEAST 1/2)

-- (9). F-1.29-c: (3) counts paid sick leave as work, and (9) denies
-- seniority to one who "receives salary without working at all"; a year
-- wholly on paid sick leave is both. This file reads (9) as not reaching
-- the absences (3) names.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_1__para_9
GIVEN y IS A `year of work`
GIVETH A BOOLEAN
DECIDE `barred by (9)` y IF
        y's `suspended for legal proceedings`
    OR (y's `paid without working at all` AND `months counted as work` y EQUALS 0)

`a year wholly on paid sick leave` MEANS
    `year of work` WITH
        `months teaching`                     IS 0
        `teaching position fraction`          IS 1
        `months in instruction or other work` IS 0
        `other work position fraction`       IS 0
        `months of paid sick leave`           IS 10
        `months of maternity or accident leave paid by National Insurance` IS 0
        `months of reserve duty`              IS 0
        `suspended for legal proceedings`     IS FALSE
        `paid without working at all`         IS TRUE
        `the Ofek Hadash internship year`     IS FALSE

`(3) counts the sick-leave year and (9) bars it` MEANS
        `months counted as work` `a year wholly on paid sick leave` AT LEAST 6
    AND `a year wholly on paid sick leave`'s `paid without working at all`
#ASSERT `(3) counts the sick-leave year and (9) bars it`
#ASSERT `the year qualifies` `a year wholly on paid sick leave`

-- (4): regular service interrupting teaching counts if the employee
-- returned within 6 months of discharge and had taught 6 months before;
-- career service the same, if not longer than two years.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_1__para_4
GIVEN `months taught before enlisting` IS A NUMBER
      `months from discharge to return` IS A NUMBER
      `a career-service term in years` IS A NUMBER @desc 0 for regular (compulsory) service
GIVETH A BOOLEAN
DECIDE `the interrupting army service counts` `months taught before enlisting` `months from discharge to return` `a career-service term in years` IF
        `months taught before enlisting` AT LEAST 6
    AND `months from discharge to return` AT MOST 6
    AND `a career-service term in years` AT MOST 2

-- (5): periods with breaks are added up; hours in several institutions in
-- one school year are combined.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_1__para_5
GIVEN `position fractions in each institution` IS A LIST OF NUMBER
GIVETH A NUMBER
DECIDE `the year's combined position` `position fractions in each institution` IS
    sum `position fractions in each institution`

GIVEN `months of each period of work in the year` IS A LIST OF NUMBER
GIVETH A NUMBER
DECIDE `the year's months of work, breaks notwithstanding` `months of each period of work in the year` IS
    sum `months of each period of work in the year`

-- (6): work before 18 is left out of the months the record holds.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_1__para_6
GIVEN `age when the work was done` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the work may count` `age when the work was done` IF
    `age when the work was done` AT LEAST 18

-- (7): a break is not counted unless this chapter expressly says otherwise.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_1__para_7
GIVEN `the chapter expressly counts this break` IS A BOOLEAN, `months of the break` IS A NUMBER
GIVETH A NUMBER
DECIDE `months of a break counted` `the chapter expressly counts this break` `months of the break` IS
    IF `the chapter expressly counts this break` THEN `months of the break` ELSE 0

-- (8): years recognised at half, rounded up when odd (the examples: 1 → 1,
-- 3 → 2, 5 → 3). F-1.29-b: the rule is stated for one who "worked more
-- than two years", and its first example is one year.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_1__para_8
GIVEN `years at half seniority` IS A NUMBER
GIVETH A NUMBER
DECIDE `years recognised at half` `years at half seniority` IS
    CEILING (`years at half seniority` DIVIDED BY 2)

GIVEN `years at half seniority` IS A NUMBER
GIVETH A NUMBER
DECIDE `years recognised at half, the rule read as stated` `years at half seniority` IS
    IF `years at half seniority` GREATER THAN 2
    THEN CEILING (`years at half seniority` DIVIDED BY 2)
    ELSE `years at half seniority` DIVIDED BY 2

#ASSERT `years recognised at half` 3 EQUALS 2 AND `years recognised at half` 5 EQUALS 3

`the first example of (8) falls outside its own rule` MEANS
    NOT (`years recognised at half, the rule read as stated` 1 EQUALS 1)
#ASSERT `the first example of (8) falls outside its own rule`

-- akn:chp_1ב__sec_1_29__ssec_1_29_3_1/p2 akn:chp_1ב__sec_1_29__ssec_1_29_3_1/p3 akn:chp_1ב__sec_1_29__ssec_1_29_3_1/p4 akn:chp_1ב__sec_1_29__ssec_1_29_3_1/p5 Sources (אסמכתא) of 1.29.3.1.

§§ `1.29.3 Professional seniority on 1 September`

-- A year earns seniority when it meets 1.29.3.2's work conditions, is not
-- left out by 1.29.3.1(3) or barred by (9), and is not an Ofek Hadash
-- internship year (1.29.3.2, p5).
GIVEN y IS A `year of work`
GIVETH A BOOLEAN
DECIDE `the year qualifies` y IF
        `the year meets the work conditions` y
    AND (NOT `the year is left out under (3)` y)
    AND (NOT `barred by (9)` y)
    AND (NOT `the year is an Ofek Hadash internship year` y)

-- Professional seniority on 1 September of a school year: the qualifying
-- years before it, plus years credited elsewhere (military service, items
-- of 1.29.3.2). The year being served is not counted: on 1 September of the
-- first year the employee has 0, and seniority moves "after the first year
-- of work" (1.29.3.2). This is what section 1.7's F-1.7-b asked.
GIVEN `past years` IS A LIST OF `year of work`
      `years credited otherwise` IS A NUMBER
GIVETH A NUMBER
DECIDE `seniority on 1 September` `past years` `years credited otherwise` IS
    min 36 (count (filter (GIVEN y YIELD `the year qualifies` y) `past years`) PLUS `years credited otherwise`)

#ASSERT `seniority on 1 September` EMPTY 0 EQUALS 0

§§ `1.29.3.2 עבודה המזכה בוותק`

DECLARE `kind of seniority` IS ONE OF
    `actual teaching seniority`
    `seniority recognised for salary only`
    `no seniority`

DECLARE `seniority document` IS ONE OF
    `none required`
    `the owning body's report`
    `original or certified employment confirmations`
    `the National Insurance report of periods of employment`
    `payslips and further documents on demand`

-- akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p3 Lead-in: "for recognising seniority the following confirmations are shown".
-- akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p4 Heading: "actual teaching seniority (criterion א below)".

-- p5: in official institutions no confirmations, seniority advancing by
-- itself after the first year; p6: recognised unofficial ones, by the
-- owning body's report; p7–p10: salary seniority needs the documents.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p5 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p6 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p7 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p8 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p9 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p10
GIVEN k IS A `kind of seniority`, `in an official institution` IS A BOOLEAN
GIVETH A LIST OF `seniority document`
DECIDE `documents to show` k `in an official institution` IS
    CONSIDER k
    WHEN `actual teaching seniority` THEN
        IF `in an official institution`
        THEN LIST `none required`
        ELSE LIST `the owning body's report`
    WHEN `seniority recognised for salary only` THEN
        LIST `original or certified employment confirmations`,
             `the National Insurance report of periods of employment`,
             `payslips and further documents on demand`
    OTHERWISE EMPTY

-- p5: under the Ofek Hadash reform the internship year is not a year of
-- seniority.
GIVEN y IS A `year of work`
GIVETH A BOOLEAN
DECIDE `the year is an Ofek Hadash internship year` y IF
    y's `the Ofek Hadash internship year`

-- א (p12, p13): actual teaching seniority only for teaching in an
-- institution under the Compulsory Education Law and the School
-- Supervision Law, licensed and run by them. א.1 (p14): teaching there
-- while not employed by the Ministry or the owning body, on the
-- principal's confirmation, is seniority for salary only.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p12 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p13 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p14
GIVEN `a licensed institution under the two laws` IS A BOOLEAN
      `employed by the Ministry or the owning body` IS A BOOLEAN
      `the principal confirms the work` IS A BOOLEAN
GIVETH A `kind of seniority`
DECIDE `seniority for teaching in an institution` `a licensed institution under the two laws` `employed by the Ministry or the owning body` `the principal confirms the work` IS
    IF (NOT `a licensed institution under the two laws`)
    THEN `no seniority`
    ELSE IF `employed by the Ministry or the owning body`
         THEN `actual teaching seniority`
         ELSE IF `the principal confirms the work`
              THEN `seniority recognised for salary only`
              ELSE `no seniority`

§§ `1.29.3.2 The work recognised as seniority for salary`

DECLARE `item status` IS ONE OF
    `in force`
    `cancelled`
    `in force until 31.8.2023, then under item 53`
    `in force from 1.9.2023`
    `folded into another item`

@desc One item of 1.29.3.2's list of work recognised as seniority for salary.
DECLARE `seniority item` HAS
    `item number`            IS A STRING
    `work recognised`        IS A STRING
    `status`                 IS AN `item status`
    `half without the qualification` IS A BOOLEAN @desc the item recognises half the seniority for one who lacked, while working, the qualification it names (a teaching certification, or for item 19 a degree in the profession)

`the salary-seniority items` MEANS
    LIST
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p15
        `seniority item` "1" "teaching in a recognised institution of higher education" `in force` FALSE,
