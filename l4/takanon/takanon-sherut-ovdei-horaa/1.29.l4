        `seniority item` "52" "a rabbi with a higher rabbinical education certificate who served as a rabbi and serves as a school rabbi or teacher of Oral Law or Jewish thought, from the year he qualified for an equivalent academic grade; from 1.4.92; half without teaching certification" `in force` TRUE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p93 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p94 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p95
        `seniority item` "53" "a worker in a workplace of at least 4 employees whose main role (at least 50%) was instructing groups of 3 or more face to face, on HR's confirmation, at half a position for six months of a school year; from 1.9.2023" `in force from 1.9.2023` FALSE

-- The rule over the list: what one qualifying year of the item's work earns.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p11
GIVEN i IS A `seniority item`
      `held the qualification` IS A BOOLEAN @desc held, while working, the qualification the item names for full credit
      `school year starting in` IS A NUMBER @desc the calendar year in which the school year of the work began
GIVETH A NUMBER
DECIDE `seniority earned for a year under` i `held the qualification` `school year starting in` IS
    CONSIDER i's `status`
    WHEN `cancelled`                 THEN 0
    WHEN `folded into another item`  THEN 0
    WHEN `in force until 31.8.2023, then under item 53` THEN
        IF `school year starting in` AT LEAST 2023 THEN 0 ELSE `the item's full or half credit` i `held the qualification`
    WHEN `in force from 1.9.2023` THEN
        IF `school year starting in` AT LEAST 2023 THEN `the item's full or half credit` i `held the qualification` ELSE 0
    OTHERWISE `the item's full or half credit` i `held the qualification`

GIVEN i IS A `seniority item`, `held the qualification` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `the item's full or half credit` i `held the qualification` IS
    IF i's `half without the qualification` AND (NOT `held the qualification`)
    THEN 0.5
    ELSE 1

GIVEN n IS A STRING
GIVETH A LIST OF `seniority item`
DECIDE `item` n IS
    filter (GIVEN i YIELD i's `item number` EQUALS n) `the salary-seniority items`

-- Item 8's hours: at most 100 counted in a month (100 a month is a full
-- position), and six months of work in the year at least.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p23
GIVEN `hours worked in each month` IS A LIST OF NUMBER
GIVETH A NUMBER
DECIDE `a substitute's hours counted` `hours worked in each month` IS
    sum (map (GIVEN h YIELD min h 100) `hours worked in each month`)

GIVEN `hours worked in each month` IS A LIST OF NUMBER
      `a secondary school, seminary or college` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a substitute's year qualifies by hours under item 8` `hours worked in each month` `a secondary school, seminary or college` IF
        count (filter (GIVEN h YIELD h GREATER THAN 0) `hours worked in each month`) AT LEAST 6
    AND `a substitute's hours counted` `hours worked in each month` AT LEAST (IF `a secondary school, seminary or college` THEN 300 ELSE 375)

#ASSERT `a substitute's hours counted` (LIST 80, 130) EQUALS 180

-- F-1.29-f: section 1.30 gives the substitute full seniority on the same
-- 375 hours with neither the monthly cap nor six months' work.
GIVEN `hours worked in each month` IS A LIST OF NUMBER
GIVETH A BOOLEAN
DECIDE `full seniority by hours under section 1.30` `hours worked in each month` IF
    sum `hours worked in each month` AT LEAST 375

`four months of 100 hours` MEANS LIST 100, 100, 100, 100
`sections 1.29 and 1.30 disagree on a substitute's 400 hours in four months` MEANS
        `full seniority by hours under section 1.30` `four months of 100 hours`
    AND NOT `a substitute's year qualifies by hours under item 8` `four months of 100 hours` FALSE
#ASSERT `sections 1.29 and 1.30 disagree on a substitute's 400 hours in four months`

-- Item 13: the officer service earns at most 28 years of seniority.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p30
GIVEN `years of qualifying officer service` IS A NUMBER
GIVETH A NUMBER
DECIDE `seniority for officer service under item 13` `years of qualifying officer service` IS
    min `years of qualifying officer service` 28

-- Item 38: a training year split over two years at half the grant is one.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p67
GIVEN `consecutive years at half the grant, without teaching` IS A NUMBER
GIVETH A NUMBER
DECIDE `seniority for a split training year` `consecutive years at half the grant, without teaching` IS
    FLOOR (`consecutive years at half the grant, without teaching` DIVIDED BY 2)

-- Item 50: every 12 weekly hours accumulated, over years of at least 150
-- days each, earn one year. Its two worked examples hold.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p85 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p86 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p87
GIVEN `weekly hours in each year of at least 150 days` IS A LIST OF NUMBER
GIVETH A NUMBER
DECIDE `seniority for Sunday-school teaching` `weekly hours in each year of at least 150 days` IS
    FLOOR (sum `weekly hours in each year of at least 150 days` DIVIDED BY 12)

#ASSERT `seniority for Sunday-school teaching` (LIST 3, 4, 5) EQUALS 1
#ASSERT `seniority for Sunday-school teaching` (LIST 6, 6) EQUALS 1

-- F-1.29-d: item 12 makes its credit depend on "all the following
-- conditions" and lists none; F-1.29-e: item 36(א)'s application is to be
-- made "with:" a list that is not there.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p29
GIVETH A LIST OF STRING
DECIDE `the conditions item 12 lists` IS EMPTY
`item 12 announces conditions and lists none` MEANS null `the conditions item 12 lists`
#ASSERT `item 12 announces conditions and lists none`

@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p64
GIVETH A LIST OF STRING
DECIDE `the documents an item 36(א) application attaches` IS EMPTY
`item 36(א)'s application names no attachments` MEANS null `the documents an item 36(א) application attaches`
#ASSERT `item 36(א)'s application names no attachments`

-- akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p96 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p97 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p98 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p99 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p100 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p101 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p102 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p103 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p104 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p105 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p106 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p107 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p108 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p109 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p110 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p111 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p112 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p113 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p114 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p115 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p116 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p117 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p118 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p119 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p120 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p121 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p122 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p123 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p124 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p125 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p126 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p127 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p128 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p129 Sources (אסמכתא) of 1.29.3.2.

#ASSERT `seniority earned for a year under` (at (`item` "32") 0) FALSE 2020 EQUALS 0.5
#ASSERT `seniority earned for a year under` (at (`item` "27") 0) TRUE 2024 EQUALS 0
#ASSERT `seniority earned for a year under` (at (`item` "53") 0) TRUE 2024 EQUALS 1

§§ `1.29.3.3 ותק וצ.ה.ל`

DECLARE `service sex` IS ONE OF `a man`, `a woman`

@desc A teaching employee's compulsory (or national, or civil) service, as far as 1.29.3.3 asks about it.
DECLARE `compulsory service` HAS
    `served as`                     IS A `service sex`
    `service began`                 IS A DATE
    `service ended`                 IS A DATE
    `months actually served`        IS A NUMBER
    `an officer obliged to extra regular service as compulsory` IS A BOOLEAN
    `a disabled veteran who could not complete it` IS A BOOLEAN @desc an IDF disabled veteran who did not complete the full compulsory service because of the disability
    `full term of the period in months` IS A NUMBER @desc the full compulsory term of the period of discharge, for a disabled veteran (the takanon names 2.5 or 3 years)

@desc The bodies 1.29.3.3 sends a declaration or a confirmation to. Section-local: the takanon's shared Party has no district section, clerk or officer.
DECLARE `1.29.3.3 party` IS ONE OF
    `the teaching employee`
    `the district teaching-manpower section`
    `the district manpower clerk`
    `the district manpower officer`
    `the owning body`
    `the employer`

DECLARE `IDF seniority action` IS ONE OF
    `declare the compulsory service to the district section`
    `send the declaration to the owning body`
    `check the declaration and pass it for payment`
    `give the Disabled Veterans' confirmation to the district manpower clerk`
    `give the Disabled Veterans' confirmation to the owning body`
    `confirm the entitlement and send a payment order to the treasury`
    `apply to the employer to check the entitlement`
    `give the national-service confirmation to the district manpower officer`
    `give the national-service confirmation to the owning body`
    `check the confirmation and pass it to the district treasury for payment`

-- (1)-(3): recognised on the employee's declaration (dates of the service,
-- and whether today's increments already count it), sent to the district
-- teaching-manpower section, which checks it and passes it for payment; an
-- employee not of the Ministry sends it to the owning body. The specimen
-- form (1) announces is not in the text.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_1 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_2 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_3 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_3/p2
GIVEN `a Ministry employee` IS A BOOLEAN
GIVETH A DEONTIC `1.29.3.3 party` `IDF seniority action`
DECIDE `recognising compulsory service` `a Ministry employee` IS
    IF `a Ministry employee`
    THEN PARTY `the teaching employee`
         MAY   `declare the compulsory service to the district section`
         HENCE (PARTY `the district teaching-manpower section`
                MUST  `check the declaration and pass it for payment`
                LEST  BREACH BY `the district teaching-manpower section` BECAUSE "section 1.29.3.3(3): the district section checks the declaration and passes it for payment")
    ELSE PARTY `the teaching employee`
         MAY   `send the declaration to the owning body`

#TRACE `recognising compulsory service` TRUE AT 0 WITH
    PARTY `the teaching employee` DOES `declare the compulsory service to the district section` AT 1
    PARTY `the district teaching-manpower section` DOES `check the declaration and pass it for payment` AT 3

-- (4) and (6): for salary only — the combined salary and every increment
-- figured as a percentage of it — and not for rights built on seniority
-- (pension accrual, vacation and recuperation quotas) or for increments
-- that follow years of seniority (education and literature increments).
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_4 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_6
GIVEN u IS A `use of seniority`
GIVETH A BOOLEAN
DECIDE `IDF seniority counts for` u IF
    u EQUALS `the combined salary and increments figured on it`

DECLARE `use of seniority` IS ONE OF
    `the combined salary and increments figured on it`
    `pension accrual`
    `vacation and recuperation quotas`
    `the education and literature increment`
    `other rights built on seniority`

-- (5): never more increments than the maximum (36, 1.29.3.1(2)).
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_5
GIVEN `seniority from teaching` IS A NUMBER, `years of IDF seniority` IS A NUMBER
GIVETH A NUMBER
DECIDE `increments paid with the IDF years` `seniority from teaching` `years of IDF seniority` IS
    min 36 (`seniority from teaching` PLUS `years of IDF seniority`)

#ASSERT `increments paid with the IDF years` 35 3 EQUALS 36

@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_7
`the IDF seniority arrangement applies from` MEANS DATE_FROM_DMY 1 4 1980

-- (10): advancement by the service actually done, never past the months
-- the law fixed in each period. F-1.29-h: the periods are dated, and the
-- text does not say which date of a service places it in one; this file
-- places it by the day it began. The women's two periods both include
-- 13.2.1950; the later one is read as starting the day after.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10/p2 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_1__subpara_a akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_1__subpara_b akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_1__subpara_c akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_a akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_b
GIVEN s IS A `sex and date`
GIVETH A NUMBER
DECIDE `the law's months for the period` s IS
    CONSIDER s's `whose service`
    WHEN `a man` THEN
        IF `day` (s's `the date`) AT LEAST `day` (DATE_FROM_DMY 7 1 1968) THEN 36 ELSE 30
    WHEN `a woman` THEN
        IF `day` (s's `the date`) GREATER THAN `day` (DATE_FROM_DMY 13 2 1950) THEN 24 ELSE 12

GIVEN s IS A `compulsory service`
GIVETH A NUMBER
DECIDE `months (10) allows` s IS
    min (s's `months actually served`) (`the law's months for the period` (`sex and date` (s's `served as`) (s's `service began`)))

DECLARE `sex and date` HAS
    `whose service` IS A `service sex`
    `the date`      IS A DATE

GIVEN d IS A DATE
GIVETH A NUMBER
DECIDE `day` d IS DATE_SERIAL d

`a man drafted in 1966 and discharged in 1969` MEANS
    `compulsory service` WITH
        `served as`                                   IS `a man`
        `service began`                               IS DATE_FROM_DMY 1 6 1966
        `service ended`                               IS DATE_FROM_DMY 1 6 1969
        `months actually served`                      IS 36
        `an officer obliged to extra regular service as compulsory` IS FALSE
        `a disabled veteran who could not complete it` IS FALSE
        `full term of the period in months`           IS 30

`the period table places a 1966-1969 service in two periods` MEANS
    NOT (`the law's months for the period` (`sex and date` `a man` (DATE_FROM_DMY 1 6 1966))
         EQUALS `the law's months for the period` (`sex and date` `a man` (DATE_FROM_DMY 1 6 1969)))
#ASSERT `the period table places a 1966-1969 service in two periods`

-- (8): three years at most, hesder yeshiva service included.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_8
`the most compulsory service can earn, in months` MEANS 36

-- The women officers' exception, in force from 1.9.94: every month
-- actually served, past 24 too. F-1.29-g: past 36 it meets (8)'s cap; this
-- file applies the cap.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_b/p2 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_b/p3
GIVEN s IS A `compulsory service`
GIVETH A BOOLEAN
DECIDE `the officers' exception applies` s IF
    s's `served as` EQUALS `a woman` AND s's `an officer obliged to extra regular service as compulsory`

GIVEN s IS A `compulsory service`
GIVETH A NUMBER
DECIDE `months under the officers' exception alone` s IS
    s's `months actually served`

`a woman officer who served 40 months` MEANS
    `compulsory service` WITH
        `served as`                                   IS `a woman`
        `service began`                               IS DATE_FROM_DMY 1 8 1995
        `service ended`                               IS DATE_FROM_DMY 1 12 1998
        `months actually served`                      IS 40
        `an officer obliged to extra regular service as compulsory` IS TRUE
        `a disabled veteran who could not complete it` IS FALSE
        `full term of the period in months`           IS 24

`the officers' exception and the three-year cap differ at 40 months` MEANS
    NOT (`months of IDF seniority` `a woman officer who served 40 months`
         EQUALS `months under the officers' exception alone` `a woman officer who served 40 months`)
#ASSERT `the officers' exception and the three-year cap differ at 40 months`

-- A teacher who finds herself entitled under the exception asks her
-- employer to check the entitlement.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_b/p4
GIVETH A DEONTIC `1.29.3.3 party` `IDF seniority action`
DECIDE `realising the officers' exception` IS
    PARTY `the teaching employee`
    MAY   `apply to the employer to check the entitlement`

-- (9): the disabled veteran is paid for the full term, "2½ or 3 years (as
-- the compulsory-service rule was in the period of discharge)", for the
-- increment only, not for years with teaching seniority; confirmation from
-- the IDF Disabled Veterans' Organisation, given to the district manpower
-- clerk (Ministry employees) or to the owning body. F-1.29-i: the two
-- figures fit men's terms only; a woman's full term was 12 or 24 months.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_9
GIVEN s IS A `compulsory service`
GIVETH A NUMBER
DECIDE `months a disabled veteran is paid for under (9)` s IS
    s's `full term of the period in months`

GIVEN `the year earned teaching seniority` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `(9) reaches the year` `the year earned teaching seniority` IF
    NOT `the year earned teaching seniority`

GIVEN `a Ministry employee` IS A BOOLEAN
GIVETH A DEONTIC `1.29.3.3 party` `IDF seniority action`
DECIDE `the disabled veteran's confirmation` `a Ministry employee` IS
    IF `a Ministry employee`
    THEN PARTY `the teaching employee`
         MAY   `give the Disabled Veterans' confirmation to the district manpower clerk`
         HENCE (PARTY `the district manpower clerk`
                MUST  `confirm the entitlement and send a payment order to the treasury`
                LEST  BREACH BY `the district manpower clerk` BECAUSE "section 1.29.3.3(9): the district manpower clerk confirms the entitlement and sends a payment order to the treasury")
    ELSE PARTY `the teaching employee`
         MAY   `give the Disabled Veterans' confirmation to the owning body`

GIVEN `the term the text names, in months` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `a term (9) names` `the term the text names, in months` IF
    `the term the text names, in months` EQUALS 30 OR `the term the text names, in months` EQUALS 36

`a woman's full term is neither of (9)'s figures` MEANS
    NOT (`a term (9) names` (`the law's months for the period` (`sex and date` `a woman` (DATE_FROM_DMY 1 1 1990))))
#ASSERT `a woman's full term is neither of (9)'s figures`

-- (ג), (ד): national service of 40 weekly hours or more — 24 months earn
-- the maximum "as above" (24 months), 12 months earn one year; from
-- 1.10.94.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_c akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_d akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_d/p2
GIVEN `months of national service` IS A NUMBER, `weekly hours` IS A NUMBER
GIVETH A NUMBER
DECIDE `months of seniority for national service` `months of national service` `weekly hours` IS
    IF `weekly hours` LESS THAN 40
    THEN 0
    ELSE IF `months of national service` AT LEAST 24
         THEN 24
         ELSE IF `months of national service` AT LEAST 12
              THEN 12
              ELSE 0

`national service seniority applies from` MEANS DATE_FROM_DMY 1 10 1994

#ASSERT `months of seniority for national service` 14 40 EQUALS 12

-- The confirmations: from the volunteering associations named (p3), or for
-- service before them, through the Torah-culture department, from the
-- teaching-manpower division (p4); the teacher applies to the division in
-- her district with them; one paid by the Ministry hands the confirmation
-- to the district manpower officer, who checks it and passes it to the
-- district treasury; any other hands it to the owning body (p5).
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_d/p3 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_d/p4 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_d/p5
GIVEN `served before the associations were founded` IS A BOOLEAN
GIVETH A STRING
DECIDE `who confirms the national service` `served before the associations were founded` IS
    IF `served before the associations were founded`
    THEN "the teaching-manpower division of the Ministry"
    ELSE "the Association for Volunteering in the Nation, or Aminadav"

GIVEN `a Ministry employee` IS A BOOLEAN
GIVETH A DEONTIC `1.29.3.3 party` `IDF seniority action`
DECIDE `the national-service confirmation` `a Ministry employee` IS
    IF `a Ministry employee`
    THEN PARTY `the teaching employee`
         MAY   `give the national-service confirmation to the district manpower officer`
         HENCE (PARTY `the district manpower officer`
                MUST  `check the confirmation and pass it to the district treasury for payment`
                LEST  BREACH BY `the district manpower officer` BECAUSE "section 1.29.3.3(10)(ד): the district manpower officer passes the confirmation, after checking it, to the district treasury for payment")
    ELSE PARTY `the teaching employee`
         MAY   `give the national-service confirmation to the owning body`

-- (11): civil service for men, by the National-Civic Service Law's
-- tracks: social, 30 weekly hours for two years or 20 for three; security,
-- 36 for two years. F-1.29-j: how much seniority it earns is not stated.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_11 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_11/p2 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_11/p3 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_11/p4 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_11/p5
GIVEN `average weekly hours` IS A NUMBER, `years served` IS A NUMBER, `security track` IS A BOOLEAN
GIVETH A `civil service track`
DECIDE `the civil service track met` `average weekly hours` `years served` `security track` IS
    IF `security track`
    THEN IF `average weekly hours` AT LEAST 36 AND `years served` AT LEAST 2
         THEN `security, 36 weekly hours for two years`
         ELSE `no track met`
    ELSE IF `average weekly hours` AT LEAST 30 AND `years served` AT LEAST 2
         THEN `social, 30 weekly hours for two years`
         ELSE IF `average weekly hours` AT LEAST 20 AND `years served` AT LEAST 3
              THEN `social, 20 weekly hours for three years`
              ELSE `no track met`

DECLARE `civil service track` IS ONE OF
    `social, 30 weekly hours for two years`
    `social, 20 weekly hours for three years`
    `security, 36 weekly hours for two years`
    `no track met`

GIVEN t IS A `civil service track`
GIVETH A MAYBE NUMBER
DECIDE `months of seniority the text gives for civil service` t IS NOTHING

`civil service earns IDF seniority of no stated amount` MEANS
        NOT (`the civil service track met` 30 2 FALSE EQUALS `no track met`)
    AND `months of seniority the text gives for civil service` (`the civil service track met` 30 2 FALSE) EQUALS NOTHING
#ASSERT `civil service earns IDF seniority of no stated amount`

-- akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p1 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p2 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p3 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p4 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p5 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p6 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p7 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p8 Sources (אסמכתא) of 1.29.3.3.

§§ `1.29.3.3 Months of IDF seniority`

-- (10)'s months, the officers' exception and (9)'s full term, under (8)'s
-- cap of three years.
GIVEN s IS A `compulsory service`
GIVETH A NUMBER
DECIDE `months of IDF seniority` s IS
    min `the most compulsory service can earn, in months`
        (IF s's `a disabled veteran who could not complete it`
         THEN `months a disabled veteran is paid for under (9)` s
         ELSE IF `the officers' exception applies` s
              THEN `months under the officers' exception alone` s
              ELSE `months (10) allows` s)

#ASSERT `months of IDF seniority` `a man drafted in 1966 and discharged in 1969` EQUALS 30

§§ `1.29.6 דרגות שכר שוות ערך — yeshiva graduates`

-- akn:chp_1ב__sec_1_29__ssec_1_29_6/p1 The circular's number and title, reproduced as the subsection's opening line.
-- akn:chp_1ב__sec_1_29__ssec_1_29_6/p2 The heading "1. כללי".

@desc A yeshiva graduate's application for an equivalent academic grade, as far as 1.29.6 asks about it.
DECLARE `equivalence file` HAS
    `teaches sacred subjects`               IS A BOOLEAN @desc teaches Talmud/Oral Law, Jewish thought or Bible in fact
    `fraction taught in the year of application` IS A NUMBER
    `yeshiva years after 18 or 12th grade`  IS A NUMBER  @desc recognised years of study (3.1.2) in a recognised higher yeshiva
    `a teaching certificate for sacred subjects` IS A BOOLEAN @desc a certificate (on reserve exams), teaching certificate, permanent licence or licence to teach in Oral Law, with Jewish thought or Bible (1.2.1, first option)
    `Shulchan Aruch exams passed`           IS A BOOLEAN @desc confirmation of the Chief Rabbinate's Shulchan Aruch exams (3.2.2(2))
    `rabbinic ordination`                   IS A BOOLEAN @desc a certificate of rabbinic ordination (3.2.2(1))
    `Gemara exams passed`                   IS A NUMBER  @desc 30-page Gemara exams passed with 75 or more (3.2.5)
    `passed the 150-page exam`              IS A BOOLEAN
    `points from the Rabbinate's certificates` IS A NUMBER @desc points the Rabbinate's certificates earn; the corpus carries no figure for them, so it is an input
    `points from college studies`           IS A NUMBER  @desc points for B.Ed./M.Ed. studies in sacred subjects (3.2.4); the corpus carries no figure, so an input
    `points from publications`              IS A NUMBER  @desc points the committee awarded under the table of 4.9, which the corpus does not carry
    `highest points for one publication`    IS A NUMBER
    `defended the publication if asked`     IS A BOOLEAN
    `a dayanut or city-rabbi certificate`   IS A BOOLEAN @desc 2.2.1
    `a "yoreh yoreh" certificate`           IS A BOOLEAN @desc 2.2.2
    `a dayanut-fitness certificate`         IS A BOOLEAN @desc exempts from publication points for the doctorate (note to 2.3)
    `holds an academic degree`              IS A BOOLEAN @desc a degree from an institution of higher education (1.3)
    `holds matriculation`                   IS A BOOLEAN
    `a senior certified teacher's certificate not used for the grade` IS A BOOLEAN @desc 1.4
    `an uncertified teacher`                IS A BOOLEAN
    `new to the system`                     IS A BOOLEAN @desc a new uncertified teacher (3.2.3(1)), not one employed and permanent (3.2.3(2))
    `years since starting work`             IS A NUMBER
    `registered at a teacher-training institute` IS A BOOLEAN

DECLARE `equivalent grade` IS ONE OF
    `equivalent to BA`
    `equivalent to MA`
    `equivalent to doctorate`
    `no equivalent grade`

-- 1.1: a grading for salary only, for yeshiva graduates teaching sacred
-- subjects in fact.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p3
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `within the purpose of 1.29.6` e IF
    e's `teaches sacred subjects`

-- 1.2.1: the four alternatives ("or" between them, p6, p8, p10).
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p4 akn:chp_1ב__sec_1_29__ssec_1_29_6/p5 akn:chp_1ב__sec_1_29__ssec_1_29_6/p6 akn:chp_1ב__sec_1_29__ssec_1_29_6/p7 akn:chp_1ב__sec_1_29__ssec_1_29_6/p8 akn:chp_1ב__sec_1_29__ssec_1_29_6/p9 akn:chp_1ב__sec_1_29__ssec_1_29_6/p10 akn:chp_1ב__sec_1_29__ssec_1_29_6/p11
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `meets 1.2.1` e IF
        e's `a teaching certificate for sacred subjects`
    OR (e's `Shulchan Aruch exams passed` AND e's `Gemara exams passed` AT LEAST 1 AND `points` e AT LEAST 15)
    OR (e's `rabbinic ordination` AND e's `Gemara exams passed` AT LEAST 1 AND `points` e AT LEAST 15)
    OR e's `passed the 150-page exam`

-- 1.2.2, 1.2.3: four yeshiva years after 18 or 12th grade; teaching the
-- subjects at a third of a position in the year of application.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p12 akn:chp_1ב__sec_1_29__ssec_1_29_6/p13
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `meets the thresholds of 1.2` e IF
        `meets 1.2.1` e
    AND e's `yeshiva years after 18 or 12th grade` AT LEAST 4
    AND e's `fraction taught in the year of application` AT LEAST 1/3

-- 1.2.4: points for a study or certificate are given once only; the file
-- holds each source once.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p14 akn:chp_1ב__sec_1_29__ssec_2/p1
GIVEN e IS AN `equivalence file`
GIVETH A NUMBER
DECIDE `points` e IS
        `points for yeshiva years` e
    PLUS `points for Gemara exams` e
    PLUS e's `points from the Rabbinate's certificates`
    PLUS e's `points from college studies`
    PLUS e's `points from publications`

-- 1.3: not for teachers who received an academic degree. F-1.29-l: 3.2.4
-- gives points for B.Ed. and M.Ed. degrees in sacred subjects.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p15
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `barred by 1.3` e IF
    e's `holds an academic degree`

-- 1.4: without matriculation, with a senior certified teacher's certificate
-- not used for the equivalent grade: a double title.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p16
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `entitled to a double title` e IF
        (NOT e's `holds matriculation`)
    AND e's `a senior certified teacher's certificate not used for the grade`
    AND (NOT (`the equivalent grade` e EQUALS `no equivalent grade`))

-- 1.5: higher Torah-education certificates on exams to 31.8.14 earn 15
-- points only if submitted by 31.12.14.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p17
GIVEN `exams held by 31.8.14` IS A BOOLEAN, `submitted by 31.12.14` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `points for a pre-2014 Torah-education certificate` `exams held by 31.8.14` `submitted by 31.12.14` IS
    IF `exams held by 31.8.14` AND (NOT `submitted by 31.12.14`) THEN 0 ELSE 15

-- 2.1-2.3 and 2.2.1-2.2.4, 2.3.1-2.3.2 and the note to 2.3.
-- F-1.29-k: 2.2.1 asks for "one Gemara exam as detailed above, in 1.2.3",
-- and 1.2.3 is the teaching load; read as 3.2.5's Gemara exam.
@ref akn:chp_1ב__sec_1_29__ssec_2_1 akn:chp_1ב__sec_1_29__ssec_2_2 akn:chp_1ב__sec_1_29__ssec_2_2_1 akn:chp_1ב__sec_1_29__ssec_2_2_1/p2 akn:chp_1ב__sec_1_29__ssec_2_2_2 akn:chp_1ב__sec_1_29__ssec_2_2_2/p2 akn:chp_1ב__sec_1_29__ssec_2_2_3 akn:chp_1ב__sec_1_29__ssec_2_2_4 akn:chp_1ב__sec_1_29__ssec_2_3 akn:chp_1ב__sec_1_29__ssec_2_3_1 akn:chp_1ב__sec_1_29__ssec_2_3_1/p2
GIVEN e IS AN `equivalence file`
GIVETH AN `equivalent grade`
DECIDE `the grade 2.1-2.3 give` e IS
    IF NOT `meets the thresholds of 1.2` e
    THEN `no equivalent grade`
    ELSE IF e's `yeshiva years after 18 or 12th grade` AT LEAST 7 AND `points` e AT LEAST 75
            AND `one of the 2.2 certificates` e AND `the doctorate's publications` e
         THEN `equivalent to doctorate`
         ELSE IF `points` e AT LEAST 55 AND `one of the 2.2 certificates` e
              THEN `equivalent to MA`
              ELSE IF `points` e AT LEAST 30
                   THEN `equivalent to BA`
                   ELSE `no equivalent grade`

-- F-1.29-k: what 1.2.3 is about, against what 2.2.1 cites it for.
GIVETH A STRING
DECIDE `what 1.2.3 requires` IS "teaching the sacred subjects at a third of a position in the year of application"

`2.2.1 cites 1.2.3 for a Gemara exam it does not hold` MEANS
    NOT (`what 1.2.3 requires` EQUALS "one Gemara exam")
#ASSERT `2.2.1 cites 1.2.3 for a Gemara exam it does not hold`

GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `one of the 2.2 certificates` e IF
        (e's `a dayanut or city-rabbi certificate` AND e's `Gemara exams passed` AT LEAST 1)
    OR  (e's `a "yoreh yoreh" certificate` AND (e's `Gemara exams passed` AT LEAST 1 OR e's `Shulchan Aruch exams passed`))
    OR  e's `passed the 150-page exam`
    OR  e's `points from publications` GREATER THAN 0

GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `the doctorate's publications` e IF
        e's `a dayanut-fitness certificate`
    OR (e's `highest points for one publication` AT LEAST 10
        AND e's `points from publications` AT LEAST 20
        AND e's `defended the publication if asked`)

-- 3.1.1 (yeshiva, kolel or hesder yeshiva recognised by the one authorised)
-- and 3.1.2 (a year runs Elul to Av, counted for 10 continuous months at 35
-- weekly hours, without months of regular army service).
@ref akn:chp_1ב__sec_1_29__ssec_3_1_1 akn:chp_1ב__sec_1_29__ssec_3_1_2
GIVEN `a yeshiva recognised by the one authorised` IS A BOOLEAN @desc a higher yeshiva, a kolel or a hesder yeshiva so recognised (3.1.1)
      `continuous months studied` IS A NUMBER @desc in the year from Elul to Av, months of actual regular army service left out
      `weekly hours` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `a recognised year of yeshiva study` `a yeshiva recognised by the one authorised` `continuous months studied` `weekly hours` IF
        `a yeshiva recognised by the one authorised`
    AND `continuous months studied` AT LEAST 10
    AND `weekly hours` AT LEAST 35

-- 3.1.3: in the first four years, no work at all; after them, work of 16
-- weekly hours at most. 3.1.4: no points for years studied in parallel for
-- a degree or certificate.
@ref akn:chp_1ב__sec_1_29__ssec_3_1_3__para_a akn:chp_1ב__sec_1_29__ssec_3_1_4/p1
GIVEN `which year of study` IS A NUMBER, `weekly hours worked` IS A NUMBER, `studied for a degree in parallel` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the yeshiva year earns points` `which year of study` `weekly hours worked` `studied for a degree in parallel` IF
        (NOT `studied for a degree in parallel`)
    AND (IF `which year of study` AT MOST 4
         THEN `weekly hours worked` EQUALS 0
         ELSE `weekly hours worked` AT MOST 16)

-- 3.2.1: 3 points a year, at most 30; signed confirmations of the head of
-- the yeshiva.
@ref akn:chp_1ב__sec_1_29__ssec_3_2_1/p1 akn:chp_1ב__sec_1_29__ssec_3_2_1/p2 akn:chp_1ב__sec_1_29__ssec_3_2_1/p3 akn:chp_1ב__sec_1_29__ssec_3_2_1/p4 akn:chp_1ב__sec_1_29__ssec_3_2_1/p5 akn:chp_1ב__sec_1_29__ssec_3_2_1/p6
GIVEN e IS AN `equivalence file`
GIVETH A NUMBER
DECIDE `points for yeshiva years` e IS
    min 30 (3 TIMES e's `yeshiva years after 18 or 12th grade`)

-- 3.2.2: the Rabbinate's ordination certificates and Shulchan Aruch exam
-- confirmations; the corpus gives no points for them (an input above).
@ref akn:chp_1ב__sec_1_29__ssec_3_2_2__para_1 akn:chp_1ב__sec_1_29__ssec_3_2_2__para_2
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `holds a Rabbinate certificate` e IF
    e's `rabbinic ordination` OR e's `Shulchan Aruch exams passed`

-- 3.2.3 (as the corpus prints it, under the heading of studies for teaching
-- sacred subjects: "ה. the status of uncertified teachers"): a new
-- uncertified teacher finishes the senior teacher's certificate within 3
-- years, and may have the BA-equivalent set within them if registered at
-- an institute; failing that, the equivalent grade is cancelled. A
-- permanent uncertified teacher gets none, and completes certification by
-- reserve exams (within 4 years, once issued an obligation letter).
-- F-1.29-o: what 3.2.3 opens to the new uncertified teacher is the BA
-- equivalent alone; this file reads it as the most that teacher can get.
@ref akn:chp_1ב__sec_1_29__ssec_3_2_3/p1 akn:chp_1ב__sec_1_29__ssec_3_2_3/p2 akn:chp_1ב__sec_1_29__ssec_3_2_3/p3 akn:chp_1ב__sec_1_29__ssec_3_2_3/p4 akn:chp_1ב__sec_1_29__ssec_3_2_3/p5
GIVEN e IS AN `equivalence file`
GIVETH AN `equivalent grade`
DECIDE `the most 3.2.3 allows` e IS
    IF NOT e's `an uncertified teacher`
    THEN `equivalent to doctorate`
    ELSE IF     e's `new to the system`
            AND e's `years since starting work` AT MOST 3
            AND e's `registered at a teacher-training institute`
         THEN `equivalent to BA`
         ELSE `no equivalent grade`

DECLARE `certification action` IS ONE OF
    `complete the studies for the senior teacher's certificate`
    `complete certification by reserve exams`

-- Time in years from the start of work (new teachers) or from the
-- obligation letter (permanent ones).
GIVETH A DEONTIC Party `certification action`
DECIDE `a new uncertified teacher's certificate` IS
    PARTY `the teaching employee`
    MUST  `complete the studies for the senior teacher's certificate`
    WITHIN 3
    LEST  BREACH BY `the teaching employee` BECAUSE "section 1.29.6, 3.2.3(1): a new uncertified teacher completes the studies for the senior teacher's certificate within 3 years of starting work; otherwise the equivalent grade is cancelled"

GIVETH A DEONTIC Party `certification action`
DECIDE `a permanent uncertified teacher's certification` IS
    PARTY `the teaching employee`
    MUST  `complete certification by reserve exams`
    WITHIN 4
    LEST  BREACH BY `the teaching employee` BECAUSE "section 1.29.6, 3.2.3(2): a teacher issued an obligation letter completes certification within 4 years"

#TRACE `a new uncertified teacher's certificate` AT 0 WITH
    PARTY `the teaching employee` DOES `complete the studies for the senior teacher's certificate` AT 3
#TRACE `a permanent uncertified teacher's certification` AT 0 WITH
    PARTY `the teaching employee` DOES `complete certification by reserve exams` AT 5

-- F-1.29-o: the only equivalent grade 3.2.3 names for a new uncertified
-- teacher.
`the equivalent grades 3.2.3 opens to a new uncertified teacher` MEANS LIST `equivalent to BA`
`3.2.3 is silent on the MA and doctorate equivalents for a new uncertified teacher` MEANS
        NOT (elem `equivalent to MA` `the equivalent grades 3.2.3 opens to a new uncertified teacher`)
    AND NOT (elem `equivalent to doctorate` `the equivalent grades 3.2.3 opens to a new uncertified teacher`)
#ASSERT `3.2.3 is silent on the MA and doctorate equivalents for a new uncertified teacher`

-- 3.2.4 and its notes: points for B.Ed./M.Ed. in sacred subjects (no
-- figure in the corpus); the M.Ed. points replace the B.Ed. points; a BA
-- studied at a university earns no equivalent grading.
@ref akn:chp_1ב__sec_1_29__ssec_3_2_4 akn:chp_1ב__sec_1_29__ssec_3_2_4/p2 akn:chp_1ב__sec_1_29__ssec_3_2_4__para_1 akn:chp_1ב__sec_1_29__ssec_3_2_4__para_2
GIVEN `points for a B.Ed.` IS A NUMBER, `points for an M.Ed.` IS A NUMBER, `has an M.Ed.` IS A BOOLEAN, `studied for a university BA` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `points for college studies` `points for a B.Ed.` `points for an M.Ed.` `has an M.Ed.` `studied for a university BA` IS
    IF `studied for a university BA`
    THEN 0
    ELSE IF `has an M.Ed.` THEN `points for an M.Ed.` ELSE `points for a B.Ed.`

-- F-1.29-l: 1.3 bars every degree holder, while 3.2.4 awards points for
-- the B.Ed. and M.Ed. degrees themselves.
-- A yeshiva graduate's file for the examples below: eight yeshiva years,
-- teaching half a position with a sacred-subjects teaching certificate.
GIVEN `with a degree` IS A BOOLEAN
      `college points` IS A NUMBER
      `Gemara exams` IS A NUMBER
      `the 150-page exam` IS A BOOLEAN
      `publication points` IS A NUMBER
GIVETH AN `equivalence file`
DECIDE `an example file` `with a degree` `college points` `Gemara exams` `the 150-page exam` `publication points` IS
    `equivalence file` WITH
        `teaches sacred subjects`               IS TRUE
        `fraction taught in the year of application` IS 0.5
        `yeshiva years after 18 or 12th grade`  IS 8
        `a teaching certificate for sacred subjects` IS TRUE
        `Shulchan Aruch exams passed`           IS FALSE
        `rabbinic ordination`                   IS FALSE
        `Gemara exams passed`                   IS `Gemara exams`
        `passed the 150-page exam`              IS `the 150-page exam`
        `points from the Rabbinate's certificates` IS 0
        `points from college studies`           IS `college points`
        `points from publications`              IS `publication points`
        `highest points for one publication`    IS 0
        `defended the publication if asked`     IS FALSE
        `a dayanut or city-rabbi certificate`   IS FALSE
        `a "yoreh yoreh" certificate`           IS FALSE
        `a dayanut-fitness certificate`         IS FALSE
        `holds an academic degree`              IS `with a degree`
        `holds matriculation`                   IS TRUE
        `a senior certified teacher's certificate not used for the grade` IS FALSE
        `an uncertified teacher`                IS FALSE
        `new to the system`                     IS FALSE
        `years since starting work`             IS 10
        `registered at a teacher-training institute` IS FALSE

`a teacher with a B.Ed. in sacred subjects` MEANS `an example file` TRUE 10 2 FALSE 0

`3.2.4 scores a degree that 1.3 bars` MEANS
        `barred by 1.3` `a teacher with a B.Ed. in sacred subjects`
    AND `a teacher with a B.Ed. in sacred subjects`'s `points from college studies` GREATER THAN 0
    AND `the equivalent grade` `a teacher with a B.Ed. in sacred subjects` EQUALS `no equivalent grade`
#ASSERT `3.2.4 scores a degree that 1.3 bars`

-- 3.2.5: a written exam on 30 pages with Rashi and Tosafot in one tractate,
-- 3 points, at most 15 (five exams), passing at 75; the committee's
-- confirmation; the schedule and the site.
@ref akn:chp_1ב__sec_1_29__ssec_3_2_5/p1 akn:chp_1ב__sec_1_29__ssec_3_2_5/p2 akn:chp_1ב__sec_1_29__ssec_3_2_5/p3 akn:chp_1ב__sec_1_29__ssec_3_2_5/p4 akn:chp_1ב__sec_1_29__ssec_3_2_5/p5 akn:chp_1ב__sec_1_29__ssec_3_2_5/p6 akn:chp_1ב__sec_1_29__ssec_3_2_5/p7 akn:chp_1ב__sec_1_29__ssec_3_2_5/p8
GIVEN e IS AN `equivalence file`
GIVETH A NUMBER
DECIDE `points for Gemara exams` e IS
    min 15 (3 TIMES e's `Gemara exams passed`)

-- 4, note: no publication points without one of 2.2's documents.
-- F-1.29-m: 2.2.4 makes publication points themselves one of 2.2's
-- alternatives; read as needing one of 2.2.1-2.2.3.
@ref akn:chp_1ב__sec_1_29__ssec_4/p1 akn:chp_1ב__sec_1_29__ssec_4/p2
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `may apply for publication points` e IF
        (e's `a dayanut or city-rabbi certificate` AND e's `Gemara exams passed` AT LEAST 1)
    OR  (e's `a "yoreh yoreh" certificate` AND (e's `Gemara exams passed` AT LEAST 1 OR e's `Shulchan Aruch exams passed`))
    OR  e's `passed the 150-page exam`

`a teacher whose only 2.2 route is publications` MEANS `an example file` FALSE 0 0 FALSE 30

`2.2.4 is open only to one who already meets 2.2.1-2.2.3` MEANS
        `one of the 2.2 certificates` `a teacher whose only 2.2 route is publications`
    AND NOT `may apply for publication points` `a teacher whose only 2.2 route is publications`
#ASSERT `2.2.4 is open only to one who already meets 2.2.1-2.2.3`

-- 4.1-4.8 (one label row and the paragraphs the corpus runs them into).
-- 4.9's table of points is a separate document the corpus does not carry;
-- the points are the committee's input.
@ref akn:chp_1ב__sec_1_29__ssec_4_1 akn:chp_1ב__sec_1_29__ssec_4_1/p1 akn:chp_1ב__sec_1_29__ssec_4_1/p2 akn:chp_1ב__sec_1_29__ssec_4_1/p3 akn:chp_1ב__sec_1_29__ssec_4_1/p4 akn:chp_1ב__sec_1_29__ssec_4_1/p5 akn:chp_1ב__sec_1_29__ssec_4_1/p6 akn:chp_1ב__sec_1_29__ssec_4_1/p7 akn:chp_1ב__sec_1_29__ssec_4_1/p8 akn:chp_1ב__sec_1_29__ssec_4_1/p9 akn:chp_1ב__sec_1_29__ssec_4_1/p10 akn:chp_1ב__sec_1_29__ssec_4_1/p11 akn:chp_1ב__sec_1_29__ssec_4_1/p12 akn:chp_1ב__sec_1_29__ssec_4_1/p13
GIVEN p IS A `publication`
GIVETH A BOOLEAN
DECIDE `the publication may earn points` p IF
        p's `printed`
    AND p's `words` AT LEAST (IF p's `a book` THEN 50000 ELSE 5000)
    AND (p's `a book` OR `the journal qualifies under 4.3` p)
    AND p's `copies distributed` AT LEAST 250
    AND p's `recognised libraries holding it` AT LEAST 10
    AND p's `sent to the listed libraries`
    AND p's `significant novelty in the committee's eyes`
    AND (NOT p's `sermons, source anthologies, arrangement or editing`)
    AND (NOT p's `used for professional advancement`)
    AND p's `all the documents of 4.8`

-- 4.3: an article's journal has an editor, a board and a publisher with an
-- address (no proof needed for a journal the committee recognised), comes
-- out every two years at least, and has reached its third issue (from
-- then on, articles in its first two count too).
GIVEN p IS A `publication`
GIVETH A BOOLEAN
DECIDE `the journal qualifies under 4.3` p IF
        (p's `journal has editor, board and publisher with address` OR p's `journal recognised by the committee`)
    AND p's `journal appears every two years at least`
    AND p's `journal issue number` AT LEAST 3

-- 4.6: a defence before the committee, if asked, for a publication earning
-- 10 points or more.
GIVEN `points for the publication` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `may be asked to defend it` `points for the publication` IF
    `points for the publication` AT LEAST 10

@desc A publication submitted for points, as far as 4.1-4.8 ask about it.
DECLARE `publication` HAS
    `a book`                          IS A BOOLEAN @desc a book; otherwise an article
    `printed`                         IS A BOOLEAN @desc printed as or in a booklet; not only on the internet
    `words`                           IS A NUMBER
    `journal has editor, board and publisher with address` IS A BOOLEAN
    `journal recognised by the committee` IS A BOOLEAN @desc a journal the committee has recognised need not prove the editor, board and publisher (4.3א)
    `journal appears every two years at least` IS A BOOLEAN
    `journal issue number`            IS A NUMBER
    `copies distributed`              IS A NUMBER
    `recognised libraries holding it` IS A NUMBER
    `sent to the listed libraries`    IS A BOOLEAN @desc the National Library, the Rambam library, the Ramat Gan religious council library and 3 teacher-training college libraries
    `significant novelty in the committee's eyes` IS A BOOLEAN
    `sermons, source anthologies, arrangement or editing` IS A BOOLEAN
    `used for professional advancement` IS A BOOLEAN @desc used for Ofek Hadash, Oz LeTmura, academic studies and the like
    `all the documents of 4.8`        IS A BOOLEAN @desc two copies, a Word file, an abstract of up to 150 words, the list of 10 libraries, the printing receipt and invoice, the application form

-- 5 (p1) and 5.1-5.5. F-1.29-n: for a teacher in recognised unofficial
-- elementary education, 5.2 sends the doctorate and publications to the
-- unofficial division, and 5.4 and 5.5 send them to the grading department.
-- 5.4 and 5.5, which name the whole recognised unofficial system, are read
-- as governing; 5.2 keeps BA and MA.
@ref akn:chp_1ב__sec_1_29__ssec_5/p1 akn:chp_1ב__sec_1_29__ssec_5_1 akn:chp_1ב__sec_1_29__ssec_5_2__para_a akn:chp_1ב__sec_1_29__ssec_5_2__para_b akn:chp_1ב__sec_1_29__ssec_5_3/p1 akn:chp_1ב__sec_1_29__ssec_5_4/p1 akn:chp_1ב__sec_1_29__ssec_5_5/p1
GIVEN s IS A `system of employment`, w IS A `what is sought`
GIVETH A `where to apply`
DECIDE `the application goes to` s w IS
    CONSIDER w
    WHEN `doctorate equivalent`    THEN `the grading and certification department, Jerusalem`
    WHEN `points for publications` THEN `the grading and certification department, Jerusalem`
    WHEN `BA or MA equivalent` THEN
        CONSIDER s
        WHEN `official education` THEN `the district teaching-manpower section`
        WHEN `recognised unofficial elementary education` THEN `the recognised-unofficial division's manpower section, Jerusalem, through the owning body`
        WHEN `recognised unofficial secondary education` THEN `the district teaching-manpower section, through the owning body`

GIVEN w IS A `what is sought`
GIVETH A `where to apply`
DECIDE `where 5.2 sends an unofficial elementary teacher` w IS
    CONSIDER w
    WHEN `points for publications` THEN `the recognised-unofficial division's manpower section, Jerusalem, directly`
    OTHERWISE `the recognised-unofficial division's manpower section, Jerusalem, through the owning body`

`5.2 and 5.4 send an unofficial elementary teacher's doctorate to two places` MEANS
    NOT (`where 5.2 sends an unofficial elementary teacher` `doctorate equivalent`
         EQUALS `the application goes to` `recognised unofficial elementary education` `doctorate equivalent`)
#ASSERT `5.2 and 5.4 send an unofficial elementary teacher's doctorate to two places`

DECLARE `where to apply` IS ONE OF
    `the district teaching-manpower section`
    `the recognised-unofficial division's manpower section, Jerusalem, through the owning body`
    `the recognised-unofficial division's manpower section, Jerusalem, directly`
    `the district teaching-manpower section, through the owning body`
    `the grading and certification department, Jerusalem`

DECLARE `system of employment` IS ONE OF
    `official education`
    `recognised unofficial elementary education`
    `recognised unofficial secondary education`

DECLARE `what is sought` IS ONE OF
    `BA or MA equivalent`
    `doctorate equivalent`
    `points for publications`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p2
GIVEN `times the composition was changed` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `may change the composition of the points` `times the composition was changed` IF
    `times the composition was changed` LESS THAN 1

-- akn:chp_1ב__sec_1_29__ssec_5_5/p3 The heading "נספחים" (annexes); the annexes are not in the corpus text.

§§ `1.29.6 The equivalent grade`

-- The grade 2.1-2.3 give, unless 1.3 bars it, and no higher than 3.2.3
-- allows an uncertified teacher.
GIVEN g IS AN `equivalent grade`
GIVETH A NUMBER
DECIDE `equivalent rank` g IS
    CONSIDER g
    WHEN `equivalent to doctorate` THEN 3
    WHEN `equivalent to MA`        THEN 2
    WHEN `equivalent to BA`        THEN 1
    OTHERWISE 0

GIVEN e IS AN `equivalence file`
GIVETH AN `equivalent grade`
DECIDE `the equivalent grade` e IS
    IF `barred by 1.3` e
    THEN `no equivalent grade`
    ELSE IF `equivalent rank` (`the grade 2.1-2.3 give` e) AT MOST `equivalent rank` (`the most 3.2.3 allows` e)
         THEN `the grade 2.1-2.3 give` e
         ELSE `the most 3.2.3 allows` e

-- Worked examples. All points are placeholders where the corpus gives none.
`a yeshiva graduate with eight years and five Gemara exams` MEANS `an example file` FALSE 0 5 TRUE 0

#ASSERT `points` `a yeshiva graduate with eight years and five Gemara exams` EQUALS 39
#ASSERT `the equivalent grade` `a yeshiva graduate with eight years and five Gemara exams` EQUALS `equivalent to BA`
#ASSERT `points for a pre-2014 Torah-education certificate` TRUE FALSE EQUALS 0
