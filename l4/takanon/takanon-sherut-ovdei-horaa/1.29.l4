        `seniority item` "24" "work as a sea officer in the merchant fleet or the Navy, for one moving to teach that profession, from the officer's rank" `in force` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p46
        `seniority item` "25" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p47
        `seniority item` "26" "work as a truant officer" `in force` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p48 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p49
        `seniority item` "27" "paid instruction in a youth movement by a certified teacher or youth instructor, after certification, at half a position" `in force until 31.8.2023, then under item 53` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p50
        `seniority item` "28" "social instructor at half a position in government-supervised boarding schools, as a certified teacher or youth instructor" `in force until 31.8.2023, then under item 53` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p51 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p52
        `seniority item` "29" "youth or sports instruction at half a position by a certified instructor, certified teacher or seminary graduate" `in force until 31.8.2023, then under item 53` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p53
        `seniority item` "30" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p54
        `seniority item` "31" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p55 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p56
        `seniority item` "32" "pedagogical assistant in special education at half a position, holding a teaching certification; half without it" `in force` TRUE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p57
        `seniority item` "33" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p58
        `seniority item` "34" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p59
        `seniority item` "35" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p60
        `seniority item` "36" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p61 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p62 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p63
        `seniority item` "36(א)" "unpaid leave for which the employee paid 18.5% of salary to buy rights (the Civil Service notice of 15.6.92 applied to teachers paid by government ministries); or an unpaid-leave year, not through the training funds, in which pension rights are bought in a recognised fund" `in force` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p65
        `seniority item` "37" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p66 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p67 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p68
        `seniority item` "38" "a training year from the teachers' training funds, on its confirmation; split over two consecutive years at half the grant each without teaching, the two count as one; from 2.9.90" `in force` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p69
        `seniority item` "39" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p70
        `seniority item` "40" "folded into item 38" `folded into another item` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p71
        `seniority item` "41" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p72 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p73
        `seniority item` "42" "teaching abroad in a government-supervised school or kindergarten or a Hebrew-language school at a third of a position, as a government-seminary graduate with 13 years' schooling, certified; half without teaching certification" `in force` TRUE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p74
        `seniority item` "43" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p75
        `seniority item` "44" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p76
        `seniority item` "45" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p77
        `seniority item` "46" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p78
        `seniority item` "47" "teaching Hebrew or Jewish studies in a school abroad on an educational mission" `in force` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p79
        `seniority item` "48" "folded into item 42" `folded into another item` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p80 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p81 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p82
        `seniority item` "48(א)" "unpaid leave in which the employee worked abroad for Amia or Eitan at a third of a position, on the State's representation's confirmation; from 1.9.2000" `in force` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p83
        `seniority item` "49" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p84 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p85 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p86 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p87 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p88
        `seniority item` "50" "certified teachers in Sunday schools abroad for the children of Israeli emissaries, under a third of a position: every 12 accumulated weekly hours, each year at least 150 days, earn one year; half without teaching certification" `in force` TRUE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p89
        `seniority item` "51" "cancelled" `cancelled` FALSE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p90 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p91 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p92
        `seniority item` "52" "a rabbi with a higher rabbinical education certificate who served as a rabbi and serves as a school rabbi or teacher of Oral Law or Jewish thought, from the year he qualified for an equivalent academic grade; from 1.4.92; half without teaching certification" `in force` TRUE,
        @ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p93 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p94 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p95
        `seniority item` "53" "a worker in a workplace of at least 4 employees whose main role (at least 50%) was instructing groups of 3 or more face to face, on HR's confirmation, at half a position for six months of a school year; from 1.9.2023" `in force from 1.9.2023` FALSE

-- The rule over the list: what one qualifying year of the item's work earns.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p11
GIVEN i IS A `seniority item`
      `held the qualification` IS A BOOLEAN @desc held, while working, the qualification the item names for full credit
      `school year starting in` IS A NUMBER @desc the calendar year in which the school year of the work began
GIVETH A NUMBER
DECIDE `seniority earned for a year under` i `held the qualification` `school year starting in` IS
    CONSIDER i's `status`
    WHEN `cancelled`                 THEN 0
    WHEN `folded into another item`  THEN 0
    WHEN `in force until 31.8.2023, then under item 53` THEN
        IF `school year starting in` AT LEAST 2023 THEN 0 ELSE `the item's full or half credit` i `held the qualification`
    WHEN `in force from 1.9.2023` THEN
        IF `school year starting in` AT LEAST 2023 THEN `the item's full or half credit` i `held the qualification` ELSE 0
    OTHERWISE `the item's full or half credit` i `held the qualification`

GIVEN i IS A `seniority item`, `held the qualification` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `the item's full or half credit` i `held the qualification` IS
    IF i's `half without the qualification` AND (NOT `held the qualification`)
    THEN 0.5
    ELSE 1

GIVEN n IS A STRING
GIVETH A LIST OF `seniority item`
DECIDE `item` n IS
    filter (GIVEN i YIELD i's `item number` EQUALS n) `the salary-seniority items`

-- Item 8's hours: at most 100 counted in a month (100 a month is a full
-- position), and six months of work in the year at least.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p23
GIVEN `hours worked in each month` IS A LIST OF NUMBER
GIVETH A NUMBER
DECIDE `a substitute's hours counted` `hours worked in each month` IS
    sum (map (GIVEN h YIELD min h 100) `hours worked in each month`)

GIVEN `hours worked in each month` IS A LIST OF NUMBER
      `a secondary school, seminary or college` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a substitute's year qualifies by hours under item 8` `hours worked in each month` `a secondary school, seminary or college` IF
        count (filter (GIVEN h YIELD h GREATER THAN 0) `hours worked in each month`) AT LEAST 6
    AND `a substitute's hours counted` `hours worked in each month` AT LEAST (IF `a secondary school, seminary or college` THEN 300 ELSE 375)

#ASSERT `a substitute's hours counted` (LIST 80, 130) EQUALS 180

-- F-1.29-f: section 1.30 gives the substitute full seniority on the same
-- 375 hours with neither the monthly cap nor six months' work.
GIVEN `hours worked in each month` IS A LIST OF NUMBER
GIVETH A BOOLEAN
DECIDE `full seniority by hours under section 1.30` `hours worked in each month` IF
    sum `hours worked in each month` AT LEAST 375

`four months of 100 hours` MEANS LIST 100, 100, 100, 100
`sections 1.29 and 1.30 disagree on a substitute's 400 hours in four months` MEANS
        `full seniority by hours under section 1.30` `four months of 100 hours`
    AND NOT `a substitute's year qualifies by hours under item 8` `four months of 100 hours` FALSE
#ASSERT `sections 1.29 and 1.30 disagree on a substitute's 400 hours in four months`

-- Item 13: the officer service earns at most 28 years of seniority.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p30
GIVEN `years of qualifying officer service` IS A NUMBER
GIVETH A NUMBER
DECIDE `seniority for officer service under item 13` `years of qualifying officer service` IS
    min `years of qualifying officer service` 28

-- Item 38: a training year split over two years at half the grant is one.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p67
GIVEN `consecutive years at half the grant, without teaching` IS A NUMBER
GIVETH A NUMBER
DECIDE `seniority for a split training year` `consecutive years at half the grant, without teaching` IS
    FLOOR (`consecutive years at half the grant, without teaching` DIVIDED BY 2)

-- Item 50: every 12 weekly hours accumulated, over years of at least 150
-- days each, earn one year. Its two worked examples hold.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p85 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p86 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p87
GIVEN `weekly hours in each year of at least 150 days` IS A LIST OF NUMBER
GIVETH A NUMBER
DECIDE `seniority for Sunday-school teaching` `weekly hours in each year of at least 150 days` IS
    FLOOR (sum `weekly hours in each year of at least 150 days` DIVIDED BY 12)

#ASSERT `seniority for Sunday-school teaching` (LIST 3, 4, 5) EQUALS 1
#ASSERT `seniority for Sunday-school teaching` (LIST 6, 6) EQUALS 1

-- F-1.29-d: item 12 makes its credit depend on "all the following
-- conditions" and lists none; F-1.29-e: item 36(א)'s application is to be
-- made "with:" a list that is not there.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p29
GIVETH A LIST OF STRING
DECIDE `the conditions item 12 lists` IS EMPTY
`item 12 announces conditions and lists none` MEANS null `the conditions item 12 lists`
#ASSERT `item 12 announces conditions and lists none`

@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p64
GIVETH A LIST OF STRING
DECIDE `the documents an item 36(א) application attaches` IS EMPTY
`item 36(א)'s application names no attachments` MEANS null `the documents an item 36(א) application attaches`
#ASSERT `item 36(א)'s application names no attachments`

-- akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p96 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p97 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p98 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p99 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p100 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p101 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p102 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p103 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p104 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p105 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p106 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p107 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p108 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p109 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p110 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p111 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p112 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p113 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p114 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p115 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p116 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p117 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p118 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p119 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p120 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p121 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p122 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p123 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p124 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p125 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p126 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p127 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p128 akn:chp_1ב__sec_1_29__ssec_1_29_3_2/p129 Sources (אסמכתא) of 1.29.3.2.

#ASSERT `seniority earned for a year under` (at (`item` "32") 0) FALSE 2020 EQUALS 0.5
#ASSERT `seniority earned for a year under` (at (`item` "27") 0) TRUE 2024 EQUALS 0
#ASSERT `seniority earned for a year under` (at (`item` "53") 0) TRUE 2024 EQUALS 1

§§ `1.29.3.3 ותק וצ.ה.ל`

DECLARE `service sex` IS ONE OF `a man`, `a woman`

@desc A teaching employee's compulsory (or national, or civil) service, as far as 1.29.3.3 asks about it.
DECLARE `compulsory service` HAS
    `served as`                     IS A `service sex`
    `service began`                 IS A DATE
    `service ended`                 IS A DATE
    `months actually served`        IS A NUMBER
    `an officer obliged to extra regular service as compulsory` IS A BOOLEAN
    `a disabled veteran who could not complete it` IS A BOOLEAN @desc an IDF disabled veteran who did not complete the full compulsory service because of the disability
    `full term of the period in months` IS A NUMBER @desc the full compulsory term of the period of discharge, for a disabled veteran (the takanon names 2.5 or 3 years)

@desc The bodies 1.29.3.3 sends a declaration or a confirmation to. Section-local: the takanon's shared Party has no district section, clerk or officer.
DECLARE `1.29.3.3 party` IS ONE OF
    `the teaching employee`
    `the district teaching-manpower section`
    `the district manpower clerk`
    `the district manpower officer`
    `the owning body`
    `the employer`

DECLARE `IDF seniority action` IS ONE OF
    `declare the compulsory service to the district section`
    `send the declaration to the owning body`
    `check the declaration and pass it for payment`
    `give the Disabled Veterans' confirmation to the district manpower clerk`
    `give the Disabled Veterans' confirmation to the owning body`
    `confirm the entitlement and send a payment order to the treasury`
    `apply to the employer to check the entitlement`
    `give the national-service confirmation to the district manpower officer`
    `give the national-service confirmation to the owning body`
    `check the confirmation and pass it to the district treasury for payment`

-- (1)-(3): recognised on the employee's declaration (dates of the service,
-- and whether today's increments already count it), sent to the district
-- teaching-manpower section, which checks it and passes it for payment; an
-- employee not of the Ministry sends it to the owning body. The specimen
-- form (1) announces is not in the text.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_1 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_2 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_3 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_3/p2
GIVEN `a Ministry employee` IS A BOOLEAN
GIVETH A DEONTIC `1.29.3.3 party` `IDF seniority action`
DECIDE `recognising compulsory service` `a Ministry employee` IS
    IF `a Ministry employee`
    THEN PARTY `the teaching employee`
         MAY   `declare the compulsory service to the district section`
         HENCE (PARTY `the district teaching-manpower section`
                MUST  `check the declaration and pass it for payment`
                LEST  BREACH BY `the district teaching-manpower section` BECAUSE "section 1.29.3.3(3): the district section checks the declaration and passes it for payment")
    ELSE PARTY `the teaching employee`
         MAY   `send the declaration to the owning body`

#TRACE `recognising compulsory service` TRUE AT 0 WITH
    PARTY `the teaching employee` DOES `declare the compulsory service to the district section` AT 1
    PARTY `the district teaching-manpower section` DOES `check the declaration and pass it for payment` AT 3

-- (4) and (6): for salary only — the combined salary and every increment
-- figured as a percentage of it — and not for rights built on seniority
-- (pension accrual, vacation and recuperation quotas) or for increments
-- that follow years of seniority (education and literature increments).
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_4 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_6
GIVEN u IS A `use of seniority`
GIVETH A BOOLEAN
DECIDE `IDF seniority counts for` u IF
    u EQUALS `the combined salary and increments figured on it`

DECLARE `use of seniority` IS ONE OF
    `the combined salary and increments figured on it`
    `pension accrual`
    `vacation and recuperation quotas`
    `the education and literature increment`
    `other rights built on seniority`

-- (5): never more increments than the maximum (36, 1.29.3.1(2)).
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_5
GIVEN `seniority from teaching` IS A NUMBER, `years of IDF seniority` IS A NUMBER
GIVETH A NUMBER
DECIDE `increments paid with the IDF years` `seniority from teaching` `years of IDF seniority` IS
    min 36 (`seniority from teaching` PLUS `years of IDF seniority`)

#ASSERT `increments paid with the IDF years` 35 3 EQUALS 36

@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_7
`the IDF seniority arrangement applies from` MEANS DATE_FROM_DMY 1 4 1980

-- (10): advancement by the service actually done, never past the months
-- the law fixed in each period. F-1.29-h: the periods are dated, and the
-- text does not say which date of a service places it in one; this file
-- places it by the day it began. The women's two periods both include
-- 13.2.1950; the later one is read as starting the day after.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10/p2 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_1__subpara_a akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_1__subpara_b akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_1__subpara_c akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_a akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_b
GIVEN s IS A `sex and date`
GIVETH A NUMBER
DECIDE `the law's months for the period` s IS
    CONSIDER s's `whose service`
    WHEN `a man` THEN
        IF `day` (s's `the date`) AT LEAST `day` (DATE_FROM_DMY 7 1 1968) THEN 36 ELSE 30
    WHEN `a woman` THEN
        IF `day` (s's `the date`) GREATER THAN `day` (DATE_FROM_DMY 13 2 1950) THEN 24 ELSE 12

GIVEN s IS A `compulsory service`
GIVETH A NUMBER
DECIDE `months (10) allows` s IS
    min (s's `months actually served`) (`the law's months for the period` (`sex and date` (s's `served as`) (s's `service began`)))

DECLARE `sex and date` HAS
    `whose service` IS A `service sex`
    `the date`      IS A DATE

GIVEN d IS A DATE
GIVETH A NUMBER
DECIDE `day` d IS DATE_SERIAL d

`a man drafted in 1966 and discharged in 1969` MEANS
    `compulsory service` WITH
        `served as`                                   IS `a man`
        `service began`                               IS DATE_FROM_DMY 1 6 1966
        `service ended`                               IS DATE_FROM_DMY 1 6 1969
        `months actually served`                      IS 36
        `an officer obliged to extra regular service as compulsory` IS FALSE
        `a disabled veteran who could not complete it` IS FALSE
        `full term of the period in months`           IS 30

`the period table places a 1966-1969 service in two periods` MEANS
    NOT (`the law's months for the period` (`sex and date` `a man` (DATE_FROM_DMY 1 6 1966))
         EQUALS `the law's months for the period` (`sex and date` `a man` (DATE_FROM_DMY 1 6 1969)))
#ASSERT `the period table places a 1966-1969 service in two periods`

-- (8): three years at most, hesder yeshiva service included.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_8
`the most compulsory service can earn, in months` MEANS 36

-- The women officers' exception, in force from 1.9.94: every month
-- actually served, past 24 too. F-1.29-g: past 36 it meets (8)'s cap; this
-- file applies the cap.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_b/p2 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_b/p3
GIVEN s IS A `compulsory service`
GIVETH A BOOLEAN
DECIDE `the officers' exception applies` s IF
    s's `served as` EQUALS `a woman` AND s's `an officer obliged to extra regular service as compulsory`

GIVEN s IS A `compulsory service`
GIVETH A NUMBER
DECIDE `months under the officers' exception alone` s IS
    s's `months actually served`

`a woman officer who served 40 months` MEANS
    `compulsory service` WITH
        `served as`                                   IS `a woman`
        `service began`                               IS DATE_FROM_DMY 1 8 1995
        `service ended`                               IS DATE_FROM_DMY 1 12 1998
        `months actually served`                      IS 40
        `an officer obliged to extra regular service as compulsory` IS TRUE
        `a disabled veteran who could not complete it` IS FALSE
        `full term of the period in months`           IS 24

`the officers' exception and the three-year cap differ at 40 months` MEANS
    NOT (`months of IDF seniority` `a woman officer who served 40 months`
         EQUALS `months under the officers' exception alone` `a woman officer who served 40 months`)
#ASSERT `the officers' exception and the three-year cap differ at 40 months`

-- A teacher who finds herself entitled under the exception asks her
-- employer to check the entitlement.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_b/p4
GIVETH A DEONTIC `1.29.3.3 party` `IDF seniority action`
DECIDE `realising the officers' exception` IS
    PARTY `the teaching employee`
    MAY   `apply to the employer to check the entitlement`

-- (9): the disabled veteran is paid for the full term, "2½ or 3 years (as
-- the compulsory-service rule was in the period of discharge)", for the
-- increment only, not for years with teaching seniority; confirmation from
-- the IDF Disabled Veterans' Organisation, given to the district manpower
-- clerk (Ministry employees) or to the owning body. F-1.29-i: the two
-- figures fit men's terms only; a woman's full term was 12 or 24 months.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_9
GIVEN s IS A `compulsory service`
GIVETH A NUMBER
DECIDE `months a disabled veteran is paid for under (9)` s IS
    s's `full term of the period in months`

GIVEN `the year earned teaching seniority` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `(9) reaches the year` `the year earned teaching seniority` IF
    NOT `the year earned teaching seniority`

GIVEN `a Ministry employee` IS A BOOLEAN
GIVETH A DEONTIC `1.29.3.3 party` `IDF seniority action`
DECIDE `the disabled veteran's confirmation` `a Ministry employee` IS
    IF `a Ministry employee`
    THEN PARTY `the teaching employee`
         MAY   `give the Disabled Veterans' confirmation to the district manpower clerk`
         HENCE (PARTY `the district manpower clerk`
                MUST  `confirm the entitlement and send a payment order to the treasury`
                LEST  BREACH BY `the district manpower clerk` BECAUSE "section 1.29.3.3(9): the district manpower clerk confirms the entitlement and sends a payment order to the treasury")
    ELSE PARTY `the teaching employee`
         MAY   `give the Disabled Veterans' confirmation to the owning body`

GIVEN `the term the text names, in months` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `a term (9) names` `the term the text names, in months` IF
    `the term the text names, in months` EQUALS 30 OR `the term the text names, in months` EQUALS 36

`a woman's full term is neither of (9)'s figures` MEANS
    NOT (`a term (9) names` (`the law's months for the period` (`sex and date` `a woman` (DATE_FROM_DMY 1 1 1990))))
#ASSERT `a woman's full term is neither of (9)'s figures`

-- (ג), (ד): national service of 40 weekly hours or more — 24 months earn
-- the maximum "as above" (24 months), 12 months earn one year; from
-- 1.10.94.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_c akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_d akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_d/p2
GIVEN `months of national service` IS A NUMBER, `weekly hours` IS A NUMBER
GIVETH A NUMBER
DECIDE `months of seniority for national service` `months of national service` `weekly hours` IS
    IF `weekly hours` LESS THAN 40
    THEN 0
    ELSE IF `months of national service` AT LEAST 24
         THEN 24
         ELSE IF `months of national service` AT LEAST 12
              THEN 12
              ELSE 0

`national service seniority applies from` MEANS DATE_FROM_DMY 1 10 1994

#ASSERT `months of seniority for national service` 14 40 EQUALS 12

-- The confirmations: from the volunteering associations named (p3), or for
-- service before them, through the Torah-culture department, from the
-- teaching-manpower division (p4); the teacher applies to the division in
-- her district with them; one paid by the Ministry hands the confirmation
-- to the district manpower officer, who checks it and passes it to the
-- district treasury; any other hands it to the owning body (p5).
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_d/p3 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_d/p4 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_10__hc_2__subpara_d/p5
GIVEN `served before the associations were founded` IS A BOOLEAN
GIVETH A STRING
DECIDE `who confirms the national service` `served before the associations were founded` IS
    IF `served before the associations were founded`
    THEN "the teaching-manpower division of the Ministry"
    ELSE "the Association for Volunteering in the Nation, or Aminadav"

GIVEN `a Ministry employee` IS A BOOLEAN
GIVETH A DEONTIC `1.29.3.3 party` `IDF seniority action`
DECIDE `the national-service confirmation` `a Ministry employee` IS
    IF `a Ministry employee`
    THEN PARTY `the teaching employee`
         MAY   `give the national-service confirmation to the district manpower officer`
         HENCE (PARTY `the district manpower officer`
                MUST  `check the confirmation and pass it to the district treasury for payment`
                LEST  BREACH BY `the district manpower officer` BECAUSE "section 1.29.3.3(10)(ד): the district manpower officer passes the confirmation, after checking it, to the district treasury for payment")
    ELSE PARTY `the teaching employee`
         MAY   `give the national-service confirmation to the owning body`

-- (11): civil service for men, by the National-Civic Service Law's
-- tracks: social, 30 weekly hours for two years or 20 for three; security,
-- 36 for two years. F-1.29-j: how much seniority it earns is not stated.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_11 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_11/p2 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_11/p3 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_11/p4 akn:chp_1ב__sec_1_29__ssec_1_29_3_3__para_11/p5
GIVEN `average weekly hours` IS A NUMBER, `years served` IS A NUMBER, `security track` IS A BOOLEAN
GIVETH A `civil service track`
DECIDE `the civil service track met` `average weekly hours` `years served` `security track` IS
    IF `security track`
    THEN IF `average weekly hours` AT LEAST 36 AND `years served` AT LEAST 2
         THEN `security, 36 weekly hours for two years`
         ELSE `no track met`
    ELSE IF `average weekly hours` AT LEAST 30 AND `years served` AT LEAST 2
         THEN `social, 30 weekly hours for two years`
         ELSE IF `average weekly hours` AT LEAST 20 AND `years served` AT LEAST 3
              THEN `social, 20 weekly hours for three years`
              ELSE `no track met`

DECLARE `civil service track` IS ONE OF
    `social, 30 weekly hours for two years`
    `social, 20 weekly hours for three years`
    `security, 36 weekly hours for two years`
    `no track met`

GIVEN t IS A `civil service track`
GIVETH A MAYBE NUMBER
DECIDE `months of seniority the text gives for civil service` t IS NOTHING

`civil service earns IDF seniority of no stated amount` MEANS
        NOT (`the civil service track met` 30 2 FALSE EQUALS `no track met`)
    AND `months of seniority the text gives for civil service` (`the civil service track met` 30 2 FALSE) EQUALS NOTHING
#ASSERT `civil service earns IDF seniority of no stated amount`

-- akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p1 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p2 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p3 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p4 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p5 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p6 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p7 akn:chp_1ב__sec_1_29__ssec_1_29_3_3/p8 Sources (אסמכתא) of 1.29.3.3.

§§ `1.29.3.3 Months of IDF seniority`

-- (10)'s months, the officers' exception and (9)'s full term, under (8)'s
-- cap of three years.
GIVEN s IS A `compulsory service`
GIVETH A NUMBER
DECIDE `months of IDF seniority` s IS
    min `the most compulsory service can earn, in months`
        (IF s's `a disabled veteran who could not complete it`
         THEN `months a disabled veteran is paid for under (9)` s
         ELSE IF `the officers' exception applies` s
              THEN `months under the officers' exception alone` s
              ELSE `months (10) allows` s)

#ASSERT `months of IDF seniority` `a man drafted in 1966 and discharged in 1969` EQUALS 30

§§ `1.29.6 דרגות שכר שוות ערך — yeshiva graduates`

-- akn:chp_1ב__sec_1_29__ssec_1_29_6/p1 The circular's number and title, reproduced as the subsection's opening line.
-- akn:chp_1ב__sec_1_29__ssec_1_29_6/p2 The heading "1. כללי".

@desc A yeshiva graduate's application for an equivalent academic grade, as far as 1.29.6 asks about it.
DECLARE `equivalence file` HAS
    `teaches sacred subjects`               IS A BOOLEAN @desc teaches Talmud/Oral Law, Jewish thought or Bible in fact
    `fraction taught in the year of application` IS A NUMBER
    `yeshiva years after 18 or 12th grade`  IS A NUMBER  @desc recognised years of study (3.1.2) in a recognised higher yeshiva
    `a teaching certificate for sacred subjects` IS A BOOLEAN @desc a certificate (on reserve exams), teaching certificate, permanent licence or licence to teach in Oral Law, with Jewish thought or Bible (1.2.1, first option)
    `Shulchan Aruch exams passed`           IS A BOOLEAN @desc confirmation of the Chief Rabbinate's Shulchan Aruch exams (3.2.2(2))
    `rabbinic ordination`                   IS A BOOLEAN @desc a certificate of rabbinic ordination (3.2.2(1))
    `Gemara exams passed`                   IS A NUMBER  @desc 30-page Gemara exams passed with 75 or more (3.2.5)
    `passed the 150-page exam`              IS A BOOLEAN
    `points from the Rabbinate's certificates` IS A NUMBER @desc points the Rabbinate's certificates earn; the corpus carries no figure for them, so it is an input
    `points from college studies`           IS A NUMBER  @desc points for B.Ed./M.Ed. studies in sacred subjects (3.2.4); the corpus carries no figure, so an input
    `points from publications`              IS A NUMBER  @desc points the committee awarded under the table of 4.9, which the corpus does not carry
    `highest points for one publication`    IS A NUMBER
    `defended the publication if asked`     IS A BOOLEAN
    `a dayanut or city-rabbi certificate`   IS A BOOLEAN @desc 2.2.1
    `a "yoreh yoreh" certificate`           IS A BOOLEAN @desc 2.2.2
    `a dayanut-fitness certificate`         IS A BOOLEAN @desc exempts from publication points for the doctorate (note to 2.3)
    `holds an academic degree`              IS A BOOLEAN @desc a degree from an institution of higher education (1.3)
    `holds matriculation`                   IS A BOOLEAN
    `a senior certified teacher's certificate not used for the grade` IS A BOOLEAN @desc 1.4
    `an uncertified teacher`                IS A BOOLEAN
    `new to the system`                     IS A BOOLEAN @desc a new uncertified teacher (3.2.3(1)), not one employed and permanent (3.2.3(2))
    `years since starting work`             IS A NUMBER
    `registered at a teacher-training institute` IS A BOOLEAN

DECLARE `equivalent grade` IS ONE OF
    `equivalent to BA`
    `equivalent to MA`
    `equivalent to doctorate`
    `no equivalent grade`

-- 1.1: a grading for salary only, for yeshiva graduates teaching sacred
-- subjects in fact.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p3
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `within the purpose of 1.29.6` e IF
    e's `teaches sacred subjects`

-- 1.2.1: the four alternatives ("or" between them, p6, p8, p10).
-- F-1.29-p: the second asks for "the completion of exams on Gemara pages"
-- and gives no number; set against the third's "one exam", the plural is
-- read as two exams at least.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p4 akn:chp_1ב__sec_1_29__ssec_1_29_6/p5 akn:chp_1ב__sec_1_29__ssec_1_29_6/p6 akn:chp_1ב__sec_1_29__ssec_1_29_6/p7 akn:chp_1ב__sec_1_29__ssec_1_29_6/p8 akn:chp_1ב__sec_1_29__ssec_1_29_6/p9 akn:chp_1ב__sec_1_29__ssec_1_29_6/p10 akn:chp_1ב__sec_1_29__ssec_1_29_6/p11
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `meets 1.2.1` e IF
        e's `a teaching certificate for sacred subjects`
    OR (e's `Shulchan Aruch exams passed` AND e's `Gemara exams passed` AT LEAST `Gemara exams the second alternative asks` AND `points` e AT LEAST 15)
    OR (e's `rabbinic ordination` AND e's `Gemara exams passed` AT LEAST 1 AND `points` e AT LEAST 15)
    OR e's `passed the 150-page exam`

`Gemara exams the second alternative asks` MEANS 2

-- F-1.29-p's evidence: a yeshiva graduate with the Shulchan Aruch
-- confirmations, no teaching certificate, eight yeshiva years (24 points)
-- and ONE Gemara exam (3): read as "one exam at least" he meets 1.2.1, read
-- as the plural he does not.
`a Shulchan Aruch graduate with one Gemara exam` MEANS
    `equivalence file` WITH
        `teaches sacred subjects`               IS TRUE
        `fraction taught in the year of application` IS 0.5
        `yeshiva years after 18 or 12th grade`  IS 8
        `a teaching certificate for sacred subjects` IS FALSE
        `Shulchan Aruch exams passed`           IS TRUE
        `rabbinic ordination`                   IS FALSE
        `Gemara exams passed`                   IS 1
        `passed the 150-page exam`              IS FALSE
        `points from the Rabbinate's certificates` IS 0
        `points from college studies`           IS 0
        `points from publications`              IS 0
        `highest points for one publication`    IS 0
        `defended the publication if asked`     IS FALSE
        `a dayanut or city-rabbi certificate`   IS FALSE
        `a "yoreh yoreh" certificate`           IS FALSE
        `a dayanut-fitness certificate`         IS FALSE
        `holds an academic degree`              IS FALSE
        `holds matriculation`                   IS TRUE
        `a senior certified teacher's certificate not used for the grade` IS FALSE
        `an uncertified teacher`                IS FALSE
        `new to the system`                     IS FALSE
        `years since starting work`             IS 10
        `registered at a teacher-training institute` IS FALSE

`"completion of Gemara exams" read as one exam and as more differ` MEANS
        `a Shulchan Aruch graduate with one Gemara exam`'s `Gemara exams passed` AT LEAST 1
    AND `points` `a Shulchan Aruch graduate with one Gemara exam` AT LEAST 15
    AND NOT `meets 1.2.1` `a Shulchan Aruch graduate with one Gemara exam`
#ASSERT `"completion of Gemara exams" read as one exam and as more differ`

-- 1.2.2, 1.2.3: four yeshiva years after 18 or 12th grade; teaching the
-- subjects at a third of a position in the year of application.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p12 akn:chp_1ב__sec_1_29__ssec_1_29_6/p13
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `meets the thresholds of 1.2` e IF
        `meets 1.2.1` e
    AND e's `yeshiva years after 18 or 12th grade` AT LEAST 4
    AND e's `fraction taught in the year of application` AT LEAST 1/3

-- 1.2.4: points for a study or certificate are given once only; the file
-- holds each source once.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p14 akn:chp_1ב__sec_1_29__ssec_2/p1
GIVEN e IS AN `equivalence file`
GIVETH A NUMBER
DECIDE `points` e IS
        `points for yeshiva years` e
    PLUS `points for Gemara exams` e
    PLUS e's `points from the Rabbinate's certificates`
    PLUS e's `points from college studies`
    PLUS e's `points from publications`

-- 1.3: not for teachers who received an academic degree. F-1.29-l: 3.2.4
-- gives points for B.Ed. and M.Ed. degrees in sacred subjects.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p15
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `barred by 1.3` e IF
    e's `holds an academic degree`

-- 1.4: without matriculation, with a senior certified teacher's certificate
-- not used for the equivalent grade: a double title.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p16
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `entitled to a double title` e IF
        (NOT e's `holds matriculation`)
    AND e's `a senior certified teacher's certificate not used for the grade`
    AND (NOT (`the equivalent grade` e EQUALS `no equivalent grade`))

-- 1.5: higher Torah-education certificates on exams to 31.8.14 earn 15
-- points only if submitted by 31.12.14.
@ref akn:chp_1ב__sec_1_29__ssec_1_29_6/p17
GIVEN `exams held by 31.8.14` IS A BOOLEAN, `submitted by 31.12.14` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `points for a pre-2014 Torah-education certificate` `exams held by 31.8.14` `submitted by 31.12.14` IS
    IF `exams held by 31.8.14` AND (NOT `submitted by 31.12.14`) THEN 0 ELSE 15

-- 2.1-2.3 and 2.2.1-2.2.4, 2.3.1-2.3.2 and the note to 2.3.
-- F-1.29-k: 2.2.1 asks for "one Gemara exam as detailed above, in 1.2.3",
-- and 1.2.3 is the teaching load; read as 3.2.5's Gemara exam.
@ref akn:chp_1ב__sec_1_29__ssec_2_1 akn:chp_1ב__sec_1_29__ssec_2_2 akn:chp_1ב__sec_1_29__ssec_2_2_1 akn:chp_1ב__sec_1_29__ssec_2_2_1/p2 akn:chp_1ב__sec_1_29__ssec_2_2_2 akn:chp_1ב__sec_1_29__ssec_2_2_2/p2 akn:chp_1ב__sec_1_29__ssec_2_2_3 akn:chp_1ב__sec_1_29__ssec_2_2_4 akn:chp_1ב__sec_1_29__ssec_2_3 akn:chp_1ב__sec_1_29__ssec_2_3_1 akn:chp_1ב__sec_1_29__ssec_2_3_1/p2
GIVEN e IS AN `equivalence file`
GIVETH AN `equivalent grade`
DECIDE `the grade 2.1-2.3 give` e IS
    IF NOT `meets the thresholds of 1.2` e
    THEN `no equivalent grade`
    ELSE IF e's `yeshiva years after 18 or 12th grade` AT LEAST 7 AND `points` e AT LEAST 75
            AND `one of the 2.2 certificates` e AND `the doctorate's publications` e
         THEN `equivalent to doctorate`
         ELSE IF `points` e AT LEAST 55 AND `one of the 2.2 certificates` e
              THEN `equivalent to MA`
              ELSE IF `points` e AT LEAST 30
                   THEN `equivalent to BA`
                   ELSE `no equivalent grade`

-- F-1.29-k: what 1.2.3 is about, against what 2.2.1 cites it for.
GIVETH A STRING
DECIDE `what 1.2.3 requires` IS "teaching the sacred subjects at a third of a position in the year of application"

`2.2.1 cites 1.2.3 for a Gemara exam it does not hold` MEANS
    NOT (`what 1.2.3 requires` EQUALS "one Gemara exam")
#ASSERT `2.2.1 cites 1.2.3 for a Gemara exam it does not hold`

GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `one of the 2.2 certificates` e IF
        (e's `a dayanut or city-rabbi certificate` AND e's `Gemara exams passed` AT LEAST 1)
    OR  (e's `a "yoreh yoreh" certificate` AND (e's `Gemara exams passed` AT LEAST 1 OR e's `Shulchan Aruch exams passed`))
    OR  e's `passed the 150-page exam`
    OR  e's `points from publications` GREATER THAN 0

GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `the doctorate's publications` e IF
        e's `a dayanut-fitness certificate`
    OR (e's `highest points for one publication` AT LEAST 10
        AND e's `points from publications` AT LEAST 20
        AND e's `defended the publication if asked`)

-- 3.1.1 (yeshiva, kolel or hesder yeshiva recognised by the one authorised)
-- and 3.1.2 (a year runs Elul to Av, counted for 10 continuous months at 35
-- weekly hours, without months of regular army service).
@ref akn:chp_1ב__sec_1_29__ssec_3_1_1 akn:chp_1ב__sec_1_29__ssec_3_1_2
GIVEN `a yeshiva recognised by the one authorised` IS A BOOLEAN @desc a higher yeshiva, a kolel or a hesder yeshiva so recognised (3.1.1)
      `continuous months studied` IS A NUMBER @desc in the year from Elul to Av, months of actual regular army service left out
      `weekly hours` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `a recognised year of yeshiva study` `a yeshiva recognised by the one authorised` `continuous months studied` `weekly hours` IF
        `a yeshiva recognised by the one authorised`
    AND `continuous months studied` AT LEAST 10
    AND `weekly hours` AT LEAST 35

-- 3.1.3: in the first four years, no work at all; after them, work of 16
-- weekly hours at most. 3.1.4: no points for years studied in parallel for
-- a degree or certificate.
@ref akn:chp_1ב__sec_1_29__ssec_3_1_3__para_a akn:chp_1ב__sec_1_29__ssec_3_1_4/p1
GIVEN `which year of study` IS A NUMBER, `weekly hours worked` IS A NUMBER, `studied for a degree in parallel` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the yeshiva year earns points` `which year of study` `weekly hours worked` `studied for a degree in parallel` IF
        (NOT `studied for a degree in parallel`)
    AND (IF `which year of study` AT MOST 4
         THEN `weekly hours worked` EQUALS 0
         ELSE `weekly hours worked` AT MOST 16)

-- 3.2.1: 3 points a year, at most 30; signed confirmations of the head of
-- the yeshiva.
@ref akn:chp_1ב__sec_1_29__ssec_3_2_1/p1 akn:chp_1ב__sec_1_29__ssec_3_2_1/p2 akn:chp_1ב__sec_1_29__ssec_3_2_1/p3 akn:chp_1ב__sec_1_29__ssec_3_2_1/p4 akn:chp_1ב__sec_1_29__ssec_3_2_1/p5 akn:chp_1ב__sec_1_29__ssec_3_2_1/p6
GIVEN e IS AN `equivalence file`
GIVETH A NUMBER
DECIDE `points for yeshiva years` e IS
    min 30 (3 TIMES e's `yeshiva years after 18 or 12th grade`)

-- 3.2.2: the Rabbinate's ordination certificates and Shulchan Aruch exam
-- confirmations; the corpus gives no points for them (an input above).
@ref akn:chp_1ב__sec_1_29__ssec_3_2_2__para_1 akn:chp_1ב__sec_1_29__ssec_3_2_2__para_2
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `holds a Rabbinate certificate` e IF
    e's `rabbinic ordination` OR e's `Shulchan Aruch exams passed`

-- 3.2.3 (as the corpus prints it, under the heading of studies for teaching
-- sacred subjects: "ה. the status of uncertified teachers"): a new
-- uncertified teacher finishes the senior teacher's certificate within 3
-- years, and may have the BA-equivalent set within them if registered at
-- an institute; failing that, the equivalent grade is cancelled. A
-- permanent uncertified teacher gets none, and completes certification by
-- reserve exams (within 4 years, once issued an obligation letter).
-- F-1.29-o: what 3.2.3 opens to the new uncertified teacher is the BA
-- equivalent alone; this file reads it as the most that teacher can get.
@ref akn:chp_1ב__sec_1_29__ssec_3_2_3/p1 akn:chp_1ב__sec_1_29__ssec_3_2_3/p2 akn:chp_1ב__sec_1_29__ssec_3_2_3/p3 akn:chp_1ב__sec_1_29__ssec_3_2_3/p4 akn:chp_1ב__sec_1_29__ssec_3_2_3/p5
GIVEN e IS AN `equivalence file`
GIVETH AN `equivalent grade`
DECIDE `the most 3.2.3 allows` e IS
    IF NOT e's `an uncertified teacher`
    THEN `equivalent to doctorate`
    ELSE IF     e's `new to the system`
            AND e's `years since starting work` AT MOST 3
            AND e's `registered at a teacher-training institute`
         THEN `equivalent to BA`
         ELSE `no equivalent grade`

DECLARE `certification action` IS ONE OF
    `complete the studies for the senior teacher's certificate`
    `complete certification by reserve exams`

-- Time in years from the start of work (new teachers) or from the
-- obligation letter (permanent ones).
GIVETH A DEONTIC Party `certification action`
DECIDE `a new uncertified teacher's certificate` IS
    PARTY `the teaching employee`
    MUST  `complete the studies for the senior teacher's certificate`
    WITHIN 3
    LEST  BREACH BY `the teaching employee` BECAUSE "section 1.29.6, 3.2.3(1): a new uncertified teacher completes the studies for the senior teacher's certificate within 3 years of starting work; otherwise the equivalent grade is cancelled"

GIVETH A DEONTIC Party `certification action`
DECIDE `a permanent uncertified teacher's certification` IS
    PARTY `the teaching employee`
    MUST  `complete certification by reserve exams`
    WITHIN 4
    LEST  BREACH BY `the teaching employee` BECAUSE "section 1.29.6, 3.2.3(2): a teacher issued an obligation letter completes certification within 4 years"

#TRACE `a new uncertified teacher's certificate` AT 0 WITH
    PARTY `the teaching employee` DOES `complete the studies for the senior teacher's certificate` AT 3
#TRACE `a permanent uncertified teacher's certification` AT 0 WITH
    PARTY `the teaching employee` DOES `complete certification by reserve exams` AT 5

-- F-1.29-o: the only equivalent grade 3.2.3 names for a new uncertified
-- teacher.
`the equivalent grades 3.2.3 opens to a new uncertified teacher` MEANS LIST `equivalent to BA`
`3.2.3 is silent on the MA and doctorate equivalents for a new uncertified teacher` MEANS
        NOT (elem `equivalent to MA` `the equivalent grades 3.2.3 opens to a new uncertified teacher`)
    AND NOT (elem `equivalent to doctorate` `the equivalent grades 3.2.3 opens to a new uncertified teacher`)
#ASSERT `3.2.3 is silent on the MA and doctorate equivalents for a new uncertified teacher`

-- 3.2.4 and its notes: points for B.Ed./M.Ed. in sacred subjects (no
-- figure in the corpus); the M.Ed. points replace the B.Ed. points; a BA
-- studied at a university earns no equivalent grading.
@ref akn:chp_1ב__sec_1_29__ssec_3_2_4 akn:chp_1ב__sec_1_29__ssec_3_2_4/p2 akn:chp_1ב__sec_1_29__ssec_3_2_4__para_1 akn:chp_1ב__sec_1_29__ssec_3_2_4__para_2
GIVEN `points for a B.Ed.` IS A NUMBER, `points for an M.Ed.` IS A NUMBER, `has an M.Ed.` IS A BOOLEAN, `studied for a university BA` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `points for college studies` `points for a B.Ed.` `points for an M.Ed.` `has an M.Ed.` `studied for a university BA` IS
    IF `studied for a university BA`
    THEN 0
    ELSE IF `has an M.Ed.` THEN `points for an M.Ed.` ELSE `points for a B.Ed.`

-- F-1.29-l: 1.3 bars every degree holder, while 3.2.4 awards points for
-- the B.Ed. and M.Ed. degrees themselves.
-- A yeshiva graduate's file for the examples below: eight yeshiva years,
-- teaching half a position with a sacred-subjects teaching certificate.
GIVEN `with a degree` IS A BOOLEAN
      `college points` IS A NUMBER
      `Gemara exams` IS A NUMBER
      `the 150-page exam` IS A BOOLEAN
      `publication points` IS A NUMBER
GIVETH AN `equivalence file`
DECIDE `an example file` `with a degree` `college points` `Gemara exams` `the 150-page exam` `publication points` IS
    `equivalence file` WITH
        `teaches sacred subjects`               IS TRUE
        `fraction taught in the year of application` IS 0.5
        `yeshiva years after 18 or 12th grade`  IS 8
        `a teaching certificate for sacred subjects` IS TRUE
        `Shulchan Aruch exams passed`           IS FALSE
        `rabbinic ordination`                   IS FALSE
        `Gemara exams passed`                   IS `Gemara exams`
        `passed the 150-page exam`              IS `the 150-page exam`
        `points from the Rabbinate's certificates` IS 0
        `points from college studies`           IS `college points`
        `points from publications`              IS `publication points`
        `highest points for one publication`    IS 0
        `defended the publication if asked`     IS FALSE
        `a dayanut or city-rabbi certificate`   IS FALSE
        `a "yoreh yoreh" certificate`           IS FALSE
        `a dayanut-fitness certificate`         IS FALSE
        `holds an academic degree`              IS `with a degree`
        `holds matriculation`                   IS TRUE
        `a senior certified teacher's certificate not used for the grade` IS FALSE
        `an uncertified teacher`                IS FALSE
        `new to the system`                     IS FALSE
        `years since starting work`             IS 10
        `registered at a teacher-training institute` IS FALSE

`a teacher with a B.Ed. in sacred subjects` MEANS `an example file` TRUE 10 2 FALSE 0

`3.2.4 scores a degree that 1.3 bars` MEANS
        `barred by 1.3` `a teacher with a B.Ed. in sacred subjects`
    AND `a teacher with a B.Ed. in sacred subjects`'s `points from college studies` GREATER THAN 0
    AND `the equivalent grade` `a teacher with a B.Ed. in sacred subjects` EQUALS `no equivalent grade`
#ASSERT `3.2.4 scores a degree that 1.3 bars`

-- 3.2.5: a written exam on 30 pages with Rashi and Tosafot in one tractate,
-- 3 points, at most 15 (five exams), passing at 75; the committee's
-- confirmation; the schedule and the site.
@ref akn:chp_1ב__sec_1_29__ssec_3_2_5/p1 akn:chp_1ב__sec_1_29__ssec_3_2_5/p2 akn:chp_1ב__sec_1_29__ssec_3_2_5/p3 akn:chp_1ב__sec_1_29__ssec_3_2_5/p4 akn:chp_1ב__sec_1_29__ssec_3_2_5/p5 akn:chp_1ב__sec_1_29__ssec_3_2_5/p6 akn:chp_1ב__sec_1_29__ssec_3_2_5/p7 akn:chp_1ב__sec_1_29__ssec_3_2_5/p8
GIVEN e IS AN `equivalence file`
GIVETH A NUMBER
DECIDE `points for Gemara exams` e IS
    min 15 (3 TIMES e's `Gemara exams passed`)

-- 4, note: no publication points without one of 2.2's documents.
-- F-1.29-m: 2.2.4 makes publication points themselves one of 2.2's
-- alternatives; read as needing one of 2.2.1-2.2.3.
@ref akn:chp_1ב__sec_1_29__ssec_4/p1 akn:chp_1ב__sec_1_29__ssec_4/p2
GIVEN e IS AN `equivalence file`
GIVETH A BOOLEAN
DECIDE `may apply for publication points` e IF
        (e's `a dayanut or city-rabbi certificate` AND e's `Gemara exams passed` AT LEAST 1)
    OR  (e's `a "yoreh yoreh" certificate` AND (e's `Gemara exams passed` AT LEAST 1 OR e's `Shulchan Aruch exams passed`))
    OR  e's `passed the 150-page exam`

`a teacher whose only 2.2 route is publications` MEANS `an example file` FALSE 0 0 FALSE 30

`2.2.4 is open only to one who already meets 2.2.1-2.2.3` MEANS
        `one of the 2.2 certificates` `a teacher whose only 2.2 route is publications`
    AND NOT `may apply for publication points` `a teacher whose only 2.2 route is publications`
#ASSERT `2.2.4 is open only to one who already meets 2.2.1-2.2.3`

-- 4.1-4.8 (one label row and the paragraphs the corpus runs them into).
-- 4.9's table of points is a separate document the corpus does not carry;
-- the points are the committee's input.
@ref akn:chp_1ב__sec_1_29__ssec_4_1 akn:chp_1ב__sec_1_29__ssec_4_1/p1 akn:chp_1ב__sec_1_29__ssec_4_1/p2 akn:chp_1ב__sec_1_29__ssec_4_1/p3 akn:chp_1ב__sec_1_29__ssec_4_1/p4 akn:chp_1ב__sec_1_29__ssec_4_1/p5 akn:chp_1ב__sec_1_29__ssec_4_1/p6 akn:chp_1ב__sec_1_29__ssec_4_1/p7 akn:chp_1ב__sec_1_29__ssec_4_1/p8 akn:chp_1ב__sec_1_29__ssec_4_1/p9 akn:chp_1ב__sec_1_29__ssec_4_1/p10 akn:chp_1ב__sec_1_29__ssec_4_1/p11 akn:chp_1ב__sec_1_29__ssec_4_1/p12 akn:chp_1ב__sec_1_29__ssec_4_1/p13
GIVEN p IS A `publication`
GIVETH A BOOLEAN
DECIDE `the publication may earn points` p IF
        p's `printed`
    AND p's `words` AT LEAST (IF p's `a book` THEN 50000 ELSE 5000)
    AND (p's `a book` OR `the journal qualifies under 4.3` p)
    AND p's `copies distributed` AT LEAST 250
    AND p's `recognised libraries holding it` AT LEAST 10
    AND p's `sent to the listed libraries`
    AND p's `significant novelty in the committee's eyes`
    AND (NOT p's `sermons, source anthologies, arrangement or editing`)
    AND (NOT p's `used for professional advancement`)
    AND p's `all the documents of 4.8`

-- 4.3: an article's journal has an editor, a board and a publisher with an
-- address (no proof needed for a journal the committee recognised), comes
-- out every two years at least, and has reached its third issue (from
-- then on, articles in its first two count too).
GIVEN p IS A `publication`
GIVETH A BOOLEAN
DECIDE `the journal qualifies under 4.3` p IF
        (p's `journal has editor, board and publisher with address` OR p's `journal recognised by the committee`)
    AND p's `journal appears every two years at least`
    AND p's `journal issue number` AT LEAST 3

-- 4.6: a defence before the committee, if asked, for a publication earning
-- 10 points or more.
GIVEN `points for the publication` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `may be asked to defend it` `points for the publication` IF
    `points for the publication` AT LEAST 10

@desc A publication submitted for points, as far as 4.1-4.8 ask about it.
DECLARE `publication` HAS
    `a book`                          IS A BOOLEAN @desc a book; otherwise an article
    `printed`                         IS A BOOLEAN @desc printed as or in a booklet; not only on the internet
    `words`                           IS A NUMBER
    `journal has editor, board and publisher with address` IS A BOOLEAN
    `journal recognised by the committee` IS A BOOLEAN @desc a journal the committee has recognised need not prove the editor, board and publisher (4.3א)
    `journal appears every two years at least` IS A BOOLEAN
    `journal issue number`            IS A NUMBER
    `copies distributed`              IS A NUMBER
    `recognised libraries holding it` IS A NUMBER
    `sent to the listed libraries`    IS A BOOLEAN @desc the National Library, the Rambam library, the Ramat Gan religious council library and 3 teacher-training college libraries
    `significant novelty in the committee's eyes` IS A BOOLEAN
    `sermons, source anthologies, arrangement or editing` IS A BOOLEAN
    `used for professional advancement` IS A BOOLEAN @desc used for Ofek Hadash, Oz LeTmura, academic studies and the like
    `all the documents of 4.8`        IS A BOOLEAN @desc two copies, a Word file, an abstract of up to 150 words, the list of 10 libraries, the printing receipt and invoice, the application form

-- 5 (p1) and 5.1-5.5. F-1.29-n: for a teacher in recognised unofficial
-- elementary education, 5.2 sends the doctorate and publications to the
-- unofficial division, and 5.4 and 5.5 send them to the grading department.
-- 5.4 and 5.5, which name the whole recognised unofficial system, are read
-- as governing; 5.2 keeps BA and MA.
@ref akn:chp_1ב__sec_1_29__ssec_5/p1 akn:chp_1ב__sec_1_29__ssec_5_1 akn:chp_1ב__sec_1_29__ssec_5_2__para_a akn:chp_1ב__sec_1_29__ssec_5_2__para_b akn:chp_1ב__sec_1_29__ssec_5_3/p1 akn:chp_1ב__sec_1_29__ssec_5_4/p1 akn:chp_1ב__sec_1_29__ssec_5_5/p1
GIVEN s IS A `system of employment`, w IS A `what is sought`
GIVETH A `where to apply`
DECIDE `the application goes to` s w IS
    CONSIDER w
    WHEN `doctorate equivalent`    THEN `the grading and certification department, Jerusalem`
    WHEN `points for publications` THEN `the grading and certification department, Jerusalem`
    WHEN `BA or MA equivalent` THEN
        CONSIDER s
        WHEN `official education` THEN `the district teaching-manpower section`
        WHEN `recognised unofficial elementary education` THEN `the recognised-unofficial division's manpower section, Jerusalem, through the owning body`
        WHEN `recognised unofficial secondary education` THEN `the district teaching-manpower section, through the owning body`

GIVEN w IS A `what is sought`
GIVETH A `where to apply`
DECIDE `where 5.2 sends an unofficial elementary teacher` w IS
    CONSIDER w
    WHEN `points for publications` THEN `the recognised-unofficial division's manpower section, Jerusalem, directly`
    OTHERWISE `the recognised-unofficial division's manpower section, Jerusalem, through the owning body`

`5.2 and 5.4 send an unofficial elementary teacher's doctorate to two places` MEANS
    NOT (`where 5.2 sends an unofficial elementary teacher` `doctorate equivalent`
         EQUALS `the application goes to` `recognised unofficial elementary education` `doctorate equivalent`)
#ASSERT `5.2 and 5.4 send an unofficial elementary teacher's doctorate to two places`

DECLARE `where to apply` IS ONE OF
    `the district teaching-manpower section`
    `the recognised-unofficial division's manpower section, Jerusalem, through the owning body`
    `the recognised-unofficial division's manpower section, Jerusalem, directly`
    `the district teaching-manpower section, through the owning body`
    `the grading and certification department, Jerusalem`

DECLARE `system of employment` IS ONE OF
    `official education`
    `recognised unofficial elementary education`
    `recognised unofficial secondary education`

DECLARE `what is sought` IS ONE OF
    `BA or MA equivalent`
    `doctorate equivalent`
    `points for publications`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p2
GIVEN `times the composition was changed` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `may change the composition of the points` `times the composition was changed` IF
    `times the composition was changed` LESS THAN 1

-- akn:chp_1ב__sec_1_29__ssec_5_5/p3 The heading "נספחים" (annexes) of 1.29.6.1.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p4 akn:chp_1ב__sec_1_29__ssec_5_5/p5 akn:chp_1ב__sec_1_29__ssec_5_5/p6 The titles of 1.29.6.1's annexes א-ג; their forms are not in the corpus text.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p7 akn:chp_1ב__sec_1_29__ssec_5_5/p8 The source (אסמכתא) of 1.29.6.1.

§§ `1.29.6 The equivalent grade`

-- The grade 2.1-2.3 give, unless 1.3 bars it, and no higher than 3.2.3
-- allows an uncertified teacher.
GIVEN g IS AN `equivalent grade`
GIVETH A NUMBER
DECIDE `equivalent rank` g IS
    CONSIDER g
    WHEN `equivalent to doctorate` THEN 3
    WHEN `equivalent to MA`        THEN 2
    WHEN `equivalent to BA`        THEN 1
    OTHERWISE 0

GIVEN e IS AN `equivalence file`
GIVETH AN `equivalent grade`
DECIDE `the equivalent grade` e IS
    IF `barred by 1.3` e
    THEN `no equivalent grade`
    ELSE IF `equivalent rank` (`the grade 2.1-2.3 give` e) AT MOST `equivalent rank` (`the most 3.2.3 allows` e)
         THEN `the grade 2.1-2.3 give` e
         ELSE `the most 3.2.3 allows` e

-- Worked examples. All points are placeholders where the corpus gives none.
`a yeshiva graduate with eight years and five Gemara exams` MEANS `an example file` FALSE 0 5 TRUE 0

#ASSERT `points` `a yeshiva graduate with eight years and five Gemara exams` EQUALS 39
#ASSERT `the equivalent grade` `a yeshiva graduate with eight years and five Gemara exams` EQUALS `equivalent to BA`
#ASSERT `points for a pre-2014 Torah-education certificate` TRUE FALSE EQUALS 0

§§ `1.29.6.2 מורות ליהדות בוגרות מכללה`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p9 The heading of 1.29.6.2 (women teachers of Judaism who graduated a college), printed as a line of 1.29.5.5.

@desc A teacher applying under 1.29.6.2, as far as it asks.
DECLARE `Judaism teacher's file` HAS
    `teaches Bible, Oral Law or Jewish thought` IS A BOOLEAN
    `a B.Ed. from an Israeli academic college of education` IS A BOOLEAN
    `a BA-equivalent grade under the 1.6.93 circular` IS A BOOLEAN
    `credit points under ג(1-6)` IS A NUMBER @desc points by the criteria of ג; ג prints study hours and no points (F-1.29-r), so the points are an input
    `credit points under ג6` IS A NUMBER @desc points by "the criterion of ג6", which ג does not print (F-1.29-r): an input
    `began the MA-equivalent studies before 1.9.97` IS A BOOLEAN

-- א: a teacher of Bible, Oral Law or Jewish thought with a B.Ed. from an
-- Israeli academic college of education and 25 credit points under ג(1-6)
-- is entitled to the MA-equivalent grade. ב: a teacher of any subject with
-- the BA-equivalent grade and 25 points under ג6 likewise. F-1.29-r: ג
-- prints four items of study hours and no points, and no ג5 or ג6; the
-- points are taken as inputs.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p10 akn:chp_1ב__sec_1_29__ssec_5_5/p11
GIVEN f IS A `Judaism teacher's file`
GIVETH A BOOLEAN
DECIDE `entitled to the MA-equivalent grade under 1.29.6.2` f IF
        (    f's `teaches Bible, Oral Law or Jewish thought`
         AND f's `a B.Ed. from an Israeli academic college of education`
         AND f's `credit points under ג(1-6)` AT LEAST 25)
    OR  (    f's `a BA-equivalent grade under the 1.6.93 circular`
         AND f's `credit points under ג6` AT LEAST 25)

`the items ג prints` MEANS LIST 1, 2, 3, 4
`ג prints no criterion 6` MEANS NOT (elem 6 `the items ג prints`)
#ASSERT `ג prints no criterion 6`

-- ג(1)-(4): the study hours required for the MA-equivalent grade, by what
-- the teacher holds and the subject she continues in: 840 hours in the
-- same specialisation; plus 180 in the subject she is certified to teach;
-- plus 360 in the subject of her B.Ed. or BA grade; plus 720 in a third
-- subject (her base being an MA-equivalent grade in ג(4), as printed).
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p12 akn:chp_1ב__sec_1_29__ssec_5_5/p13 akn:chp_1ב__sec_1_29__ssec_5_5/p14 akn:chp_1ב__sec_1_29__ssec_5_5/p15 akn:chp_1ב__sec_1_29__ssec_5_5/p16 akn:chp_1ב__sec_1_29__ssec_5_5/p17
DECLARE `subject of the MA studies` IS ONE OF
    `the same specialisation` @desc ג(1): a teaching certificate or licence for that subject
    `the subject she is certified to teach` @desc ג(2): certified in another subject than her degree's
    `the subject of her B.Ed. or BA grade` @desc ג(3)
    `a third subject` @desc ג(4)

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p14 akn:chp_1ב__sec_1_29__ssec_5_5/p15 akn:chp_1ב__sec_1_29__ssec_5_5/p16 akn:chp_1ב__sec_1_29__ssec_5_5/p17
GIVEN s IS A `subject of the MA studies`
GIVETH A NUMBER
DECIDE `study hours required` s IS
    CONSIDER s
    WHEN `the same specialisation` THEN 840
    WHEN `the subject she is certified to teach` THEN 840 PLUS 180
    WHEN `the subject of her B.Ed. or BA grade` THEN 840 PLUS 360
    WHEN `a third subject` THEN 840 PLUS 720

-- From 1.9.97; a teacher who began the MA-equivalent studies before then
-- gets the grade under the old instructions (section 105 of circular נד/2,
-- named, not reproduced).
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p18 akn:chp_1ב__sec_1_29__ssec_5_5/p19
GIVEN f IS A `Judaism teacher's file`
GIVETH A BOOLEAN
DECIDE `the old instructions govern` f IF
    f's `began the MA-equivalent studies before 1.9.97`

-- ד: the teacher applies to her employer; one seeking points for
-- publications to the teaching-manpower department. She submits only what
-- the grade needs; surplus studies or publications may go to the training
-- rewards, and surplus points earn no training reward. The employer
-- forwards the application with everything to the grading and
-- certification department, Jerusalem; applications under ג(1-5) go to the
-- committee for Torah education. The department tells the employer the
-- grade, and the employer tells the teacher. From 1.9.93, replacing
-- section 104 of circular מד/4.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p20 The heading of ד (applications and commencement).
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p21 akn:chp_1ב__sec_1_29__ssec_5_5/p22
GIVEN `seeks points for publications` IS A BOOLEAN
GIVETH A Party
DECIDE `where a 1.29.6.2 application is made` `seeks points for publications` IS
    IF `seeks points for publications` THEN `the Ministry of Education` ELSE `the employer`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p23 akn:chp_1ב__sec_1_29__ssec_5_5/p24
GIVEN `points from the documents` IS A NUMBER, `points the grade needs` IS A NUMBER
GIVETH A NUMBER
DECIDE `surplus points that earn a training reward` `points from the documents` `points the grade needs` IS
    0

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p25 akn:chp_1ב__sec_1_29__ssec_5_5/p26
DECLARE `grading action` IS ONE OF
    `forward the application with all its documents to the grading department`
    `tell the employer the teacher's grade`
    `tell the teacher her grade`
    `notify the employee of the grade and seniority`
    `send a copy of the determination to the manpower division`
    `decide the doubtful or exceptional case`
    `correct the salary from the month of discovery`
    `notify the Accountant General of the overpayment`
    `notify the official in charge of employees' affairs`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p25 akn:chp_1ב__sec_1_29__ssec_5_5/p26
GIVETH A DEONTIC Party `grading action`
DECIDE `handling a 1.29.6.2 application` IS
    PARTY `the employer`
    MUST  `forward the application with all its documents to the grading department`
    HENCE PARTY `the Ministry of Education`
          MUST  `tell the employer the teacher's grade`
          HENCE PARTY `the employer`
                MUST  `tell the teacher her grade`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p25
GIVEN `based on ג(1-5)` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `discussed by the Torah education committee` `based on ג(1-5)` IF
    `based on ג(1-5)`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p27 akn:chp_1ב__sec_1_29__ssec_5_5/p28 Commencement (1.9.93) and the section 104 of circular מד/4 it replaces.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p29 akn:chp_1ב__sec_1_29__ssec_5_5/p30 akn:chp_1ב__sec_1_29__ssec_5_5/p31 akn:chp_1ב__sec_1_29__ssec_5_5/p32 The sources (אסמכתא) of 1.29.6.2.

§§ `1.29.6.3 דרגות שכר שוות ערך למורים במקצועות ההכשרה`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p33 akn:chp_1ב__sec_1_29__ssec_5_5/p34 The heading of 1.29.6.3 and of its א (introduction).
-- akn:chp_1ב__sec_1_29__ssec_5_5/p35 א1: the purpose — letting teacher-training institutions employ artists and teachers of stature where no formal academic route exists; a statement of purpose, no rule.

-- א2: the committee for equivalent grades.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p36
`the 1.29.6.3 committee` MEANS
    LIST "the teacher-training department's representative (chair)",
         "the national subject supervisor",
         "the head of the grading department",
         "the conditions-of-service department's representative",
         "the colleges' cells' representative in the union",
         "the head of the teacher-training department's manpower branch"

-- ב: only teachers of music, art, theatre, film and television, dance, and
-- physical-education skills may apply, with matriculation or a teaching
-- certification at any level; a teacher without pedagogical education
-- completes it during the trial period at the college, and no tenure is
-- given without it.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p37 The heading of ב (principles).
@desc The subjects 1.29.6.3 ב(1) lets apply.
DECLARE `training subject` IS ONE OF
    `music`, `art`, `theatre`, `film and television`, `dance`, `physical-education skills`, `another subject`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p38 akn:chp_1ב__sec_1_29__ssec_5_5/p39
GIVEN s IS A `training subject`, `matriculation or a teaching certification` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `may apply under 1.29.6.3` s `matriculation or a teaching certification` IF
    (NOT (s EQUALS `another subject`)) AND `matriculation or a teaching certification`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p40
GIVEN `completed pedagogical education` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `may be given tenure at the college` `completed pedagogical education` IF
    `completed pedagogical education`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p40
DECLARE `college action` IS ONE OF
    `complete pedagogical education`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p40
GIVEN `trial period in years` IS A NUMBER
GIVETH A DEONTIC Party `college action`
DECIDE `completing pedagogical education` `trial period in years` IS
    PARTY `the teaching employee`
    MUST  `complete pedagogical education`
    WITHIN `trial period in years`
    LEST  BREACH BY `the teaching employee` BECAUSE "section 1.29.6.3 ב(3): no tenure for one who did not complete his pedagogical education"

-- ג: cumulative points — 30 for the BA-equivalent grade, 55 for the
-- MA-equivalent one, which also needs at least 6 points under 4.2-4.4. A
-- B.A./B.Sc. in the subject taught, or a B.Ed. specialising in it, earns
-- 30. The tables of ג4 and ד1-5 are not in the text: their points are an
-- input.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p41 akn:chp_1ב__sec_1_29__ssec_5_5/p42 The heading of ג (the method) and its opening line.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p47 akn:chp_1ב__sec_1_29__ssec_5_5/p49 akn:chp_1ב__sec_1_29__ssec_5_5/p50 akn:chp_1ב__sec_1_29__ssec_5_5/p51 akn:chp_1ב__sec_1_29__ssec_5_5/p52 akn:chp_1ב__sec_1_29__ssec_5_5/p53 akn:chp_1ב__sec_1_29__ssec_5_5/p54 The headings of ג4's general table and ד's subject tables (art, music, physical-education skills, dance, drama-theatre-film-television), whose rows are not in the corpus text.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p43 akn:chp_1ב__sec_1_29__ssec_5_5/p44 akn:chp_1ב__sec_1_29__ssec_5_5/p46 akn:chp_1ב__sec_1_29__ssec_5_5/p48
GIVEN `holds a degree in the subject taught` IS A BOOLEAN
      `points under ג4 and ד` IS A NUMBER @desc points from the tables of ג4 and ד, which the corpus text does not carry
      `points under 4.2-4.4` IS A NUMBER
GIVETH AN `equivalent grade`
DECIDE `the 1.29.6.3 grade` `holds a degree in the subject taught` `points under ג4 and ד` `points under 4.2-4.4` IS
    LET p MEANS (IF `holds a degree in the subject taught` THEN 30 ELSE 0) PLUS `points under ג4 and ד`
    IN  IF p AT LEAST 55 AND `points under 4.2-4.4` AT LEAST 6
        THEN `equivalent to MA`
        ELSE IF p AT LEAST 30
             THEN `equivalent to BA`
             ELSE `no equivalent grade`

-- ג2: a teacher who received a training reward for a criterion of ג4 or ד
-- and is then given an equivalent grade stops receiving that reward from
-- the day the grade is approved ("יחלד", read as "יחדל", ceases).
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p45
GIVEN `the reward's criterion counted for the grade` IS A BOOLEAN, `the grade has been approved` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the training reward continues` `the reward's criterion counted for the grade` `the grade has been approved` IF
    NOT (`the reward's criterion counted for the grade` AND `the grade has been approved`)

-- akn:chp_1ב__sec_1_29__ssec_5_5/p55 akn:chp_1ב__sec_1_29__ssec_5_5/p56 The source (אסמכתא) of 1.29.6.3.

§§ `1.29.6.4 דרגות שכר שוות ערך לתואר ראשון לבוגרי מוסד להכשרת עובדי הוראה`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p57 The heading of 1.29.6.4.

-- 1: an institution may prepare graduates for the BA-equivalent grade after
-- a special committee finds it meets the criteria and the director-general
-- approves its recommendation.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p58
GIVEN `meets the criteria` IS A BOOLEAN, `the director-general approves` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `may prepare graduates for the BA-equivalent grade` `meets the criteria` `the director-general approves` IF
    `meets the criteria` AND `the director-general approves`

@desc A teacher-training institution, as far as 1.29.6.4(2) asks.
DECLARE `training institution` HAS
    `recognised`                         IS A BOOLEAN
    `years of experience`                IS A NUMBER
    `only teachers barred on principle from a university` IS A BOOLEAN
    `proven capacity, laboratories, library and staff` IS A BOOLEAN @desc ג: the proven capacity and the means it lists
    `serves several districts`           IS A BOOLEAN
    `teachers in its target pool`        IS A NUMBER
    `teachers in training`               IS A NUMBER

-- 2(א)-(ד): recognised, at least 20 years old, teaching only women teachers
-- barred on principle and conscience from a university; proven capacity;
-- serving several districts, a pool of at least 3,000 and at least 300 in
-- training.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p59 akn:chp_1ב__sec_1_29__ssec_5_5/p60 akn:chp_1ב__sec_1_29__ssec_5_5/p62 akn:chp_1ב__sec_1_29__ssec_5_5/p63
GIVEN i IS A `training institution`
GIVETH A BOOLEAN
DECIDE `meets the 1.29.6.4 criteria` i IF
        i's `recognised`
    AND i's `years of experience` AT LEAST 20
    AND i's `only teachers barred on principle from a university`
    AND i's `proven capacity, laboratories, library and staff`
    AND i's `serves several districts`
    AND i's `teachers in its target pool` AT LEAST 3000
    AND i's `teachers in training` AT LEAST 300

-- 2(ב): admitted are only teaching employees with a permanent post-primary
-- licence or a senior certified teacher's certificate for primary school,
-- from regular studies at a recognised institution, with an average of at
-- least "good" (80).
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p61
GIVEN `a permanent post-primary licence or a senior certified primary certificate, from regular studies` IS A BOOLEAN, `average grade` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `admitted to the 1.29.6.4 programme` `a permanent post-primary licence or a senior certified primary certificate, from regular studies` `average grade` IF
    `a permanent post-primary licence or a senior certified primary certificate, from regular studies` AND `average grade` AT LEAST 80

-- 3: a programme of at least a year, in one of two forms: 720 hours and two
-- seminar papers, or 480 hours, one seminar paper and two articles or a
-- book approved and published as 4 provides.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p64 akn:chp_1ב__sec_1_29__ssec_5_5/p65
GIVEN `years` IS A NUMBER, `hours` IS A NUMBER, `seminar papers` IS A NUMBER, `approved articles` IS A NUMBER, `an approved book` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the programme meets 1.29.6.4(3)` `years` `hours` `seminar papers` `approved articles` `an approved book` IF
        `years` AT LEAST 1
    AND (    (`hours` AT LEAST 720 AND `seminar papers` AT LEAST 2)
         OR  (`hours` AT LEAST 480 AND `seminar papers` AT LEAST 1 AND (`approved articles` AT LEAST 2 OR `an approved book`)))

-- 4: the publications committee — the head of the teaching-manpower
-- division (chair), representatives of the training and in-service
-- departments, the institution's supervisor, the head of grading and a
-- representative of the seminary; the chair may add members. Its tasks:
-- approving the subject in advance, approving the papers or book, approving
-- the journal or the way of publication.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p66 akn:chp_1ב__sec_1_29__ssec_5_5/p67 akn:chp_1ב__sec_1_29__ssec_5_5/p68
GIVEN `subject approved in advance` IS A BOOLEAN, `the papers approved` IS A BOOLEAN, `the journal approved` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a publication counts under 1.29.6.4` `subject approved in advance` `the papers approved` `the journal approved` IF
    `subject approved in advance` AND `the papers approved` AND `the journal approved`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p69 akn:chp_1ב__sec_1_29__ssec_5_5/p70 The source (אסמכתא) of 1.29.6.4.

§§ `1.29 הגדרות`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p71 akn:chp_1ב__sec_1_29__ssec_5_5/p72 The heading "הגדרות" and its scope line ("valid in this chapter only").
-- akn:chp_1ב__sec_1_29__ssec_5_5/p73 "דרגה" means a salary grade; the section uses the word in that sense throughout.

-- The kinds of institution and of employee the definitions name.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p74 akn:chp_1ב__sec_1_29__ssec_5_5/p75 akn:chp_1ב__sec_1_29__ssec_5_5/p76
DECLARE `defined institution` IS ONE OF
    `an approved institution for training teachers and kindergarten teachers` @desc also "a seminary for teaching employees": one approved by the Ministry
    `a recognised Hebrew institution abroad for training teachers` @desc a Hebrew seminary abroad the Ministry recognises
    `a primary school`
    `a middle school`
    `a continuation of a primary school`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p76
GIVEN i IS A `defined institution`
GIVETH A BOOLEAN
DECIDE `a post-primary institution` i IF
       i EQUALS `a continuation of a primary school`
    OR i EQUALS `a middle school`
    OR i EQUALS `an approved institution for training teachers and kindergarten teachers`

-- "מורה"/"עובד הוראה": anyone employed in teaching (a vocational instructor
-- included), supervision or management in any institution; "גננת": a
-- kindergarten teaching employee, not an assistant; "מנהל"/"מרכז": a
-- teaching employee in charge of a school; "work in teaching or education":
-- in a formal institution.
@desc A person's work, as far as the definitions ask.
DECLARE `defined work` IS ONE OF
    `teaching`, `vocational instruction`, `supervision`, `management of a school`,
    `teaching in a kindergarten`, `assisting a kindergarten teacher`, `other work`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p77 akn:chp_1ב__sec_1_29__ssec_5_5/p78 akn:chp_1ב__sec_1_29__ssec_5_5/p79
GIVEN w IS A `defined work`
GIVETH A BOOLEAN
DECIDE `a teaching employee by the definition` w IF
    (NOT (w EQUALS `assisting a kindergarten teacher`)) AND (NOT (w EQUALS `other work`))

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p80
GIVEN `in a formal institution` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `work in teaching or education` `in a formal institution` IF
    `in a formal institution`

-- "בחינות מילואים" are the Ministry's exams for uncertified teaching
-- employees toward a certified teacher's or kindergarten teacher's
-- certificate; "בחינות השלמה" its exams toward a permanent teaching or
-- instruction licence for middle and post-primary schools.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p81 akn:chp_1ב__sec_1_29__ssec_5_5/p82
DECLARE `Ministry exams` IS ONE OF
    `reserve exams` @desc toward a certified teacher's (primary) or certified kindergarten teacher's certificate
    `completion exams` @desc toward a permanent teaching or instruction licence (middle and post-primary)

-- "השכלה פדגוגית" and "השכלה עברית": each is any one of four.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p83 akn:chp_1ב__sec_1_29__ssec_5_5/p84 akn:chp_1ב__sec_1_29__ssec_5_5/p85 akn:chp_1ב__sec_1_29__ssec_5_5/p86 akn:chp_1ב__sec_1_29__ssec_5_5/p87
DECLARE `pedagogical education route` IS ONE OF
    `a teaching certificate from an approved or recognised foreign institution`
    `reserve or completion exams in the pedagogical subjects`
    `a secondary teaching certificate from a school of education at a recognised higher-education institution`
    `equivalent education the Ministry recognised`
    `none of these`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p83 akn:chp_1ב__sec_1_29__ssec_5_5/p84 akn:chp_1ב__sec_1_29__ssec_5_5/p85 akn:chp_1ב__sec_1_29__ssec_5_5/p86 akn:chp_1ב__sec_1_29__ssec_5_5/p87
GIVEN r IS A `pedagogical education route`
GIVETH A BOOLEAN
DECIDE `has pedagogical education` r IF
    NOT (r EQUALS `none of these`)

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p88 akn:chp_1ב__sec_1_29__ssec_5_5/p89 akn:chp_1ב__sec_1_29__ssec_5_5/p90 akn:chp_1ב__sec_1_29__ssec_5_5/p91 akn:chp_1ב__sec_1_29__ssec_5_5/p92
DECLARE `Hebrew education route` IS ONE OF
    `an Israeli matriculation certificate`
    `reserve exams in the Hebrew subjects`
    `graduating a recognised Hebrew institution abroad`
    `equivalent Hebrew education the Ministry recognised`
    `no Hebrew education`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p88 akn:chp_1ב__sec_1_29__ssec_5_5/p89 akn:chp_1ב__sec_1_29__ssec_5_5/p90 akn:chp_1ב__sec_1_29__ssec_5_5/p91 akn:chp_1ב__sec_1_29__ssec_5_5/p92
GIVEN r IS A `Hebrew education route`
GIVETH A BOOLEAN
DECIDE `has Hebrew education` r IF
    NOT (r EQUALS `no Hebrew education`)

-- The three classes of subject.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p93 akn:chp_1ב__sec_1_29__ssec_5_5/p94 akn:chp_1ב__sec_1_29__ssec_5_5/p95
DECLARE `subject class` IS ONE OF
    `Hebrew subjects`, `general subjects`, `pedagogical subjects`, `none of the classes`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p93 akn:chp_1ב__sec_1_29__ssec_5_5/p94 akn:chp_1ב__sec_1_29__ssec_5_5/p95
GIVEN s IS A STRING, `a kindergarten teacher` IS A BOOLEAN
GIVETH A `subject class`
DECIDE `the class of` s `a kindergarten teacher` IS
    IF elem s (LIST "לשון עברית", "הבעה עברית", "ספרות עברית", "תורה שבעל-פה", "יהדות", "תנ\"ך")
    THEN `Hebrew subjects`
    ELSE IF elem s (LIST "היסטוריה", "גאוגרפיה", "טבע", "מתמטיקה")
         THEN `general subjects`
         ELSE IF elem s (LIST "פסיכולוגיה", "פדגוגיה", "תורת החינוך ותולדותיו", "דידקטיקה כללית", "דידקטיקה מיוחדת")
                 OR (`a kindergarten teacher` AND elem s (LIST "תורת הגן", "תורת הבריאות"))
              THEN `pedagogical subjects`
              ELSE `none of the classes`

-- "Academic", "certified" and "uncertified" teacher: by the grade the
-- employee is entitled to under the takanon.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p96 akn:chp_1ב__sec_1_29__ssec_5_5/p97 akn:chp_1ב__sec_1_29__ssec_5_5/p98
DECLARE `teacher class` IS ONE OF
    `an academic teacher`, `a certified teacher`, `an uncertified teacher`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p96 akn:chp_1ב__sec_1_29__ssec_5_5/p97 akn:chp_1ב__sec_1_29__ssec_5_5/p98
GIVEN `entitled to an academic grade` IS A BOOLEAN, `entitled to the certified grade` IS A BOOLEAN
GIVETH A `teacher class`
DECIDE `the teacher class` `entitled to an academic grade` `entitled to the certified grade` IS
    IF `entitled to an academic grade`
    THEN `an academic teacher`
    ELSE IF `entitled to the certified grade`
         THEN `a certified teacher`
         ELSE `an uncertified teacher`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p99 akn:chp_1ב__sec_1_29__ssec_5_5/p100 akn:chp_1ב__sec_1_29__ssec_5_5/p101 akn:chp_1ב__sec_1_29__ssec_5_5/p102 The sources (אסמכתא) of the definitions.

§§ `1.29 הוראות נוהל וביצוע — א. כללי`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p103 akn:chp_1ב__sec_1_29__ssec_5_5/p104 The headings "הוראות נוהל וביצוע" and "א. כללי".

-- Setting the grade and seniority is the district manager's unless this
-- section says otherwise; a teaching employee always applies to the direct
-- employer — the district manager in official education, the owner in
-- unofficial education.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p105 akn:chp_1ב__sec_1_29__ssec_5_5/p106
GIVEN `official education` IS A BOOLEAN
GIVETH A Party
DECIDE `whom the teaching employee applies to` `official education` IS
    IF `official education` THEN `the district manager` ELSE `the local authority or owning body`

-- (1)(א): for this sub-chapter the heads of settlement education, Arab
-- education and culture, adult education, teacher training and in-service
-- training, and field-studies act with the district manager's authority,
-- each in its field.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p107 The heading of (1), determination by the district manager.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p108
`acting with the district manager's authority` MEANS
    LIST "the head of the settlement education division",
         "the head of the Arab education and culture department",
         "the head of the adult education department",
         "the head of the teacher training and in-service department",
         "the head of the field-studies department"

-- (1)(ב): the grade and seniority are set on the teaching-employee
-- questionnaire and the documents attached; the authorised official checks
-- every detail and signs; the district manager notifies the employee on
-- the "notice of grade, seniority" form (in post-primary education the
-- "determination of grade and seniority" form) and sends a copy, with its
-- grounds, to the manpower division.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p109 akn:chp_1ב__sec_1_29__ssec_5_5/p110
GIVEN `details and certificates checked and signed` IS A BOOLEAN
GIVETH A DEONTIC Party `grading action`
DECIDE `notifying the grade and seniority` `details and certificates checked and signed` IS
    IF `details and certificates checked and signed`
    THEN PARTY `the district manager`
         MUST  `notify the employee of the grade and seniority`
         HENCE PARTY `the district manager`
               MUST  `send a copy of the determination to the manpower division`
    ELSE FULFILLED

-- (1)(ג) and the paragraph after it: the district manager's approval of
-- the certified grade for a third-year student, or of the senior certified
-- grade for a third-year graduate who has not yet produced the certificate,
-- holds for one school year; without the certificate by its end the
-- employee is graded by the education he has.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p110 akn:chp_1ב__sec_1_29__ssec_5_5/p111
GIVEN `school years since the approval` IS A NUMBER, `certificate produced` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the provisional certified grade holds` `school years since the approval` `certificate produced` IF
    `certificate produced` OR `school years since the approval` LESS THAN 1

-- (2): the manpower division decides every doubtful or exceptional case
-- the district manager refers with his opinion, recognition of
-- administrative-educational seniority, grades or seniority on sworn
-- statements, equivalent grades, and the intermediate academic grade for
-- post-primary teachers.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p112 The heading of (2), determination by the manpower division.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p113
DECLARE `grading matter` IS ONE OF
    `an ordinary determination`
    `a doubtful or exceptional case`
    `administrative-educational seniority`
    `a grade or seniority on sworn statements`
    `an equivalent grade`
    `the intermediate academic grade, post-primary`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p105 akn:chp_1ב__sec_1_29__ssec_5_5/p113
GIVEN m IS A `grading matter`
GIVETH A Party
DECIDE `who determines` m IS
    IF m EQUALS `an ordinary determination`
    THEN `the district manager`
    ELSE `the Ministry of Education`

-- (3): an owner may set grade and seniority only for licensed employees
-- (permanent or temporary) or those for whom a licence was applied; the
-- senior teacher's grade on an Israeli approved seminary's certificate; BA
-- and MA grades on recognised Israeli degrees; one year of seniority for a
-- new employee who never taught; (ה) is cancelled; a receiving owner pays
-- by the Ministry's determination made at another owner; grade and
-- seniority of one employed in official education (not in seminaries) on
-- three original Ministry payslips.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p114 akn:chp_1ב__sec_1_29__ssec_5_5/p115 The heading of (3), determination by the owner, and its opening line.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p120 (ה) is cancelled and carries no rule.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p116
GIVEN `licensed, permanent or temporary` IS A BOOLEAN, `a licence was applied for` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the owner may set grade and seniority` `licensed, permanent or temporary` `a licence was applied for` IF
    `licensed, permanent or temporary` OR `a licence was applied for`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p117 akn:chp_1ב__sec_1_29__ssec_5_5/p118
DECLARE `basis of an owner's grade` IS ONE OF
    `a certificate of an approved Israeli seminary` @desc for the senior teacher's grade
    `a degree of a recognised Israeli institution` @desc for the BA and MA grades
    `a foreign degree`
    `three original Ministry payslips` @desc (ז), for one employed in official education

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p117 akn:chp_1ב__sec_1_29__ssec_5_5/p118 akn:chp_1ב__sec_1_29__ssec_5_5/p122
GIVEN b IS A `basis of an owner's grade`
GIVETH A BOOLEAN
DECIDE `the owner may grade on` b IF
    NOT (b EQUALS `a foreign degree`)

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p119
GIVEN `taught before` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `seniority an owner sets for a new teaching employee` `taught before` IS
    IF `taught before` THEN 0 ELSE 1

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p121
GIVEN `the Ministry's determination at the previous owner` IS A NUMBER, `the receiving owner's own view` IS A NUMBER
GIVETH A NUMBER
DECIDE `the grade the receiving owner pays by` `the Ministry's determination at the previous owner` `the receiving owner's own view` IS
    `the Ministry's determination at the previous owner`

-- (ח): copies of every determination with its documents go to the
-- manpower division in Jerusalem (owners in the North, Haifa and Tel Aviv
-- districts) or to the manpower sections (owners in the decentralised
-- districts: Jerusalem, Centre, South), and are filed with the owner.
-- (ט): in doubt, or without authority, the owner applies to the division in
-- Jerusalem or to the district office (decentralised districts), with the
-- certificates in original (a copy certified by a notary or the employer),
-- the foreign-diplomas equivalence where there is one, employers'
-- confirmations of the work with dates and position fractions, foreign
-- documents with a notarised Hebrew translation, and, with no file at the
-- Ministry, the questionnaires; the employer verifies the details;
-- incomplete applications are returned unhandled.
DECLARE `district` IS ONE OF
    `North`, `Haifa`, `Tel Aviv`, `Jerusalem`, `Centre`, `South`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p123 akn:chp_1ב__sec_1_29__ssec_5_5/p124 akn:chp_1ב__sec_1_29__ssec_5_5/p125
GIVEN d IS A `district`
GIVETH A BOOLEAN
DECIDE `a decentralised district` d IF
    d EQUALS `Jerusalem` OR d EQUALS `Centre` OR d EQUALS `South`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p123 akn:chp_1ב__sec_1_29__ssec_5_5/p124
GIVEN d IS A `district`
GIVETH A STRING
DECIDE `where an owner sends the copies` d IS
    IF `a decentralised district` d
    THEN "the teaching-manpower sections of the Ministry"
    ELSE "the teaching-manpower division, Jerusalem"

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p125 akn:chp_1ב__sec_1_29__ssec_5_5/p126 akn:chp_1ב__sec_1_29__ssec_5_5/p127
GIVEN `certificates in original or certified` IS A BOOLEAN
      `work confirmations with dates and fractions` IS A BOOLEAN
      `foreign documents translated` IS A BOOLEAN
      `questionnaires, where there is no file` IS A BOOLEAN
      `verified by the employer` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the owner's application is handled` `certificates in original or certified` `work confirmations with dates and fractions` `foreign documents translated` `questionnaires, where there is no file` `verified by the employer` IF
        `certificates in original or certified`
    AND `work confirmations with dates and fractions`
    AND `foreign documents translated`
    AND `questionnaires, where there is no file`
    AND `verified by the employer`

§§ `1.29 הוראות נוהל וביצוע — ב. ערר ושינויים`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p128 akn:chp_1ב__sec_1_29__ssec_5_5/p129 The headings "ב. הנחיות לערערים ולשינויים" and "(1) הגשת ערער".

-- (1)(א): a determination may be changed by the Ministry on its own
-- initiative, or on the employee's written appeal with documents, through
-- the district manager or the owner, who re-examine it.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p130 akn:chp_1ב__sec_1_29__ssec_5_5/p131
GIVEN `official education` IS A BOOLEAN
GIVETH A Party
DECIDE `whom an appeal is submitted to` `official education` IS
    `whom the teaching employee applies to` `official education`

-- (1)(ב)-(ג): an accepted appeal is notified (by the district manager, with
-- copies to the district treasurer and the division; by an owner, on the
-- form "attached (see annex א)" — F-1.29-s: annex א of this section is the
-- application for publication points, not a determination form). A change
-- is retroactive only if the appeal came within 60 days of the first
-- determination, otherwise from the 1st of the month after it. A rejection
-- by the district manager is a reasoned letter; an owner who would reject
-- refers the appeal to the division for a final decision.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p131 akn:chp_1ב__sec_1_29__ssec_5_5/p132 akn:chp_1ב__sec_1_29__ssec_5_5/p133
GIVEN `days from the first determination to the appeal` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the change is retroactive` `days from the first determination to the appeal` IF
    `days from the first determination to the appeal` AT MOST 60

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p132
`the annex 1.29 names א` MEANS "a request to approve points for an equivalent grade for publications"
`the form an owner's new determination is made on` MEANS "a new grade-and-seniority determination"
`the owner's form points to the publications annex` MEANS
    NOT (`the annex 1.29 names א` EQUALS `the form an owner's new determination is made on`)
#ASSERT `the owner's form points to the publications annex`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p133
DECLARE `appeal outcome` IS ONE OF
    `accepted`
    `rejected by the district manager, in a reasoned letter`
    `referred by the owner to the division for a final decision`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p133
GIVEN `official education` IS A BOOLEAN, `to be accepted` IS A BOOLEAN
GIVETH AN `appeal outcome`
DECIDE `the appeal's outcome` `official education` `to be accepted` IS
    IF `to be accepted`
    THEN `accepted`
    ELSE IF `official education`
         THEN `rejected by the district manager, in a reasoned letter`
         ELSE `referred by the owner to the division for a final decision`

-- (2): a request for a change. (ב) after passing exams that improve the
-- grade, the correction is from the 1st of the month after the exams if the
-- confirmations reach the district manager within a year; (ו) after a year,
-- from the 1st of the month after they are produced. (ג) after reserve
-- exams with a negative supervision opinion, from the 1st of the month a
-- positive one arrives. (ד) a foreign degree: from the 1st of the month
-- after the request, a copy going to the foreign-degrees bureau. (ה) on
-- special exams or exemptions from them, from the 1st of the month after.
-- (ז) a committee may grant seniority grades retroactively. (ח) no change
-- in July or August, but for supervisors or those about to retire.
-- F-1.29-t: a correction (ב) dates to 1 July or 1 August (exams in June or
-- July) falls in the months (ח) bars; (ח) is read as barring the making of
-- a change in those months, not the date it takes effect from.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p134 The heading of (2), a request for a change.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p135
GIVEN `official education` IS A BOOLEAN
GIVETH A Party
DECIDE `whom a request for a change goes to` `official education` IS
    `whom the teaching employee applies to` `official education`

-- Months are numbered serially (any fixed origin); the result is the month
-- whose 1st the correction takes effect from.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p136 akn:chp_1ב__sec_1_29__ssec_5_5/p141
GIVEN `month of the exams` IS A NUMBER, `month the confirmations were produced` IS A NUMBER
GIVETH A NUMBER
DECIDE `the month the exam correction takes effect` `month of the exams` `month the confirmations were produced` IS
    IF `month the confirmations were produced` MINUS `month of the exams` AT MOST 12
    THEN `month of the exams` PLUS 1
    ELSE `month the confirmations were produced` PLUS 1

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p137
GIVEN `month a positive opinion arrives` IS A NUMBER
GIVETH A NUMBER
DECIDE `the month the reserve-exam correction takes effect` `month a positive opinion arrives` IS
    `month a positive opinion arrives`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p138 akn:chp_1ב__sec_1_29__ssec_5_5/p139 akn:chp_1ב__sec_1_29__ssec_5_5/p140
GIVEN `month of the request, the exemption or the exams` IS A NUMBER
GIVETH A NUMBER
DECIDE `the month a foreign-degree or special correction takes effect` `month of the request, the exemption or the exams` IS
    `month of the request, the exemption or the exams` PLUS 1

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p141
GIVETH A DEONTIC Party `grading action`
DECIDE `notifying a raise` IS
    PARTY `the district manager`
    MUST  `notify the employee of the grade and seniority`
    HENCE PARTY `the district manager`
          MUST  `send a copy of the determination to the manpower division`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p142 akn:chp_1ב__sec_1_29__ssec_5_5/p143
GIVEN `official education` IS A BOOLEAN
GIVETH A STRING
DECIDE `how one reaches the retroactive-seniority committee` `official education` IS
    IF `official education` THEN "through the manpower section of the district office" ELSE "through the owner"

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p144
GIVEN `school month of the change` IS A `school month`, `a supervisor or about to retire` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a change may be made in` `school month of the change` `a supervisor or about to retire` IF
    `a supervisor or about to retire`
    OR NOT (`school month of the change` EQUALS July OR `school month of the change` EQUALS August)

`exams in June correct the grade from July, a month (ח) bars` MEANS
    NOT (`a change may be made in` July FALSE)
#ASSERT `exams in June correct the grade from July, a month (ח) bars`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p145 akn:chp_1ב__sec_1_29__ssec_5_5/p146 akn:chp_1ב__sec_1_29__ssec_5_5/p147 akn:chp_1ב__sec_1_29__ssec_5_5/p148 akn:chp_1ב__sec_1_29__ssec_5_5/p149 The sources (אסמכתא) of the procedure.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p150 akn:chp_1ב__sec_1_29__ssec_5_5/p151 akn:chp_1ב__sec_1_29__ssec_5_5/p152 akn:chp_1ב__sec_1_29__ssec_5_5/p153 The sources (אסמכתא) of the procedure, continued.

§§ `1.29 החזר תשלומי יתר`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p154 akn:chp_1ב__sec_1_29__ssec_5_5/p155 The heading "החזר תשלומי יתר" and (1)'s opening line.

-- (1): an overpayment is anything paid above what the rules in force for
-- that period give. (2): on discovery, the salary is corrected at once,
-- from the month of discovery.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p156
GIVEN `paid` IS A NUMBER, `due` IS A NUMBER
GIVETH A NUMBER
DECIDE `the overpayment` `paid` `due` IS
    IF `paid` GREATER THAN `due` THEN `paid` MINUS `due` ELSE 0

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p157
GIVETH A DEONTIC Party `grading action`
DECIDE `correcting the salary` IS
    PARTY `the employer`
    MUST  `correct the salary from the month of discovery`
    WITHIN 0

-- (3): how it is recovered, as a list of monthly deductions from the month
-- after discovery. (א) one payment found within the month after it: in one
-- deduction, or two equal ones above 10% of the total salary. (ב) two
-- consecutive months found in the third: two, or four equal ones above
-- 20%. (ג) three months or more, and (ד) one or two months found later:
-- equal deductions of 10% of the monthly total salary. (ה) continues to the
-- end of the debt. The floor below which no deduction may take the salary
-- is an input (set by the Ministry's accountant). F-1.29-u: "אין לנכות
-- תשלום יתר שכתוצאה מהניכוי תהיה משכורתו נמוכה" — no deduction at all, or
-- a deduction down to the floor? Read as deducting down to the floor and
-- carrying the rest by (ה).
-- akn:chp_1ב__sec_1_29__ssec_5_5/p158 A bare item number ("(3)") whose text is (א)-(ג).
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p159 akn:chp_1ב__sec_1_29__ssec_5_5/p161 akn:chp_1ב__sec_1_29__ssec_5_5/p162
GIVEN `months paid` IS A NUMBER, `found within the month after the last payment` IS A BOOLEAN
      `overpayment` IS A NUMBER, `monthly total salary` IS A NUMBER
GIVETH A NUMBER
DECIDE `the number of equal deductions` `months paid` `found within the month after the last payment` `overpayment` `monthly total salary` IS
    IF `months paid` EQUALS 1 AND `found within the month after the last payment`
    THEN (IF `overpayment` GREATER THAN `monthly total salary` TIMES 0.1 THEN 2 ELSE 1)
    ELSE IF `months paid` EQUALS 2 AND `found within the month after the last payment`
         THEN (IF `overpayment` GREATER THAN `monthly total salary` TIMES 0.2 THEN 4 ELSE 2)
         ELSE IF `monthly total salary` GREATER THAN 0
              THEN CEILING (`overpayment` DIVIDED BY (`monthly total salary` TIMES 0.1))
              ELSE 1

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p159 akn:chp_1ב__sec_1_29__ssec_5_5/p160 akn:chp_1ב__sec_1_29__ssec_5_5/p162
GIVEN `scheduled deduction` IS A NUMBER, `salary before the deduction` IS A NUMBER, `the accountant's floor` IS A NUMBER
GIVETH A NUMBER
DECIDE `the deduction made` `scheduled deduction` `salary before the deduction` `the accountant's floor` IS
    max 0 (min `scheduled deduction` (`salary before the deduction` MINUS `the accountant's floor`))

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p160
GIVEN `scheduled deduction` IS A NUMBER, `salary before the deduction` IS A NUMBER, `the accountant's floor` IS A NUMBER
GIVETH A NUMBER
DECIDE `the deduction on the other reading` `scheduled deduction` `salary before the deduction` `the accountant's floor` IS
    IF `salary before the deduction` MINUS `scheduled deduction` LESS THAN `the accountant's floor` THEN 0 ELSE `scheduled deduction`

`the two readings of the floor differ` MEANS
    NOT (`the deduction made` 1000 6000 5500 EQUALS `the deduction on the other reading` 1000 6000 5500)
#ASSERT `the two readings of the floor differ`

-- (4): (3) applies only to overpayments found within the school year they
-- were made in, or within 6 months of the first, whichever is later;
-- found later, the Accountant General is told and decides, consulting the
-- union. (5): (3) and (4) do not apply where the employee gave false
-- information or hid it: then the whole is deducted in the month after
-- discovery unless the Accountant General decides otherwise on the
-- employee's request, consulting the union, and the official in charge of
-- employees' affairs is told at once. (6): on leaving service, the whole
-- remainder is deducted from anything due.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p163 akn:chp_1ב__sec_1_29__ssec_5_5/p166 Bare item numbers ("(4)", "(5)") whose texts follow.
@ref akn:chp_1ב__sec_1_29__ssec_5_5/p164 akn:chp_1ב__sec_1_29__ssec_5_5/p165
GIVEN `months from the first overpayment to discovery` IS A NUMBER, `months from the first overpayment to the end of its school year` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `(3) governs the recovery` `months from the first overpayment to discovery` `months from the first overpayment to the end of its school year` IF
    `months from the first overpayment to discovery` AT MOST max 6 `months from the first overpayment to the end of its school year`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p165
GIVEN `(3) governs` IS A BOOLEAN
GIVETH A DEONTIC Party `grading action`
DECIDE `a late-found overpayment` `(3) governs` IS
    IF `(3) governs`
    THEN FULFILLED
    ELSE PARTY `the employer`
         MUST  `notify the Accountant General of the overpayment`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p167 akn:chp_1ב__sec_1_29__ssec_5_5/p168
GIVEN `false or hidden information` IS A BOOLEAN, `the Accountant General decides otherwise` IS A BOOLEAN
      `overpayment` IS A NUMBER, `deduction by (3)` IS A NUMBER
GIVETH A NUMBER
DECIDE `the first deduction` `false or hidden information` `the Accountant General decides otherwise` `overpayment` `deduction by (3)` IS
    IF `false or hidden information` AND NOT `the Accountant General decides otherwise`
    THEN `overpayment`
    ELSE `deduction by (3)`

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p168
GIVEN `false or hidden information` IS A BOOLEAN
GIVETH A DEONTIC Party `grading action`
DECIDE `reporting false information` `false or hidden information` IS
    IF `false or hidden information`
    THEN PARTY `the employer`
         MUST  `notify the official in charge of employees' affairs`
         WITHIN 0
    ELSE FULFILLED

@ref akn:chp_1ב__sec_1_29__ssec_5_5/p169
GIVEN `remainder of the overpayment` IS A NUMBER, `payments due on leaving` IS A NUMBER
GIVETH A NUMBER
DECIDE `deducted on leaving service` `remainder of the overpayment` `payments due on leaving` IS
    min `remainder of the overpayment` `payments due on leaving`

-- akn:chp_1ב__sec_1_29__ssec_5_5/p170 A pointer to §3.15.3 for the rhythmic-music teacher's grade and seniority, encoded there.
-- akn:chp_1ב__sec_1_29__ssec_5_5/p171 akn:chp_1ב__sec_1_29__ssec_5_5/p172 akn:chp_1ב__sec_1_29__ssec_5_5/p173 The sources (אסמכתא) of the overpayment rules.

§§ `Property checks`

-- The section's finite rules over their whole space: all seventeen grades,
-- 0 to 40 years, a grid of school years, and every compulsory service of 0
-- to 48 months for each sex, officer or not, begun the day before or on
-- each date the period table names.

`every salary grade` MEANS
    LIST `academic grade, doctorate`, `academic grade, MA`, `academic grade, BA`
       , `intermediate academic grade C`, `intermediate academic grade B`
       , `intermediate academic grade A`, `academic intermediate supplement`
       , `senior certified teacher`, `certified teacher`, `certified kindergarten teacher`
       , `uncertified teacher or kindergarten teacher, stage AA`
       , `uncertified teacher or kindergarten teacher, stage A+`
       , `uncertified teacher or kindergarten teacher, stage A`
       , `uncertified teacher or kindergarten teacher, stage B`
       , `certified professional instructor`, `de facto certified professional instructor`
       , `uncertified professional instructor`

-- The order of 1.29.2.1(א), as the encoding ranks it: every grade has its
-- own rank from 1 to 17, and the rank gives back the grade, so "the
-- highest grade" of F-1.29-a's reading is always one grade.
#ASSERT all (GIVEN g YIELD `the grade of rank` (`rank of` g) EQUALS g) `every salary grade`
#ASSERT map `rank of` `every salary grade` EQUALS range 1 17

-- (1)–(2): the increment is paid for at most 36 years, never for more
-- than the seniority, and never less for more seniority.
`the years checked` MEANS range 0 40
#ASSERT all (GIVEN n YIELD
                    `years the seniority increment is paid for` n AT MOST 36
                AND `years the seniority increment is paid for` n AT MOST n)
            `the years checked`
#ASSERT and (zipWith (GIVEN a, b YIELD `years the seniority increment is paid for` a AT MOST `years the seniority increment is paid for` b)
                     `the years checked` (drop 1 `the years checked`))

-- (8) over 0 to 40 years at half seniority: never less than half and
-- never a year more than half, never less for more years; and the rule as
-- worded ("more than two years") parts from the examples on exactly one
-- count, the 1 its first example gives (F-1.29-b over the space).
#ASSERT all (GIVEN n YIELD
                    `years recognised at half` n AT LEAST n DIVIDED BY 2
                AND `years recognised at half` n LESS THAN n DIVIDED BY 2 PLUS 1)
            `the years checked`
#ASSERT and (zipWith (GIVEN a, b YIELD `years recognised at half` a AT MOST `years recognised at half` b)
                     `the years checked` (drop 1 `the years checked`))
`the counts the worded rule and the examples part on` MEANS
    filter (GIVEN n YIELD NOT (`years recognised at half` n EQUALS `years recognised at half, the rule read as stated` n))
           `the years checked`
#ASSERT `the counts the worded rule and the examples part on` EQUALS LIST 1

-- 1.29.3.2's opening over a grid of school years: a year qualifies only if
-- one criterion alone holds six months — teaching (with the absences (3)
-- counts) at a third of a position, or other work at half — never the two
-- added together.
GIVEN teaching IS A NUMBER, tf IS A NUMBER, other IS A NUMBER, of IS A NUMBER, sick IS A NUMBER
GIVETH A `year of work`
DECIDE `a checked year of work` teaching tf other of sick IS
    `year of work` WITH
        `months teaching`                     IS teaching
        `teaching position fraction`          IS tf
        `months in instruction or other work` IS other
        `other work position fraction`        IS of
        `months of paid sick leave`           IS sick
        `months of maternity or accident leave paid by National Insurance` IS 0
        `months of reserve duty`              IS 0
        `suspended for legal proceedings`     IS FALSE
        `paid without working at all`         IS FALSE
        `the Ofek Hadash internship year`     IS FALSE

`the months checked` MEANS LIST 0, 3, 5, 6, 10
`the fractions checked` MEANS LIST 0, 0.3, 1/3, 0.5, 1

GIVEN teaching IS A NUMBER, other IS A NUMBER, sick IS A NUMBER
GIVETH A BOOLEAN
DECIDE `a year qualifies only by one criterion alone at` teaching other sick IF
    all (GIVEN tf YIELD
            all (GIVEN of YIELD
                    (NOT `the year qualifies` (`a checked year of work` teaching tf other of sick))
                    OR (teaching PLUS sick AT LEAST 6 AND tf AT LEAST 1/3)
                    OR (other AT LEAST 6 AND of AT LEAST 1/2))
                `the fractions checked`)
        `the fractions checked`

#ASSERT all (GIVEN t YIELD
                all (GIVEN o YIELD
                        all (GIVEN s YIELD `a year qualifies only by one criterion alone at` t o s) (LIST 0, 3, 6))
                    `the months checked`)
            `the months checked`
#ASSERT NOT `the year qualifies` (`a checked year of work` 3 1 3 1 0)

-- Seniority on 1 September: never above 36, and one more qualifying year
-- never lowers it.
`a full teaching year` MEANS `a checked year of work` 10 1 0 0 0
#ASSERT all (GIVEN n YIELD
                    `seniority on 1 September` (replicate n `a full teaching year`) 0 EQUALS min n 36
                AND `seniority on 1 September` (replicate n `a full teaching year`) 2 AT MOST 36)
            `the years checked`

-- 1.29.3.3 (10) and (8) over every service of 0 to 48 months, for each sex,
-- officer or not, begun the day before or on each date the period table
-- turns on: never negative, never more than served unless a disabled
-- veteran, never past 36 months, never less for more months served; a
-- man's cap steps from 30 to 36 exactly on 7.1.1968, a woman's from 12 to
-- 24 the day after 13.2.1950.
GIVEN who IS A `service sex`, began IS A DATE, months IS A NUMBER, officer IS A BOOLEAN
GIVETH A `compulsory service`
DECIDE `a checked service` who began months officer IS
    `compulsory service` WITH
        `served as`                                   IS who
        `service began`                               IS began
        `service ended`                               IS began
        `months actually served`                      IS months
        `an officer obliged to extra regular service as compulsory` IS officer
        `a disabled veteran who could not complete it` IS FALSE
        `full term of the period in months`           IS 36

`the service starts checked` MEANS
    LIST DATE_FROM_DMY 13 2 1950, DATE_FROM_DMY 14 2 1950, DATE_FROM_DMY 6 1 1968, DATE_FROM_DMY 7 1 1968, DATE_FROM_DMY 1 8 1995
`the months served checked` MEANS range 0 48

GIVEN who IS A `service sex`, began IS A DATE, officer IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the IDF months are bounded and monotone for` who began officer IF
        all (GIVEN m YIELD
                    `months of IDF seniority` (`a checked service` who began m officer) AT LEAST 0
                AND `months of IDF seniority` (`a checked service` who began m officer) AT MOST min m 36)
            `the months served checked`
    AND and (zipWith (GIVEN a, b YIELD `months of IDF seniority` (`a checked service` who began a officer)
                                      AT MOST `months of IDF seniority` (`a checked service` who began b officer))
                     `the months served checked` (drop 1 `the months served checked`))

#ASSERT all (GIVEN who YIELD
                all (GIVEN d YIELD
                        all (GIVEN o YIELD `the IDF months are bounded and monotone for` who d o) (LIST TRUE, FALSE))
                    `the service starts checked`)
            (LIST `a man`, `a woman`)

GIVEN who IS A `service sex`
GIVETH A LIST OF NUMBER
DECIDE `the most each start earns` who IS
    map (GIVEN d YIELD `months of IDF seniority` (`a checked service` who d 48 FALSE)) `the service starts checked`
#ASSERT `the most each start earns` `a man` EQUALS LIST 30, 30, 30, 36, 36
#ASSERT `the most each start earns` `a woman` EQUALS LIST 12, 24, 24, 24, 24

-- National service (ג–ד) over 0 to 36 months, at 39 and 40 weekly hours:
-- nothing under 40 hours, never more than 24 months, never less for more
-- months, and stepping exactly at 12 and 24.
#ASSERT all (GIVEN h YIELD
                    all (GIVEN m YIELD
                                `months of seniority for national service` m h AT MOST 24
                            AND (h AT LEAST 40 OR `months of seniority for national service` m h EQUALS 0))
                        (range 0 36)
                AND and (zipWith (GIVEN a, b YIELD `months of seniority for national service` a h AT MOST `months of seniority for national service` b h)
                                 (range 0 36) (drop 1 (range 0 36))))
            (LIST 39, 40)
`the national-service months the seniority steps at` MEANS
    filter (GIVEN m YIELD NOT (`months of seniority for national service` (m MINUS 1) 40 EQUALS `months of seniority for national service` m 40))
           (range 1 36)
#ASSERT `the national-service months the seniority steps at` EQUALS LIST 12, 24

-- The restored rules (1.29.6.2-1.29.6.4, the procedure, the overpayments)
-- over their finite spaces.
`the two booleans` MEANS LIST TRUE, FALSE
`every MA subject` MEANS LIST `the same specialisation`, `the subject she is certified to teach`, `the subject of her B.Ed. or BA grade`, `a third subject`
`every school month` MEANS LIST September, October, November, December, January, February, March, April, May, June, July, August

-- 1.29.6.2 ג: every route needs at least the 840 base hours and at most
-- 840 + 720, and the hours rise with each step away from the
-- specialisation.
#ASSERT all (GIVEN s YIELD `study hours required` s AT LEAST 840 AND `study hours required` s AT MOST 1560)
            `every MA subject`
`the hours rise with each step from the specialisation` MEANS
        `study hours required` `the same specialisation` LESS THAN `study hours required` `the subject she is certified to teach`
    AND `study hours required` `the subject she is certified to teach` LESS THAN `study hours required` `the subject of her B.Ed. or BA grade`
    AND `study hours required` `the subject of her B.Ed. or BA grade` LESS THAN `study hours required` `a third subject`
#ASSERT `the hours rise with each step from the specialisation`

-- 1.29.6.3 ג over 0 to 60 table points and 0 to 8 points under 4.2-4.4,
-- with a degree or without: the grade never falls with more points, the
-- MA-equivalent always has 6 under 4.2-4.4, and a degree alone gives the
-- BA-equivalent.
GIVEN g IS AN `equivalent grade`
GIVETH A NUMBER
DECIDE `1.29.6.3 rank` g IS `equivalent rank` g

#ASSERT all (GIVEN d YIELD
                all (GIVEN p YIELD
                        all (GIVEN q YIELD
                                LET g MEANS `the 1.29.6.3 grade` d p q
                                IN      `1.29.6.3 rank` g AT MOST `1.29.6.3 rank` (`the 1.29.6.3 grade` d (p PLUS 1) q)
                                    AND `1.29.6.3 rank` g AT MOST `1.29.6.3 rank` (`the 1.29.6.3 grade` d p (q PLUS 1))
                                    AND ((NOT (g EQUALS `equivalent to MA`)) OR q AT LEAST 6)
                                    AND ((NOT d) OR `1.29.6.3 rank` g AT LEAST 1))
                            (range 0 8))
                    (range 0 60))
            `the two booleans`

-- 1.29.6.4(3) over 0 to 800 hours in steps of 40, 0 to 3 seminar papers,
-- 0 to 3 articles, with a book or without: the shorter form never admits
-- under 480 hours, and the longer one never with fewer than 2 papers.
#ASSERT all (GIVEN h YIELD
                all (GIVEN s YIELD
                        all (GIVEN a YIELD
                                all (GIVEN b YIELD
                                        LET ok MEANS `the programme meets 1.29.6.4(3)` 1 (h TIMES 40) s a b
                                        IN      ((NOT ok) OR h TIMES 40 AT LEAST 480)
                                            AND ((NOT ok) OR s AT LEAST 1)
                                            AND ((NOT ok) OR h TIMES 40 AT LEAST 720 OR a AT LEAST 2 OR b)
                                            AND NOT `the programme meets 1.29.6.4(3)` 0 (h TIMES 40) s a b)
                                    `the two booleans`)
                            (range 0 3))
                    (range 0 3))
            (range 0 20)

-- The appeal over 0 to 120 days: retroactive exactly to 60 days.
#ASSERT all (GIVEN d YIELD `the change is retroactive` d EQUALS (d AT MOST 60))
            (range 0 120)

-- (2)(ב),(ו) over exams in any of 24 months and confirmations 0 to 30
-- months later: the correction is never before the month after the exams,
-- and within a year it is exactly that month.
#ASSERT all (GIVEN e YIELD
                all (GIVEN k YIELD
                        LET m MEANS `the month the exam correction takes effect` e (e PLUS k)
                        IN      m AT LEAST e PLUS 1
                            AND (m EQUALS e PLUS 1) EQUALS (k AT MOST 12))
                    (range 0 30))
            (range 1 24)

-- (2)(ח) over every school month: a change may be made in every month but
-- July and August, and in those for a supervisor or one about to retire.
#ASSERT all (GIVEN m YIELD
                    `a change may be made in` m TRUE
                AND `a change may be made in` m FALSE EQUALS NOT (m EQUALS July OR m EQUALS August))
            `every school month`

-- (3) over overpayments of 0 to 3,000 in steps of 100 against a salary of
-- 10,000, one to four months paid, found early or late: (א) one or two
-- deductions, (ב) two or four, (ג)-(ד) as many 10% steps as cover it; a
-- deduction never takes the salary below the floor and never exceeds what
-- is scheduled.
#ASSERT all (GIVEN o YIELD
                all (GIVEN n YIELD
                        all (GIVEN early YIELD
                                LET k MEANS `the number of equal deductions` n early (o TIMES 100) 10000
                                IN  IF n EQUALS 1 AND early
                                    THEN k EQUALS (IF o TIMES 100 GREATER THAN 1000 THEN 2 ELSE 1)
                                    ELSE IF n EQUALS 2 AND early
                                         THEN k EQUALS (IF o TIMES 100 GREATER THAN 2000 THEN 4 ELSE 2)
                                         ELSE k TIMES 1000 AT LEAST o TIMES 100)
                            `the two booleans`)
                    (range 1 4))
            (range 0 30)
#ASSERT all (GIVEN d YIELD
                all (GIVEN f YIELD
                        LET x MEANS `the deduction made` (d TIMES 100) 6000 (f TIMES 500)
                        IN      x AT MOST d TIMES 100
                            AND x AT LEAST 0
                            AND 6000 MINUS x AT LEAST min 6000 (f TIMES 500))
                    (range 0 12))
            (range 0 20)

-- (4) over 0 to 18 months to discovery and 1 to 12 to the end of the year:
-- (3) governs at least for the first 6 months, and always to the year's
-- end.
#ASSERT all (GIVEN t YIELD
                all (GIVEN y YIELD
                            ((NOT (t AT MOST 6)) OR `(3) governs the recovery` t y)
                        AND ((NOT (t AT MOST y)) OR `(3) governs the recovery` t y))
                    (range 1 12))
            (range 0 18)
