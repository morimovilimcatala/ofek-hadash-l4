-- תקנון שירות עובדי הוראה, פרק 7, §7.1 מרכזי חטיבה צעירה
-- The young-division coordinator (later titled head): management hours,
-- appointment, tasks, and the deputy's management reward she is paid.

IMPORT prelude
IMPORT daydate
IMPORT common

@desc A school's young division and its coordinator, as far as section 7.1 asks about them.
DECLARE `young division` HAS
    `classes in the division including kindergarten classes` IS A NUMBER
    `management hours`  IS A NUMBER @desc the coordinator's weekly hours of coordination and management
    `assistance hours`  IS A NUMBER @desc her weekly hours of assistance
    `teaching hours`    IS A NUMBER @desc her weekly teaching hours
    `full position hours` IS A NUMBER @desc the weekly hours of a full position for her

@desc Who acts under section 7.1. The young-division coordinator and the district are not among the takanon's shared parties, so they are declared here.
DECLARE `7.1 party` IS ONE OF
    `the district manager`
    `the district`
    `the young division coordinator`
    `the principal`

@desc What was done before an appointment.
DECLARE `young division appointment` HAS
    `meets the appointment conditions of deputy principals` IS A BOOLEAN @desc under section 7.3.2, an input until it is encoded
    `the principal consents`                            IS A BOOLEAN
    `coordinated with the school's supervisor`          IS A BOOLEAN
    `coordinated with the supervisor of the division's kindergartens` IS A BOOLEAN
    `coordinated with the supervisor of young divisions` IS A BOOLEAN @desc in the pedagogical secretariat

DECLARE `7.1 action` IS ONE OF
    `appoint a young division coordinator`
    `publicise the post`
    `perform a task` HAS `the task` IS A `young division task`
    `attend the coordinators' training`

§ `7.1 מרכזי חטיבה צעירה`

-- akn:chp_7__sec_7_1/p2 akn:chp_7__sec_7_1/p3 akn:chp_7__sec_7_1/p4 akn:chp_7__sec_7_1/p5 The section's table of contents: the titles of its subsections, each encoded below.

§§ `7.1.1 יחידת עבודה`

@ref akn:chp_7__sec_7_1__ssec_7_1_1/p1
GIVEN d IS A `young division`
GIVETH A NUMBER
DECIDE `coordination hours` d IS
    min (3 TIMES d's `classes in the division including kindergarten classes`) 12

@ref akn:chp_7__sec_7_1__ssec_7_1_1/p2
GIVEN d IS A `young division`
GIVETH A NUMBER
DECIDE `her position's hours` d IS
    d's `management hours` PLUS d's `assistance hours` PLUS d's `teaching hours`

-- "מומלץ": working her whole position in the division is a recommendation,
-- not a condition.
@ref akn:chp_7__sec_7_1__ssec_7_1_1/p2
GIVEN d IS A `young division`
GIVETH A BOOLEAN
DECIDE `she works the recommended full position in the division` d IF
    `her position's hours` d AT LEAST d's `full position hours`

-- akn:chp_7__sec_7_1__ssec_7_1_1/p3 akn:chp_7__sec_7_1__ssec_7_1_1/p4 The source (אסמכתא) of section 7.1.1.

§§ `7.1.2 מינוי`

@ref akn:chp_7__sec_7_1__ssec_7_1_2__para_1
GIVEN a IS A `young division appointment`
GIVETH A BOOLEAN
DECIDE `the appointment may be made` a IF
        a's `meets the appointment conditions of deputy principals`
    AND a's `the principal consents`
    AND a's `coordinated with the school's supervisor`
    AND a's `coordinated with the supervisor of the division's kindergartens`
    AND a's `coordinated with the supervisor of young divisions`

@ref akn:chp_7__sec_7_1__ssec_7_1_2__para_1
GIVEN a IS A `young division appointment`
GIVETH A DEONTIC `7.1 party` `7.1 action`
DECIDE `appointing a young division coordinator` a IS
    IF `the appointment may be made` a
    THEN PARTY `the district manager`
         MAY   `appoint a young division coordinator`
    ELSE PARTY `the district manager`
         SHANT `appoint a young division coordinator`
         LEST BREACH BY `the district manager` BECAUSE "section 7.1.2.1: appointed under the deputies' conditions, with the principal's consent and after coordinating with the supervisors"

-- No deadline is set for publicising the post; it is an open duty.
@ref akn:chp_7__sec_7_1__ssec_7_1_2__para_1
GIVETH A DEONTIC `7.1 party` `7.1 action`
DECIDE `publicising the post` IS
    PARTY `the district`
    MUST  `publicise the post`

@ref akn:chp_7__sec_7_1__ssec_7_1_2__para_2
`the post's title` MEANS "מנהלת חטיבה צעירה"

@ref akn:chp_7__sec_7_1__ssec_7_1_2__para_2
GIVEN p IS A `7.1 party`
GIVETH A BOOLEAN
DECIDE `the young division head answers directly to` p IF
    p EQUALS `the principal`

-- akn:chp_7__sec_7_1__ssec_7_1_2/p1 akn:chp_7__sec_7_1__ssec_7_1_2/p2 akn:chp_7__sec_7_1__ssec_7_1_2/p3 The sources (אסמכתא) of section 7.1.2.

§§ `7.1.3 הגדרת תפקיד`

@desc The coordinator's tasks, one per paragraph of section 7.1.3.
@ref akn:chp_7__sec_7_1__ssec_7_1_3/p1
DECLARE `young division task` IS ONE OF
    @ref akn:chp_7__sec_7_1__ssec_7_1_3__para_a
    `planning and coordinating the educational work of all the division's classes`
    @ref akn:chp_7__sec_7_1__ssec_7_1_3__para_b
    `exercising management powers: directing and guiding the division's staff`
    @ref akn:chp_7__sec_7_1__ssec_7_1_3__para_c
    `coordinating the follow-up of each child's development and initiating help`
    @ref akn:chp_7__sec_7_1__ssec_7_1_3__para_d
    `responsibility for buying and keeping the division's didactic equipment`
    @ref akn:chp_7__sec_7_1__ssec_7_1_3__para_e
    `planning and running staff meetings at fixed times`
    @ref akn:chp_7__sec_7_1__ssec_7_1_3__para_f
    `ongoing contact with the supervision and the principal`
    @ref akn:chp_7__sec_7_1__ssec_7_1_3__para_g
    `contact with the pupils' parents`
    @ref akn:chp_7__sec_7_1__ssec_7_1_3__para_h
    `attending the coordinators' training at least monthly away from home`
    @ref akn:chp_7__sec_7_1__ssec_7_1_3__para_i
    `contact with psychological, health and social services and local bodies`
    @ref akn:chp_7__sec_7_1__ssec_7_1_3__para_j
    `reporting to the principal and the pedagogical council`

-- Each task is a duty of the post. Time is in days; the school year's
-- length is the deadline of the open-ended tasks.
@ref akn:chp_7__sec_7_1__ssec_7_1_3/p1
GIVEN t IS A `young division task`, `days in the school year` IS A NUMBER
GIVETH A DEONTIC `7.1 party` `7.1 action`
DECIDE `the coordinator's task` t `days in the school year` IS
    PARTY `the young division coordinator`
    MUST  `perform a task` done PROVIDED done EQUALS t
    WITHIN `days in the school year`
    LEST  BREACH BY `the young division coordinator` BECAUSE "section 7.1.3: a task of the post was not performed"

-- (ח): the coordinators' training is held at least once a month, away
-- from where they live; one month (30 days) is the deadline of each.
@ref akn:chp_7__sec_7_1__ssec_7_1_3__para_h
GIVETH A DEONTIC `7.1 party` `7.1 action`
DECIDE `monthly training` IS
    PARTY `the young division coordinator`
    MUST  `attend the coordinators' training`
    WITHIN 30
    LEST  BREACH BY `the young division coordinator` BECAUSE "section 7.1.3ח: the coordinators' training is at least monthly"

-- akn:chp_7__sec_7_1__ssec_7_1_3/p2 akn:chp_7__sec_7_1__ssec_7_1_3/p3 The source (אסמכתא) of section 7.1.3.

§§ `7.1.6 גמול ניהול`

-- §7.1.6.1: she serves as first deputy, and the young division's classes
-- are the basis of a deputy's management reward "לפי הטבלה להלן". The table
-- is not in the corpus text (the ministry's page links it as a separate
-- document), so the reward it gives is an input here.
@ref akn:chp_7__sec_7_1__ssec_7_1_6__para_1
GIVEN d IS A `young division`
GIVETH A NUMBER
DECIDE `classes the deputy's reward is based on` d IS
    d's `classes in the division including kindergarten classes`

@ref akn:chp_7__sec_7_1__ssec_7_1_6__para_1/p1
`her place in the school's management` MEANS "first deputy"

@ref akn:chp_7__sec_7_1__ssec_7_1_6__para_1/p2
GIVEN `the day` IS A DATE
GIVETH A BOOLEAN
DECIDE `the table is in force on` `the day` IF
    `the day` AT LEAST Date 1 9 1995

@ref akn:chp_7__sec_7_1__ssec_7_1_6__para_1 akn:chp_7__sec_7_1__ssec_7_1_6__para_2
GIVEN d IS A `young division`
      `deputy's reward from the table` IS A FUNCTION FROM NUMBER TO NUMBER @desc the first deputy's management reward the table of section 7.1.6 gives for a number of classes; the table is not in the corpus text
      `management seniority supplement` IS A NUMBER @desc the management seniority added under sections 7.6.10 and 7.3.10
GIVETH A NUMBER
DECIDE `young division coordinator's management reward` d `deputy's reward from the table` `management seniority supplement` IS
    `deputy's reward from the table` (`classes the deputy's reward is based on` d) PLUS `management seniority supplement`

-- Examples. The reward of 50 per class and the supplement of 10 are placeholders.
`a 5-class young division` MEANS
    `young division` WITH
        `classes in the division including kindergarten classes` IS 5
        `management hours`    IS 12
        `assistance hours`    IS 6
        `teaching hours`      IS 12
        `full position hours` IS 30

#ASSERT `coordination hours` `a 5-class young division` EQUALS 12
#ASSERT `she works the recommended full position in the division` `a 5-class young division`
#ASSERT `young division coordinator's management reward` `a 5-class young division` (GIVEN n YIELD 50 TIMES n) 10 EQUALS 260

#TRACE `the coordinator's task` `contact with the pupils' parents` 300 AT 0 WITH
    PARTY `the young division coordinator` DOES `perform a task` `contact with the pupils' parents` AT 20
-- Training attended within the month: fulfilled; first attended on day 45: breached.
#TRACE `monthly training` AT 0 WITH
    PARTY `the young division coordinator` DOES `attend the coordinators' training` AT 25
#TRACE `monthly training` AT 0 WITH
    PARTY `the young division coordinator` DOES `attend the coordinators' training` AT 45
#ASSERT NOT `the table is in force on` (Date 31 8 1995)

-- akn:chp_7__sec_7_1__ssec_7_1_6__para_3 A pointer: the right to carry the management reward over is section 7.3.6.1's, encoded there.

-- akn:chp_7__sec_7_1__ssec_7_1_6/p1 akn:chp_7__sec_7_1__ssec_7_1_6/p2 akn:chp_7__sec_7_1__ssec_7_1_6/p3 akn:chp_7__sec_7_1__ssec_7_1_6/p4 The sources (אסמכתא) of section 7.1.6.
