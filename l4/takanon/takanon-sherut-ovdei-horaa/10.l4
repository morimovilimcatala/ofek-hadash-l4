-- תקנון שירות עובדי הוראה, פרק 10, עו"ה בבי"ס לנערים עובדים
-- The management allowance of a principal of a school for working youth.

IMPORT prelude
IMPORT common

§ `10 עו"ה בבי"ס לנערים עובדים`

@desc A school for working youth whose principal's management allowance chapter 10 sets.
DECLARE `working-youth school` HAS
    `is a youth centre`  IS A BOOLEAN @desc the institution is a youth centre (מרכז נוער), which chapter 10 excludes
    `number of classes`  IS A NUMBER  @desc the number of classes in the school
    `post-primary allowance for the same number of classes` IS A NUMBER
        @desc the management allowance (as a percentage of the personal combined salary) of a post-primary school principal with the same number of classes, from section 7.6.6.1's table; an input until that section's table is encoded

@ref akn:chp_10__hc_2/p1
GIVEN s IS A `working-youth school`
GIVETH A BOOLEAN
DECIDE `chapter 10 governs the principal's allowance` s IF
    NOT s's `is a youth centre`

-- 80% of the post-primary allowance for an equal number of classes; the
-- same rule is restated in section 7.6.6.1(7), which points here.
@ref akn:chp_10__hc_2/p1
GIVEN s IS A `working-youth school`
GIVETH A NUMBER
DECIDE `working-youth principal's management allowance rate` s IS
    IF `chapter 10 governs the principal's allowance` s
    THEN 0.8 TIMES s's `post-primary allowance for the same number of classes`
    ELSE 0

-- akn:chp_10__hc_3__para_1 The chapter's source (אסמכתא): a circular and the special collective agreement it rests on.

-- Example. The post-primary rate of 10 is a placeholder: section 7.6.6.1's
-- table is not part of the text this file encodes.
`a working-youth school with 12 classes` MEANS
    `working-youth school` WITH
        `is a youth centre` IS FALSE
        `number of classes` IS 12
        `post-primary allowance for the same number of classes` IS 10

`a youth centre` MEANS
    `working-youth school` WITH
        `is a youth centre` IS TRUE
        `number of classes` IS 12
        `post-primary allowance for the same number of classes` IS 10

#ASSERT `working-youth principal's management allowance rate` `a working-youth school with 12 classes` EQUALS 8
#ASSERT `working-youth principal's management allowance rate` `a youth centre` EQUALS 0
