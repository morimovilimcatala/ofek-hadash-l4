-- תקנון שירות עובדי הוראה, פרק 3, §3.19 מורה בבית ספר ימי או חקלאי
-- Teachers in maritime and agricultural schools: the split allowance, the
-- coordination allowances of an agricultural farm, and the number of
-- classes a management allowance is reckoned on.

IMPORT prelude
IMPORT daydate
IMPORT common

§ `3.19 מורה בבית ספר ימי או חקלאי`

DECLARE `kind of school` IS ONE OF `agricultural`, `maritime`

@desc Which grades a school's pupils are in (section 3.19.6.2-3).
DECLARE `school population` IS ONE OF
    `grades 1-6 only`
    `grades 7-12`
    `both grades 1-6 and grades 7-12`

DECLARE `coordination rules` IS ONE OF
    `as in primary education (section 3.14)`
    `as in post-primary education (section 6.10)`
    `not decided by the text`

@desc A maritime or agricultural school, as section 3.19.7 asks about it.
DECLARE `visiting-school case` HAS
    `standard hours`                         IS A NUMBER @desc the school's standard (תקן) weekly hours
    `visiting classes taught 2 hours`        IS A NUMBER @desc classes that visit the school and are taught 2 weekly hours each
    `visiting classes taught 3 hours`        IS A NUMBER @desc classes that visit the school and are taught 3 weekly hours each
    `weekly hours of the layer's position`   IS A NUMBER @desc 24 or 30, "according to the educational layer, grades 1-6 or 7 and up" (an input: see F-3.19-c)

§§ `3.19.6.1 גמול פיצול`

-- The allowance's measure is section 1.11's ("לפי אמות המידה המקובלות").
@ref akn:chp_3__sec_3_19__ssec_3_19_6_1/p1
GIVEN k IS A `kind of school`, d IS A DATE,
      `split by section 1.11's measures` IS A BOOLEAN @desc the teacher's theoretical and practical work, together, meet section 1.11's measures for a split allowance
GIVETH A BOOLEAN
DECIDE `entitled to the split allowance` k d `split by section 1.11's measures` IF
    `split by section 1.11's measures` AND d AT LEAST `the split allowance applies from` k

@ref akn:chp_3__sec_3_19__ssec_3_19_6_1/p2 akn:chp_3__sec_3_19__ssec_3_19_6_1/p3
GIVEN k IS A `kind of school`
GIVETH A DATE
DECIDE `the split allowance applies from` k IS
    CONSIDER k
    WHEN `agricultural` THEN Date 1 1 1990
    WHEN `maritime`     THEN Date 1 9 1993

-- akn:chp_3__sec_3_19__ssec_3_19_6_1/p4 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_19__ssec_3_19_6_1/p5 Source (אסמכתא): a supreme parity-committee decision of 9.1.90.
-- akn:chp_3__sec_3_19__ssec_3_19_6_1/p6 Source (אסמכתא): a supreme parity-committee decision of 20.9.93.

§§ `3.19.6.2 גמול ריכוז מקצוע בחווה חקלאית`

-- F-3.19-a: for a mixed population the clause sends the reader to
-- 3.19.6.3, which governs only the LAYER coordinator; which rules govern
-- the SUBJECT coordinator of a mixed school is not said.
@ref akn:chp_3__sec_3_19__ssec_3_19_6_2__para_1 akn:chp_3__sec_3_19__ssec_3_19_6_2__para_2 akn:chp_3__sec_3_19__ssec_3_19_6_2__para_3
GIVEN p IS A `school population`
GIVETH A `coordination rules`
DECIDE `subject-coordination rules of an agricultural farm` p IS
    CONSIDER p
    WHEN `grades 1-6 only`                 THEN `as in primary education (section 3.14)`
    WHEN `grades 7-12`                     THEN `as in post-primary education (section 6.10)`
    WHEN `both grades 1-6 and grades 7-12` THEN `not decided by the text`

-- akn:chp_3__sec_3_19__ssec_3_19_6_2/p1 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_19__ssec_3_19_6_2/p2 Source (אסמכתא): a parity-committee decision of 7.8.89.

§§ `3.19.6.3 גמול ריכוז שכבה`

@ref akn:chp_3__sec_3_19__ssec_3_19_6_3/p1
GIVEN p IS A `school population`
GIVETH A BOOLEAN
DECIDE `a layer coordinator may be appointed on an agricultural farm` p IF
    CONSIDER p
    WHEN `both grades 1-6 and grades 7-12` THEN TRUE
    OTHERWISE FALSE

@ref akn:chp_3__sec_3_19__ssec_3_19_6_3/p2
GIVETH A NUMBER
DECIDE `layer-coordination allowance rate` IS 6%

-- akn:chp_3__sec_3_19__ssec_3_19_6_3/p3 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_19__ssec_3_19_6_3/p4 Source (אסמכתא): a parity-committee decision of 7.8.89.

§§ `3.19.7 קביעת מספר הכיתות לצורך חישוב גמול הניהול`

-- (1): standard hours plus the visiting classes, over 24 or 30 (the
-- printed formula's numerator, fraction bar and denominator are its rows).
@ref akn:chp_3__sec_3_19__ssec_3_19_7__para_1/p1 akn:chp_3__sec_3_19__ssec_3_19_7__para_1/p2 akn:chp_3__sec_3_19__ssec_3_19_7__para_1/p3 akn:chp_3__sec_3_19__ssec_3_19_7__para_1/p4
GIVEN s IS A `visiting-school case`
GIVETH A NUMBER
DECIDE `classes by the 2-hour formula` s IS
    (s's `standard hours` PLUS s's `visiting classes taught 2 hours`) DIVIDED BY s's `weekly hours of the layer's position`

-- F-3.19-b: the 3-hour formula multiplies the visiting classes by a figure
-- printed "5.1". The reading adopted is 1.5 — three weekly hours against the
-- two of formula (1) — the digits of "1.5" reversed in right-to-left
-- typesetting.
@ref akn:chp_3__sec_3_19__ssec_3_19_7__para_2/p2
GIVETH A NUMBER
DECIDE `the multiplier of the 3-hour formula` IS 3 DIVIDED BY 2

GIVETH A NUMBER
DECIDE `the multiplier as printed` IS 5.1

@ref akn:chp_3__sec_3_19__ssec_3_19_7__para_2/p1 akn:chp_3__sec_3_19__ssec_3_19_7__para_2/p2 akn:chp_3__sec_3_19__ssec_3_19_7__para_2/p3 akn:chp_3__sec_3_19__ssec_3_19_7__para_2/p4
GIVEN s IS A `visiting-school case`, `multiplier` IS A NUMBER
GIVETH A NUMBER
DECIDE `classes by the 3-hour formula` s `multiplier` IS
    (s's `standard hours` PLUS s's `visiting classes taught 3 hours` TIMES `multiplier`) DIVIDED BY s's `weekly hours of the layer's position`

-- (3): with both kinds of visiting class, "the formula is computed
-- accordingly": each kind enters with its own weight. (4): round up.
@ref akn:chp_3__sec_3_19__ssec_3_19_7__para_3 akn:chp_3__sec_3_19__ssec_3_19_7__para_4/p1
GIVEN s IS A `visiting-school case`
GIVETH A NUMBER
DECIDE `classes for the management allowance` s IS
    CEILING ((  s's `standard hours`
              PLUS s's `visiting classes taught 2 hours`
              PLUS s's `visiting classes taught 3 hours` TIMES `the multiplier of the 3-hour formula`)
             DIVIDED BY s's `weekly hours of the layer's position`)

@ref akn:chp_3__sec_3_19__ssec_3_19_7__para_4/p2
`the class-count arrangement applies from` MEANS Date 1 9 1987


-- akn:chp_3__sec_3_19__ssec_3_19_7/p1 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_19__ssec_3_19_7/p2 Source (אסמכתא): supreme parity-committee decisions of 29.3.89 and 20.9.93.

-- Examples with round placeholder figures.
`a farm school, 40 standard hours, 8 classes at 3 hours, grades 7+` MEANS
    `visiting-school case` WITH
        `standard hours`                       IS 40
        `visiting classes taught 2 hours`      IS 0
        `visiting classes taught 3 hours`      IS 8
        `weekly hours of the layer's position` IS 30

#ASSERT `classes for the management allowance` `a farm school, 40 standard hours, 8 classes at 3 hours, grades 7+` EQUALS 2
#ASSERT `classes by the 3-hour formula` `a farm school, 40 standard hours, 8 classes at 3 hours, grades 7+` `the multiplier of the 3-hour formula` EQUALS (52 DIVIDED BY 30)

-- F-3.19-a: the mixed population is the one case of three the clause
-- leaves undecided.
`a mixed farm's subject-coordination rules are not decided` MEANS
    `subject-coordination rules of an agricultural farm` `both grades 1-6 and grades 7-12` EQUALS `not decided by the text`
#ASSERT `a mixed farm's subject-coordination rules are not decided`

-- F-3.19-b: the printed multiplier and the read one give different class counts.
`the printed and the read multiplier give different class counts` MEANS
    NOT (CEILING (`classes by the 3-hour formula` `a farm school, 40 standard hours, 8 classes at 3 hours, grades 7+` `the multiplier as printed`)
         EQUALS CEILING (`classes by the 3-hour formula` `a farm school, 40 standard hours, 8 classes at 3 hours, grades 7+` `the multiplier of the 3-hour formula`))
#ASSERT `the printed and the read multiplier give different class counts`

-- F-3.19-c: for a school of both layers the divisor (24 or 30) is not
-- determined, and the two give different class counts.
`a school of both layers, 48 standard hours, at 24` MEANS
    `visiting-school case` WITH
        `standard hours`                       IS 48
        `visiting classes taught 2 hours`      IS 12
        `visiting classes taught 3 hours`      IS 0
        `weekly hours of the layer's position` IS 24
`the same school at 30` MEANS
    `visiting-school case` WITH
        `standard hours`                       IS 48
        `visiting classes taught 2 hours`      IS 12
        `visiting classes taught 3 hours`      IS 0
        `weekly hours of the layer's position` IS 30
`the two layer divisors give different class counts for a school of both layers` MEANS
    NOT (`classes for the management allowance` `a school of both layers, 48 standard hours, at 24`
         EQUALS `classes for the management allowance` `the same school at 30`)
#ASSERT `the two layer divisors give different class counts for a school of both layers`

§§ `Property checks`

-- The section's rules over their whole finite space: both kinds of school
-- on the eve of each one's starting day, on it, and in 2000, split or not;
-- every school population; and every school of 0 to 60 standard hours by
-- fours, 0 to 10 visiting classes of each kind, and either divisor.

`both booleans` MEANS LIST TRUE, FALSE
`both kinds of school` MEANS LIST `agricultural`, `maritime`
`every school population` MEANS LIST `grades 1-6 only`, `grades 7-12`, `both grades 1-6 and grades 7-12`
`the standard hours checked` MEANS map (GIVEN k YIELD k TIMES 4) (range 0 15)

-- 3.19.6.1: from the day each kind of school's allowance applies, and
-- never before it, exactly a teacher split by section 1.11's measures.
#ASSERT all (GIVEN k YIELD
                all (GIVEN split YIELD
                            (NOT `entitled to the split allowance` k (`the split allowance applies from` k MINUS 1) split)
                        AND `entitled to the split allowance` k (`the split allowance applies from` k) split EQUALS split
                        AND `entitled to the split allowance` k (Date 1 1 2000) split EQUALS split)
                    `both booleans`)
            `both kinds of school`

-- 3.19.6.2-3, F-3.19-a over every population: the subject coordinator's
-- rules are undecided in exactly one population, and it is exactly the
-- one where a layer coordinator may be appointed.
#ASSERT all (GIVEN p YIELD
                (`subject-coordination rules of an agricultural farm` p EQUALS `not decided by the text`)
                EQUALS `a layer coordinator may be appointed on an agricultural farm` p)
            `every school population`
#ASSERT count (filter (GIVEN p YIELD `subject-coordination rules of an agricultural farm` p EQUALS `not decided by the text`) `every school population`) EQUALS 1

GIVEN h IS A NUMBER, v2 IS A NUMBER, v3 IS A NUMBER, d IS A NUMBER
GIVETH A `visiting-school case`
DECIDE `a checked visiting school` h v2 v3 d IS
    `visiting-school case` WITH
        `standard hours`                       IS h
        `visiting classes taught 2 hours`      IS v2
        `visiting classes taught 3 hours`      IS v3
        `weekly hours of the layer's position` IS d

GIVEN prop IS A FUNCTION FROM NUMBER AND NUMBER AND NUMBER TO BOOLEAN
GIVETH A BOOLEAN
DECIDE `holds for every visiting school` prop IF
    all (GIVEN h YIELD
            all (GIVEN v2 YIELD
                    all (GIVEN v3 YIELD prop h v2 v3)
                        (range 0 10))
                (range 0 10))
        `the standard hours checked`

-- 3.19.7: the count (3) makes of both kinds agrees with formula (1) where
-- no class is taught 3 hours and with formula (2) where none is taught 2;
-- it is never negative, and never falls as visiting classes are added.
-- F-3.19-c over the whole space: the divisor of 24 never gives fewer
-- classes than that of 30. F-3.19-b over the whole space: the printed
-- multiplier never gives fewer classes than the one read, and the two
-- agree wherever no class is taught 3 hours.
GIVEN h IS A NUMBER, v2 IS A NUMBER, v3 IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the class count agrees with its formulas` h v2 v3 IF
    all (GIVEN d YIELD
                `classes for the management allowance` (`a checked visiting school` h v2 v3 d) AT LEAST 0
            AND ((v3 GREATER THAN 0)
                 OR `classes for the management allowance` (`a checked visiting school` h v2 v3 d)
                    EQUALS CEILING (`classes by the 2-hour formula` (`a checked visiting school` h v2 v3 d)))
            AND ((v2 GREATER THAN 0)
                 OR `classes for the management allowance` (`a checked visiting school` h v2 v3 d)
                    EQUALS CEILING (`classes by the 3-hour formula` (`a checked visiting school` h v2 v3 d) `the multiplier of the 3-hour formula`))
            AND `classes for the management allowance` (`a checked visiting school` h (v2 PLUS 1) v3 d)
                AT LEAST `classes for the management allowance` (`a checked visiting school` h v2 v3 d)
            AND `classes for the management allowance` (`a checked visiting school` h v2 (v3 PLUS 1) d)
                AT LEAST `classes for the management allowance` (`a checked visiting school` h v2 v3 d)
            AND CEILING (`classes by the 3-hour formula` (`a checked visiting school` h 0 v3 d) `the multiplier as printed`)
                AT LEAST CEILING (`classes by the 3-hour formula` (`a checked visiting school` h 0 v3 d) `the multiplier of the 3-hour formula`)
            AND ((v3 GREATER THAN 0)
                 OR `classes by the 3-hour formula` (`a checked visiting school` h 0 v3 d) `the multiplier as printed`
                    EQUALS `classes by the 3-hour formula` (`a checked visiting school` h 0 v3 d) `the multiplier of the 3-hour formula`))
        (LIST 24, 30)
    AND `classes for the management allowance` (`a checked visiting school` h v2 v3 24)
        AT LEAST `classes for the management allowance` (`a checked visiting school` h v2 v3 30)
#ASSERT `holds for every visiting school` `the class count agrees with its formulas`
