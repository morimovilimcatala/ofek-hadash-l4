    `probationer` WITH
        `certified when hired`                  IS FALSE
        `year of work in which certified`       IS 2
        `a kindergarten teacher hired for general or professional teaching` IS FALSE
        `uncertified stage`                     IS `other stage`
        `years added by extension notices`      IS 0
