-- תקנון שירות עובדי הוראה, פרק 4, §4.12 מורה יועץ
-- The special-education counsellor: who may serve, the training required,
-- the goals and functions, the special-education supplement beside the
-- counselling allowance, and the organisational framework.

IMPORT prelude
IMPORT common

§ `4.12 מורה יועץ`

@desc A candidate counsellor in special education, as section 4.12.2 asks about them.
DECLARE `special-education counsellor candidate` HAS
    `certified teacher in special education`             IS A BOOLEAN
    `years teaching in special education`                IS A NUMBER
    `academic counselling training with a special-education bearing` IS A BOOLEAN
    `already employed as a special-education counsellor` IS A BOOLEAN
    `completing the missing education`                   IS A BOOLEAN
    `a regular-education counsellor`                     IS A BOOLEAN
    `completed the special programme of שפ"י and the special-education department` IS A BOOLEAN
    `academic studies in a special-education department` IS A BOOLEAN
    `completed the missing academic courses in counselling and vocational guidance` IS A BOOLEAN
    `an exceptional case`                                IS A BOOLEAN

@desc One goal or function of the special-education counsellor, as the approved list states it.
DECLARE `counselling function` HAS
    `area of the function` IS A STRING
    `what the function is` IS A STRING

@desc The parties of section 4.12: the takanon's common ones, and the district's senior special-education counsellor, whom common.l4 does not name.
DECLARE `4.12 party` IS ONE OF
    `a takanon party` HAS `who` IS A Party
    `the district senior special-education counsellor`

DECLARE `special-education counsellor action` IS ONE OF
    `take the special training of the field`
    `refer the counsellor to work`
    `approve the referral`
    `plan and give the counsellor's guidance`

DECLARE `special-education framework` IS ONE OF
    `early childhood`, `compulsory kindergarten`, `primary school and middle school`,
    `advancement classes in a regular school`, `therapeutic classes`, `learning-difficulty classes`,
    `classes in medical institutions`, `classes in welfare institutions`, `recognised schools`,
    `another special-education framework`

§§ `4.12.2 מינוי`

-- (1): all three conditions; the counsellor already serving who lacks some
-- of them is not harmed, provided the missing education is completed.
@ref akn:chp_4__sec_4_12__ssec_4_12_2__para_1 akn:chp_4__sec_4_12__ssec_4_12_2__para_1__subpara_a akn:chp_4__sec_4_12__ssec_4_12_2__para_1__subpara_b akn:chp_4__sec_4_12__ssec_4_12_2__para_1__subpara_c/p1
GIVEN c IS A `special-education counsellor candidate`
GIVETH A BOOLEAN
DECIDE `meets the conditions of a special-education counsellor` c IF
        c's `certified teacher in special education`
    AND c's `years teaching in special education` AT LEAST 3
    AND c's `academic counselling training with a special-education bearing`

@ref akn:chp_4__sec_4_12__ssec_4_12_2__para_1__subpara_c/p2
GIVEN c IS A `special-education counsellor candidate`
GIVETH A BOOLEAN
DECIDE `kept on as a serving counsellor` c IF
    c's `already employed as a special-education counsellor` AND c's `completing the missing education`

@ref akn:chp_4__sec_4_12__ssec_4_12_2__para_2
GIVEN c IS A `special-education counsellor candidate`
GIVETH A BOOLEAN
DECIDE `a regular-education counsellor may become one` c IF
    c's `a regular-education counsellor` AND c's `completed the special programme of שפ"י and the special-education department`

@ref akn:chp_4__sec_4_12__ssec_4_12_2__para_3
GIVEN c IS A `special-education counsellor candidate`
GIVETH A BOOLEAN
DECIDE `approved as an exception` c IF
        c's `an exceptional case`
    AND c's `certified teacher in special education`
    AND c's `years teaching in special education` AT LEAST 3
    AND c's `academic studies in a special-education department`
    AND c's `completed the missing academic courses in counselling and vocational guidance`

@export Whether a teaching employee may work as a counsellor in special education under section 4.12.2 of the takanon
GIVEN c IS A `special-education counsellor candidate` @desc the candidate
GIVETH A BOOLEAN
DECIDE `may work as a special-education counsellor` c IF
       `meets the conditions of a special-education counsellor` c
    OR `kept on as a serving counsellor` c
    OR `a regular-education counsellor may become one` c
    OR `approved as an exception` c

-- (4): special training by the fields of work — the list is open ("וכו'").
@ref akn:chp_4__sec_4_12__ssec_4_12_2__para_4/p1
GIVETH A DEONTIC `4.12 party` `special-education counsellor action`
DECIDE `special training by field` IS
    PARTY `a takanon party` `the teaching employee` MUST `take the special training of the field`

-- akn:chp_4__sec_4_12__ssec_4_12_2__para_4/p2 A pointer: see also section 3.12.2 (counselling licences), encoded there.
-- akn:chp_4__sec_4_12__ssec_4_12_2/p1 Heading of the source list (אסמכתא).
-- akn:chp_4__sec_4_12__ssec_4_12_2/p2 Source (אסמכתא): a Director-General's circular.

§§ `4.12.3 הגדרת תפקידים`

-- akn:chp_4__sec_4_12__ssec_4_12_3/p1 The heading of the goals ("מטרות הייעוץ").
@ref akn:chp_4__sec_4_12__ssec_4_12_3/p2
`the goals of counselling in special education` MEANS
    LIST
        `counselling function` "goal" "coming to the help of the pupils, their parents, the educational staff and the school's interdisciplinary team",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p3 Goal 2: directing and coordinating the pupil's rehabilitation.
        `counselling function` "goal" "directing and coordinating the pupil's rehabilitation, as the functions below detail",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p4 Goal 3: an atmosphere that advances human relations in the school.
        `counselling function` "goal" "working for an atmosphere that advances human relations in the school"

-- 4: every function is filled as the framework needs, by the school's
-- management in coordination with שפ"י and the special-education
-- supervision.
@ref akn:chp_4__sec_4_12__ssec_4_12_3/p5
GIVEN `filled by the management` IS A BOOLEAN, `coordinated with שפ"י and the supervision` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a function is filled as the clause requires` `filled by the management` `coordinated with שפ"י and the supervision` IF
    `filled by the management` AND `coordinated with שפ"י and the supervision`

@ref akn:chp_4__sec_4_12__ssec_4_12_3/p6
`the functions of the special-education counsellor` MEANS
    LIST
-- akn:chp_4__sec_4_12__ssec_4_12_3/p7 Heading of function group 1 (employment counselling and guidance).
-- akn:chp_4__sec_4_12__ssec_4_12_3/p8 akn:chp_4__sec_4_12__ssec_4_12_3/p9 Group 1 is done with the homeroom teacher, toward vocational and social rehabilitation (its area says so); 1(a) helping teach "toward independence".
        `counselling function` "employment counselling toward vocational and social rehabilitation, with the homeroom teacher" "helping to teach \"toward independence\": self-knowledge, the world of work, occupational choice",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p10 1(b) counselling pupils and parents.
        `counselling function` "employment counselling toward vocational and social rehabilitation, with the homeroom teacher" "counselling pupils and parents, singly and in groups",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p11 1(c) consulting the educational and interdisciplinary staff.
        `counselling function` "employment counselling toward vocational and social rehabilitation, with the homeroom teacher" "consulting the educational and interdisciplinary staff",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p12 1(d) organising visits to workplaces.
        `counselling function` "employment counselling toward vocational and social rehabilitation, with the homeroom teacher" "organising visits with pupils to workplaces",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p13 1(e) graduated transfer to the youth employment service.
        `counselling function` "employment counselling toward vocational and social rehabilitation, with the homeroom teacher" "the pupil's graduated transfer to the youth employment service",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p14 1(f) workshop days and combined study and work.
        `counselling function` "employment counselling toward vocational and social rehabilitation, with the homeroom teacher" "initiating and helping to run workshop days or combined study and work",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p15 Heading of function group 2 (educational-therapeutic counselling).
-- akn:chp_4__sec_4_12__ssec_4_12_3/p16 akn:chp_4__sec_4_12__ssec_4_12_3/p17 Group 2: the counsellor centres the overall care of the individual, with the team, management and supervision, by שפ"י's directions (its area says so); 2(a) helping the teacher with behaviour problems.
        `counselling function` "educational-therapeutic counselling, centring the individual's care" "helping the teacher with the pupil's behaviour problems, individually or in a group",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p18 2(b) helping the teacher with learning problems and disabilities.
        `counselling function` "educational-therapeutic counselling, centring the individual's care" "helping the teacher with learning problems or learning disabilities, individually or in a group",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p19 2(c) helping the principal run the interdisciplinary team, with personal programmes.
        `counselling function` "educational-therapeutic counselling, centring the individual's care" "helping the principal run the interdisciplinary and inter-service team, planning and following personal programmes",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p20 2(d) special subjects by the counsellor's training and the pupils' needs.
        `counselling function` "educational-therapeutic counselling, centring the individual's care" "running special subjects — therapeutic teaching, individual programmes and the like — by training, skill and the pupils' needs",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p21 2(e) "preparation for family life" (in state-religious schools, with the supervisor's approval).
        `counselling function` "educational-therapeutic counselling, centring the individual's care" "running \"preparation for family life\" (in a state-religious school with the supervisor's approval), with talks to pupils and parents",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p22 2(f) initiated discussions of single pupils.
        `counselling function` "educational-therapeutic counselling, centring the individual's care" "initiating discussions of single pupils in the interdisciplinary team or the teachers' council",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p23 Heading of function group 3 (intake, referral and follow-up).
-- akn:chp_4__sec_4_12__ssec_4_12_3/p24 3(a) intake, referral and direction of the pupils.
        `counselling function` "intake, referral and follow-up" "receiving, referring and directing pupils to frameworks in and outside the school",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p25 3(b) following the pupil's development until transfer.
        `counselling function` "intake, referral and follow-up" "following the pupil's development from entry until transfer to another framework",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p26 3(c) graduated transfer to a rehabilitative framework.
        `counselling function` "intake, referral and follow-up" "seeing to the pupil's graduated transfer to a rehabilitative framework, with the staff, parents and the framework",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p27 3(d) accompanying graduates through their first year.
        `counselling function` "intake, referral and follow-up" "accompanying graduates and following their adjustment through the first year in the new framework",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p28 3(e) continuing with a graduate not yet placed.
        `counselling function` "intake, referral and follow-up" "continuing to care for a graduate not placed in work or another framework until placed",
-- akn:chp_4__sec_4_12__ssec_4_12_3/p29 3(f) following pupils in workshop days and study-and-work.
        `counselling function` "intake, referral and follow-up" "following pupils in workshop days or in combined study and work"

-- 3(d)-(e): the follow-up has a length — a graduate is accompanied through
-- the first year after leaving, and one not placed is cared for until
-- placed.
@ref akn:chp_4__sec_4_12__ssec_4_12_3/p27 akn:chp_4__sec_4_12__ssec_4_12_3/p28
GIVEN `months since the graduate left` IS A NUMBER, `the graduate is placed` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the counsellor still follows the graduate` `months since the graduate left` `the graduate is placed` IF
    `months since the graduate left` LESS THAN 12 OR NOT `the graduate is placed`

-- akn:chp_4__sec_4_12__ssec_4_12_3/p30 Heading of the source list (אסמכתא).
-- akn:chp_4__sec_4_12__ssec_4_12_3/p31 Source (אסמכתא): a Director-General's circular.

§§ `4.12.6 גמולים`

-- akn:chp_4__sec_4_12__ssec_4_12_6/p1 A heading ("תוספת חינוך מיוחד", the special-education supplement).

-- (1)-(2): the supplement continues (or begins, for one certified and
-- starting special-education work after the appointment), paid beside the
-- counselling allowance, by the position fraction.
@ref akn:chp_4__sec_4_12__ssec_4_12_6__para_1/p1 akn:chp_4__sec_4_12__ssec_4_12_6__para_2/p1
GIVEN `worked in special education before the appointment` IS A BOOLEAN,
      `certified for and started special-education work after the appointment` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the counsellor receives the special-education supplement` `worked in special education before the appointment` `certified for and started special-education work after the appointment` IF
    `worked in special education before the appointment` OR `certified for and started special-education work after the appointment`

@ref akn:chp_4__sec_4_12__ssec_4_12_6__para_1/p2
GIVEN `the supplement for a full position` IS A NUMBER @desc the special-education supplement for a full position (section 4.6); an input
      , `position fraction` IS A NUMBER
      , `entitled` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `special-education supplement of the counsellor` `the supplement for a full position` `position fraction` `entitled` IS
    IF `entitled` THEN `the supplement for a full position` TIMES `position fraction` ELSE 0

@ref akn:chp_4__sec_4_12__ssec_4_12_6__para_2/p2
GIVEN `serves as a counsellor` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `entitled to the counselling allowance` `serves as a counsellor` IF `serves as a counsellor`

-- akn:chp_4__sec_4_12__ssec_4_12_6__para_2/p3 A pointer: the allowance's terms are section 1.12's, encoded there.
-- akn:chp_4__sec_4_12__ssec_4_12_6/p2 Heading of the source list (אסמכתא).
-- akn:chp_4__sec_4_12__ssec_4_12_6/p3 Source (אסמכתא): a Director-General's circular.

§§ `4.12.7 המסגרת הארגונית`

-- (1): all special-education classes, in every framework; the list ends
-- "וכו'" (and so on), so it is open, closed here by `another special-education framework`.
@ref akn:chp_4__sec_4_12__ssec_4_12_7__para_1
`the frameworks the counsellor works in` MEANS
    LIST `early childhood`, `compulsory kindergarten`, `primary school and middle school`,
         `advancement classes in a regular school`, `therapeutic classes`, `learning-difficulty classes`,
         `classes in medical institutions`, `classes in welfare institutions`, `recognised schools`,
         `another special-education framework`

@ref akn:chp_4__sec_4_12__ssec_4_12_7__para_2
GIVEN `special-education classes` IS A NUMBER
GIVETH A NUMBER
DECIDE `weekly counselling hours` `special-education classes` IS
    2 TIMES `special-education classes`

@ref akn:chp_4__sec_4_12__ssec_4_12_7__para_3
GIVEN `serves several classes in small schools or single classes` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a roving counsellor` `serves several classes in small schools or single classes` IF
    `serves several classes in small schools or single classes`

-- (4): referred by the district's senior special-education counsellor and
-- approved by the district's special-education supervisor.
@ref akn:chp_4__sec_4_12__ssec_4_12_7__para_4
GIVETH A DEONTIC `4.12 party` `special-education counsellor action`
DECIDE `referral and approval` IS
    PARTY `the district senior special-education counsellor`
    MUST  `refer the counsellor to work`
    HENCE (PARTY `a takanon party` `the supervisor` MUST `approve the referral`)

-- (5): planned and given by the district's senior special-education
-- counsellor within שפ"י's directions, in full coordination with the
-- special-education supervisor.
@ref akn:chp_4__sec_4_12__ssec_4_12_7__para_5
GIVETH A DEONTIC `4.12 party` `special-education counsellor action`
DECIDE `guidance of the counsellor` IS
    PARTY `the district senior special-education counsellor` MUST `plan and give the counsellor's guidance`

-- akn:chp_4__sec_4_12__ssec_4_12_7/p1 Heading of the source list (אסמכתא).
-- akn:chp_4__sec_4_12__ssec_4_12_7/p2 Source (אסמכתא): a Director-General's circular.
-- akn:chp_4__sec_4_12__ssec_4_12_7/p3 A stray heading ("4.12.1 יחידת עבודה") printed after 4.12.7.
-- akn:chp_4__sec_4_12__ssec_4_12_7/p4 A pure pointer: the work unit is section 3.12.1's, encoded there.
-- akn:chp_4__sec_4_12__ssec_4_12_7/p5 An empty source heading (אסמכתא) with no source after it.

-- Examples.
`a serving counsellor without the academic training` MEANS
    `special-education counsellor candidate` WITH
        `certified teacher in special education`             IS TRUE
        `years teaching in special education`                IS 5
        `academic counselling training with a special-education bearing` IS FALSE
        `already employed as a special-education counsellor` IS TRUE
        `completing the missing education`                   IS TRUE
        `a regular-education counsellor`                     IS FALSE
        `completed the special programme of שפ"י and the special-education department` IS FALSE
        `academic studies in a special-education department` IS FALSE
        `completed the missing academic courses in counselling and vocational guidance` IS FALSE
        `an exceptional case`                                IS FALSE

#ASSERT `may work as a special-education counsellor` `a serving counsellor without the academic training`
#ASSERT NOT `meets the conditions of a special-education counsellor` `a serving counsellor without the academic training`
#ASSERT `weekly counselling hours` 6 EQUALS 12
#ASSERT count `the frameworks the counsellor works in` EQUALS 10
#ASSERT `special-education supplement of the counsellor` 1000 0.5 TRUE EQUALS 500
#ASSERT count `the functions of the special-education counsellor` EQUALS 18
#TRACE `referral and approval` AT 0 WITH
    PARTY `the district senior special-education counsellor` DOES `refer the counsellor to work` AT 1
    PARTY `a takanon party` `the supervisor` DOES `approve the referral` AT 2
