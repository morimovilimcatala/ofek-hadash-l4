-- תקנון שירות עובדי הוראה, פרק 1א', §1.21 קבלה לעבודה
-- Taking up work: the Civil Service (Appointments) Law as applied to
-- teaching employees; teaching licences for post-primary schools (general
-- routes, special subjects, exceptional and temporary licences, completion
-- exams and exemptions); licences for technological subjects; and the
-- Director-General's employment approval.

IMPORT prelude
IMPORT common

§ `1.21 קבלה לעבודה`

-- akn:chp_1א___sec_1_21/p2 akn:chp_1א___sec_1_21/p3 akn:chp_1א___sec_1_21/p4 akn:chp_1א___sec_1_21/p5 akn:chp_1א___sec_1_21/p6 The page's table of contents: the titles of 1.21.1 to 1.21.4.

§§ `1.21.1 הפעלת חוק שירות המדינה על עובדי הוראה`

-- akn:chp_1א___sec_1_21__ssec_1_21_1/p1 Heading: "1. conditions for receiving a letter of appointment".

-- ¶2: by the government decision of 2.5.1967, the Civil Service
-- (Appointments) Law applies, from 20.11.1967, to teachers, principals,
-- kindergarten teachers and Shelach instructors whose salary is paid directly
-- from the Ministry's budget. All are exempt from the standards sections
-- (13–15); all but school principals are exempt from the public tender (19).
-- Dates are numbers YYYYMMDD.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p2
DECLARE `appointments-law role` IS ONE OF
    `a teacher`
    `a school principal`
    `a kindergarten teacher`
    `a Shelach instructor`
    `another employee`

`20 November 1967` MEANS 19671120

GIVEN r IS AN `appointments-law role`, `paid directly from the Ministry's budget` IS A BOOLEAN, `date` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the Appointments Law applies` r `paid directly from the Ministry's budget` `date` IF
        NOT r EQUALS `another employee`
    AND `paid directly from the Ministry's budget`
    AND `date` AT LEAST `20 November 1967`

DECLARE `section of the Appointments Law` IS ONE OF
    `the standards sections 13 to 15`
    `the public tender, section 19`
    `another section of the law`

GIVEN r IS AN `appointments-law role`, s IS A `section of the Appointments Law`
GIVETH A BOOLEAN
DECIDE `exempt from the section` r s IF
    CONSIDER s
    WHEN `the standards sections 13 to 15` THEN TRUE
    WHEN `the public tender, section 19`   THEN NOT r EQUALS `a school principal`
    OTHERWISE FALSE

#ASSERT NOT `exempt from the section` `a school principal` `the public tender, section 19`
#ASSERT `exempt from the section` `a teacher` `the public tender, section 19`

-- ¶3: the law sets the conditions for a letter of appointment; ¶4–¶17 give
-- the main ones, each a heading row and its text.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p3
DECLARE `candidate for appointment` HAS
    @ref akn:chp_1א___sec_1_21__ssec_1_21_1/p4 akn:chp_1א___sec_1_21__ssec_1_21_1/p5
    `is an Israeli citizen`                IS A BOOLEAN
    `employed under a special contract`    IS A BOOLEAN  @desc in special circumstances a non-citizen may be employed under a special contract (sections 16 and 40)
    @ref akn:chp_1א___sec_1_21__ssec_1_21_1/p6 akn:chp_1א___sec_1_21__ssec_1_21_1/p7
    `made the declaration of allegiance`   IS A BOOLEAN  @desc "I undertake to keep allegiance to the State of Israel and its laws…", made before the letter of appointment is delivered (section 34)
    @ref akn:chp_1א___sec_1_21__ssec_1_21_1/p8 akn:chp_1א___sec_1_21__ssec_1_21_1/p9
    `declared property in writing`         IS A BOOLEAN  @desc assets and debts of the employee, the spouse living with the employee and dependent children, and their sources of income (section 35)
    @ref akn:chp_1א___sec_1_21__ssec_1_21_1/p10 akn:chp_1א___sec_1_21__ssec_1_21_1/p11
    `found medically fit`                  IS A BOOLEAN  @desc examined, and found fit for the post by a government doctor or a medical committee (section 29)
    @ref akn:chp_1א___sec_1_21__ssec_1_21_1/p12 akn:chp_1א___sec_1_21__ssec_1_21_1/p13
    `barred by a family relation`          IS A BOOLEAN  @desc the restrictions on appointment where a close relative works in the same unit (section 33); their content is section 1.37 of the takanon, an input here
    @ref akn:chp_1א___sec_1_21__ssec_1_21_1/p14 akn:chp_1א___sec_1_21__ssec_1_21_1/p15 akn:chp_1א___sec_1_21__ssec_1_21_1/p16 akn:chp_1א___sec_1_21__ssec_1_21_1/p17
    `accepted for permanent work`          IS A BOOLEAN
    `passed the probation period`          IS A BOOLEAN

DECLARE `appointment action` IS ONE OF
    `make the declaration of allegiance`
    `deliver the letter of appointment`
    `accept the teacher for permanent work`

-- ב: the declaration of allegiance comes BEFORE the letter is delivered.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p7
GIVETH A DEONTIC Party `appointment action`
DECIDE `allegiance before appointment` IS
    PARTY `the teaching employee`
    MUST  `make the declaration of allegiance`
    HENCE (PARTY `the Ministry of Education`
           MAY   `deliver the letter of appointment`)

-- ו (¶14–¶15): one accepted for permanent work is employed under an
-- authorisation of hourly employment until the letter of appointment comes;
-- א: a non-citizen only under a special contract.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p15
DECLARE `basis of employment` IS ONE OF
    `a letter of appointment`
    `an authorisation of hourly employment`
    `a special contract`
    `no lawful basis`

GIVEN c IS A `candidate for appointment`, `holds a letter of appointment` IS A BOOLEAN
GIVETH A `basis of employment`
DECIDE `the basis of employment` c `holds a letter of appointment` IS
    IF NOT c's `is an Israeli citizen`
    THEN IF c's `employed under a special contract` THEN `a special contract` ELSE `no lawful basis`
    ELSE IF `holds a letter of appointment`
         THEN `a letter of appointment`
         ELSE IF c's `accepted for permanent work`
              THEN `an authorisation of hourly employment`
              ELSE `no lawful basis`

-- ז (¶16–¶17): a letter of appointment once every condition above is met and
-- the probation period is passed.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p17
GIVEN c IS A `candidate for appointment`
GIVETH A BOOLEAN
DECIDE `entitled to a letter of appointment` c IF
        c's `is an Israeli citizen`
    AND c's `made the declaration of allegiance`
    AND c's `declared property in writing`
    AND c's `found medically fit`
    AND NOT c's `barred by a family relation`
    AND c's `accepted for permanent work`
    AND c's `passed the probation period`

`a candidate who meets every condition` MEANS `candidate for appointment` WITH
    `is an Israeli citizen`              IS TRUE
    `employed under a special contract`  IS FALSE
    `made the declaration of allegiance` IS TRUE
    `declared property in writing`       IS TRUE
    `found medically fit`                IS TRUE
    `barred by a family relation`        IS FALSE
    `accepted for permanent work`        IS TRUE
    `passed the probation period`        IS TRUE

#ASSERT `entitled to a letter of appointment` `a candidate who meets every condition`
#ASSERT `the basis of employment` `a candidate who meets every condition` FALSE EQUALS `an authorisation of hourly employment`

-- akn:chp_1א___sec_1_21__ssec_1_21_1/p18 Heading: "notes".

-- Note 1 (¶19): under ו, a principal may not accept a teacher for permanent
-- work until the authorisation of hourly employment has come from the
-- district office.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p19
GIVEN `the authorisation has arrived` IS A BOOLEAN
GIVETH A DEONTIC Party `appointment action`
DECIDE `no permanent acceptance before the authorisation` `the authorisation has arrived` IS
    IF `the authorisation has arrived`
    THEN PARTY `the school principal`
         MAY   `accept the teacher for permanent work`
    ELSE PARTY `the school principal`
         SHANT `accept the teacher for permanent work`
         LEST  BREACH BY `the school principal` BECAUSE "section 1.21.1, note 1: no permanent acceptance before the hourly-employment authorisation"

-- akn:chp_1א___sec_1_21__ssec_1_21_1/p20 Note 2: details of the ceremonies and procedure "will be published later"; it promises a publication and sets no rule.

-- Note 3 (¶21): the full text of the law (Sefer HaHukim 279, 5719, p. 86)
-- and the regulations, rules and notices under it are binding — so where
-- this summary differs from the law, the law governs.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p21
DECLARE `text on appointment` IS ONE OF
    `the law and the instruments under it`
    `the takanon's summary of the law`

GIVEN `the summary differs from the law` IS A BOOLEAN
GIVETH A `text on appointment`
DECIDE `the binding text` `the summary differs from the law` IS
    `the law and the instruments under it`

-- akn:chp_1א___sec_1_21__ssec_1_21_1/p22 akn:chp_1א___sec_1_21__ssec_1_21_1/p23 Heading "2. applying the law to veteran teaching employees", and its introduction.

-- ¶24: an employee with permanent status on the day the law is applied
-- receives from the district office (or employing unit), through the
-- principal, these forms.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p24
`the forms for a veteran employee` MEANS
    LIST
        @ref akn:chp_1א___sec_1_21__ssec_1_21_1/p25
        "a notice to the teaching employee",
        @ref akn:chp_1א___sec_1_21__ssec_1_21_1/p26
        "an application form for a certificate of Israeli citizenship",
        @ref akn:chp_1א___sec_1_21__ssec_1_21_1/p27
        "a property declaration form",
        @ref akn:chp_1א___sec_1_21__ssec_1_21_1/p28
        "an envelope for the property declaration"

DECLARE `veteran procedure action` IS ONE OF
    `apply for a certificate of citizenship`
    `present proof of citizenship`
    `hand the property declaration to the principal`
    `forward the material to the district office`

-- ¶29: on receiving the forms, the employee applies at once to the Interior
-- Ministry for a certificate of citizenship and presents it on receipt; a
-- valid Israeli passport may be presented instead.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p29
GIVEN `has the certificate of citizenship` IS A BOOLEAN, `has a valid Israeli passport` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `proof of citizenship is presented` `has the certificate of citizenship` `has a valid Israeli passport` IF
    `has the certificate of citizenship` OR `has a valid Israeli passport`

GIVETH A DEONTIC Party `veteran procedure action`
DECIDE `applying for the certificate` IS
    PARTY `the teaching employee`
    MUST  `apply for a certificate of citizenship`
    HENCE (PARTY `the teaching employee`
           MUST  `present proof of citizenship`)

-- ¶30: within 20 days of receiving the forms the employee hands the property
-- declaration and its envelope to the principal. Time in days from the
-- receipt of the forms.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p30
GIVETH A DEONTIC Party `veteran procedure action`
DECIDE `the employee's 20 days` IS
    PARTY `the teaching employee`
    MUST  `hand the property declaration to the principal`
    WITHIN 20
    LEST  BREACH BY `the teaching employee` BECAUSE "section 1.21.1(2)ג: the declaration is handed to the principal within 20 days"

-- ¶31: within 30 days of the SAME receipt the principal forwards the material.
-- Both periods run from the employee's receipt of the forms, so the
-- principal's deadline is what is left of the 30 days when the employee
-- hands the declaration in.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p31
GIVEN `day the employee handed it in` IS A NUMBER
GIVETH A DEONTIC Party `veteran procedure action`
DECIDE `the principal's 30 days` `day the employee handed it in` IS
    PARTY `the school principal`
    MUST  `forward the material to the district office`
    WITHIN 30 MINUS `day the employee handed it in`
    LEST  BREACH BY `the school principal` BECAUSE "section 1.21.1(2)ד: the principal forwards the material within 30 days of the employee's receipt of the forms"

#TRACE `the employee's 20 days` AT 0 WITH
    PARTY `the teaching employee` DOES `hand the property declaration to the principal` AT 12
#TRACE `the principal's 30 days` 12 AT 12 WITH
    PARTY `the school principal` DOES `forward the material to the district office` AT 25

-- ¶32: a non-citizen employee is deemed to have resigned from the civil
-- service a year after this procedure is applied to him, unless he acquires
-- citizenship by then; the Civil Service Commission may set compensation or
-- a pension as it sees fit. ¶33: exceptionally he may be employed after the
-- year under a special contract, as new non-citizen employees are. Time in
-- days from the procedure's application to him.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p32 akn:chp_1א___sec_1_21__ssec_1_21_1/p33
GIVEN `days since the procedure applied` IS A NUMBER, `acquired citizenship` IS A BOOLEAN, `kept under a special contract` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `deemed to have resigned` `days since the procedure applied` `acquired citizenship` `kept under a special contract` IF
        `days since the procedure applied` AT LEAST 365
    AND NOT `acquired citizenship`
    AND NOT `kept under a special contract`

DECLARE `commission action` IS ONE OF
    `set compensation or a pension`

GIVETH A DEONTIC Party `commission action`
DECIDE `compensation for a deemed resignation` IS
    PARTY `the Civil Service Commission`
    MAY   `set compensation or a pension`

#ASSERT `deemed to have resigned` 400 FALSE FALSE
#ASSERT NOT `deemed to have resigned` 400 FALSE TRUE

-- akn:chp_1א___sec_1_21__ssec_1_21_1/p34 akn:chp_1א___sec_1_21__ssec_1_21_1/p35 The circular ¶33 rests on (Director-General's circular כט/1 of 1.9.1968), and the heading "note".

-- ¶36: these instructions apply to teaching employees employed by the
-- Ministry in primary education and by its teacher-training, Hebrew-teaching,
-- agricultural-education, Shelach and maritime-education units.
@ref akn:chp_1א___sec_1_21__ssec_1_21_1/p36
DECLARE `employing unit` IS ONE OF
    `the Ministry's primary education`
    `the teacher-training department`
    `the department for teaching Hebrew`
    `the agricultural-education division`
    `the Shelach supervision`
    `the maritime-education unit`
    `another employer`

GIVEN u IS AN `employing unit`
GIVETH A BOOLEAN
DECIDE `the veterans procedure applies` u IF
    NOT u EQUALS `another employer`

-- akn:chp_1א___sec_1_21__ssec_1_21_1/p37 akn:chp_1א___sec_1_21__ssec_1_21_1/p38 akn:chp_1א___sec_1_21__ssec_1_21_1/p39 akn:chp_1א___sec_1_21__ssec_1_21_1/p40 Subsection 1.21.1's source list (אסמכתא): two circulars, and a note that sections cited without a source are from the Takshir.

§§ `1.21.2 Teaching licences — the vocabulary`

DECLARE `country of study` IS ONE OF
    `Israel`
    `an English-speaking country`
    `a French-speaking country`
    `another country`

`Israel only`                   MEANS LIST `Israel`
`abroad`                        MEANS LIST `an English-speaking country`, `a French-speaking country`, `another country`
`Israel or abroad`              MEANS LIST `Israel`, `an English-speaking country`, `a French-speaking country`, `another country`
`an English-speaking country only` MEANS LIST `an English-speaking country`
`a French-speaking country only`   MEANS LIST `a French-speaking country`
`abroad, not English-speaking`  MEANS LIST `a French-speaking country`, `another country`
`abroad, not French-speaking`   MEANS LIST `an English-speaking country`, `another country`

DECLARE `certificate level` IS ONE OF
    `post-primary`
    `junior high`
    `primary`
    `kindergarten`

`post-primary or junior high` MEANS LIST `post-primary`, `junior high`

DECLARE `grade range` IS ONE OF
    `grades 7 to 12`
    `grades 7 to 10`
    `the junior high school`
    `grades 11 to 12`

DECLARE `exam` IS ONE OF
    `adolescent psychology`
    `theory of education`
    `theory of teaching`
    `methodology of teaching the subject`
    `Hebrew language`
    `Bible`
    `Hebrew literature`
    `Jewish history`
    `civics`
    `Jewish heritage`
    `English proficiency, mark 80 or more`
    `pedagogical linguistics`
    `English and American literature`
    `300 pages of Gemara`
    `introduction to the Oral Law`
    `educational thought`
    `ways of teaching and the Bible cantillation`
    `learning processes`
    `ways of teaching the Oral Law`
    `principles of special education`

-- What a route to a licence asks for. A degree "at least" of a level (1
-- first, 2 second, 3 third) in one of the fields, from one of the countries;
-- the field "the subject applied for" stands for the licence's own subject
-- and "any subject" for any field.
DECLARE `requirement` IS ONE OF
    `a degree` HAS
        `least degree level` IS A NUMBER
        `degree fields`      IS A LIST OF STRING
        `degree countries`   IS A LIST OF `country of study`
    `a teaching certificate` HAS
        `certificate fields`    IS A LIST OF STRING
        `certificate countries` IS A LIST OF `country of study`
        `certificate levels`    IS A LIST OF `certificate level`
    `an equivalent academic grade` HAS
        `least equivalent level` IS A NUMBER
        `equivalent fields`      IS A LIST OF STRING
    `full Hebrew education`
    `full pedagogical education`
    `completion exams` HAS `exams required` IS A LIST OF `exam`
    `a positive supervision report`
    `a matriculation certificate`
    `teaching experience` HAS
        `least years`      IS A NUMBER
        `experience where` IS A STRING
    `a general route` HAS
        `general route grades`   IS A `grade range`
        `general routes left out` IS A LIST OF STRING
    `a further condition` HAS `condition` IS A STRING

DECLARE `licence route` HAS
    `route name`         IS A STRING
    `licence subjects`   IS A LIST OF STRING
    `licence grades`     IS A `grade range`
    `route requirements` IS A LIST OF `requirement`

-- What an applicant holds.
DECLARE `exemption ground` IS ONE OF
    `finished an English-medium high school`
    `a degree or teaching certificate from an English-speaking country`
    `an Israeli degree in English and an Israeli English teaching certificate`
    `a degree in English literature`
    `a TESOL degree or diploma, or a degree in English or applied linguistics or English language`
    `an Israeli English teaching certificate`
    `a degree in education, applying for the pedagogical subjects`
    `a degree in psychology or Ben-Gurion behavioural sciences`
    `the same, applying for a psychology licence`
    `a primary teaching certificate, or a reserve-exams certification`
    `a certified professional instructor of the government technological institute`
    `a double major with education, applying for the other major`
    `an associate professor, docent or senior lecturer teaching the subject`
    `a permanent post-primary principal for three years or more`
    `a pedagogical instructor, mentor or methodology lecturer for two years or more`
    `taught the subject eight consecutive years, the last four in the same post-primary school`
    `taught in a Hebrew post-primary school before the State`
    `taught in a Hebrew primary school before the State`
    `a certified kindergarten teacher`
    `began teaching in Israel by 5721 and teaches continuously`
    `holds a "Jerusalem certificate"`
    `a foreign-language, vocational or science teacher over 50 with sufficient Hebrew in the supervisor's view`
    `a foreign-language, science or vocational teacher certified in Israel as a teacher for the diaspora, with sufficient Hebrew`
    `a rabbinical higher-education certificate of the Chief Rabbinate`
    `an equivalent grade to a second or third degree in the Oral Law`

DECLARE `holding` IS ONE OF
    `holds a degree` HAS
        `held degree level`   IS A NUMBER
        `held degree field`   IS A STRING
        `held degree country` IS A `country of study`
    `holds a teaching certificate` HAS
        `held certificate field`   IS A STRING
        `held certificate country` IS A `country of study`
        `held certificate level`   IS A `certificate level`
    `holds an equivalent academic grade` HAS
        `held equivalent level` IS A NUMBER
        `held equivalent field` IS A STRING
    `recognised as having full Hebrew education`
    `recognised as having full pedagogical education`
    `passed` HAS `exam passed` IS AN `exam`
    `has a positive supervision report`
    `has a matriculation certificate`
    `taught` HAS
        `years taught` IS A NUMBER
        `taught where` IS A STRING
    `meets` HAS `condition met` IS A STRING
    `has the ground` HAS `ground held` IS AN `exemption ground`

GIVEN `fields required` IS A LIST OF STRING
      `field held` IS A STRING
      `the subject` IS A STRING
GIVETH A BOOLEAN
DECIDE `the field matches` `fields required` `field held` `the subject` IF
       elem `field held` `fields required`
    OR elem "any subject" `fields required`
    OR (elem "the subject applied for" `fields required` AND `field held` EQUALS `the subject`)

§§ `1.21.2.1 כללי`

-- ¶1: this circular is the updated summary of the rules on licences for
-- post-primary schools and cancels every earlier instruction on the subject.
@ref akn:chp_1א___sec_1_21__ssec_1_21_2_1__para_1
DECLARE `licensing instruction` IS ONE OF
    `this circular`
    `an earlier instruction`

GIVEN i IS A `licensing instruction`
GIVETH A BOOLEAN
DECIDE `the instruction is in force` i IF
    i EQUALS `this circular`

-- ¶3: a post-primary school is a four-year institution above the eighth
-- school year, or a six-year one above the sixth, under the supervision of
-- the Ministry of Education or of Labour and Welfare; and a junior high
-- school that is not part of a six-year school.
@ref akn:chp_1א___sec_1_21__ssec_1_21_2_1__para_3
DECLARE `supervising ministry` IS ONE OF
    `the Ministry of Education, Culture and Sport`
    `the Ministry of Labour and Welfare`
    `no such ministry`

DECLARE `institution` HAS
    `years of study`          IS A NUMBER  @desc 4 or 6, or 3 for a junior high school
    `above school year`       IS A NUMBER  @desc the school year the institution starts after (8 for a four-year school, 6 for a six-year one)
    `is a junior high school` IS A BOOLEAN
    `part of a six-year school` IS A BOOLEAN
    `supervised by`           IS A `supervising ministry`

GIVEN i IS AN `institution`
GIVETH A BOOLEAN
DECIDE `a post-primary school` i IF
        (    NOT i's `supervised by` EQUALS `no such ministry`
         AND (   (i's `years of study` EQUALS 4 AND i's `above school year` AT LEAST 8)
              OR (i's `years of study` EQUALS 6 AND i's `above school year` AT LEAST 6)))
    OR (i's `is a junior high school` AND NOT i's `part of a six-year school`)

-- ¶2: every teaching employee of a post-primary school needs a licence from
-- the Ministry; the principal answers for no one teaching but by the licence.
-- ¶6: an employment approval from the Director-General or a deputy is needed
-- besides (Supervision of Schools Law 1969; section 1.21.4 below), and the
-- principal answers for that too.
@ref akn:chp_1א___sec_1_21__ssec_1_21_2_1__para_2 akn:chp_1א___sec_1_21__ssec_1_21_2_1__para_6
GIVEN `licensed for the subject and grades` IS A BOOLEAN, `has the employment approval` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `may teach in a post-primary school` `licensed for the subject and grades` `has the employment approval` IF
    `licensed for the subject and grades` AND `has the employment approval`

DECLARE `licensing action` IS ONE OF
    `let a teacher teach` HAS
        `teacher is licensed` IS A BOOLEAN
        `teacher is approved` IS A BOOLEAN
    `employ a teacher with a temporary licence`
    `see the temporary licensees complete their duties`

GIVETH A DEONTIC Party `licensing action`
DECIDE `no teaching without a licence and approval` IS
    PARTY `the school principal`
    SHANT `let a teacher teach` l a
          PROVIDED NOT `may teach in a post-primary school` l a
    LEST  BREACH BY `the school principal` BECAUSE "section 1.21.2.1(2),(6): no one teaches without a licence and an employment approval"

-- ¶4: the principal makes efforts to employ teachers with a permanent
-- licence; where the posts cannot all be filled so, he may employ teachers
-- with a temporary licence, and must see that they complete their duties for
-- a permanent licence within 2–3 years. Time in years; the outer bound, 3.
@ref akn:chp_1א___sec_1_21__ssec_1_21_2_1__para_4
GIVEN `posts cannot all be filled with permanent licensees` IS A BOOLEAN
GIVETH A DEONTIC Party `licensing action`
DECIDE `employing temporary licensees` `posts cannot all be filled with permanent licensees` IS
    IF `posts cannot all be filled with permanent licensees`
    THEN PARTY `the school principal`
         MAY   `employ a teacher with a temporary licence`
         HENCE (PARTY `the school principal`
                MUST  `see the temporary licensees complete their duties`
                WITHIN 3
                LEST  BREACH BY `the school principal` BECAUSE "section 1.21.2.1(4): temporary licensees complete their duties within 2-3 years")
    ELSE PARTY `the school principal`
         SHANT `employ a teacher with a temporary licence`

-- ¶5: the four general conditions of a permanent licence.
-- (א) full professional education in the subject — the routes of 1.21.2.2
-- to 1.21.2.5 below, which is where each route's degree is set.
-- (ב) full pedagogical education: an Israeli teaching certificate for the
-- subject at post-primary (or junior high) level, a recognised foreign
-- certification, or the pedagogical completion exams.
-- (ג) full Hebrew education: an Israeli matriculation or teaching
-- certificate or academic degree, or the Hebrew completion exams (the
-- new-immigrant teachers' course counts as those exams).
-- (ד) a positive report on the practical work from the last year or the one
-- before; waived for a licence based on an Israeli teaching certificate.
-- (The exam lists are those of 1.21.2.7, chapter ד'.)
-- The conditions are checked route by route: each route of 1.21.2.2 to
-- 1.21.2.5 lists its own professional education (א) and whichever of
-- (ב)–(ד) it asks, and a licence is granted by a route all of whose
-- requirements are met.
@ref akn:chp_1א___sec_1_21__ssec_1_21_2_1__para_5 akn:chp_1א___sec_1_21__ssec_1_21_2_1__para_5__subpara_a
GIVEN hs IS A LIST OF `holding`
      `the subject` IS A STRING
      r IS A `requirement`
GIVETH A BOOLEAN
DECIDE `the requirement is met` hs `the subject` r IF
    CONSIDER r
    WHEN `a degree` n fs cs THEN
        any (GIVEN h YIELD CONSIDER h
                 WHEN `holds a degree` m f c THEN m AT LEAST n AND `the field matches` fs f `the subject` AND elem c cs
                 OTHERWISE FALSE) hs
    WHEN `a teaching certificate` fs cs ls THEN
        any (GIVEN h YIELD CONSIDER h
                 WHEN `holds a teaching certificate` f c l THEN `the field matches` fs f `the subject` AND elem c cs AND elem l ls
                 OTHERWISE FALSE) hs
    WHEN `an equivalent academic grade` n fs THEN
        any (GIVEN h YIELD CONSIDER h
                 WHEN `holds an equivalent academic grade` m f THEN m AT LEAST n AND `the field matches` fs f `the subject`
                 OTHERWISE FALSE) hs
    WHEN `full Hebrew education`         THEN `has full Hebrew education` hs `the subject` FALSE
    WHEN `full pedagogical education`    THEN `has full pedagogical education` hs `the subject`
    WHEN `completion exams` es           THEN all (GIVEN e YIELD `has passed or is exempt from` hs `the subject` e) es
    WHEN `a positive supervision report` THEN `has the required supervision report` hs
    WHEN `a matriculation certificate`   THEN elem `has a matriculation certificate` hs
    WHEN `teaching experience` y w THEN
        any (GIVEN h YIELD CONSIDER h
                 WHEN `taught` t tw THEN t AT LEAST y AND tw EQUALS w
                 OTHERWISE FALSE) hs
    WHEN `a general route` g out THEN
        any (GIVEN q YIELD q's `licence grades` EQUALS g
                       AND NOT elem (q's `route name`) out
                       AND `the route is open` hs `the subject` q)
            `the general routes`
    WHEN `a further condition` t THEN elem (`meets` t) hs

GIVEN hs IS A LIST OF `holding`
      `the subject` IS A STRING
      q IS A `licence route`
GIVETH A BOOLEAN
DECIDE `the route is open` hs `the subject` q IF
    all (GIVEN r YIELD `the requirement is met` hs `the subject` r) (q's `route requirements`)

@export default Whether a teaching employee may be granted a permanent licence to teach a `the subject` in a range of post-primary grades under section 1.21.2 of the takanon, and by which printed routes
GIVEN hs IS A LIST OF `holding` @desc what the applicant holds: degrees, certificates, equivalent grades, exams passed, reports, grounds of exemption
      `the subject` IS A STRING @desc the `the subject` applied for, as the takanon names it (e.g. "history", "English", "the Oral Law")
      grades IS A `grade range` @desc the grades applied for
GIVETH A LIST OF STRING
DECIDE `the routes that grant the licence` hs `the subject` grades IS
    map (GIVEN q YIELD q's `route name`)
        (filter (GIVEN q YIELD q's `licence grades` EQUALS grades AND `the route is open` hs `the subject` q)
                (`the routes for the subject` `the subject`))

@ref akn:chp_1א___sec_1_21__ssec_1_21_2_1__para_5__subpara_b
GIVEN hs IS A LIST OF `holding`
      `the subject` IS A STRING
GIVETH A BOOLEAN
DECIDE `has full pedagogical education` hs `the subject` IF
       any (GIVEN h YIELD CONSIDER h
                WHEN `recognised as having full pedagogical education` THEN TRUE
                WHEN `holds a teaching certificate` f c l THEN
                     f EQUALS `the subject` AND c EQUALS `Israel` AND elem l `post-primary or junior high`
                OTHERWISE FALSE) hs
    OR all (GIVEN e YIELD `has passed or is exempt from` hs `the subject` e) `the pedagogical exams`

@ref akn:chp_1א___sec_1_21__ssec_1_21_2_1__para_5__subpara_c
GIVEN hs IS A LIST OF `holding`
      `the subject` IS A STRING
      `teaches in the Arab or Druze sector` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `has full Hebrew education` hs `the subject` `teaches in the Arab or Druze sector` IF
       any (GIVEN h YIELD CONSIDER h
                WHEN `recognised as having full Hebrew education` THEN TRUE
                WHEN `has a matriculation certificate` THEN TRUE
                WHEN `holds a teaching certificate` f c l THEN c EQUALS `Israel`
                WHEN `holds a degree` n f c THEN c EQUALS `Israel`
                OTHERWISE FALSE) hs
    OR all (GIVEN e YIELD `has passed or is exempt from` hs `the subject` e) (`the Hebrew exams to sit` `teaches in the Arab or Druze sector`)

@ref akn:chp_1א___sec_1_21__ssec_1_21_2_1__para_5__subpara_d
GIVEN hs IS A LIST OF `holding`
GIVETH A BOOLEAN
DECIDE `has the required supervision report` hs IF
    any (GIVEN h YIELD CONSIDER h
             WHEN `has a positive supervision report` THEN TRUE
             WHEN `holds a teaching certificate` f c l THEN c EQUALS `Israel`
             OTHERWISE FALSE) hs

§§ `1.21.2.1 Worked examples of the licence routes`

-- Worked examples: applicants made up for the purpose, not from any file.
`an Israeli MA in history with an Israeli history certificate` MEANS
    LIST `holds a degree` 2 "history" `Israel`,
         `holds a teaching certificate` "history" `Israel` `post-primary`

#ASSERT elem "(יח) grades 7-12"
             (`the routes that grant the licence` `an Israeli MA in history with an Israeli history certificate` "history" `grades 7 to 12`)
#EVAL `the routes that grant the licence` `an Israeli MA in history with an Israeli history certificate` "history" `grades 7 to 12`

`an Israeli single-major BA in English who sat the English exams` MEANS
    LIST `holds a degree` 1 "English (single major)" `Israel`,
         `passed` `adolescent psychology`, `passed` `theory of education`, `passed` `theory of teaching`,
         `passed` `methodology of teaching the subject`, `passed` `English proficiency, mark 80 or more`,
         `passed` `English and American literature`,
         `has the ground` `a TESOL degree or diploma, or a degree in English or applied linguistics or English language`,
         `has a positive supervision report`

-- Pedagogical linguistics is not sat: the TESOL ground exempts from it.
#ASSERT elem "(כח)4 grades 7-12"
             (`the routes that grant the licence` `an Israeli single-major BA in English who sat the English exams` "English" `grades 7 to 12`)

`a foreign MA in history with no Hebrew education` MEANS
    LIST `holds a degree` 2 "history" `another country`,
         `holds a teaching certificate` "history" `another country` `post-primary`,
         `has a positive supervision report`

#ASSERT NOT elem "(יח) grades 7-12"
                 (`the routes that grant the licence` `a foreign MA in history with no Hebrew education` "history" `grades 7 to 12`)

`a senior certified Bible teacher for the junior high` MEANS
    LIST `holds a teaching certificate` "Bible" `Israel` `junior high`,
         `meets` "the certificate is of a senior certified teacher (מורה מוסמך בכיר)"

#ASSERT elem "(טז) junior high"
             (`the routes that grant the licence` `a senior certified Bible teacher for the junior high` "Bible" `the junior high school`)

§§ `1.21.2.2 רשיונות הוראה קבועים — the general routes`

-- akn:chp_1א___sec_1_21__ssec_1_21_2_2/p1 A note of the date the subsection was last updated (10/02/2022).

-- ¶1.1: as a rule licences are given by paragraphs 2, 3 and 4 below — except
-- the special subjects, for which 1.21.2.3 and 1.21.2.4 bind, and the
-- exceptional licences of 1.21.2.5.
@ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_1/p1
GIVEN `the subject` IS A STRING
GIVETH A LIST OF `licence route`
DECIDE `the routes for the subject` `the subject` IS
    IF any (GIVEN q YIELD elem `the subject` (q's `licence subjects`)) `the special-subject routes`
    THEN concat (LIST (filter (GIVEN q YIELD elem `the subject` (q's `licence subjects`)) `the special-subject routes`),
                      `the exceptional routes`)
    ELSE concat (LIST `the general routes`, `the exceptional routes`)

-- The routes the general rules print: paragraph 2 (grades 7–12), 3 (7–10)
-- and 4 (junior high). The requirements of each route are those its own
-- words name; "as in 1.21.2.1" sends to the report rule of 1.21.2.1(5)(ד).
@ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_2
`the general routes` MEANS
    LIST
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_2__subpara_a akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_2__subpara_a/p2
        `licence route` "2(א)" (LIST "any subject") `grades 7 to 12`
            (LIST `a degree` 2 (LIST "the subject applied for") `Israel only`,
                  `a teaching certificate` (LIST "the subject applied for") `Israel only` `post-primary or junior high`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_2__subpara_b akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_2__subpara_b/p2
        `licence route` "2(ב)" (LIST "any subject") `grades 7 to 12`
            (LIST `a degree` 2 (LIST "the subject applied for") `abroad`,
                  `a teaching certificate` (LIST "the subject applied for") `abroad` (LIST `post-primary`),
                  `full Hebrew education`,
                  `a further condition` "the certificates and Hebrew studies are recognised by the Ministry",
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_2__subpara_c
        `licence route` "2(ג)" (LIST "any subject") `grades 7 to 12`
            (LIST `a degree` 2 (LIST "the subject applied for") `Israel only`,
                  `completion exams` `the pedagogical exams`,
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_2__subpara_d
        `licence route` "2(ד)" (LIST "any subject") `grades 7 to 12`
            (LIST `a degree` 2 (LIST "the subject applied for") `abroad`,
                  `completion exams` `the pedagogical exams`,
                  `full Hebrew education`,
                  `a positive supervision report`),
        -- (ה): an equivalent academic salary grade to an M.A. or doctorate,
        -- approved by the Ministry, in the subjects of 1.21.2.3–1.21.2.4; it
        -- stands in for the degree, the other general conditions remaining.
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_2__subpara_e
        `licence route` "2(ה)" (LIST "any subject") `grades 7 to 12`
            (LIST `an equivalent academic grade` 2 (LIST "the subject applied for"),
                  `a further condition` "the subject is one of those listed in 1.21.2.3 and 1.21.2.4",
                  `full pedagogical education`,
                  `full Hebrew education`,
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_3 akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_3__subpara_a
        `licence route` "3(א)" (LIST "any subject") `grades 7 to 10`
            (LIST `a degree` 1 (LIST "the subject applied for") `Israel only`,
                  `a teaching certificate` (LIST "the subject applied for") `Israel only` `post-primary or junior high`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_3__subpara_b akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_3__subpara_b/p2
        `licence route` "3(ב)" (LIST "any subject") `grades 7 to 10`
            (LIST `a degree` 1 (LIST "the subject applied for") `abroad`,
                  `a teaching certificate` (LIST "the subject applied for") `abroad` (LIST `post-primary`),
                  `full Hebrew education`,
                  `a further condition` "the certificates and Hebrew studies are recognised by the Ministry",
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_3__subpara_c
        `licence route` "3(ג)" (LIST "any subject") `grades 7 to 10`
            (LIST `a degree` 1 (LIST "the subject applied for") `Israel only`,
                  `completion exams` `the pedagogical exams`,
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_3__subpara_d
        `licence route` "3(ד)" (LIST "any subject") `grades 7 to 10`
            (LIST `a degree` 1 (LIST "the subject applied for") `abroad`,
                  `completion exams` `the pedagogical exams`,
                  `full Hebrew education`,
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_3__subpara_e
        `licence route` "3(ה)" (LIST "any subject") `grades 7 to 10`
            (LIST `an equivalent academic grade` 1 (LIST "the subject applied for"),
                  `a further condition` "the subject is one of those listed in 1.21.2.3 and 1.21.2.4",
                  `full pedagogical education`,
                  `full Hebrew education`,
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_4 akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_4__subpara_a
        `licence route` "4(א)" (LIST "any subject") `the junior high school`
            (LIST `a teaching certificate` (LIST "the subject applied for") `Israel only` (LIST `junior high`),
                  `a further condition` "the certificate is of a senior certified teacher (מורה מוסמך בכיר)"),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_4__subpara_b
        `licence route` "4(ב)" (LIST "any subject") `the junior high school`
            (LIST `a degree` 1 (LIST "the subject applied for") `Israel or abroad`,
                  `a teaching certificate` (LIST "any subject") `Israel only` (LIST `primary`),
                  `teaching experience` 3 "grades 7 to 9",
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_4__subpara_c
        `licence route` "4(ג)" (LIST "any subject") `the junior high school`
            (LIST `a teaching certificate` (LIST "the subject applied for") `abroad` (LIST `junior high`),
                  `full Hebrew education`,
                  `a further condition` "the certificate and Hebrew studies are recognised by the Ministry",
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_4__subpara_d
        `licence route` "4(ד)" (LIST "any subject") `the junior high school`
            (LIST `a further condition` "finished a junior-high certification course in the subject run with the higher-education institutions",
                  `a further condition` "was a certified teacher before the course")

-- akn:chp_1א___sec_1_21__ssec_1_21_2_2__para_2__subpara_f (ו) only points ahead: some subjects license up to grade 12 without a second degree, as 1.21.2.3 and 1.21.2.4 set out in their own routes.
-- akn:chp_1א___sec_1_21__ssec_1_21_2_2/p2 akn:chp_1א___sec_1_21__ssec_1_21_2_2/p3 The subsection's source list (אסמכתא): a Director-General's special circular.

§§ `1.21.2.3 רשיונות למקצועות מיוחדים (חלק א)`

-- ¶1: throughout this subsection "chapter א'" means 1.21.2.1, so "as in
-- chapter א'" is the report and education rules there; ¶2 is the heading
-- "5. licences for special subjects". The routes, as printed:
@ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p1 akn:chp_1א___sec_1_21__ssec_1_21_2_3/p2
`the special-subject routes, part א` MEANS
    LIST
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p3
        `licence route` "(א)" (LIST "general philosophy") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "general philosophy") `Israel or abroad`,
                  `full Hebrew education`, `full pedagogical education`, `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p4
        `licence route` "(ב)" (LIST "social sciences") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "economics", "sociology", "political science") `Israel or abroad`,
                  `a further condition` "completed the introductions to all three of economics, sociology and political science",
                  `full Hebrew education`,
                  `full pedagogical education`,
                  `a further condition` "the methodology exam, if taken, is that of teaching social sciences, not of one of the three",
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p5
        `licence route` "(ג)" (LIST "political science") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "political science") `Israel or abroad`,
                  `full Hebrew education`, `full pedagogical education`, `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p6
        `licence route` "(ד) Israeli degree" (LIST "civics") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "international relations", "political science", "law", "social work") `Israel only`,
                  `full Hebrew education`, `full pedagogical education`, `a positive supervision report`),
        `licence route` "(ד) foreign degree" (LIST "civics") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "international relations", "political science", "law", "social work") `abroad`,
                  `full Hebrew education`, `full pedagogical education`, `a positive supervision report`,
                  `a further condition` "took the course \"the regime in the State of Israel\", unless released by the central supervisor"),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p7 akn:chp_1א___sec_1_21__ssec_1_21_2_3/p8
        `licence route` "(ה)1" (LIST "sociology") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "sociology") `Israel or abroad`,
                  `full Hebrew education`, `full pedagogical education`, `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p9
        `licence route` "(ה)2" (LIST "sociology") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "social work") `Israel only`,
                  `full pedagogical education`, `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p10
        `licence route` "(ה)3" (LIST "sociology") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "behavioural sciences (Ben-Gurion University)") `Israel only`,
                  `full pedagogical education`, `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p11
        `licence route` "(ו)" (LIST "economics") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "economics") `Israel or abroad`,
                  `full Hebrew education`, `full pedagogical education`, `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p12 akn:chp_1א___sec_1_21__ssec_1_21_2_3/p13
        `licence route` "(ז)1" (LIST "Jewish thought") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "Jewish thought") `Israel only`,
                  `a teaching certificate` (LIST "Jewish thought") `Israel only` `post-primary or junior high`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p14
        `licence route` "(ז)2" (LIST "Jewish thought") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "Jewish thought") `Israel only`,
                  `completion exams` `the pedagogical exams`, `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p15
        `licence route` "(ז)3" (LIST "Jewish thought") `grades 7 to 12`
            (LIST `a teaching certificate` (LIST "Jewish thought") `Israel only` (LIST `post-primary`),
                  `a further condition` "the certificate is from a recognised Torah institute for training teachers of Jewish thought, and is not limited to grade 9"),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p16
        `licence route` "(ז)4" (LIST "Jewish thought") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "Jewish thought") `abroad`,
                  `a further condition` "the course report is recognised by the subject's chief supervisor as sufficient, or the missing courses were completed",
                  `a teaching certificate` (LIST "Jewish thought") `abroad` (LIST `post-primary`),
                  `full Hebrew education`,
                  `a further condition` "the certificate and Hebrew studies are recognised by the Ministry",
                  `a positive supervision report`),
        `licence route` "(ז) junior high" (LIST "Jewish thought") `the junior high school`
            (LIST `a general route` `the junior high school` (LIST "4(ג)")),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p17 akn:chp_1א___sec_1_21__ssec_1_21_2_3/p18
        `licence route` "(ח)1" (LIST "Middle East and Islam studies") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "Middle East and Islam studies") `Israel only`,
                  `a teaching certificate` (LIST "Middle East and Islam studies") `Israel only` `post-primary or junior high`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p19
        `licence route` "(ח)2" (LIST "Middle East and Islam studies") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "Middle East and Islam studies") `Israel only`,
                  `completion exams` `the pedagogical exams`, `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p20
        `licence route` "(ח)3" (LIST "Middle East and Islam studies") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "Middle East and Islam studies") `abroad`,
                  `a teaching certificate` (LIST "Middle East and Islam studies") `abroad` (LIST `post-primary`),
                  `a further condition` "the course report is recognised by the subject's chief supervisor as sufficient, or the missing courses were completed",
                  `full Hebrew education`, `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p21
        `licence route` "(ח)4" (LIST "Middle East and Islam studies") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "Middle East and Islam studies") `abroad`,
                  `a further condition` "the course report is recognised by the subject's chief supervisor as sufficient, or the missing courses were completed",
                  `completion exams` `the pedagogical exams`, `completion exams` `the Hebrew exams`,
                  `a positive supervision report`),
        `licence route` "(ח) junior high" (LIST "Middle East and Islam studies") `the junior high school`
            (LIST `a general route` `the junior high school` (LIST "4(ג)")),
        -- (ט)1 names two degrees and then the exams and the opinion; the
        -- exams are those 1.21.2.7(3)(ג) leaves a psychology graduate, so
        -- they are read as asked of both.
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p22 akn:chp_1א___sec_1_21__ssec_1_21_2_3/p23
        `licence route` "(ט)1 psychology" (LIST "psychology") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "psychology") `Israel only`,
                  `completion exams` (LIST `theory of teaching`, `theory of education`),
                  `a positive supervision report`),
        `licence route` "(ט)1 behavioural sciences" (LIST "psychology") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "behavioural sciences (Ben-Gurion University)") `Israel only`,
                  `completion exams` (LIST `theory of teaching`, `theory of education`),
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p24
        `licence route` "(ט)2" (LIST "psychology") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "psychology") `abroad`,
                  `completion exams` (LIST `theory of teaching`, `theory of education`),
                  `completion exams` `the Hebrew exams`,
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p25
        `licence route` "(ט)3" (LIST "psychology") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "psychology and education") `Israel only`,
                  `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p26
        `licence route` "(ט)4" (LIST "psychology") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "psychology and education") `abroad`,
                  `full Hebrew education`, `a positive supervision report`),
        @ref akn:chp_1א___sec_1_21__ssec_1_21_2_3/p27 akn:chp_1א___sec_1_21__ssec_1_21_2_3/p28
        `licence route` "(י)1 Israel" (LIST "special education") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "special education") `Israel only`,
                  `a teaching certificate` (LIST "special education") `Israel only` `post-primary or junior high`,
                  `full Hebrew education`),
        `licence route` "(י)1 abroad" (LIST "special education") `grades 7 to 12`
            (LIST `a degree` 1 (LIST "special education") `abroad`,
                  `a teaching certificate` (LIST "special education") `abroad` `post-primary or junior high`,
