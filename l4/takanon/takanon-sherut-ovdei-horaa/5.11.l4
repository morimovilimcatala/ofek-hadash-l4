-- תקנון שירות עובדי הוראה, פרק 5, §5.11 מורה למקצועות הטכנולוגיים
-- The clothing quota and the additional clothing allowance of middle-school
-- technological teachers, and of other teachers who instruct in workshops.

IMPORT prelude
IMPORT daydate
IMPORT common

§ `5.11 מורה למקצועות הטכנולוגיים`

@desc A middle-school teacher's situation, as far as section 5.11.6 asks about it.
DECLARE `technology clothing case` HAS
    `a technological-subject teacher in a middle school` IS A BOOLEAN
    `works in a workshop or laboratory`                  IS A BOOLEAN
    `holds the grade of vocational instructor`           IS A BOOLEAN @desc the teacher holds the "מדריך מקצועי" grade
    `instructs in workshops like the vocational instructors` IS A BOOLEAN
    `the day`                                            IS A DATE

§§ `5.11.6 קצובת ביגוד`

@ref akn:chp_5__sec_5_11__ssec_5_11_6__para_1
GIVEN c IS A `technology clothing case`
GIVETH A BOOLEAN
DECIDE `entitled to the clothing quota for workshop and laboratory work` c IF
        (    c's `a technological-subject teacher in a middle school`
         OR `entitled to clothing like the middle-school technological teachers` c)
    AND c's `works in a workshop or laboratory`
    AND c's `the day` AT LEAST Date 1 9 1981

-- F-5.11-a: the allowance is "נוספת" (additional), and 2 does not say to
-- what, nor make it depend on 1's workshop or laboratory work. Encoded as
-- printed: from 1.9.82 every technological teacher has it, quota or not.
@ref akn:chp_5__sec_5_11__ssec_5_11_6__para_2
GIVEN c IS A `technology clothing case`
GIVETH A BOOLEAN
DECIDE `entitled to the additional clothing allowance` c IF
        (    c's `a technological-subject teacher in a middle school`
         OR `entitled to clothing like the middle-school technological teachers` c)
    AND c's `the day` AT LEAST Date 1 9 1982

-- §5.11.6.3: a teacher without the vocational-instructor grade who instructs
-- in the workshops like those who hold it is entitled "like the
-- technological teachers"; this file reads that as giving them both of the
-- grants above, as the technological teachers have them.
@ref akn:chp_5__sec_5_11__ssec_5_11_6__para_3
GIVEN c IS A `technology clothing case`
GIVETH A BOOLEAN
DECIDE `entitled to clothing like the middle-school technological teachers` c IF
        (NOT c's `holds the grade of vocational instructor`)
    AND c's `instructs in workshops like the vocational instructors`

-- The amounts of the quota and of the allowance are set outside this
-- section (by the Treasury's yearly figures); they are inputs of any
-- calculation, never numbers here.

-- akn:chp_5__sec_5_11__ssec_5_11_6/p1 Heading of the source list (אסמכתא).
-- akn:chp_5__sec_5_11__ssec_5_11_6/p2 Source (אסמכתא): a Director-General's circular.
-- akn:chp_5__sec_5_11__ssec_5_11_6/p3 Source (אסמכתא): a Director-General's circular.
-- akn:chp_5__sec_5_11__ssec_5_11_6/p4 Source (אסמכתא): a Director-General's circular.

`an instructor without the grade, 1983` MEANS
    `technology clothing case` WITH
        `a technological-subject teacher in a middle school` IS FALSE
        `works in a workshop or laboratory`                  IS TRUE
        `holds the grade of vocational instructor`           IS FALSE
        `instructs in workshops like the vocational instructors` IS TRUE
        `the day`                                            IS Date 1 1 1983

#ASSERT `entitled to the clothing quota for workshop and laboratory work` `an instructor without the grade, 1983`
#ASSERT `entitled to the additional clothing allowance` `an instructor without the grade, 1983`
`the same instructor, early 1982` MEANS
    `technology clothing case` WITH
        `a technological-subject teacher in a middle school` IS FALSE
        `works in a workshop or laboratory`                  IS TRUE
        `holds the grade of vocational instructor`           IS FALSE
        `instructs in workshops like the vocational instructors` IS TRUE
        `the day`                                            IS Date 1 1 1982

#ASSERT `entitled to the clothing quota for workshop and laboratory work` `the same instructor, early 1982`
#ASSERT NOT `entitled to the additional clothing allowance` `the same instructor, early 1982`

§§ `Property checks`

-- The section's rules over their whole finite space: every combination of
-- the four booleans, on the day before and the day of each date the text
-- names (1.9.81, 1.9.82) and a day long after — 80 cases.

`both booleans` MEANS LIST TRUE, FALSE
`the boundary days of section 5.11` MEANS
    LIST Date 31 8 1981, Date 1 9 1981, Date 31 8 1982, Date 1 9 1982, Date 1 9 2025

GIVEN tech IS A BOOLEAN, ws IS A BOOLEAN, grade IS A BOOLEAN, instr IS A BOOLEAN, d IS A DATE
GIVETH A `technology clothing case`
DECIDE `a checked clothing case` tech ws grade instr d IS
    `technology clothing case` WITH
        `a technological-subject teacher in a middle school` IS tech
        `works in a workshop or laboratory`                  IS ws
        `holds the grade of vocational instructor`           IS grade
        `instructs in workshops like the vocational instructors` IS instr
        `the day`                                            IS d

GIVEN prop IS A FUNCTION FROM `technology clothing case` TO BOOLEAN
GIVETH A BOOLEAN
DECIDE `holds for every clothing case` prop IF
    all (GIVEN tech YIELD
            all (GIVEN ws YIELD
                    all (GIVEN grade YIELD
                            all (GIVEN instr YIELD
                                    all (GIVEN d YIELD
                                            prop (`a checked clothing case` tech ws grade instr d))
                                        `the boundary days of section 5.11`)
                                `both booleans`)
                        `both booleans`)
                `both booleans`)
        `both booleans`

-- 1-3 over every case: nothing is owed before 1.9.81, and the additional
-- allowance nothing before 1.9.82; each grant, once owed, is owed on every
-- later boundary day; 3's instructor without the grade is owed exactly
-- what the technological teacher in the same work is owed.
GIVEN c IS A `technology clothing case`
GIVETH A BOOLEAN
DECIDE `5.11.6, for every case` c IF
        ((c's `the day` AT LEAST Date 1 9 1981)
         OR NOT `entitled to the clothing quota for workshop and laboratory work` c)
    AND ((c's `the day` AT LEAST Date 1 9 1982)
         OR NOT `entitled to the additional clothing allowance` c)
    AND all (GIVEN d YIELD
                    (d LESS THAN c's `the day`)
                 OR (    ((NOT `entitled to the clothing quota for workshop and laboratory work` c)
                          OR `entitled to the clothing quota for workshop and laboratory work` (`a checked clothing case` (c's `a technological-subject teacher in a middle school`) (c's `works in a workshop or laboratory`) (c's `holds the grade of vocational instructor`) (c's `instructs in workshops like the vocational instructors`) d))
                     AND ((NOT `entitled to the additional clothing allowance` c)
                          OR `entitled to the additional clothing allowance` (`a checked clothing case` (c's `a technological-subject teacher in a middle school`) (c's `works in a workshop or laboratory`) (c's `holds the grade of vocational instructor`) (c's `instructs in workshops like the vocational instructors`) d))))
            `the boundary days of section 5.11`
    AND ((NOT `entitled to clothing like the middle-school technological teachers` c)
         OR (    `entitled to the clothing quota for workshop and laboratory work` c
                 EQUALS `entitled to the clothing quota for workshop and laboratory work` (`a checked clothing case` TRUE (c's `works in a workshop or laboratory`) FALSE FALSE (c's `the day`))
             AND `entitled to the additional clothing allowance` c
                 EQUALS `entitled to the additional clothing allowance` (`a checked clothing case` TRUE (c's `works in a workshop or laboratory`) FALSE FALSE (c's `the day`))))
#ASSERT `holds for every clothing case` `5.11.6, for every case`

-- F-5.11-a over every case: the additional allowance is owed without the
-- quota exactly to a technological teacher (or 3's instructor) who works
-- in no workshop or laboratory, from 1.9.82; and the quota is never owed
-- where the additional allowance is not, from that day.
GIVEN c IS A `technology clothing case`
GIVETH A BOOLEAN
DECIDE `owed the additional allowance without the quota` c IF
    `entitled to the additional clothing allowance` c AND (NOT `entitled to the clothing quota for workshop and laboratory work` c)

GIVEN c IS A `technology clothing case`
GIVETH A BOOLEAN
DECIDE `owed the additional allowance outside the workshop` c IF
    `entitled to the additional clothing allowance` c AND (NOT c's `works in a workshop or laboratory`)

GIVEN c IS A `technology clothing case`
GIVETH A BOOLEAN
DECIDE `owed the quota without the additional allowance from 1.9.82` c IF
    c's `the day` AT LEAST Date 1 9 1982
    AND `entitled to the clothing quota for workshop and laboratory work` c
    AND (NOT `entitled to the additional clothing allowance` c)

GIVEN c IS A `technology clothing case`
GIVETH A BOOLEAN
DECIDE `the additional allowance is owed without the quota exactly outside the workshop` c IF
    `owed the additional allowance without the quota` c EQUALS `owed the additional allowance outside the workshop` c
    AND NOT `owed the quota without the additional allowance from 1.9.82` c
#ASSERT `holds for every clothing case` `the additional allowance is owed without the quota exactly outside the workshop`

`a technological teacher outside the workshop, 1982` MEANS
    `a checked clothing case` TRUE FALSE FALSE FALSE (Date 1 9 1982)
`the additional allowance is owed to a technological teacher without the quota it adds to` MEANS
        `entitled to the additional clothing allowance` `a technological teacher outside the workshop, 1982`
    AND NOT `entitled to the clothing quota for workshop and laboratory work` `a technological teacher outside the workshop, 1982`
#ASSERT `the additional allowance is owed to a technological teacher without the quota it adds to`
