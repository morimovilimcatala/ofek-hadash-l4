-- תקנון שירות עובדי הוראה, פרק 2, §2.4 גננת מרכזת
-- The coordinating kindergarten teacher: when one may be appointed and how,
-- who may be appointed, her duties and how they sit with her own class, the
-- staff's joint planning, and the management allowance and keeping it.

IMPORT prelude
IMPORT common

§ `2.4 גננת מרכזת`

DECLARE `2.4 party` IS ONE OF
    `a takanon party` HAS `who` IS A Party
    `the Teachers' Union branch committee`
    `the kindergarten staff`

DECLARE `coordination action` IS ONE OF
    `propose appointing a coordinating teacher`
    `send the reasoned decision in writing for approval`
    `file the decision in the teacher's personal file`
    `request a discussion of the supervisor's decision`
    `bring the appeal to the parity committee`
    `perform a coordination duty` HAS `duty` IS A `coordination duty`, `outside regular hours` IS A BOOLEAN
    `plan jointly` HAS `subject` IS A `planning subject`

§§ `2.4.2 Appointment`

DECLARE `kindergarten site` HAS
    `full-establishment classes of one stream in or near the building` IS A NUMBER
    `classes belong to one owner or the owners agree`                 IS A BOOLEAN
    `classes administratively attached to a school`                   IS A BOOLEAN

-- 1: the preconditions for appointing a coordinating teacher.
@ref akn:chp_2__sec_2_4__ssec_2_4_2__para_1
GIVEN k IS A `kindergarten site`
GIVETH A BOOLEAN
DECIDE `a coordinating teacher may be appointed` k IF
        `2.4.2.1א` k
    AND `2.4.2.1ב` k
    AND `2.4.2.1ג` k

@ref akn:chp_2__sec_2_4__ssec_2_4_2__para_1__subpara_a
GIVEN k IS A `kindergarten site`
GIVETH A BOOLEAN
DECIDE `2.4.2.1א` k IF
    k's `full-establishment classes of one stream in or near the building` AT LEAST 2

@ref akn:chp_2__sec_2_4__ssec_2_4_2__para_1__subpara_b
GIVEN k IS A `kindergarten site`
GIVETH A BOOLEAN
DECIDE `2.4.2.1ב` k IF
    k's `classes belong to one owner or the owners agree`

@ref akn:chp_2__sec_2_4__ssec_2_4_2__para_1__subpara_c
GIVEN k IS A `kindergarten site`
GIVETH A BOOLEAN
DECIDE `2.4.2.1ג` k IF
    NOT k's `classes administratively attached to a school`

-- 2: the kindergarten supervisor proposes the appointment to the district
-- manager, after consulting the local education authority where it has an
-- education department headed by a department manager.
@ref akn:chp_2__sec_2_4__ssec_2_4_2__para_2
GIVEN `the authority has an education department with a manager` IS A BOOLEAN, `consulted the authority` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the supervisor may propose the appointment` `the authority has an education department with a manager` `consulted the authority` IF
    (NOT `the authority has an education department with a manager`) OR `consulted the authority`

-- 3א: a supervisor who finds reasonable cause sends her reasoned decision in
-- writing to the district manager for approval; it is filed in the teacher's
-- personal file. 3ב: the union branch committee may ask the district manager
-- to discuss it; without agreement, the appeal goes to the joint parity
-- committee.
@ref akn:chp_2__sec_2_4__ssec_2_4_2__para_3__subpara_a
GIVEN `found reasonable cause` IS A BOOLEAN
GIVETH A DEONTIC `2.4 party` `coordination action`
DECIDE `the supervisor's reasoned decision` `found reasonable cause` IS
    IF `found reasonable cause`
    THEN (PARTY `a takanon party` `the supervisor`
          MUST  `send the reasoned decision in writing for approval`
          LEST  BREACH BY `a takanon party` `the supervisor` BECAUSE "2.4.2.3א: the supervisor's reasoned decision goes in writing to the district manager")
         RAND
         (PARTY `a takanon party` `the Ministry of Education`
          MUST  `file the decision in the teacher's personal file`
          LEST  BREACH BY `a takanon party` `the Ministry of Education` BECAUSE "2.4.2.3א: the decision is filed in the teacher's personal file")
    ELSE FULFILLED

@ref akn:chp_2__sec_2_4__ssec_2_4_2__para_3__subpara_b akn:chp_2__sec_2_4__ssec_2_4_2__para_3__subpara_b/p2
GIVEN `agreement reached in the discussion` IS A BOOLEAN
GIVETH A DEONTIC `2.4 party` `coordination action`
DECIDE `the union's discussion and appeal` `agreement reached in the discussion` IS
    PARTY `the Teachers' Union branch committee`
    MAY   `request a discussion of the supervisor's decision`
    HENCE (IF `agreement reached in the discussion`
           THEN FULFILLED
           ELSE PARTY `the Teachers' Union branch committee`
                MAY   `bring the appeal to the parity committee`)

DECLARE `candidate for coordinating teacher` HAS
    `certified kindergarten teacher`                  IS A BOOLEAN
    `official (רשמית) kindergarten teacher`           IS A BOOLEAN
    `years teaching in kindergartens`                 IS A NUMBER
    `administrative ability`                          IS A BOOLEAN
    `has shown proper working relations`              IS A BOOLEAN

@ref akn:chp_2__sec_2_4__ssec_2_4_2__para_4
GIVEN c IS A `candidate for coordinating teacher`
GIVETH A BOOLEAN
DECIDE `may be appointed coordinating teacher` c IF
    @ref akn:chp_2__sec_2_4__ssec_2_4_2__para_4__subpara_a
        c's `certified kindergarten teacher`
    @ref akn:chp_2__sec_2_4__ssec_2_4_2__para_4__subpara_b
    AND c's `official (רשמית) kindergarten teacher`
    @ref akn:chp_2__sec_2_4__ssec_2_4_2__para_4__subpara_c
    AND c's `years teaching in kindergartens` AT LEAST 3
    @ref akn:chp_2__sec_2_4__ssec_2_4_2__para_4__subpara_d
    AND c's `administrative ability`
    @ref akn:chp_2__sec_2_4__ssec_2_4_2__para_4__subpara_e
    AND c's `has shown proper working relations`

-- akn:chp_2__sec_2_4__ssec_2_4_2/p1 The heading of the source list (אסמכתא).
-- akn:chp_2__sec_2_4__ssec_2_4_2/p2 A source: director-general's circular לא/7, section 127.

§§ `2.4.3 Duties`

-- 1: the coordinating teacher's duties, א-טז. 2: they are performed
-- outside regular working hours.
@ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1
DECLARE `coordination duty` IS ONE OF
    `administrative and household responsibility for the kindergarten`
    `fostering joint work between the classes`
    `contact with the authority or owner, the medical team, the preventive worker and the social worker`
    `contact with the parents on money and household matters`
    `proper arrangements on all classes' outings and trips`
    `the feeding arrangements and their quality`
    `proper keeping of every class's diary`
    `sending the monthly reports to the district office`
    `handling censuses`
    `arranging substitutes for a missing teacher or assistant, per the supervisor`
    `handling the institution's income and expenses, collections included`
    `reporting income and expenses to the owner`
    `ordering equipment and materials, keeping and recording the inventory`
    `keeping the children's health and observation cards`
    `reporting thefts and damage to the owner and the police`
    `reporting every accident to the district office and the insurer`

`the coordinating teacher's duties` MEANS
    LIST
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_a
        `administrative and household responsibility for the kindergarten`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_b
        `fostering joint work between the classes`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_c
        `contact with the authority or owner, the medical team, the preventive worker and the social worker`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_d
        `contact with the parents on money and household matters`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_e
        `proper arrangements on all classes' outings and trips`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_f
        `the feeding arrangements and their quality`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_g
        `proper keeping of every class's diary`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_h
        `sending the monthly reports to the district office`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_i
        `handling censuses`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_j
        `arranging substitutes for a missing teacher or assistant, per the supervisor`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_ja
        `handling the institution's income and expenses, collections included`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_jb
        `reporting income and expenses to the owner`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_jc
        `ordering equipment and materials, keeping and recording the inventory`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_jd
        `keeping the children's health and observation cards`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_if
        `reporting thefts and damage to the owner and the police`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_1__subpara_ig
        `reporting every accident to the district office and the insurer`

-- 2: each duty is the coordinating teacher's, performed outside her regular
-- hours; 3: within her hours she teaches her own class like any teacher.
@ref akn:chp_2__sec_2_4__ssec_2_4_3__para_2 akn:chp_2__sec_2_4__ssec_2_4_3__para_3
GIVEN d IS A `coordination duty`
GIVETH A DEONTIC `2.4 party` `coordination action`
DECIDE `performing a coordination duty` d IS
    PARTY `a takanon party` `the teaching employee`
    MUST  `perform a coordination duty` x outside PROVIDED x EQUALS d AND outside
    LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "2.4.3: a coordination duty is performed, outside regular working hours"

-- 4: the coordinator's responsibility does not free each class's teacher
-- from her own pedagogical, administrative and household duties.
@ref akn:chp_2__sec_2_4__ssec_2_4_3__para_4
GIVEN `a class teacher's own duty` IS A BOOLEAN, `the coordinator is responsible too` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the class teacher remains bound` `a class teacher's own duty` `the coordinator is responsible too` IF
    `a class teacher's own duty`

-- 5: the staff plan together the work plan, the daily schedule, parents'
-- meetings, parties and celebrations, and trips.
@ref akn:chp_2__sec_2_4__ssec_2_4_3__para_5
DECLARE `planning subject` IS ONE OF
    `the work plan`
    `the daily schedule, within the existing guidelines`
    `parents' meetings on educational problems`
    `parties and celebrations`
    `trips`

`the subjects planned jointly` MEANS
    LIST
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_5__subpara_a
        `the work plan`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_5__subpara_b
        `the daily schedule, within the existing guidelines`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_5__subpara_c
        `parents' meetings on educational problems`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_5__subpara_d
        `parties and celebrations`,
        @ref akn:chp_2__sec_2_4__ssec_2_4_3__para_5__subpara_e
        `trips`

GIVEN s IS A `planning subject`
GIVETH A DEONTIC `2.4 party` `coordination action`
DECIDE `joint planning` s IS
    PARTY `the kindergarten staff`
    MUST  `plan jointly` x PROVIDED x EQUALS s
    LEST  BREACH BY `the kindergarten staff` BECAUSE "2.4.3.5: the kindergarten's teachers plan this together"

-- akn:chp_2__sec_2_4__ssec_2_4_3/p1 The heading of the source list (אסמכתא).
-- akn:chp_2__sec_2_4__ssec_2_4_3/p2 A source: director-general's circular לא/7, section 127.

§§ `2.4.6 Management allowance`

-- 1: by the number of classes, from two, at the rates set for an
-- elementary-school principal (section 7.6.6.1, a named input).
@ref akn:chp_2__sec_2_4__ssec_2_4_6__para_1
@desc The management allowance of an elementary-school principal under section 7.6.6.1 for a given number of classes; an input until that section is imported
ASSUME `the elementary principal's management allowance of section 7.6.6.1` IS A FUNCTION FROM NUMBER TO NUMBER

GIVEN `classes in the kindergarten` IS A NUMBER
GIVETH A NUMBER
DECIDE `coordinating teacher's management allowance` `classes in the kindergarten` IS
    IF `classes in the kindergarten` AT LEAST 2
    THEN `the elementary principal's management allowance of section 7.6.6.1` `classes in the kindergarten`
    ELSE 0

DECLARE `former manager` HAS
    `post`                                  IS A `former post`
    `years in the post with the allowance`  IS A NUMBER
    `served continuously`                   IS A BOOLEAN
    `moved at the employer's initiative, for its needs` IS A BOOLEAN
    `moved to a post without a management allowance` IS A BOOLEAN
    `month moved`                           IS A NUMBER @desc year × 12 + month

DECLARE `former post` IS ONE OF `coordinating teacher`, `other kindergarten manager`

-- 2: a coordinating teacher who served eight years with the allowance keeps
-- (drags) it after being moved from the post.
@ref akn:chp_2__sec_2_4__ssec_2_4_6__para_2
GIVEN f IS A `former manager`
GIVETH A BOOLEAN
DECIDE `drags under 2.4.6.2` f IF
        f's `post` EQUALS `coordinating teacher`
    AND f's `years in the post with the allowance` AT LEAST 8

-- ¶2-¶4, the parity committee of 14.10.2009: a kindergarten manager moved
-- at the employer's initiative, for its needs, to work as a complementing
-- teacher or in any post without a management allowance, keeps it if she
-- served continuously as a manager. No number of years is set.
@ref akn:chp_2__sec_2_4__ssec_2_4_6__para_2/p2 akn:chp_2__sec_2_4__ssec_2_4_6__para_2/p3 akn:chp_2__sec_2_4__ssec_2_4_6__para_2/p4
GIVEN f IS A `former manager`
GIVETH A BOOLEAN
DECIDE `drags under the 2009 decision` f IF
        f's `served continuously`
    AND f's `moved at the employer's initiative, for its needs`
    AND f's `moved to a post without a management allowance`
    AND f's `month moved` AT LEAST 2009 TIMES 12 PLUS 10

-- F-2.4-a: a coordinating teacher with fewer than eight years, moved by the
-- employer to a complementing post, keeps the allowance under the 2009
-- decision and not under 2. The reading adopted: the later decision adds a
-- case — either clause suffices.
GIVEN f IS A `former manager`
GIVETH A BOOLEAN
DECIDE `keeps the management allowance` f IF
    `drags under 2.4.6.2` f OR `drags under the 2009 decision` f

`a coordinating teacher of three years, moved in 2012` MEANS
    `former manager` WITH
        `post`                                  IS `coordinating teacher`
        `years in the post with the allowance`  IS 3
        `served continuously`                   IS TRUE
        `moved at the employer's initiative, for its needs` IS TRUE
        `moved to a post without a management allowance` IS TRUE
        `month moved`                           IS 2012 TIMES 12 PLUS 9

`2 and the 2009 decision disagree on a manager of under eight years` MEANS
        `drags under the 2009 decision` `a coordinating teacher of three years, moved in 2012`
    AND NOT `drags under 2.4.6.2` `a coordinating teacher of three years, moved in 2012`
#ASSERT `2 and the 2009 decision disagree on a manager of under eight years`

-- akn:chp_2__sec_2_4__ssec_2_4_6/p1 The heading of the source list (אסמכתא).
-- akn:chp_2__sec_2_4__ssec_2_4_6/p2 A source: director-general's circular לא/7, section 127.
-- akn:chp_2__sec_2_4__ssec_2_4_6/p3 A source: director-general's circular מד/2, annex ג; collective agreement of 10.3.83.
-- akn:chp_2__sec_2_4__ssec_2_4_6/p4 A source: collective agreement of 19.9.94; special director-general's circular י' (5756); parity committee of 14.10.2009.

-- Worked examples.
`two classes of one stream, one owner` MEANS
    `kindergarten site` WITH
        `full-establishment classes of one stream in or near the building` IS 2
        `classes belong to one owner or the owners agree`                 IS TRUE
        `classes administratively attached to a school`                   IS FALSE
#ASSERT `a coordinating teacher may be appointed` `two classes of one stream, one owner`
#ASSERT `keeps the management allowance` `a coordinating teacher of three years, moved in 2012`
#ASSERT count `the coordinating teacher's duties` EQUALS 16

#TRACE `performing a coordination duty` `handling censuses` AT 0 WITH
    PARTY `a takanon party` `the teaching employee` DOES `perform a coordination duty` `handling censuses` TRUE AT 1
#TRACE `the union's discussion and appeal` FALSE AT 0 WITH
    PARTY `the Teachers' Union branch committee` DOES `request a discussion of the supervisor's decision` AT 1
    PARTY `the Teachers' Union branch committee` DOES `bring the appeal to the parity committee` AT 2
