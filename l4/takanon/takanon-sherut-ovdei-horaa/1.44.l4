-- תקנון שירות עובדי הוראה, פרק 1ב', §1.44 בחירות לרשויות מקומיות
-- Local-authority elections and political activity of teaching employees
-- who are state employees: what every teacher may not do, what senior and
-- empowered teachers may not do, standing as a candidate, and whether an
-- elected teacher keeps working.

IMPORT prelude
IMPORT common

§ `1.44 בחירות לרשויות מקומיות`

-- akn:chp_1ב__sec_1_44__hc_2 The section's title line ("elections to the local authorities").

DECLARE `teacher in politics` HAS
    `a state employee`                              IS A BOOLEAN @desc (א.1)
    `in a supervision or guidance post on a Civil Service Commission establishment` IS A BOOLEAN @desc (א.2)
    `grade`                                         IS A `salary grade`
    `may grant licences or permits or recommend them` IS A BOOLEAN @desc (ב.4ב)
    `may hire for the state service or recommend hiring` IS A BOOLEAN @desc (ב.4ג)
    `holds administrative authority`                IS A BOOLEAN @desc "סמכות מנהלית" as defined in ב.5 ¶2
    `in a post involving contact with the public`   IS A BOOLEAN @desc (ב.5, ב.6); the text does not define it (F-1.44-b)
    `role`                                          IS A `teaching role`
    `licensing or hiring power covers the authority where he lives or works` IS A BOOLEAN @desc (ג.2)

DECLARE `salary grade` IS ONE OF
    `senior certified teacher`
    `senior certified professional instructor`
    `BA grade`
    `MA grade`
    `doctorate grade`
    `other grade`

DECLARE `teaching role` IS ONE OF
    `supervisor`
    `principal of an institution`
    `deputy principal of an institution`
    `principal of a junior high school`
    `other teaching role`

DECLARE `1.44 party` IS ONE OF
    `a takanon party` HAS `who` IS A Party
    `the Government`
    `the head of the personnel-in-teaching division`

DECLARE `political act` IS ONE OF
    `organise a political demonstration or procession`
    `raise donations or collect donated money` HAS `for the state treasury in his role` IS A BOOLEAN
    `criticise the Knesset offensively in public` HAS `forum` IS A `public forum`
    `sit on the active leadership of a party or political body`
    `organise, preside at or speak at a political public meeting`
    `take part in a political demonstration or procession`
    `take part in public propaganda for local elections`
    `lecture at a public meeting of a party or political body`
    `host or speak at a house circle for public Knesset-election propaganda`
    `criticise the Knesset in public` HAS `forum of criticism` IS A `public forum`
    `criticise the Government or its ministries in public` HAS `forum of government criticism` IS A `public forum`
    `take part in local-election propaganda, public or not`
    `host or speak at a house circle for local-election propaganda`
    `serve between the list's filing and election day`
    `stand as a candidate without having resigned`
    `notify the district manager of the candidacy`
    `report the candidacy urgently to the head of the personnel division`
    `permit an act forbidden by ב.2א`

DECLARE `public forum` IS ONE OF
    `press conference`, `interview with a journalist`, `speech in a public place`,
    `broadcast`, `newspaper`, `book`, `elsewhere`

GIVEN f IS A `public forum`
GIVETH A BOOLEAN
DECIDE `a forum ב.3 names` f IF
    NOT f EQUALS `elsewhere`

§§ `א Introduction`

-- akn:chp_1ב__sec_1_44__hc_2__para_a A heading ("introduction").

@ref akn:chp_1ב__sec_1_44__hc_2__para_a__subpara_1
GIVEN t IS A `teacher in politics`
GIVETH A BOOLEAN
DECIDE `these rules apply` t IF
    t's `a state employee`

@ref akn:chp_1ב__sec_1_44__hc_2__para_a__subpara_2
GIVEN t IS A `teacher in politics`
GIVETH A BOOLEAN
DECIDE `the Civil Service Regulations (תקשי"ר) also apply` t IF
    `these rules apply` t AND t's `in a supervision or guidance post on a Civil Service Commission establishment`

§§ `ב Party, political and election activity`

-- akn:chp_1ב__sec_1_44__hc_2__para_b A heading ("party, political and election activity").

@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_1
GIVETH A DEONTIC `1.44 party` `political act`
DECIDE `no political demonstrations organised` IS
    PARTY `a takanon party` `the teaching employee`
    SHANT `organise a political demonstration or procession`
    LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "1.44 ב.1: no teaching employee, of any grade, seniority or role, organises a political demonstration or procession"

-- ב.2א: no fund-raising or collecting of donations except for the state
-- treasury in the course of the role. ב.2ד: every grade, seniority and role.
@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_2__cls_a akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_2__cls_d
GIVEN `the Government permitted it` IS A BOOLEAN
GIVETH A DEONTIC `1.44 party` `political act`
DECIDE `no fund-raising` `the Government permitted it` IS
    IF `the Government permitted it`
    THEN FULFILLED
    ELSE PARTY `a takanon party` `the teaching employee`
         SHANT `raise donations or collect donated money` forTreasury PROVIDED NOT forTreasury
         LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "1.44 ב.2א: no fund-raising or collecting of donations, save for the state treasury in the role"

-- ב.2ב: deductions from salary that section 25 of the Wage Protection Law
-- allows are not fund-raising under ב.2א.
@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_2__cls_b
GIVEN `deduction allowed by section 25 of the Wage Protection Law` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a salary deduction is outside ב.2א` `deduction allowed by section 25 of the Wage Protection Law` IF
    `deduction allowed by section 25 of the Wage Protection Law`

@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_2__cls_c
GIVETH A DEONTIC `1.44 party` `political act`
DECIDE `the Government may permit fund-raising` IS
    PARTY `the Government`
    MAY   `permit an act forbidden by ב.2א`

@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_3
GIVETH A DEONTIC `1.44 party` `political act`
DECIDE `no offensive criticism of the Knesset` IS
    PARTY `a takanon party` `the teaching employee`
    SHANT `criticise the Knesset offensively in public` f PROVIDED `a forum ב.3 names` f
    LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "1.44 ב.3: no teacher criticises the Knesset, its committees or their laws and decisions offensively in a public forum"

-- ב.4א-ג: who the further prohibitions bind.
@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4 akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_a akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_b akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c
GIVEN t IS A `teacher in politics`
GIVETH A BOOLEAN
DECIDE `bound by the ב.4 prohibitions` t IF
        NOT t's `grade` EQUALS `other grade`
    OR  t's `may grant licences or permits or recommend them`
    OR  t's `may hire for the state service or recommend hiring`

-- ב.4 ¶2 ("these are the prohibitions") and (א)-(ח), for a teacher ב.4
-- binds. (ז) is printed in the same row as (ו)(4).
@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c/p2 akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_a
GIVEN a IS A `political act`
GIVETH A BOOLEAN
DECIDE `forbidden by ב.4 (א)` a IF a EQUALS `sit on the active leadership of a party or political body`

@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_b
GIVEN a IS A `political act`
GIVETH A BOOLEAN
DECIDE `forbidden by ב.4 (ב)` a IF a EQUALS `organise, preside at or speak at a political public meeting`

@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_c
GIVEN a IS A `political act`
GIVETH A BOOLEAN
DECIDE `forbidden by ב.4 (ג)` a IF a EQUALS `take part in a political demonstration or procession`

@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_d
GIVEN a IS A `political act`
GIVETH A BOOLEAN
DECIDE `forbidden by ב.4 (ד)` a IF a EQUALS `take part in public propaganda for local elections`

@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_e
GIVEN a IS A `political act`
GIVETH A BOOLEAN
DECIDE `forbidden by ב.4 (ה)` a IF a EQUALS `lecture at a public meeting of a party or political body`

@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_f
GIVEN a IS A `political act`
GIVETH A BOOLEAN
DECIDE `forbidden by ב.4 (ו)` a IF a EQUALS `host or speak at a house circle for public Knesset-election propaganda`

-- (ו)(1)-(4): when a house circle's propaganda counts as public. The text
-- gives them as examples ("לדוגמה"), so other circumstances may count too;
-- `otherwise public` carries them.
@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_f__pnt_1 akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_f__pnt_2 akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_f__pnt_3
DECLARE `house circle` HAS
    `written invitations naming the teacher as host or speaker were sent` IS A BOOLEAN @desc (1), whether or not addressed to named people and whether or not the circle took place
    `held after an invitation to the public`        IS A BOOLEAN @desc (2), even to a particular public, in any form
    `reporters or recorders present to report`      IS A BOOLEAN @desc (3)
    `visible or audible to the uninvited`           IS A BOOLEAN @desc (4), e.g. on a lawn by a house, or with a loudspeaker
    `otherwise public`                              IS A BOOLEAN @desc other circumstances that make the propaganda public

GIVEN h IS A `house circle`
GIVETH A BOOLEAN
DECIDE `the house circle is public` h IF
        h's `written invitations naming the teacher as host or speaker were sent`
    OR  h's `held after an invitation to the public`
    OR  h's `reporters or recorders present to report`
    OR  h's `visible or audible to the uninvited`
    OR  h's `otherwise public`

-- The row of (ו)(4) also prints (ז): no criticism of the Knesset, in the
-- forums named — for these teachers, offensive or not.
@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_f__pnt_4
GIVEN a IS A `political act`
GIVETH A BOOLEAN
DECIDE `forbidden by ב.4 (ז)` a IF
    CONSIDER a
    WHEN `criticise the Knesset in public` f THEN `a forum ב.3 names` f
    OTHERWISE FALSE

@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_4__cls_c__pnt_h
GIVEN a IS A `political act`
GIVETH A BOOLEAN
DECIDE `forbidden by ב.4 (ח)` a IF
    CONSIDER a
    WHEN `criticise the Government or its ministries in public` f THEN `a forum ב.3 names` f
    OTHERWISE FALSE

GIVEN a IS A `political act`
GIVETH A BOOLEAN
DECIDE `forbidden by ב.4` a IF
        `forbidden by ב.4 (א)` a OR `forbidden by ב.4 (ב)` a OR `forbidden by ב.4 (ג)` a
    OR  `forbidden by ב.4 (ד)` a OR `forbidden by ב.4 (ה)` a OR `forbidden by ב.4 (ו)` a
    OR  `forbidden by ב.4 (ז)` a OR `forbidden by ב.4 (ח)` a

GIVEN t IS A `teacher in politics`
GIVETH A DEONTIC `1.44 party` `political act`
DECIDE `the ב.4 prohibitions` t IS
    IF `bound by the ב.4 prohibitions` t
    THEN PARTY `a takanon party` `the teaching employee`
         SHANT a PROVIDED `forbidden by ב.4` a
         LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "1.44 ב.4: a senior-grade or empowered teacher did an act ב.4 forbids"
    ELSE FULFILLED

-- ב.5: a teacher with administrative authority or in a post involving contact
-- with the public takes no part in local-election propaganda, public or not,
-- anywhere in the country. ¶2 defines administrative authority.
@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_5 akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_5/p2
GIVEN t IS A `teacher in politics`
GIVETH A BOOLEAN
DECIDE `bound by ב.5 and ב.6` t IF
    t's `holds administrative authority` OR t's `in a post involving contact with the public`

DECLARE `power` HAS
    `decides matters for members of the public` IS A BOOLEAN
    `by law or not`                            IS A BOOLEAN @desc either; the definition covers both

GIVEN p IS A `power`
GIVETH A BOOLEAN
DECIDE `is administrative authority` p IF
    p's `decides matters for members of the public`

GIVEN t IS A `teacher in politics`
GIVETH A DEONTIC `1.44 party` `political act`
DECIDE `no local-election propaganda` t IS
    IF `bound by ב.5 and ב.6` t
    THEN PARTY `a takanon party` `the teaching employee`
         SHANT `take part in local-election propaganda, public or not`
         LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "1.44 ב.5: a teacher with administrative authority or contact with the public takes no part in local-election propaganda"
    ELSE FULFILLED

-- F-1.44-b: "a post involving contact with the public" is not defined. Every
-- teacher's post involves pupils and parents; read so, ב.5 and ב.6 bind every
-- teacher, read as the public at large, only some.
`a class teacher with no administrative authority` MEANS
    `teacher in politics` WITH
        `a state employee`                              IS TRUE
        `in a supervision or guidance post on a Civil Service Commission establishment` IS FALSE
        `grade`                                         IS `other grade`
        `may grant licences or permits or recommend them` IS FALSE
        `may hire for the state service or recommend hiring` IS FALSE
        `holds administrative authority`                IS FALSE
        `in a post involving contact with the public`   IS FALSE
        `role`                                          IS `other teaching role`
        `licensing or hiring power covers the authority where he lives or works` IS FALSE

`the same class teacher, if teaching is contact with the public` MEANS
    `teacher in politics` WITH
        `a state employee`                              IS TRUE
        `in a supervision or guidance post on a Civil Service Commission establishment` IS FALSE
        `grade`                                         IS `other grade`
        `may grant licences or permits or recommend them` IS FALSE
        `may hire for the state service or recommend hiring` IS FALSE
        `holds administrative authority`                IS FALSE
        `in a post involving contact with the public`   IS TRUE
        `role`                                          IS `other teaching role`
        `licensing or hiring power covers the authority where he lives or works` IS FALSE

`whether ב.5 binds a class teacher turns on an undefined term` MEANS
        NOT `bound by ב.5 and ב.6` `a class teacher with no administrative authority`
    AND `bound by ב.5 and ב.6` `the same class teacher, if teaching is contact with the public`
#ASSERT `whether ב.5 binds a class teacher turns on an undefined term`

@ref akn:chp_1ב__sec_1_44__hc_2__para_b__subpara_6
GIVEN t IS A `teacher in politics`
GIVETH A DEONTIC `1.44 party` `political act`
DECIDE `no local-election house circles` t IS
    IF `bound by ב.5 and ב.6` t
    THEN PARTY `a takanon party` `the teaching employee`
         SHANT `host or speak at a house circle for local-election propaganda`
         LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "1.44 ב.6: a teacher with administrative authority or contact with the public neither hosts nor speaks at a local-election house circle"
    ELSE FULFILLED

§§ `ג Standing as a candidate`

-- akn:chp_1ב__sec_1_44__hc_2__para_c A heading ("standing as a candidate").

-- ג.1: from the day the list is filed to election day inclusive, the
-- candidate stops serving; the absence is unpaid leave. Time in days from
-- the filing of the list.
@ref akn:chp_1ב__sec_1_44__hc_2__para_c__subpara_1
GIVEN `days from filing to election day` IS A NUMBER
GIVETH A DEONTIC `1.44 party` `political act`
DECIDE `no service during candidacy` `days from filing to election day` IS
    PARTY `a takanon party` `the teaching employee`
    SHANT `serve between the list's filing and election day`
    WITHIN `days from filing to election day` PLUS 1
    LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "1.44 ג.1: a candidate stops serving from the filing of the list to election day"

GIVEN `on the list` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the candidacy period is unpaid leave` `on the list` IF `on the list`

@ref akn:chp_1ב__sec_1_44__hc_2__para_c__subpara_2
GIVEN t IS A `teacher in politics`
GIVETH A DEONTIC `1.44 party` `political act`
DECIDE `resign before standing` t IS
    IF t's `licensing or hiring power covers the authority where he lives or works`
    THEN PARTY `a takanon party` `the teaching employee`
         SHANT `stand as a candidate without having resigned`
         LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "1.44 ג.2: an employee whose licensing or hiring power covers the authority must resign before standing"
    ELSE FULFILLED

@ref akn:chp_1ב__sec_1_44__hc_2__para_c__subpara_3
GIVETH A DEONTIC `1.44 party` `political act`
DECIDE `notifying the candidacy` IS
    PARTY `a takanon party` `the teaching employee`
    MUST  `notify the district manager of the candidacy`
    HENCE (PARTY `a takanon party` `the district manager`
           MUST  `report the candidacy urgently to the head of the personnel division`
           LEST  BREACH BY `a takanon party` `the district manager` BECAUSE "1.44 ג.3: the district manager reports the candidacy urgently")
    LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "1.44 ג.3: a candidate notifies the district manager"

§§ `ד An elected teacher's term`

-- akn:chp_1ב__sec_1_44__hc_2__para_d A heading ("an elected teaching employee's term").

DECLARE `elected office` IS ONE OF
    `head of a local authority`
    `paid deputy head of a local authority`
    `unpaid deputy head of a local authority`
    `council member holding the education portfolio`
    `council member`

DECLARE `term status` IS ONE OF
    `unpaid leave`
    `may keep working for pay`
    `the text does not say`

@ref akn:chp_1ב__sec_1_44__hc_2__para_d__subpara_1
GIVEN o IS AN `elected office`
GIVETH A BOOLEAN
DECIDE `ד.1 applies` o IF
    o EQUALS `head of a local authority` OR o EQUALS `paid deputy head of a local authority`

@ref akn:chp_1ב__sec_1_44__hc_2__para_d__subpara_2
GIVEN t IS A `teacher in politics`, o IS AN `elected office`, `the authority is within his remit` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `ד.2 applies` t o `the authority is within his remit` IF
        `a role ד.2 names` t
    AND NOT `ד.1 applies` o
    AND `the authority is within his remit`

GIVEN t IS A `teacher in politics`
GIVETH A BOOLEAN
DECIDE `a role ד.2 names` t IF
    NOT t's `role` EQUALS `other teaching role`

@ref akn:chp_1ב__sec_1_44__hc_2__para_d__subpara_3
GIVEN t IS A `teacher in politics`, o IS AN `elected office`, `the authority is where he works` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `ד.3 applies` t o `the authority is where he works` IF
        NOT `a role ד.2 names` t
    AND o EQUALS `council member holding the education portfolio`
    AND `the authority is where he works`

-- ד.4: "a teacher not mentioned above" elected to a council keeps working.
-- F-1.44-a: "mentioned" may mean NAMED BY ROLE in ד.1-3 or CAUGHT BY a case
-- of ד.1-3. A principal elected to the council of an authority outside his
-- remit is named by role in ד.2 but not caught by it: on the first reading
-- the text decides nothing for him, on the second he keeps working. The
-- second reading is adopted.
@ref akn:chp_1ב__sec_1_44__hc_2__para_d__subpara_4
GIVEN t IS A `teacher in politics`, o IS AN `elected office`, `within his remit` IS A BOOLEAN, `where he works` IS A BOOLEAN
GIVETH A `term status`
DECIDE `status during the term` t o `within his remit` `where he works` IS
    IF `ד.1 applies` o OR `ד.2 applies` t o `within his remit` OR `ד.3 applies` t o `where he works`
    THEN `unpaid leave`
    ELSE `may keep working for pay`

GIVEN t IS A `teacher in politics`, o IS AN `elected office`, `within his remit` IS A BOOLEAN, `where he works` IS A BOOLEAN
GIVETH A `term status`
DECIDE `status if "mentioned" means named by role` t o `within his remit` `where he works` IS
    IF `ד.1 applies` o OR `ד.2 applies` t o `within his remit` OR `ד.3 applies` t o `where he works`
    THEN `unpaid leave`
    ELSE IF `a role ד.2 names` t
         THEN `the text does not say`
         ELSE `may keep working for pay`

`a principal on a council outside his remit` MEANS
    `teacher in politics` WITH
        `a state employee`                              IS TRUE
        `in a supervision or guidance post on a Civil Service Commission establishment` IS FALSE
        `grade`                                         IS `MA grade`
        `may grant licences or permits or recommend them` IS FALSE
        `may hire for the state service or recommend hiring` IS FALSE
        `holds administrative authority`                IS TRUE
        `in a post involving contact with the public`   IS TRUE
        `role`                                          IS `principal of an institution`
        `licensing or hiring power covers the authority where he lives or works` IS FALSE

`the two readings of "not mentioned above" differ for a principal outside his remit` MEANS
        `status during the term` `a principal on a council outside his remit` `council member` FALSE FALSE
            EQUALS `may keep working for pay`
    AND `status if "mentioned" means named by role` `a principal on a council outside his remit` `council member` FALSE FALSE
            EQUALS `the text does not say`
#ASSERT `the two readings of "not mentioned above" differ for a principal outside his remit`

§§ `ה Propaganda`

-- ה: teachers' attention is drawn to circular מט/1 section 4, which binds
-- them all; its content is encoded in section 1.45, so this is a named input.
@ref akn:chp_1ב__sec_1_44__hc_2__para_e akn:chp_1ב__sec_1_44__hc_2__para_e/p2
ASSUME `complies with the propaganda rules of section 1.45` IS A FUNCTION FROM `teacher in politics` TO BOOLEAN

-- akn:chp_1ב__sec_1_44__hc_3 The heading of the source list (אסמכתא).
-- akn:chp_1ב__sec_1_44__hc_3/p1 A source: special director-general's circular of 5754, copy 5.
-- akn:chp_1ב__sec_1_44__hc_3/p2 A source: director-general's circular נד/5, section 235.

-- Worked examples.
#ASSERT `bound by the ב.4 prohibitions` `a principal on a council outside his remit`
#ASSERT `status during the term` `a principal on a council outside his remit` `council member` TRUE FALSE EQUALS `unpaid leave`
#ASSERT `status during the term` `a class teacher with no administrative authority` `head of a local authority` FALSE FALSE EQUALS `unpaid leave`
#ASSERT `status during the term` `a class teacher with no administrative authority` `council member holding the education portfolio` FALSE TRUE EQUALS `unpaid leave`
#ASSERT `status during the term` `a class teacher with no administrative authority` `council member` FALSE TRUE EQUALS `may keep working for pay`

`a circle advertised by written invitation` MEANS
    `house circle` WITH
        `written invitations naming the teacher as host or speaker were sent` IS TRUE
        `held after an invitation to the public`        IS FALSE
        `reporters or recorders present to report`      IS FALSE
        `visible or audible to the uninvited`           IS FALSE
        `otherwise public`                              IS FALSE
#ASSERT `the house circle is public` `a circle advertised by written invitation`

#TRACE `the ב.4 prohibitions` `a principal on a council outside his remit` AT 0 WITH
    PARTY `a takanon party` `the teaching employee` DOES `criticise the Government or its ministries in public` `interview with a journalist` AT 5
#TRACE `notifying the candidacy` AT 0 WITH
    PARTY `a takanon party` `the teaching employee` DOES `notify the district manager of the candidacy` AT 1
    PARTY `a takanon party` `the district manager` DOES `report the candidacy urgently to the head of the personnel division` AT 2
