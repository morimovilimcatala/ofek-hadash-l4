-- תקנון שירות עובדי הוראה, פרק 6, §6.17 מדריכי של"ח
-- Shelach (field-studies) guides: to whom the agreement applies, the work
-- unit and surplus hours, the duties of full- and part-time guides,
-- tenure, grades and seniority, allowances and payments for special
-- activity, pregnancy and motherhood, social rights, substitution,
-- transfer between districts and transfer to teaching.

IMPORT prelude
IMPORT daydate
IMPORT common

§ `6.17 מדריכי של"ח`

@desc Who acts under section 6.17. The Shelach supervision and the guide are not among the takanon's shared parties, so the section's actors are declared here.
DECLARE `6.17 party` IS ONE OF
    `the Shelach guide`
    `the Shelach supervision` @desc the coordinating supervisor of Shelach activity in the Ministry, or whoever he authorised in writing (section 6.17.1.4)
    `the Ministry`
    `the coordinating supervisor`
    `the Ministry's accountant`

@desc A Shelach guide's grade (section 6.17.5).
DECLARE `guide grade` IS ONE OF
    `certified teacher or higher`
    `certified Shelach guide`
    `non-certified Shelach guide, stage AA`
    `non-certified Shelach guide A`
    `non-certified Shelach guide B`

@desc A Shelach guide, as far as section 6.17 asks.
DECLARE `Shelach guide` HAS
    `position fraction`                IS A NUMBER @desc share of a full position (1 = full, 24 weekly hours)
    `frontal teaching hours`           IS A NUMBER @desc weekly hours of frontal (timetabled) teaching
    `weekly hours`                     IS A NUMBER @desc all weekly hours of the position
    `is on probation`                  IS A BOOLEAN
    `is permanent`                     IS A BOOLEAN
    `grade`                            IS A `guide grade`
    `monthly salary`                   IS A NUMBER @desc gross monthly salary by grade and seniority

@desc A guide's schooling and examinations, for the grade (section 6.17.5).
DECLARE `guide schooling` HAS
    `years of schooling`                       IS A NUMBER @desc in Israel
    `has a Hebrew matriculation certificate`   IS A BOOLEAN @desc recognised by the Ministry
    `finished the Gadna guides' seminar`       IS A BOOLEAN
    `passed Gadna and its teaching`            IS A BOOLEAN
    `passed Shelach and its teaching`          IS A BOOLEAN
    `passed psychology`                        IS A BOOLEAN
    `passed Hebrew language`                   IS A BOOLEAN
    `positive supervision assessment for a year or more` IS A BOOLEAN
    `exams of the 1962 booklet still owed`     IS A NUMBER @desc for 10–11 years of schooling: the exams of "בחינות מילואים למורים לא-מוסמכים" (תשכ"ב), less two that are not psychology or Hebrew, not yet passed
    `the one exam owed is Shelach and its teaching` IS A BOOLEAN

DECLARE `6.17 action` IS ONE OF
    `perform` HAS `the duty` IS A `Shelach duty`
    `assign one guide to a class`
    `notify the guide in writing of an extended probation`
    `request a transfer in writing`
    `appeal the equipment assessment`
    `set up a parity committee`
    `deduct the debt from the guide's salary` HAS `within the Wage Protection Law` IS A BOOLEAN
    `pay the overnight reward for the arrears`
    `give the substitute workplace priority`
    `refer to the Civil Service Commission`
    `endeavour to accept the guide as a teacher`

-- akn:chp_6__sec_6_17/p2 akn:chp_6__sec_6_17/p3 akn:chp_6__sec_6_17/p4 akn:chp_6__sec_6_17/p5 akn:chp_6__sec_6_17/p6 akn:chp_6__sec_6_17/p7 akn:chp_6__sec_6_17/p8 akn:chp_6__sec_6_17/p9 akn:chp_6__sec_6_17/p10 akn:chp_6__sec_6_17/p11 akn:chp_6__sec_6_17/p12 akn:chp_6__sec_6_17/p13 akn:chp_6__sec_6_17/p14 The section's table of contents: the titles of its subsections, each encoded below.

§§ `6.17.1 כללי`

@ref akn:chp_6__sec_6_17__ssec_6_17_1__para_1
GIVEN `the day` IS A DATE
GIVETH A BOOLEAN
DECIDE `the Shelach agreement is in force on` `the day` IF
    `the day` AT LEAST Date 1 9 1977

@desc How a guide is employed, for section 6.17.1.2.
DECLARE `guide employment` HAS
    `paid by a grade of the teaching staff's scale` IS A BOOLEAN @desc whether permanent, temporary or casual
    `on a special contract paying by such a grade` IS A BOOLEAN

@ref akn:chp_6__sec_6_17__ssec_6_17_1__para_2
GIVEN e IS A `guide employment`
GIVETH A BOOLEAN
DECIDE `the provisions apply to the guide` e IF
    e's `paid by a grade of the teaching staff's scale` OR e's `on a special contract paying by such a grade`

-- §6.17.1.3 turns on "the agreement" and the day it was signed. Neither is
-- identified in the section (F-6.17-a): the signing day is an input here.
@ref akn:chp_6__sec_6_17__ssec_6_17_1__para_3
GIVEN `employed on the signing day` IS A BOOLEAN
      `employed during the agreement and retired before the signing day` IS A BOOLEAN
      `dismissed before the signing day for a disciplinary or criminal offence` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the provisions reach the guide's period` `employed on the signing day` `employed during the agreement and retired before the signing day` `dismissed before the signing day for a disciplinary or criminal offence` IF
        (`employed on the signing day` OR `employed during the agreement and retired before the signing day`)
    AND NOT `dismissed before the signing day for a disciplinary or criminal offence`

`the section names no signing day` MEANS
    `the day the agreement applying to Shelach guides was signed, as the section states it` EQUALS NOTHING
#ASSERT `the section names no signing day`

GIVETH A MAYBE DATE
DECIDE `the day the agreement applying to Shelach guides was signed, as the section states it` IS NOTHING

@ref akn:chp_6__sec_6_17__ssec_6_17_1__para_4
`who the Shelach supervision is` MEANS `the Shelach supervision`

-- akn:chp_6__sec_6_17__ssec_6_17_1/p1 akn:chp_6__sec_6_17__ssec_6_17_1/p2 The source (אסמכתא) of section 6.17.1.

§§ `6.17.2 יחידת עבודה וחופשות`

@ref akn:chp_6__sec_6_17__ssec_6_17_2__para_1__subpara_a
`the Shelach guide's work unit in weekly hours` MEANS 24

@ref akn:chp_6__sec_6_17__ssec_6_17_2__para_1__subpara_a/p2
GIVEN `school year` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the 24-hour unit is in force in` `school year` IF
    `school year` AT LEAST 5752

@desc A full post-primary Shelach position, as section 6.17.2.1ב composes it.
DECLARE `position composition` HAS
    `hours for field days` IS A NUMBER
    `field days`           IS A NUMBER
    `frontal hours`        IS A NUMBER

@ref akn:chp_6__sec_6_17__ssec_6_17_2__para_1__subpara_b akn:chp_6__sec_6_17__ssec_6_17_2__para_1__subpara_b/p2 akn:chp_6__sec_6_17__ssec_6_17_2__para_1__subpara_b/p3
`the post-primary position` MEANS
    `position composition` WITH
        `hours for field days` IS 18
        `field days`           IS 3
        `frontal hours`        IS 6

#ASSERT `the post-primary position`'s `hours for field days` PLUS `the post-primary position`'s `frontal hours` EQUALS `the Shelach guide's work unit in weekly hours`

@ref akn:chp_6__sec_6_17__ssec_6_17_2__para_1__subpara_c
GIVETH A DEONTIC `6.17 party` `6.17 action`
DECIDE `one guide to a class` IS
    PARTY `the Shelach supervision`
    MAY   `assign one guide to a class`

@ref akn:chp_6__sec_6_17__ssec_6_17_2__para_1__subpara_c/p2
GIVETH A BOOLEAN
DECIDE `one guide to a class changes the Ministry's rules on escorts` IF FALSE

-- §6.17.2.2א: beyond these hours a guide works a trek for each age group
-- in the year and joint enterprises the Shelach branch decides.
@ref akn:chp_6__sec_6_17__ssec_6_17_2__para_2__subpara_a akn:chp_6__sec_6_17__ssec_6_17_2__para_2__subpara_a/p2 akn:chp_6__sec_6_17__ssec_6_17_2__para_2__subpara_a/p3
`work beyond the position's hours` MEANS
    LIST "a trek (טיול) for each age group in the school year",
         "joint enterprises, by the Shelach branch's decisions"

-- §6.17.2.2ב: for a guide at a full position or more, field-day
-- preparation hours count as surplus hours for the Dafna fund, provided a
-- third of the position's hours are frontal teaching; at most 4 a week,
-- on a report of the work done; from 1.9.94.
@ref akn:chp_6__sec_6_17__ssec_6_17_2__para_2__subpara_b
GIVEN g IS A `Shelach guide`
GIVETH A BOOLEAN
DECIDE `preparation hours may count as surplus hours` g IF
        g's `position fraction` AT LEAST 1
    AND g's `frontal teaching hours` AT LEAST g's `weekly hours` DIVIDED BY 3

@ref akn:chp_6__sec_6_17__ssec_6_17_2__para_2__subpara_b/p2 akn:chp_6__sec_6_17__ssec_6_17_2__para_2__subpara_b/p3
GIVEN g IS A `Shelach guide`, `reported preparation hours this week` IS A NUMBER, `the day` IS A DATE
GIVETH A NUMBER
DECIDE `surplus hours counted this week` g `reported preparation hours this week` `the day` IS
    IF `preparation hours may count as surplus hours` g AND `the day` AT LEAST Date 1 9 1994
    THEN min `reported preparation hours this week` 4
    ELSE 0

-- F-6.17-b: the full position §6.17.2.1ב composes has 6 frontal hours of
-- 24 — a quarter — so a guide in it never meets §6.17.2.2ב's third.
`a guide in the composed full position` MEANS
    `Shelach guide` WITH
        `position fraction`      IS 1
        `frontal teaching hours` IS `the post-primary position`'s `frontal hours`
        `weekly hours`           IS `the Shelach guide's work unit in weekly hours`
        `is on probation`        IS FALSE
        `is permanent`           IS TRUE
        `grade`                  IS `certified Shelach guide`
        `monthly salary`         IS 9000

`the composed full position never meets the frontal third` MEANS
    NOT `preparation hours may count as surplus hours` `a guide in the composed full position`
#ASSERT `the composed full position never meets the frontal third`

@ref akn:chp_6__sec_6_17__ssec_6_17_2__para_3/p1
`the Shelach guide's vacations` MEANS "the vacation calendar of the secondary schools the Ministry recognises"

-- akn:chp_6__sec_6_17__ssec_6_17_2/p1 akn:chp_6__sec_6_17__ssec_6_17_2/p2 akn:chp_6__sec_6_17__ssec_6_17_2/p3 akn:chp_6__sec_6_17__ssec_6_17_2/p4 akn:chp_6__sec_6_17__ssec_6_17_2/p5 The sources (אסמכתא) of section 6.17.2.

§§ `6.17.3 הגדרת תפקידים`

@desc The duties of section 6.17.3א (full position) and ב (part-time), one per paragraph; a duty both lists name cites both.
@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a/p1 akn:chp_6__sec_6_17__ssec_6_17_3__para_b/p1
DECLARE `Shelach duty` IS ONE OF
    `going out on field days to the monthly quota`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_2 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_2
    `preparing each field day outside working hours`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_3 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_3
    `organising and conducting the school's sorties and treks`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_4
    `taking part in the IDF march with the school team`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_5 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_4
    `going to the national service enterprise in charge of a class`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_6 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_5
    `working to the contents the supervision and school management set`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_7 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_6
    `taking part in visits to training bases`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_8
    `attending the supervision's briefings and training`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_9 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_8
    `organising and conducting the supervision's enterprises`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_10 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_7
    `attending the school's pedagogical council`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_11 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_9
    `attending in-service training in the school breaks while on probation`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_12 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_10
    `attending in-service training in the breaks, up to two weeks a year, when permanent`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_13 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_11
    `instructing at the supervision's courses and seminars at least once in three years`
    @ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_14 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_12
    `working by this takanon, the Ministry's instructions and the Gadna procedure`

-- §6.17.3א.1 and the first paragraph of ב.1.
@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_1 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_1
GIVEN g IS A `Shelach guide`, `monthly field-day quota for a full position` IS A NUMBER
GIVETH A NUMBER
DECIDE `monthly field-day hours owed` g `monthly field-day quota for a full position` IS
    `monthly field-day quota for a full position` TIMES min (g's `position fraction`) 1

-- Which duties bind which guide: the IDF march and the supervision's
-- briefings are in the full-position list only; the probation and
-- permanent training duties turn on the guide's status.
GIVEN d IS A `Shelach duty`, g IS A `Shelach guide`
GIVETH A BOOLEAN
DECIDE `binds the guide` d g IF
    CONSIDER d
    WHEN `taking part in the IDF march with the school team` THEN g's `position fraction` AT LEAST 1
    WHEN `attending the supervision's briefings and training` THEN g's `position fraction` AT LEAST 1
    WHEN `attending in-service training in the school breaks while on probation` THEN g's `is on probation`
    WHEN `attending in-service training in the breaks, up to two weeks a year, when permanent` THEN g's `is permanent`
    OTHERWISE TRUE

-- The limits the lists set, in days of a school year.
@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_5 akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_9 akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_12 akn:chp_6__sec_6_17__ssec_6_17_3__para_e
GIVEN `national service days` IS A NUMBER, `enterprise days` IS A NUMBER, `enterprise days in vacation` IS A NUMBER, `training days in breaks when permanent` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the year's demands are within the limits` `national service days` `enterprise days` `enterprise days in vacation` `training days in breaks when permanent` IF
        `national service days` AT MOST 14
    AND `enterprise days` AT MOST 10
    AND `enterprise days in vacation` AT MOST 5
    AND `enterprise days in vacation` AT MOST `enterprise days`
    AND `training days in breaks when permanent` AT MOST 14

-- §6.17.3א.13 / ב.11: the guide must answer a demand to instruct at a
-- course only if it was made a month in advance. Time in days.
@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_13 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_11
GIVEN `days' notice given` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the demand to instruct binds the guide` `days' notice given` IF
    `days' notice given` AT LEAST 30

-- Each duty, owed within the school year (an input length in days).
@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a/p1 akn:chp_6__sec_6_17__ssec_6_17_3__para_b/p1
GIVEN d IS A `Shelach duty`, g IS A `Shelach guide`, `days in the school year` IS A NUMBER
GIVETH A DEONTIC `6.17 party` `6.17 action`
DECIDE `the guide's duty` d g `days in the school year` IS
    IF `binds the guide` d g
    THEN PARTY `the Shelach guide`
         MUST  `perform` done PROVIDED done EQUALS d
         WITHIN `days in the school year`
         LEST  BREACH BY `the Shelach guide` BECAUSE "section 6.17.3: a duty of the Shelach guide was not performed"
    ELSE FULFILLED

-- §6.17.3א.15 / ב.13: a guide who wants to move district applies in writing
-- by the end of May of that year. Time in school months: May is month 9.
@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_a__subpara_15 akn:chp_6__sec_6_17__ssec_6_17_3__para_b__subpara_13
GIVETH A DEONTIC `6.17 party` `6.17 action`
DECIDE `requesting a transfer between districts` IS
    PARTY `the Shelach guide`
    MAY   `request a transfer in writing`
    WITHIN `month number` May

-- §6.17.3ג: a split position is coordinated by the supervision with the
-- principals, provided the guide's share of central enterprises is no
-- higher than at one institution at the same fraction.
@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_c
GIVEN `central enterprise days asked of a split-position guide` IS A NUMBER, `days asked at one institution at the same fraction` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the split position's coordination is allowed` `central enterprise days asked of a split-position guide` `days asked at one institution at the same fraction` IF
    `central enterprise days asked of a split-position guide` AT MOST `days asked at one institution at the same fraction`

-- §6.17.3ד: a field day lasts 6 hours; the supervision may approve longer
-- days, the guide then going out on fewer field days a month ("לפחות ימי
-- שדה" is read as "פחות": the proviso fixes the total), provided the month's
-- field-day hours equal the monthly quota.
@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_d
`hours in a field day` MEANS 6

@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_d
GIVEN `approved longer days` IS A BOOLEAN, `hours per field day` IS A NUMBER, `field days in the month` IS A NUMBER, `monthly quota` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the month's field days are in order` `approved longer days` `hours per field day` `field days in the month` `monthly quota` IF
    IF `approved longer days`
    THEN `hours per field day` TIMES `field days in the month` EQUALS `monthly quota`
    ELSE `hours per field day` EQUALS `hours in a field day`

-- akn:chp_6__sec_6_17__ssec_6_17_3__para_f/p1 The circumstance that motivates the next paragraphs (the supervision cannot always provide substitutes); it states no rule of its own.

@desc Where a training day is held when the class's other guide is absent with no substitute.
DECLARE `training day place` IS ONE OF
    `a training centre where other guides are with their classes`
    `near the school`
    `cancelled`

@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_f/p2 akn:chp_6__sec_6_17__ssec_6_17_3__para_f/p3
GIVEN `a substitute from the guides' team` IS A BOOLEAN, `a training centre in the area` IS A BOOLEAN
GIVETH A MAYBE `training day place`
DECIDE `where the present guide holds the training day` `a substitute from the guides' team` `a training centre in the area` IS
    IF `a substitute from the guides' team`
    THEN NOTHING
    ELSE IF `a training centre in the area`
         THEN JUST `a training centre where other guides are with their classes`
         ELSE JUST `near the school`

-- ¶4–5: equipment lost or damaged by the guide's negligence is repaid in
-- kind or in its value as the supervision assesses; the guide may appeal to
-- the coordinating supervisor, who sets up a parity committee whose
-- decision is final; the sum is a debt the Ministry may deduct, subject to
-- the Wage Protection Law, 1958.
@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_f/p4
GIVEN `lost or damaged by the guide's negligence` IS A BOOLEAN, `value assessed by the supervision` IS A NUMBER
GIVETH A NUMBER
DECIDE `the guide owes for the equipment` `lost or damaged by the guide's negligence` `value assessed by the supervision` IS
    IF `lost or damaged by the guide's negligence` THEN `value assessed by the supervision` ELSE 0

@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_f/p4
GIVETH A DEONTIC `6.17 party` `6.17 action`
DECIDE `appealing the equipment assessment` IS
    PARTY `the Shelach guide`
    MAY   `appeal the equipment assessment`
    HENCE (PARTY `the coordinating supervisor`
           MUST  `set up a parity committee`)

@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_f/p5
GIVEN `the committee's sum` IS A NUMBER
GIVETH A NUMBER
DECIDE `the guide's debt to the government` `the committee's sum` IS
    `the committee's sum`

@ref akn:chp_6__sec_6_17__ssec_6_17_3__para_f/p5
GIVETH A DEONTIC `6.17 party` `6.17 action`
DECIDE `deducting the debt` IS
    PARTY `the Ministry`
    MAY   `deduct the debt from the guide's salary` lawful PROVIDED lawful

-- akn:chp_6__sec_6_17__ssec_6_17_3/p1 akn:chp_6__sec_6_17__ssec_6_17_3/p2 akn:chp_6__sec_6_17__ssec_6_17_3/p3 The sources (אסמכתא) of section 6.17.3.

§§ `6.17.4 קביעות`

@ref akn:chp_6__sec_6_17__ssec_6_17_4__para_1/p1 akn:chp_6__sec_6_17__ssec_6_17_4__para_1__subpara_a akn:chp_6__sec_6_17__ssec_6_17_4__para_1__subpara_b
GIVEN g IS A `Shelach guide`, `years of probation` IS A NUMBER, `consecutive years worked` IS A NUMBER, `found fit by the supervision` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `entitled to tenure` g `years of probation` `consecutive years worked` `found fit by the supervision` IF
        `found fit by the supervision`
    AND (   (    (g's `grade` EQUALS `certified Shelach guide` OR g's `grade` EQUALS `certified teacher or higher`)
             AND `years of probation` AT LEAST 2
             AND `years of probation` AT MOST 4)
         OR `consecutive years worked` AT LEAST 5)

-- (א), last sentence: the Ministry tells the guide in writing that the
-- probation is extended, ahead of the third or fourth year. Time in school
-- months from the start of the probation year that is ending.
@ref akn:chp_6__sec_6_17__ssec_6_17_4__para_1__subpara_a
GIVETH A DEONTIC `6.17 party` `6.17 action`
DECIDE `notice of an extended probation` IS
    PARTY `the Ministry`
    MUST  `notify the guide in writing of an extended probation`
    WITHIN 12
    LEST  BREACH BY `the Ministry` BECAUSE "section 6.17.4(א): an extended probation is notified in writing ahead of the year"

-- akn:chp_6__sec_6_17__ssec_6_17_4/p1 akn:chp_6__sec_6_17__ssec_6_17_4/p2 The source (אסמכתא) of section 6.17.4.

§§ `6.17.5 דרגה וותק`

@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_1
`the scale a Shelach guide is paid on` MEANS "the grades of teaching staff in official primary institutions under the Compulsory Education Law, 1949"

@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_2__subpara_a
GIVEN g IS A `guide grade`
GIVETH A BOOLEAN
DECIDE `must take the certified guides' supplementary exams` g IF
    g EQUALS `certified Shelach guide`

@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_2__subpara_b
GIVEN `consecutive years worked` IS A NUMBER, `finished the Shelach seminar` IS A BOOLEAN, `recommended by the supervision` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `may take the Shelach exam without the seminar` `consecutive years worked` `finished the Shelach seminar` `recommended by the supervision` IF
        `consecutive years worked` AT LEAST 2
    AND (NOT `finished the Shelach seminar`)
    AND `recommended by the supervision`

-- §6.17.5(3)–(6), each grade's definition as printed.
@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_3/p1 akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_3__subpara_a
GIVEN s IS A `guide schooling`
GIVETH A BOOLEAN
DECIDE `is a certified Shelach guide` s IF
        (s's `has a Hebrew matriculation certificate` OR s's `years of schooling` AT LEAST 12)
    AND s's `finished the Gadna guides' seminar`
    AND s's `passed Gadna and its teaching`
    AND s's `passed psychology`
    AND s's `passed Hebrew language`
    AND s's `positive supervision assessment for a year or more`

-- (3)ב: a guide of 10–11 years' schooling owes the 1962 booklet's exams.
@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_3__subpara_b
GIVEN s IS A `guide schooling`
GIVETH A BOOLEAN
DECIDE `owes the 1962 booklet's exams` s IF
    s's `years of schooling` AT LEAST 10 AND s's `years of schooling` AT MOST 11

@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_4
GIVEN s IS A `guide schooling`
GIVETH A BOOLEAN
DECIDE `is stage AA` s IF
        `owes the 1962 booklet's exams` s
    AND s's `exams of the 1962 booklet still owed` EQUALS 1
    AND NOT s's `the one exam owed is Shelach and its teaching`

@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_5 akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_5__subpara_a akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_5__subpara_b akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_5__subpara_c akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_5__subpara_d
GIVEN s IS A `guide schooling`
GIVETH A BOOLEAN
DECIDE `is non-certified A` s IF
       s's `has a Hebrew matriculation certificate`
    OR (s's `years of schooling` AT LEAST 12 AND s's `passed Shelach and its teaching`)
    OR (    s's `years of schooling` EQUALS 11
        AND s's `passed Shelach and its teaching`
        AND (s's `passed psychology` OR s's `passed Hebrew language`))
    OR (    s's `years of schooling` EQUALS 10
        AND s's `passed Shelach and its teaching`
        AND s's `passed psychology`
        AND s's `passed Hebrew language`)

-- (6): every guide the definitions above do not include is B. A guide who
-- meets more than one definition — a matriculation holder who is also
-- certified — is read as having the highest grade he meets.
@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_6
GIVEN s IS A `guide schooling`
GIVETH A `guide grade`
DECIDE `grade of the guide` s IS
    BRANCH IF `is a certified Shelach guide` s THEN `certified Shelach guide`
           IF `is stage AA` s                 THEN `non-certified Shelach guide, stage AA`
           IF `is non-certified A` s          THEN `non-certified Shelach guide A`
           OTHERWISE                               `non-certified Shelach guide B`

@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_7
GIVEN `passed the exams his schooling and supplementary exams require` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a certified guide may become a certified teacher` `passed the exams his schooling and supplementary exams require` IF
    `passed the exams his schooling and supplementary exams require`

@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_1__para_8
GIVEN `passed the exams owed` IS A BOOLEAN, `years of actual guiding` IS A NUMBER, `positive supervision assessment` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a non-certified guide is certified as a teacher` `passed the exams owed` `years of actual guiding` `positive supervision assessment` IF
    `passed the exams owed` AND `years of actual guiding` AT LEAST 2 AND `positive supervision assessment`

-- Seniority (וותק) 1: as for teachers, plus years as a Gadna guide for the
-- Ministry of Defence, and years as a Gadna guide in the IDF's standing
-- army from the day the guide was a sergeant or above.
@ref akn:chp_6__sec_6_17__ssec_6_17_5__hc_2__para_1
GIVEN `seniority by the teachers' rules` IS A NUMBER, `years as a Ministry of Defence Gadna guide` IS A NUMBER, `standing-army Gadna years as sergeant or above` IS A NUMBER
GIVETH A NUMBER
DECIDE `recognised seniority` `seniority by the teachers' rules` `years as a Ministry of Defence Gadna guide` `standing-army Gadna years as sergeant or above` IS
    `seniority by the teachers' rules` PLUS `years as a Ministry of Defence Gadna guide` PLUS `standing-army Gadna years as sergeant or above`

-- akn:chp_6__sec_6_17__ssec_6_17_5/p1 akn:chp_6__sec_6_17__ssec_6_17_5/p2 akn:chp_6__sec_6_17__ssec_6_17_5/p3 akn:chp_6__sec_6_17__ssec_6_17_5/p4 akn:chp_6__sec_6_17__ssec_6_17_5/p5 The sources (אסמכתא) of section 6.17.5.

§§ `6.17.7 תוספות וקצובות`

-- akn:chp_6__sec_6_17__ssec_6_17_7/p1 The heading "קצובת ביגוד" of the clothing paragraphs that follow.

@desc One year's clothing for a Shelach guide, in items (or their value in money, as the Ministry's accountant decides).
DECLARE `Shelach clothing` HAS
    `suits`                 IS A NUMBER @desc shirt and trousers in a khaki-like shade
    `windbreakers`          IS A NUMBER @desc supplied once in 3 years
    `pairs of paratrooper boots` IS A NUMBER

@ref akn:chp_6__sec_6_17__ssec_6_17_7/p2 akn:chp_6__sec_6_17__ssec_6_17_7/p3 akn:chp_6__sec_6_17__ssec_6_17_7/p4
GIVEN g IS A `Shelach guide`, `a windbreaker year` IS A BOOLEAN
GIVETH A `Shelach clothing`
DECIDE `clothing for the year` g `a windbreaker year` IS
    `Shelach clothing` WITH
        `suits`                      IS 2 TIMES min (g's `position fraction`) 1
        `windbreakers`               IS (IF `a windbreaker year` THEN 1 ELSE 0) TIMES min (g's `position fraction`) 1
        `pairs of paratrooper boots` IS 1 TIMES min (g's `position fraction`) 1

-- akn:chp_6__sec_6_17__ssec_6_17_7/p5 The heading "אש\"ל" (subsistence) of the next paragraph.

@ref akn:chp_6__sec_6_17__ssec_6_17_7/p6
GIVEN `travel time from the school in hours` IS A NUMBER, `subsistence under the Takshir` IS A NUMBER
GIVETH A NUMBER
DECIDE `subsistence for the trip` `travel time from the school in hours` `subsistence under the Takshir` IS
    IF `travel time from the school in hours` AT LEAST 1 THEN `subsistence under the Takshir` ELSE 0

-- akn:chp_6__sec_6_17__ssec_6_17_7/p7 The heading "תוספת בעבור פעילות מיוחדת" of the paragraphs that follow.
-- akn:chp_6__sec_6_17__ssec_6_17_7/p8 An amendment note: the paragraph was updated on 6.8.03.
-- akn:chp_6__sec_6_17__ssec_6_17_7/p9 The heading of item 1 ("from 1.9.77"); the start date is the agreement's own (section 6.17.1.1), encoded there.

-- 1.1א: an outside worker (a substitute up to 51 days): a senior guide's
-- gross monthly salary in his third year of seniority, over 120, times the
-- hours worked (at most 10), plus 24% for social rights.
@ref akn:chp_6__sec_6_17__ssec_6_17_7/p10 akn:chp_6__sec_6_17__ssec_6_17_7/p11 akn:chp_6__sec_6_17__ssec_6_17_7/p12 akn:chp_6__sec_6_17__ssec_6_17_7/p13
GIVEN `senior guide's monthly salary in the third year` IS A NUMBER, `hours worked` IS A NUMBER
GIVETH A NUMBER
DECIDE `an outside worker's pay for an overnight activity` `senior guide's monthly salary in the third year` `hours worked` IS
    `senior guide's monthly salary in the third year` DIVIDED BY 120 TIMES min `hours worked` 10 TIMES (1 PLUS 24%)

-- 1.1ב: a regular guide: 14 hours less the hours the school roster owes
-- that day, at his monthly salary over 120, plus 24%.
@ref akn:chp_6__sec_6_17__ssec_6_17_7/p14
GIVEN g IS A `Shelach guide`, `hours owed that day by the roster` IS A NUMBER
GIVETH A NUMBER
DECIDE `a regular guide's pay for an overnight activity` g `hours owed that day by the roster` IS
    g's `monthly salary` DIVIDED BY 120 TIMES max (14 MINUS `hours owed that day by the roster`) 0 TIMES (1 PLUS 24%)

-- 1.2–1.6 count hours but give no rate for them (F-6.17-d); the rate is an
-- input here.
@ref akn:chp_6__sec_6_17__ssec_6_17_7/p15 akn:chp_6__sec_6_17__ssec_6_17_7/p16
GIVEN `hours worked` IS A NUMBER, `hours owed that day by the roster` IS A NUMBER, `is a field day` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `hours paid for a day activity` `hours worked` `hours owed that day by the roster` `is a field day` IS
    IF `is a field day`
    THEN 0
    ELSE max (min `hours worked` 10 MINUS `hours owed that day by the roster`) 0

@ref akn:chp_6__sec_6_17__ssec_6_17_7/p17
GIVEN `sortie hours` IS A NUMBER, `position hours in those days` IS A NUMBER
GIVETH A NUMBER
DECIDE `hours paid for a sortie` `sortie hours` `position hours in those days` IS
    IF `sortie hours` AT LEAST 24
    THEN max (20 MINUS `position hours in those days`) 0
    ELSE 0

-- 1.4: the preparation activities it cites as "6.17.3 א(4) and ב(4)" are
-- not there: א(4) is the IDF march and ב(4) the national service. The
-- preparation duty is א(2) / ב(2) (F-6.17-c).
@ref akn:chp_6__sec_6_17__ssec_6_17_7/p18
GIVEN d IS A `Shelach duty`
GIVETH A BOOLEAN
DECIDE `the duty 1.4 cites as preparation` d IF
    d EQUALS `taking part in the IDF march with the school team` OR d EQUALS `going to the national service enterprise in charge of a class`

`1.4 cites no preparation activity` MEANS
        (NOT `the duty 1.4 cites as preparation` `preparing each field day outside working hours`)
    AND `the duty 1.4 cites as preparation` `taking part in the IDF march with the school team`
#ASSERT `1.4 cites no preparation activity`

@ref akn:chp_6__sec_6_17__ssec_6_17_7/p18
GIVEN d IS A `Shelach duty`
GIVETH A NUMBER
DECIDE `hours paid for preparing` d IS
    IF d EQUALS `preparing each field day outside working hours` THEN 1 ELSE 0

@ref akn:chp_6__sec_6_17__ssec_6_17_7/p19
GIVEN `rate for an hour` IS A NUMBER, `Sabbath supplement under the Hours of Work and Rest Law` IS A NUMBER
GIVETH A NUMBER
DECIDE `pay for a national service Sabbath` `rate for an hour` `Sabbath supplement under the Hours of Work and Rest Law` IS
    12 TIMES `rate for an hour` PLUS `Sabbath supplement under the Hours of Work and Rest Law`

@ref akn:chp_6__sec_6_17__ssec_6_17_7/p20
GIVEN `days instructing for the supervision` IS A NUMBER
GIVETH A NUMBER
DECIDE `extra hours paid for instructing` `days instructing for the supervision` IS
    10 TIMES `days instructing for the supervision`

@ref akn:chp_6__sec_6_17__ssec_6_17_7/p15 akn:chp_6__sec_6_17__ssec_6_17_7/p17 akn:chp_6__sec_6_17__ssec_6_17_7/p18 akn:chp_6__sec_6_17__ssec_6_17_7/p20
GIVEN `hours paid` IS A NUMBER, `rate for an hour` IS A NUMBER @desc the rate of an hour of special activity; sections 1.2–1.6 do not state it
GIVETH A NUMBER
DECIDE `pay for counted hours` `hours paid` `rate for an hour` IS
    `hours paid` TIMES `rate for an hour`

`items 1.2 to 1.6 state no rate` MEANS
    `the rate items 1.2 to 1.6 state` EQUALS NOTHING
GIVETH A MAYBE NUMBER
DECIDE `the rate items 1.2 to 1.6 state` IS NOTHING
#ASSERT `items 1.2 to 1.6 state no rate`

-- akn:chp_6__sec_6_17__ssec_6_17_7/p21 The heading of item 2 ("from 1.9.98").

-- 2.1–2.2: from 1.9.98 a Shelach teacher also receives the shekel reward
-- for a night spent out, on the terms of section 6.10 of the 1989
-- agreement; on 1.9.98 it was 56.84 NIS. Not before 1.9.98.
@ref akn:chp_6__sec_6_17__ssec_6_17_7/p22 akn:chp_6__sec_6_17__ssec_6_17_7/p23
GIVEN `the night` IS A DATE, `meets the terms of section 6.10 of the 1989 agreement` IS A BOOLEAN, `the reward's amount then` IS A NUMBER
GIVETH A NUMBER
DECIDE `overnight reward` `the night` `meets the terms of section 6.10 of the 1989 agreement` `the reward's amount then` IS
    IF `the night` AT LEAST Date 1 9 1998 AND `meets the terms of section 6.10 of the 1989 agreement`
    THEN `the reward's amount then`
    ELSE 0

@ref akn:chp_6__sec_6_17__ssec_6_17_7/p22
`the overnight reward as stated for 1.9.98` MEANS 56.84

-- 2.3: the arrears from 1.9.98 are paid on the reports, with January 2003's
-- salary and no later than February 2003's; then monthly. Time in months
-- from December 2002: January 2003 is 1, February 2.
@ref akn:chp_6__sec_6_17__ssec_6_17_7/p24
GIVETH A DEONTIC `6.17 party` `6.17 action`
DECIDE `paying the overnight arrears` IS
    PARTY `the Ministry`
    MUST  `pay the overnight reward for the arrears`
    WITHIN 2
    LEST  BREACH BY `the Ministry` BECAUSE "section 6.17.7, 2.3: the arrears are paid no later than February 2003's salary"

-- akn:chp_6__sec_6_17__ssec_6_17_7/p25 akn:chp_6__sec_6_17__ssec_6_17_7/p26 akn:chp_6__sec_6_17__ssec_6_17_7/p27 akn:chp_6__sec_6_17__ssec_6_17_7/p28 akn:chp_6__sec_6_17__ssec_6_17_7/p29 akn:chp_6__sec_6_17__ssec_6_17_7/p30 The sources (אסמכתא) of section 6.17.7.

§§ `6.17.8 מדריכת של"ח בתקופת ההיריון ומדריכת של"ח-אם`

@desc A woman guide's circumstances, for section 6.17.8.
DECLARE `guide mother` HAS
    `is pregnant`                        IS A BOOLEAN
    `gave birth`                         IS A BOOLEAN
    `child's age in years`               IS A NUMBER @desc the youngest child's age
    `is nursing, with a medical certificate` IS A BOOLEAN

@desc What section 6.17.8 frees a guide from.
DECLARE `release` HAS
    `physical work`            IS A BOOLEAN
    `treks`                    IS A BOOLEAN
    `national service`         IS A BOOLEAN

@ref akn:chp_6__sec_6_17__ssec_6_17_8__para_1 akn:chp_6__sec_6_17__ssec_6_17_8__para_2 akn:chp_6__sec_6_17__ssec_6_17_8__para_3 akn:chp_6__sec_6_17__ssec_6_17_8__para_4
GIVEN m IS A `guide mother`
GIVETH A `release`
DECIDE `released from` m IS
    `release` WITH
        `physical work`    IS m's `is pregnant`
        `treks`            IS    (m's `gave birth` AND m's `child's age in years` LESS THAN 1)
                              OR (m's `is nursing, with a medical certificate` AND m's `child's age in years` AT LEAST 1)
        `national service` IS    (m's `gave birth` AND m's `child's age in years` LESS THAN 2)
                              OR (m's `is nursing, with a medical certificate` AND m's `child's age in years` AT LEAST 1)

-- (1), second sentence: a pregnant guide's teaching in classes grows. By
-- how much is not said (F-6.17-f); it is an input.
@ref akn:chp_6__sec_6_17__ssec_6_17_8__para_1
GIVEN m IS A `guide mother`, `class hours before` IS A NUMBER, `increase set for her` IS A NUMBER
GIVETH A NUMBER
DECIDE `class hours while pregnant` m `class hours before` `increase set for her` IS
    IF m's `is pregnant` THEN `class hours before` PLUS `increase set for her` ELSE `class hours before`

`the text sets no size for the increase` MEANS
    `the increase in a pregnant guide's lessons, as stated` EQUALS NOTHING
GIVETH A MAYBE NUMBER
DECIDE `the increase in a pregnant guide's lessons, as stated` IS NOTHING
#ASSERT `the text sets no size for the increase`

@ref akn:chp_6__sec_6_17__ssec_6_17_8__para_5
GIVEN m IS A `guide mother`
GIVETH A BOOLEAN
DECIDE `pay computed as for teacher mothers of children under 14` m IF
    m's `child's age in years` LESS THAN 14

-- akn:chp_6__sec_6_17__ssec_6_17_8/p1 akn:chp_6__sec_6_17__ssec_6_17_8/p2 The source (אסמכתא) of section 6.17.8.

§§ `6.17.9 זכויות סוציאליות`

@ref akn:chp_6__sec_6_17__ssec_6_17_9__para_1
`the guide's social rights` MEANS "those customary for teaching staff in official primary schools"

-- akn:chp_6__sec_6_17__ssec_6_17_9/p1 akn:chp_6__sec_6_17__ssec_6_17_9/p2 The source (אסמכתא) of section 6.17.9.

§§ `6.17.10 מילוי מקום`

@ref akn:chp_6__sec_6_17__ssec_6_17_10__para_1
GIVEN g IS A `Shelach guide`, `single hours given` IS A NUMBER
GIVETH A NUMBER
DECIDE `pay for substituting another guide` g `single hours given` IS
    g's `monthly salary` DIVIDED BY 120 TIMES `single hours given`

@ref akn:chp_6__sec_6_17__ssec_6_17_10__para_2
GIVEN `single hours given` IS A NUMBER, `substitute teachers' hourly rate` IS A NUMBER
GIVETH A NUMBER
DECIDE `pay of a substitute Shelach guide` `single hours given` `substitute teachers' hourly rate` IS
    `single hours given` TIMES `substitute teachers' hourly rate`

-- akn:chp_6__sec_6_17__ssec_6_17_10/p1 akn:chp_6__sec_6_17__ssec_6_17_10/p2 The source (אסמכתא) of section 6.17.10.

§§ `6.17.11 העברה ממחוז למחוז`

@ref akn:chp_6__sec_6_17__ssec_6_17_11__para_1
GIVEN `transfer approved by the supervision` IS A BOOLEAN
GIVETH A DEONTIC `6.17 party` `6.17 action`
DECIDE `priority in the new district` `transfer approved by the supervision` IS
    IF `transfer approved by the supervision`
    THEN PARTY `the Ministry`
         MUST  `give the substitute workplace priority`
    ELSE FULFILLED

-- akn:chp_6__sec_6_17__ssec_6_17_11/p1 akn:chp_6__sec_6_17__ssec_6_17_11/p2 The source (אסמכתא) of section 6.17.11.

§§ `6.17.12 העברה להוראה`

@ref akn:chp_6__sec_6_17__ssec_6_17_12__para_1
GIVEN `permanent and physically unable to guide` IS A BOOLEAN, `the pedagogical committee found him fit to teach` IS A BOOLEAN
GIVETH A DEONTIC `6.17 party` `6.17 action`
DECIDE `a guide no longer fit to guide` `permanent and physically unable to guide` `the pedagogical committee found him fit to teach` IS
    IF `permanent and physically unable to guide` AND NOT `the pedagogical committee found him fit to teach`
    THEN PARTY `the Ministry`
         MUST  `refer to the Civil Service Commission`
    ELSE FULFILLED

@ref akn:chp_6__sec_6_17__ssec_6_17_12__para_2
GIVEN `the supervision recommends` IS A BOOLEAN
GIVETH A DEONTIC `6.17 party` `6.17 action`
DECIDE `a guide asking to become a teacher` `the supervision recommends` IS
    IF `the supervision recommends`
    THEN PARTY `the Ministry`
         MUST  `endeavour to accept the guide as a teacher`
    ELSE FULFILLED

@ref akn:chp_6__sec_6_17__ssec_6_17_12__para_3
GIVEN `years as a guide` IS A NUMBER, `teaching years` IS A NUMBER
GIVETH A NUMBER
DECIDE `seniority carried into teaching` `years as a guide` `teaching years` IS
    `years as a guide` PLUS `teaching years`

-- akn:chp_6__sec_6_17__ssec_6_17_12/p1 akn:chp_6__sec_6_17__ssec_6_17_12/p2 The source (אסמכתא) of section 6.17.12.
-- akn:chp_6__sec_6_17__ssec_6_17_12/p3 akn:chp_6__sec_6_17__ssec_6_17_12/p4 §6.17.6 (instruction or teaching licence) is a pointer to section 1.21.2.3 of the takanon, encoded there.

-- Examples. Salaries and the calendar are placeholders, not the takanon's.
`a matriculated certified guide` MEANS
    `guide schooling` WITH
        `years of schooling`                     IS 12
        `has a Hebrew matriculation certificate` IS TRUE
        `finished the Gadna guides' seminar`     IS TRUE
        `passed Gadna and its teaching`          IS TRUE
        `passed Shelach and its teaching`        IS TRUE
        `passed psychology`                      IS TRUE
        `passed Hebrew language`                 IS TRUE
        `positive supervision assessment for a year or more` IS TRUE
        `exams of the 1962 booklet still owed`   IS 0
        `the one exam owed is Shelach and its teaching` IS FALSE

`a 10-year guide with Shelach, psychology and Hebrew` MEANS
    `guide schooling` WITH
        `years of schooling`                     IS 10
        `has a Hebrew matriculation certificate` IS FALSE
        `finished the Gadna guides' seminar`     IS FALSE
        `passed Gadna and its teaching`          IS FALSE
        `passed Shelach and its teaching`        IS TRUE
        `passed psychology`                      IS TRUE
        `passed Hebrew language`                 IS TRUE
        `positive supervision assessment for a year or more` IS FALSE
        `exams of the 1962 booklet still owed`   IS 3
        `the one exam owed is Shelach and its teaching` IS FALSE

#ASSERT `grade of the guide` `a matriculated certified guide` EQUALS `certified Shelach guide`
#ASSERT `grade of the guide` `a 10-year guide with Shelach, psychology and Hebrew` EQUALS `non-certified Shelach guide A`
#ASSERT `a regular guide's pay for an overnight activity` `a guide in the composed full position` 8 EQUALS 9000 DIVIDED BY 120 TIMES 6 TIMES 1.24
#ASSERT `an outside worker's pay for an overnight activity` 12000 12 EQUALS 1240
#ASSERT `pay for substituting another guide` `a guide in the composed full position` 4 EQUALS 300
#ASSERT `released from` (`guide mother` WITH `is pregnant` IS FALSE, `gave birth` IS TRUE, `child's age in years` IS 1, `is nursing, with a medical certificate` IS FALSE) EQUALS `release` WITH `physical work` IS FALSE, `treks` IS FALSE, `national service` IS TRUE
#ASSERT `entitled to tenure` `a guide in the composed full position` 2 2 TRUE

#TRACE `the guide's duty` `preparing each field day outside working hours` `a guide in the composed full position` 300 AT 0 WITH
    PARTY `the Shelach guide` DOES `perform` `preparing each field day outside working hours` AT 10
#TRACE `paying the overnight arrears` AT 0 WITH
    PARTY `the Ministry` DOES `pay the overnight reward for the arrears` AT 1
#TRACE `appealing the equipment assessment` AT 0 WITH
    PARTY `the Shelach guide` DOES `appeal the equipment assessment` AT 3
    PARTY `the coordinating supervisor` DOES `set up a parity committee` AT 10
