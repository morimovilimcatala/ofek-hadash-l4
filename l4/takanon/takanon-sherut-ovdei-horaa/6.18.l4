-- תקנון שירות עובדי הוראה, פרק 6, §6.18 מורים מקצועיים
-- Clothing for teachers in the nursing, dental-technician and
-- dental-assistant tracks: what each is given every year, and from when.

IMPORT prelude
IMPORT daydate
IMPORT common

§ `6.18 מורים מקצועיים`

§§ `6.18.6 גמול ביגוד`

@desc The track a vocational teacher teaches in, as far as section 6.18.6 asks about it.
@ref akn:chp_6__sec_6_18__ssec_6_18_6/p1
DECLARE `clothing track` IS ONE OF
    `nursing`
    `dental technicians`
    `dental assistants`
    `another track`

DECLARE `clothing teacher` HAS
    `track`                                         IS A `clothing track`
    `must wear high white shoes in hospitals`       IS A BOOLEAN @desc the teacher is required to wear high white shoes in the hospitals she works in
    `is a woman`                                    IS A BOOLEAN @desc the text gives the shoes to "מורות" (women teachers)

@desc What one school year's clothing grant consists of.
DECLARE `yearly clothing` HAS
    `pairs of high white shoes` IS A NUMBER
    `coats`                     IS A NUMBER

@ref akn:chp_6__sec_6_18__ssec_6_18_6__para_1
GIVEN t IS A `clothing teacher`
GIVETH A NUMBER
DECIDE `pairs of high white shoes a year` t IS
    IF      t's `track` EQUALS `nursing`
        AND t's `is a woman`
        AND t's `must wear high white shoes in hospitals`
    THEN 1
    ELSE 0

@ref akn:chp_6__sec_6_18__ssec_6_18_6__para_2
GIVEN t IS A `clothing teacher`
GIVETH A NUMBER
DECIDE `coats a year` t IS
    IF t's `track` EQUALS `dental technicians` OR t's `track` EQUALS `dental assistants`
    THEN 2
    ELSE 0

@ref akn:chp_6__sec_6_18__ssec_6_18_6/p2
GIVEN `the year begins on` IS A DATE
GIVETH A BOOLEAN
DECIDE `the clothing rules are in force for a year beginning on` `the year begins on` IF
    `the year begins on` AT LEAST Date 1 9 1982

@export The clothing a nursing, dental-technician or dental-assistant track teacher is given for one year under section 6.18.6 of the takanon
GIVEN t IS A `clothing teacher` @desc the teacher
      `the year begins on` IS A DATE @desc the first day of the year asked about
GIVETH A `yearly clothing`
DECIDE `clothing for the year` t `the year begins on` IS
    IF `the clothing rules are in force for a year beginning on` `the year begins on`
    THEN `yearly clothing` WITH
             `pairs of high white shoes` IS `pairs of high white shoes a year` t
             `coats`                     IS `coats a year` t
    ELSE `yearly clothing` WITH
             `pairs of high white shoes` IS 0
             `coats`                     IS 0

-- akn:chp_6__sec_6_18__ssec_6_18_6/p3 akn:chp_6__sec_6_18__ssec_6_18_6/p4 The section's source (אסמכתא): the circular it rests on.

§§ `Worked examples`

-- Examples.
`a nursing teacher who wears hospital shoes` MEANS
    `clothing teacher` WITH
        `track`                                   IS `nursing`
        `must wear high white shoes in hospitals` IS TRUE
        `is a woman`                              IS TRUE

`a dental-assistants teacher` MEANS
    `clothing teacher` WITH
        `track`                                   IS `dental assistants`
        `must wear high white shoes in hospitals` IS FALSE
        `is a woman`                              IS FALSE

#ASSERT `clothing for the year` `a nursing teacher who wears hospital shoes` (Date 1 9 1990) EQUALS `yearly clothing` WITH `pairs of high white shoes` IS 1, `coats` IS 0
#ASSERT `coats a year` `a dental-assistants teacher` EQUALS 2
#ASSERT `clothing for the year` `a dental-assistants teacher` (Date 1 9 1981) EQUALS `yearly clothing` WITH `pairs of high white shoes` IS 0, `coats` IS 0

§§ `Property checks`

-- 6.18.6 over every teacher (each track, bound to high white shoes or
-- not, a woman or not) in years beginning the day before and the day of
-- 1.9.1982: nothing before it; from it, a pair of high white shoes exactly
-- to a woman of the nursing track bound to wear them, two coats exactly to
-- a teacher of the two dental tracks, and no teacher both.
`both booleans` MEANS LIST TRUE, FALSE
`every clothing track` MEANS LIST `nursing`, `dental technicians`, `dental assistants`, `another track`

#ASSERT all (GIVEN tr YIELD
                all (GIVEN w YIELD
                        all (GIVEN f YIELD
                                LET t MEANS `clothing teacher` WITH `track` IS tr, `must wear high white shoes in hospitals` IS w, `is a woman` IS f
                                    c MEANS `clothing for the year` t (Date 1 9 1982)
                                IN      `clothing for the year` t (Date 31 8 1982) EQUALS `yearly clothing` WITH `pairs of high white shoes` IS 0, `coats` IS 0
                                    AND c's `pairs of high white shoes` EQUALS (IF tr EQUALS `nursing` AND w AND f THEN 1 ELSE 0)
                                    AND c's `coats` EQUALS (IF elem tr (LIST `dental technicians`, `dental assistants`) THEN 2 ELSE 0)
                                    AND (c's `pairs of high white shoes` EQUALS 0 OR c's `coats` EQUALS 0))
                            `both booleans`)
                    `both booleans`)
            `every clothing track`
