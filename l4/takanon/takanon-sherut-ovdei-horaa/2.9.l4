-- תקנון שירות עובדי הוראה, פרק 2, §2.9 גננת מילו"א (מרכז להעשרה אמנותית)
-- The kindergarten teacher of a Milo"a arts-enrichment centre: her days and
-- hours, the morning visits and afternoon cultural outings, her education
-- hours, coordination allowance and telephone grant, and her assistant.

IMPORT prelude
IMPORT common

§ `2.9 גננת מילו"א`

-- 2.9.7 places an assistant at the teacher's disposal without saying by
-- whom; the party is named for the act, not for an office.
DECLARE `2.9 party` IS ONE OF
    `a takanon party` HAS `who` IS A Party
    `the Milo"a centre`
    `the Milo"a manager`
    `whoever places kindergarten assistants`

DECLARE `milo'a action` IS ONE OF
    `organise afternoon visits to cultural venues in the field studied, for the children, parents, teacher and assistant`
    `decide on whole class or small groups`
    `invite several classes to the event`
    `place an assistant at the Milo"a teacher's disposal`

§§ `2.9.1 Days and hours of work`

-- akn:chp_2__sec_2_9__ssec_2_9_1__para_a A label (clause א) over א.1-א.7.

-- א.1 (a temporary provision): full-time, five days a week like every
-- kindergarten teacher — four mornings and one afternoon.
@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_a__subpara_1 akn:chp_2__sec_2_9__ssec_2_9_1__para_a__subpara_1/p2
`mornings a full-time Milo"a teacher works` MEANS 4
`afternoons a full-time Milo"a teacher works` MEANS 1

-- א.2: the working hours, morning and afternoon (minutes from midnight).
@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_a__subpara_2
DECLARE `shift` IS ONE OF morning, afternoon

GIVEN s IS A `shift`
GIVETH A NUMBER
DECIDE `shift starts` s IS
    CONSIDER s
    WHEN morning   THEN `the morning starts`
    WHEN afternoon THEN `the afternoon starts`

GIVEN s IS A `shift`
GIVETH A NUMBER
DECIDE `shift ends` s IS
    CONSIDER s
    WHEN morning   THEN `the morning ends`
    WHEN afternoon THEN `the afternoon ends`

@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_a__subpara_2/p2
`the morning starts` MEANS 8 TIMES 60
`the morning ends`   MEANS 13 TIMES 60 PLUS 20

@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_a__subpara_2/p3
`the afternoon starts` MEANS 13 TIMES 60 PLUS 50
`the afternoon ends`   MEANS 18 TIMES 60 PLUS 30

-- א.3: each morning two kindergarten classes visit, two hours each, or
-- three, 75-80 minutes each.
@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_a__subpara_3
GIVEN classes IS A NUMBER, `minutes each` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `a proper morning of visits` classes `minutes each` IF
        (classes EQUALS 2 AND `minutes each` EQUALS 120)
    OR  (classes EQUALS 3 AND `minutes each` AT LEAST 75 AND `minutes each` AT MOST 80)

`a morning's visits fit in the morning shift` MEANS
    2 TIMES 120 AT MOST `shift ends` morning MINUS `shift starts` morning
#ASSERT `a morning's visits fit in the morning shift`

-- א.4: a part-time teacher's working days are agreed in a summary between the
-- supervisor and the teacher. א.5: her hours follow her days.
@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_a__subpara_4
GIVEN `days agreed between the supervisor and the teacher` IS A NUMBER
GIVETH A NUMBER
DECIDE `a part-time teacher's working days` `days agreed between the supervisor and the teacher` IS
    `days agreed between the supervisor and the teacher`

@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_a__subpara_5
GIVEN mornings IS A NUMBER, afternoons IS A NUMBER
GIVETH A NUMBER
DECIDE `a part-time teacher's weekly minutes` mornings afternoons IS
        mornings TIMES (`shift ends` morning MINUS `shift starts` morning)
    PLUS afternoons TIMES (`shift ends` afternoon MINUS `shift starts` afternoon)

-- א.6: in a centre where two teachers work, the hours are shared so that
-- each works both mornings and afternoons, as her position requires; the
-- aim is that each meets the children in the mornings and their parents in
-- the afternoons. The clause speaks of two teachers and of no other number.
@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_a__subpara_6
GIVEN `teachers in the centre` IS A NUMBER, mornings IS A NUMBER, afternoons IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the hours are shared as א.6 requires` `teachers in the centre` mornings afternoons IF
    (NOT (`teachers in the centre` EQUALS 2)) OR (mornings AT LEAST 1 AND afternoons AT LEAST 1)

@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_a__subpara_7
GIVEN clause IS A NUMBER
GIVETH A BOOLEAN
DECIDE `in force from 1.9.1982` clause IF
    elem clause (LIST 1, 2, 4, 5, 6)

-- ב: the Milo"a manager decides the activity times on pedagogical and/or
-- administrative grounds, uniform for the year and all kindergartens or
-- mixed.
@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_b
DECLARE `timing decision` IS ONE OF `uniform for the year and every kindergarten`, `mixed`

GIVEN `pedagogical or administrative grounds` IS A BOOLEAN, d IS A `timing decision`
GIVETH A BOOLEAN
DECIDE `a valid timing decision` `pedagogical or administrative grounds` d IF
    `pedagogical or administrative grounds`

-- ב ¶2: 30 kindergartens visit Milo"a in the mornings, in 8 programmes of
-- two hours, or an equivalent number if the activities are shorter. The
-- examples follow, one row each.
@ref akn:chp_2__sec_2_9__ssec_2_9_1__para_b/p2
`kindergartens visiting in two-hour programmes` MEANS 30
`two-hour programmes per kindergarten` MEANS 8

DECLARE `visit pattern` IS ONE OF `two hours`, `75-80 minutes`, `mixed`

DECLARE `visit example` HAS
    `pattern`                   IS A `visit pattern`
    `example's classes a day`   IS A MAYBE NUMBER @desc none is printed for the mixed schedule
    `example's kindergartens`   IS A NUMBER

GIVEN v IS A `visit pattern`
GIVETH A LIST OF NUMBER
DECIDE `kindergartens the examples give for` v IS
    map (GIVEN e YIELD e's `example's kindergartens`)
        (filter (GIVEN e YIELD e's `pattern` EQUALS v) `the examples of ב`)

-- "An equivalent number": the examples scale the kindergartens with the
-- classes a day (3 a day serve half as many again as 2), and the mixed
-- schedule falls between the two.
`the examples are equivalent numbers` MEANS
        `kindergartens the examples give for` `two hours` EQUALS LIST `kindergartens visiting in two-hour programmes`
    AND `kindergartens the examples give for` `75-80 minutes` EQUALS LIST (`kindergartens visiting in two-hour programmes` TIMES 3 DIVIDED BY 2)
    AND all (GIVEN n YIELD n GREATER THAN 30 AND n LESS THAN 45) (`kindergartens the examples give for` `mixed`)
#ASSERT `the examples are equivalent numbers`

`the examples of ב` MEANS
    LIST
        @ref akn:chp_2__sec_2_9__ssec_2_9_1__para_b/p3
        `visit example` `two hours` (JUST 2) 30,
        @ref akn:chp_2__sec_2_9__ssec_2_9_1__para_b/p4
        `visit example` `75-80 minutes` (JUST 3) 45,
        @ref akn:chp_2__sec_2_9__ssec_2_9_1__para_b/p5
        `visit example` `mixed` NOTHING 37

-- Afternoons: Milo"a organises visits to cultural venues in the field
-- studied, for the children, parents, teacher and assistant.
@ref akn:chp_2__sec_2_9__ssec_2_9_1/p1
GIVETH A DEONTIC `2.9 party` `milo'a action`
DECIDE `afternoon cultural visits` IS
    PARTY `the Milo"a centre`
    MUST  `organise afternoon visits to cultural venues in the field studied, for the children, parents, teacher and assistant`
    LEST  BREACH BY `the Milo"a centre` BECAUSE "2.9.1: Milo\"a organises afternoon cultural visits"

@ref akn:chp_2__sec_2_9__ssec_2_9_1/p2
GIVETH A DEONTIC `2.9 party` `milo'a action`
DECIDE `library or museum visits` IS
    PARTY `the Milo"a manager`
    MAY   `decide on whole class or small groups`

@ref akn:chp_2__sec_2_9__ssec_2_9_1/p3
GIVETH A DEONTIC `2.9 party` `milo'a action`
DECIDE `shows and concerts` IS
    PARTY `the Milo"a manager`
    MUST  `invite several classes to the event`
    LEST  BREACH BY `the Milo"a manager` BECAUSE "2.9.1: several classes are invited to a show or concert"

-- ¶4: each child takes part in at least two cultural activities in the same
-- field, besides the morning visit, held in a theatre or concert hall.
@ref akn:chp_2__sec_2_9__ssec_2_9_1/p4
GIVEN `activities in the field, in a theatre or concert hall` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the child had enough cultural activities` `activities in the field, in a theatre or concert hall` IF
    `activities in the field, in a theatre or concert hall` AT LEAST 2

-- akn:chp_2__sec_2_9__ssec_2_9_1/p5 The heading of the source list (אסמכתא).
-- akn:chp_2__sec_2_9__ssec_2_9_1/p6 A source: director-general's circular מג/5, section 145.
-- akn:chp_2__sec_2_9__ssec_2_9_1/p7 A source: director-general's circular נג/9, section 394.

§§ `2.9.6.1 Education hours`

@ref akn:chp_2__sec_2_9__ssec_2_9_6_1__para_1
`education hours of a full-time Milo"a teacher` MEANS 2

GIVEN `weekly hours of the position` IS A NUMBER
GIVETH A NUMBER
DECIDE `education hours` `weekly hours of the position` IS
    BRANCH
    @ref akn:chp_2__sec_2_9__ssec_2_9_6_1__para_2__subpara_a
        IF `weekly hours of the position` AT MOST 9 THEN 0
    @ref akn:chp_2__sec_2_9__ssec_2_9_6_1__para_2__subpara_b
        IF `weekly hours of the position` AT MOST 19 THEN 1
    @ref akn:chp_2__sec_2_9__ssec_2_9_6_1__para_2__subpara_c
        OTHERWISE 2

-- akn:chp_2__sec_2_9__ssec_2_9_6_1/p1 The heading of the source list (אסמכתא).
-- akn:chp_2__sec_2_9__ssec_2_9_6_1/p2 A source: director-general's circular מג/5, section 145.

§§ `2.9.6.2 Coordination allowance`

-- 1א: a teacher responsible for one centre gets the kindergarten-coordination
-- payment of the special circular ה' (5739) — section 2.3.6, a named input.
-- (The clause cites that circular's "section 12, subsection ב"; 2 and 2.3.6
-- cite the same page as section 19ב.) 1ב: in special cases, at the
-- supervision's demand, two centres each working in a different part of the
-- week, and a double allowance. 2: a part-time teacher gets the full
-- allowance.
@ref akn:chp_2__sec_2_9__ssec_2_9_6_2__para_1__subpara_a
@desc The kindergarten-coordination allowance of section 2.3.6 (an independent teacher's); an input until that section is imported
ASSUME `the coordination allowance of section 2.3.6` IS A NUMBER

@ref akn:chp_2__sec_2_9__ssec_2_9_6_2__para_1__subpara_b
GIVEN centres IS A NUMBER, `at the supervision's demand` IS A BOOLEAN, `each centre works in a different part of the week` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `coordination allowances` centres `at the supervision's demand` `each centre works in a different part of the week` IS
    IF centres EQUALS 2 AND `at the supervision's demand` AND `each centre works in a different part of the week` THEN 2 ELSE 1

@ref akn:chp_2__sec_2_9__ssec_2_9_6_2__para_2
GIVEN centres IS A NUMBER, `at the supervision's demand` IS A BOOLEAN, `each centre works in a different part of the week` IS A BOOLEAN, `position fraction` IS A NUMBER
GIVETH A NUMBER
DECIDE `Milo"a coordination allowance` centres `at the supervision's demand` `each centre works in a different part of the week` `position fraction` IS
    `coordination allowances` centres `at the supervision's demand` `each centre works in a different part of the week`
        TIMES `the coordination allowance of section 2.3.6`

-- akn:chp_2__sec_2_9__ssec_2_9_6_2/p1 The heading of the source list (אסמכתא).
-- akn:chp_2__sec_2_9__ssec_2_9_6_2/p2 A source: director-general's circular מג/5, section 145.

§§ `2.9.6.3 Telephone`

-- 1: 125 calls a month for one centre, 150 for two, pro-rated by position and
-- period, never above one position. ¶2: from 1.4.2000, by time: 29.13 shekels
-- instead of 125 calls and 36.45 instead of 150.
@ref akn:chp_2__sec_2_9__ssec_2_9_6_3__para_1
GIVEN centres IS A NUMBER
GIVETH A NUMBER
DECIDE `monthly calls for a full position` centres IS
    IF centres AT LEAST 2 THEN 150 ELSE 125

GIVEN `position fraction` IS A NUMBER, `share of the period worked` IS A NUMBER
GIVETH A NUMBER
DECIDE `the grant's share` `position fraction` `share of the period worked` IS
    min `position fraction` 1 TIMES `share of the period worked`

GIVEN centres IS A NUMBER, `position fraction` IS A NUMBER, `share of the period worked` IS A NUMBER
GIVETH A NUMBER
DECIDE `monthly calls` centres `position fraction` `share of the period worked` IS
    `monthly calls for a full position` centres TIMES `the grant's share` `position fraction` `share of the period worked`

@ref akn:chp_2__sec_2_9__ssec_2_9_6_3__para_1/p2
`the grant is paid by call time from` MEANS DATE_FROM_DMY 1 4 2000

GIVEN centres IS A NUMBER, `position fraction` IS A NUMBER, `share of the period worked` IS A NUMBER
GIVETH A NUMBER
DECIDE `monthly telephone grant from 1.4.2000` centres `position fraction` `share of the period worked` IS
    (IF centres AT LEAST 2 THEN 36.45 ELSE 29.13)
        TIMES `the grant's share` `position fraction` `share of the period worked`

-- akn:chp_2__sec_2_9__ssec_2_9_6_3/p1 The heading of the source list (אסמכתא).
-- akn:chp_2__sec_2_9__ssec_2_9_6_3/p2 A source: director-general's circular מג/5; Accountant General's circular 2000/16.

§§ `2.9.7 Assistant`

@ref akn:chp_2__sec_2_9__ssec_2_9_7/p1
GIVETH A DEONTIC `2.9 party` `milo'a action`
DECIDE `an assistant for the Milo"a teacher` IS
    PARTY `whoever places kindergarten assistants`
    MUST  `place an assistant at the Milo"a teacher's disposal`
    LEST  BREACH BY `whoever places kindergarten assistants` BECAUSE "2.9.7: a kindergarten assistant is placed at the Milo\"a teacher's disposal, as usual in the system"

-- akn:chp_2__sec_2_9__ssec_2_9_7/p2 The heading of the source list (אסמכתא).
-- akn:chp_2__sec_2_9__ssec_2_9_7/p3 A source: letter of the head of the conditions-of-service department of 26.8.79.

-- Worked examples.
#ASSERT `education hours` 15 EQUALS 1
#ASSERT `education hours` 28 EQUALS `education hours of a full-time Milo"a teacher`
#ASSERT `monthly telephone grant from 1.4.2000` 1 1.5 1 EQUALS 29.13
#ASSERT `a proper morning of visits` 3 80
#ASSERT `in force from 1.9.1982` 6
#ASSERT NOT `in force from 1.9.1982` 3
