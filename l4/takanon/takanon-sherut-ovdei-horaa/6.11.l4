-- תקנון שירות עובדי הוראה, פרק 6, §6.11 מחנך כיתה
-- The post-primary class educator: the educator's hours, and the duties of
-- the post (§6.11.3), each a regulative rule with the time it runs in.

IMPORT prelude
IMPORT common

§ `6.11 מחנך כיתה`

@desc When a duty of the post falls due.
DECLARE `duty timing` IS ONE OF
    `throughout the year`
    `every school day`
    `every week`
    `every term`
    `at the start of the year`

@desc The school calendar the deadlines are counted in, in days. Its figures are inputs; the takanon does not set them here.
DECLARE `school calendar` HAS
    `days in the school year`       IS A NUMBER
    `days in a term`                IS A NUMBER @desc a שליש
    `days counted as the start of the year` IS A NUMBER

GIVEN c IS A `school calendar`, t IS A `duty timing`
GIVETH A NUMBER
DECIDE `days to perform` c t IS
    CONSIDER t
    WHEN `throughout the year`      THEN c's `days in the school year`
    WHEN `every school day`         THEN 1
    WHEN `every week`               THEN 7
    WHEN `every term`               THEN c's `days in a term`
    WHEN `at the start of the year` THEN c's `days counted as the start of the year`

DECLARE `educator action` IS ONE OF
    `perform` HAS `the duty` IS A `educator duty`
    `employ as educator of a second class`
    `visit the class's Gadna training` HAS `with the principal's approval` IS A BOOLEAN
    `make a home visit`

§§ `6.11.1 שעות חינוך`

@ref akn:chp_6__sec_6_11__ssec_6_11_1__para_1
GIVEN `is a class educator in a post-primary school` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `educator hours for one class` `is a class educator in a post-primary school` IS
    IF `is a class educator in a post-primary school` THEN 3 ELSE 0

-- §6.11.1.2: an educator of two classes is treated as the educator of each
-- separately, so the hours are counted per class.
@ref akn:chp_6__sec_6_11__ssec_6_11_1__para_2
GIVEN `classes educated` IS A NUMBER
GIVETH A NUMBER
DECIDE `educator hours` `classes educated` IS
    `classes educated` TIMES `educator hours for one class` TRUE

-- akn:chp_6__sec_6_11__ssec_6_11_1/p1 akn:chp_6__sec_6_11__ssec_6_11_1/p2 akn:chp_6__sec_6_11__ssec_6_11_1/p3 akn:chp_6__sec_6_11__ssec_6_11_1/p4 The sources (אסמכתא) of section 6.11.1.

§§ `6.11.3 הגדרת תפקידים`

@desc The class educator's duties, one or more per paragraph of section 6.11.3.
@ref akn:chp_6__sec_6_11__ssec_6_11_3__para_1/p1
DECLARE `educator duty` IS ONE OF
    `caring for each pupil's progress and the class's cohesion, involving the class's teachers as needed`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_2__subpara_a
    `reporting to and consulting the principal regularly on the class`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_2__subpara_b
    `keeping constant contact with the class's teachers and following pupils' achievement and conduct`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_2__subpara_c
    `bringing the class's problems before the pedagogical council`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_3
    `acting to prevent discipline problems with the teachers and parents`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_4__subpara_a
    `keeping the class register properly`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_4__subpara_b
    `checking lateness and absence in the register`
    `summing up lateness and absence`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_4__subpara_c
    `looking into the causes of lateness and absence and the teachers' remarks`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_5__subpara_a
    `organising the class's institutions and committees`
    `fostering the class's social life and initiating social activities`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_5__subpara_b
    `discussing national, social and current matters in the educator's lessons`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_6
    `following the Gadna activities`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_7
    `helping the principal organise activities beyond the class`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_8
    `keeping homework fairly divided and following the planning of tests`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_9__subpara_a
    `preparing the material on each pupil and on the class for the pedagogical council`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_9__subpara_b
    `collecting and analysing grades for the term's sorting meeting`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_9__subpara_c
    `writing the term report cards, having the principal sign them and handing them out`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_10
    `keeping each pupil's card`
    `completing each pupil's card at the end of the year`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_11__subpara_a
    `keeping constant contact with the parents and meeting them on parents' evenings`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_11__subpara_b
    `receiving pupils and parents at a fixed time`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_12
    `attending to the pupils' health with the nurse, counsellor and psychologist`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_13__subpara_a
    `seeing that the pupils are properly turned out`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_13__subpara_b
    `seeing to the classroom's appearance`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_14/p1
    `fostering the pupils' religious growth, with the teachers and parents`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_14__subpara_a
    `preparing the festivals, memorial days and Independence Day from Torah sources`
    @ref akn:chp_6__sec_6_11__ssec_6_11_3__para_14__subpara_b
    `guiding pupils in keeping the commandments outside school, involving the parents`

-- Which duties bind which educator: §6.11.3(14) binds the educator of a
-- religious school only.
@ref akn:chp_6__sec_6_11__ssec_6_11_3__para_14/p1
GIVEN d IS A `educator duty`, `the school is religious` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `binds the educator` d `the school is religious` IF
    CONSIDER d
    WHEN `fostering the pupils' religious growth, with the teachers and parents` THEN `the school is religious`
    WHEN `preparing the festivals, memorial days and Independence Day from Torah sources` THEN `the school is religious`
    WHEN `guiding pupils in keeping the commandments outside school, involving the parents` THEN `the school is religious`
    OTHERWISE TRUE

-- When each duty falls due, as the paragraph says: "יומית" daily, "פעם
-- בשליש" / "בתום כל שליש" every term, "לפחות פעם בשבוע" weekly,
-- "בראשית שנת הלימודים" at the start, and "בסוף שנת הלימודים" by the end of
-- the year; a duty with no time is owed throughout the year.
@ref akn:chp_6__sec_6_11__ssec_6_11_3__para_2__subpara_c akn:chp_6__sec_6_11__ssec_6_11_3__para_4__subpara_b akn:chp_6__sec_6_11__ssec_6_11_3__para_5__subpara_a akn:chp_6__sec_6_11__ssec_6_11_3__para_9__subpara_b akn:chp_6__sec_6_11__ssec_6_11_3__para_9__subpara_c akn:chp_6__sec_6_11__ssec_6_11_3__para_11__subpara_b
GIVEN d IS A `educator duty`
GIVETH A `duty timing`
DECIDE `timing of` d IS
    CONSIDER d
    WHEN `bringing the class's problems before the pedagogical council` THEN `every term`
    WHEN `checking lateness and absence in the register` THEN `every school day`
    WHEN `summing up lateness and absence` THEN `every term`
    WHEN `organising the class's institutions and committees` THEN `at the start of the year`
    WHEN `collecting and analysing grades for the term's sorting meeting` THEN `every term`
    WHEN `writing the term report cards, having the principal sign them and handing them out` THEN `every term`
    WHEN `receiving pupils and parents at a fixed time` THEN `every week`
    OTHERWISE `throughout the year`

@ref akn:chp_6__sec_6_11__ssec_6_11_3__para_1/p1
GIVEN d IS A `educator duty`, c IS A `school calendar`, `the school is religious` IS A BOOLEAN
GIVETH A DEONTIC Party `educator action`
DECIDE `the educator's duty` d c `the school is religious` IS
    IF `binds the educator` d `the school is religious`
    THEN PARTY `the teaching employee`
         MUST  `perform` done PROVIDED done EQUALS d
         WITHIN `days to perform` c (`timing of` d)
         LEST  BREACH BY `the teaching employee` BECAUSE "section 6.11.3: a duty of the class educator was not performed in its time"
    ELSE FULFILLED

-- §6.11.3(1), note: a teacher is employed as educator of one class only.
@ref akn:chp_6__sec_6_11__ssec_6_11_3__para_1/p2
GIVETH A DEONTIC Party `educator action`
DECIDE `one class per educator` IS
    PARTY `the school principal`
    SHANT `employ as educator of a second class`
    LEST  BREACH BY `the school principal` BECAUSE "section 6.11.3(1): a teacher is employed as educator in one class only"

@ref akn:chp_6__sec_6_11__ssec_6_11_3__para_1/p2
GIVEN `classes educated` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the number of classes is allowed by §6.11.3` `classes educated` IF
    `classes educated` AT MOST 1

-- F-6.11-a: §6.11.1.2 prices the educator of two classes (6 hours) while
-- §6.11.3(1) forbids employing anyone as educator of more than one.
`§6.11.1.2 prices what §6.11.3 forbids` MEANS
        `educator hours` 2 EQUALS 6
    AND NOT `the number of classes is allowed by §6.11.3` 2
#ASSERT `§6.11.1.2 prices what §6.11.3 forbids`

-- The reading adopted (F-6.11-a): both stand. The prohibition binds who
-- assigns educators; if a teacher is nonetheless educator of two classes,
-- §6.11.1.2 pays the hours of each.

-- §6.11.3(6): following Gadna is a duty (in the list above); visiting the
-- class's training is "רצוי" (desirable), with the principal's approval.
@ref akn:chp_6__sec_6_11__ssec_6_11_3__para_6
GIVETH A DEONTIC Party `educator action`
DECIDE `visiting Gadna training` IS
    PARTY `the teaching employee`
    MAY   `visit the class's Gadna training` approved PROVIDED approved

-- §6.11.3(11)א: home visits are "רצוי" when needed — a permission, not a duty.
@ref akn:chp_6__sec_6_11__ssec_6_11_3__para_11__subpara_a
GIVETH A DEONTIC Party `educator action`
DECIDE `home visits` IS
    PARTY `the teaching employee`
    MAY   `make a home visit`

@ref akn:chp_6__sec_6_11__ssec_6_11_3__para_2__subpara_a akn:chp_6__sec_6_11__ssec_6_11_3__para_3
GIVEN p IS A Party
GIVETH A BOOLEAN
DECIDE `the class educator answers to` p IF
    p EQUALS `the school principal`

-- Examples. The calendar's figures are placeholders, not the takanon's.
`a placeholder calendar` MEANS
    `school calendar` WITH
        `days in the school year`               IS 300
        `days in a term`                        IS 100
        `days counted as the start of the year` IS 30

#ASSERT `educator hours` 1 EQUALS 3
#ASSERT NOT `binds the educator` `guiding pupils in keeping the commandments outside school, involving the parents` FALSE

-- Reception hours held in the first week: fulfilled. Absences not checked
-- on the day: breached.
#TRACE `the educator's duty` `receiving pupils and parents at a fixed time` `a placeholder calendar` FALSE AT 0 WITH
    PARTY `the teaching employee` DOES `perform` `receiving pupils and parents at a fixed time` AT 3
#TRACE `the educator's duty` `checking lateness and absence in the register` `a placeholder calendar` FALSE AT 0 WITH
    PARTY `the teaching employee` DOES `perform` `checking lateness and absence in the register` AT 2
#TRACE `one class per educator` AT 0 WITH
    PARTY `the school principal` DOES `employ as educator of a second class` AT 1

-- akn:chp_6__sec_6_11__ssec_6_11_3/p1 akn:chp_6__sec_6_11__ssec_6_11_3/p2 The source (אסמכתא) of section 6.11.3.
