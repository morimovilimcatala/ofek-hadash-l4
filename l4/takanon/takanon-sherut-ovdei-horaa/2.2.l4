-- תקנון שירות עובדי הוראה, פרק 2, §2.2 גננת אחראית על גן
-- A kindergarten teacher in charge of a kindergarten is entitled to the
-- education allowance, whose terms are in section 1.12.

IMPORT prelude
IMPORT common

§ `2.2 גננת אחראית על גן`

DECLARE `kindergarten post` IS ONE OF
    `teacher in charge of a kindergarten`
    `other kindergarten post`

§§ `2.2.6 Education allowance`

@ref akn:chp_2__sec_2_2__ssec_2_2_6/p1
GIVEN p IS A `kindergarten post`
GIVETH A BOOLEAN
DECIDE `entitled to the education allowance under 2.2.6` p IF
    p EQUALS `teacher in charge of a kindergarten`

-- The allowance's amount and terms are section 1.12's: a named input until
-- that section is imported.
@ref akn:chp_2__sec_2_2__ssec_2_2_6/p2
@desc The class-education allowance of section 1.12 for the employee's salary, an input until section 1.12 is imported
ASSUME `the education allowance of section 1.12` IS A FUNCTION FROM NUMBER TO NUMBER

#ASSERT `entitled to the education allowance under 2.2.6` `teacher in charge of a kindergarten`
#ASSERT NOT `entitled to the education allowance under 2.2.6` `other kindergarten post`
