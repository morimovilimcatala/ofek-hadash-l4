-- תקנון שירות עובדי הוראה, פרק 3, §3.20 מורה המתמחה בהוראה
-- The teaching internship: who must do it, where and how much the intern
-- works, the approved frameworks of each stage, referral and entry, the
-- intern's duties (the internship workshop), and the intern's rights.

IMPORT prelude
IMPORT daydate
IMPORT common

§ `3.20 מורה המתמחה בהוראה`

@desc The parties of section 3.20: the takanon's common ones and the internship bodies common.l4 does not name.
DECLARE `3.20 party` IS ONE OF
    `a takanon party` HAS `who` IS A Party
    `the internship branch`
    `the teaching-staff movement branch`
    `the internship coordinator of the training institution`
    `the intern`

DECLARE `internship action` IS ONE OF
    `issue the internship referral`
    `apply for renewal of the referral`
    `notify the internship coordinator of entering work` HAS `details given` IS A LIST OF `entry detail`
    `take part in the internship workshop`
    `approve employment outside the frameworks`

DECLARE `entry detail` IS ONE OF
    `the name of the kindergarten, school or institution`
    `its address and telephone`
    `the name of the supervisor or principal`
    `the mentor's name and identity number`
    `the scope of employment`
    `the age layer`
    `the subjects, fields of employment and further roles`

@desc An approved framework of internship, by stage (sections 1.2-1.9 of 3.20).
DECLARE `internship framework` IS ONE OF
    `compulsory kindergarten`, `pre-compulsory kindergarten`, `kindergarten in a school's young division`,
    `licensed private kindergarten under Ministry supervision or guidance`, `afternoon programme in a licensed, supervised kindergarten`,
    `six-year school, grades 1-6`, `eight-year school, grades 1-8`, `grades 1-2 in a school's young division`,
    `four-year post-primary school, grades 9-12`, `six-year post-primary school, grades 7-12`, `middle school, grades 7-9`, `eight-year primary school, grades 7-8`,
    `special-education kindergarten`, `integrating kindergarten in regular education`, `special-education school`,
    `special-education class in regular education`, `integrating class in regular education`, `classes in regular education`,
    `supervised school in a hospital or prison`,
    `schools under Ministry supervision (music)`, `kindergartens supervised or guided by the Ministry (music)`,
    `youth departments of local authorities and municipalities`, `youth departments of community centres`, `youth movements`,
    `youth houses`, `community schools`, `voluntary extra-curricular frameworks in schools and boarding schools`, `summer camps`,
    `youth-advancement units of local authorities`, `HILA centres`, `projects against dropping out, violence or addiction`,
    `schools running של"ח and knowledge of the land`, `schools running social-education coordination`,
    `not an approved framework`

@desc An intern's year, as section 3.20 asks about it.
DECLARE `internship year` HAS
    `position fraction`                    IS A NUMBER
    `months worked in the year`            IS A NUMBER  @desc full months of work in the school year, in one continuous period
    `two periods of at least three months` IS A BOOLEAN @desc the year's work is two periods of at least three months each
    `only single days`                     IS A BOOLEAN @desc the work is an accumulation of single working days
    `in the trained age layer and subjects` IS A BOOLEAN
    `framework`                            IS AN `internship framework`
    `share in specially approved settings` IS A NUMBER  @desc the share of the required third of a position worked in a setting that needs the internship branch's special approval (a treatment centre, a conservatory, an out-of-school dance centre)

DECLARE `licence the internship is a condition of` IS ONE OF
    `a teaching licence, from the senior division of teaching personnel`
    `a youth-guidance licence, from the society and youth administration`

DECLARE `where the candidate applies` IS ONE OF `the district`, `the school principal (upper division)`

DECLARE `workshop evaluation` IS ONE OF `verbal`, `by the training institution's rules`

DECLARE `intern's pay` IS ONE OF
    `by the degree held`
    `senior certified teacher`
    `senior certified instructor`

GIVEN f IS AN `internship framework`
GIVETH A BOOLEAN
DECIDE `an approved framework` f IF
    elem f (concat (LIST `the approved pre-primary frameworks (short and long school day)`,
                         `the approved primary frameworks (short and long school day)`,
                         `the approved post-primary frameworks`,
                         `the approved special-education frameworks`,
                         `the approved music frameworks`,
                         `the approved "youth and community" frameworks`,
                         `the approved "youth advancement" frameworks`,
                         `the approved של"ח and social-education frameworks`))

@ref akn:chp_3__sec_3_20/p2
`the day section 3.20 applies from` MEANS Date 2 12 2001

@ref akn:chp_3__sec_3_20/p3
GIVEN `a regular student at a college of teacher training` IS A BOOLEAN,
      `started studying in תשנ"ז or later` IS A BOOLEAN,
      `a graduate of a retraining track for academics` IS A BOOLEAN,
      `not a practising teacher` IS A BOOLEAN,
      `started the track in תשס"א or later` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the internship is obligatory` `a regular student at a college of teacher training` `started studying in תשנ"ז or later` `a graduate of a retraining track for academics` `not a practising teacher` `started the track in תשס"א or later` IF
       (`a regular student at a college of teacher training` AND `started studying in תשנ"ז or later`)
    OR (`a graduate of a retraining track for academics` AND `not a practising teacher` AND `started the track in תשס"א or later`)

-- akn:chp_3__sec_3_20/p4 A heading ("1. העסקת המתמחה בעבודה בשנת ההתמחות").

§§ `1.1 ההעסקה בעבודה בשנת ההתמחות`

@ref akn:chp_3__sec_3_20__ssec_1_1_1
GIVEN `grade` IS A NUMBER @desc the class level, kindergarten being 0
GIVETH A BOOLEAN
DECIDE `a class level the internship may be done in` `grade` IF
    `grade` AT LEAST 0 AND `grade` AT MOST 12

@ref akn:chp_3__sec_3_20__ssec_1_1_2
GIVETH A `3.20 party`
DECIDE `who pays the intern's salary` IS `a takanon party` `the local authority or owning body`

@ref akn:chp_3__sec_3_20__ssec_1_1_2
GIVETH A BOOLEAN
DECIDE `the intern is a teacher in every respect, with every right` IS TRUE

@ref akn:chp_3__sec_3_20__ssec_1_1_3
GIVEN y IS AN `internship year`
GIVETH A BOOLEAN
DECIDE `the scope is at least a third of a position` y IF
    y's `position fraction` AT LEAST 1/3

@ref akn:chp_3__sec_3_20__ssec_1_1_4
GIVEN y IS AN `internship year`
GIVETH A BOOLEAN
DECIDE `the duration is recognised` y IF
        (NOT y's `only single days`)
    AND (y's `months worked in the year` AT LEAST 6 OR y's `two periods of at least three months`)

@ref akn:chp_3__sec_3_20__ssec_1_1_5
GIVEN y IS AN `internship year`
GIVETH A BOOLEAN
DECIDE `done, as the rule is, in the trained layer and subjects` y IF
    y's `in the trained age layer and subjects`

-- (6): any employment outside the frameworks above and below needs the
-- internship branch's special approval, case by case.
@ref akn:chp_3__sec_3_20__ssec_1_1_6
GIVEN y IS AN `internship year`
GIVETH A BOOLEAN
DECIDE `needs the internship branch's special approval` y IF
       y's `framework` EQUALS `not an approved framework`
    OR y's `share in specially approved settings` GREATER THAN 0
    OR NOT y's `in the trained age layer and subjects`

§§ `1.2 העסקת המתמחה בחינוך הקדם יסודי`

@ref akn:chp_3__sec_3_20__ssec_1_2_1
GIVEN `under Ministry supervision or pedagogical guidance` IS A BOOLEAN, `prior written approval of the supervision` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a pre-primary internship may proceed` `under Ministry supervision or pedagogical guidance` `prior written approval of the supervision` IF
    `under Ministry supervision or pedagogical guidance` AND `prior written approval of the supervision`

@ref akn:chp_3__sec_3_20__ssec_1_2_2
GIVETH A BOOLEAN
DECIDE `a pre-primary intern's work is recognised as a kindergarten teacher's` IS TRUE

@ref akn:chp_3__sec_3_20__ssec_1_2_3
`the approved pre-primary frameworks (short and long school day)` MEANS
    LIST
        @ref akn:chp_3__sec_3_20__ssec_1_2_3__para_a
        -- (a) compulsory kindergarten.
        `compulsory kindergarten`,
        @ref akn:chp_3__sec_3_20__ssec_1_2_3__para_b
        -- (b) pre-compulsory kindergarten.
        `pre-compulsory kindergarten`,
        @ref akn:chp_3__sec_3_20__ssec_1_2_3__para_c
        -- (c) a kindergarten in a school's "young division".
        `kindergarten in a school's young division`,
        @ref akn:chp_3__sec_3_20__ssec_1_2_3__para_d
        -- (d) a licensed private kindergarten under Ministry supervision or guidance.
        `licensed private kindergarten under Ministry supervision or guidance`,
        @ref akn:chp_3__sec_3_20__ssec_1_2_3__para_e
        -- (e) an afternoon programme in a licensed, supervised kindergarten.
        `afternoon programme in a licensed, supervised kindergarten`

@ref akn:chp_3__sec_3_20__ssec_1_2_4
GIVEN `a standard for a second kindergarten teacher exists` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `employment as a second kindergarten teacher is approved` `a standard for a second kindergarten teacher exists` IF
    `a standard for a second kindergarten teacher exists`

§§ `1.3 העסקת המתמחה בחינוך היסודי`

@ref akn:chp_3__sec_3_20__ssec_1_3_1
`the approved primary frameworks (short and long school day)` MEANS
    LIST
        @ref akn:chp_3__sec_3_20__ssec_1_3_1__para_a
        -- (a) six-year schools, grades 1-6.
        `six-year school, grades 1-6`,
        @ref akn:chp_3__sec_3_20__ssec_1_3_1__para_b
        -- (b) eight-year schools, grades 1-8.
        `eight-year school, grades 1-8`,
        @ref akn:chp_3__sec_3_20__ssec_1_3_1__para_c
        -- (c) grades 1-2 in a school's "young division".
        `grades 1-2 in a school's young division`

@ref akn:chp_3__sec_3_20__ssec_1_3_2
GIVEN `in a school framework` IS A BOOLEAN, `in formal teaching hours` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `employment through "קרן קרב" is approved` `in a school framework` `in formal teaching hours` IF
    `in a school framework` AND `in formal teaching hours`

§§ `1.4 העסקת המתמחה בחינוך העל יסודי`

@ref akn:chp_3__sec_3_20__ssec_1_4
`the approved post-primary frameworks` MEANS
    LIST
        @ref akn:chp_3__sec_3_20__ssec_1_4__para_a
        -- (a) four-year post-primary schools, grades 9-12.
        `four-year post-primary school, grades 9-12`,
        @ref akn:chp_3__sec_3_20__ssec_1_4__para_b
        -- (b) six-year post-primary schools, grades 7-12.
        `six-year post-primary school, grades 7-12`,
        @ref akn:chp_3__sec_3_20__ssec_1_4__para_c
        -- (c) middle schools, grades 7-9.
        `middle school, grades 7-9`,
        @ref akn:chp_3__sec_3_20__ssec_1_4__para_d
        -- (d) eight-year primary schools, grades 7-8.
        `eight-year primary school, grades 7-8`

§§ `1.5 העסקת המתמחה בחינוך המיוחד`

@ref akn:chp_3__sec_3_20__ssec_1_5_2
`the approved special-education frameworks` MEANS
    LIST
        @ref akn:chp_3__sec_3_20__ssec_1_5_2__para_a
        -- (a) a special-education kindergarten.
        `special-education kindergarten`,
        @ref akn:chp_3__sec_3_20__ssec_1_5_2__para_b
        -- (b) an integrating kindergarten in regular education.
        `integrating kindergarten in regular education`,
        @ref akn:chp_3__sec_3_20__ssec_1_5_2__para_c
        -- (c) a special-education school.
        `special-education school`,
        @ref akn:chp_3__sec_3_20__ssec_1_5_2__para_d
        -- (d) a special-education class in regular education.
        `special-education class in regular education`,
        @ref akn:chp_3__sec_3_20__ssec_1_5_2__para_e
        -- (e) an integrating class in regular education.
        `integrating class in regular education`,
        @ref akn:chp_3__sec_3_20__ssec_1_5_2__para_f
        -- (f) classes in regular education.
        `classes in regular education`,
        @ref akn:chp_3__sec_3_20__ssec_1_5_2__para_g
        -- (g) a supervised school in a hospital or prison.
        `supervised school in a hospital or prison`

-- 1.5.3, 1.6.2, 1.7.2: a treatment centre or club, a conservatory, an
-- out-of-school dance centre — each needs the branch's special approval,
-- and may take no more than 40% of the required third of a position; the
-- rest is worked in an approved framework.
@ref akn:chp_3__sec_3_20__ssec_1_5_3 akn:chp_3__sec_3_20__ssec_1_6_2 akn:chp_3__sec_3_20__ssec_1_7_2
GIVEN y IS AN `internship year`, `the internship branch approved it specially` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the specially approved setting is within its limits` y `the internship branch approved it specially` IF
    y's `share in specially approved settings` EQUALS 0
    OR (`the internship branch approved it specially` AND y's `share in specially approved settings` AT MOST 40%)

@ref akn:chp_3__sec_3_20__ssec_1_5_4
GIVEN `months of employment, holidays included` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `summer or holiday employment is recognised` `months of employment, holidays included` IF
    `months of employment, holidays included` AT LEAST 6

§§ `1.6 העסקת המתמחה בהוראת המוסיקה`

@ref akn:chp_3__sec_3_20__ssec_1_6_1
`the approved music frameworks` MEANS
    LIST
        @ref akn:chp_3__sec_3_20__ssec_1_6_1__para_a
        -- (a) schools under Ministry supervision.
        `schools under Ministry supervision (music)`,
        @ref akn:chp_3__sec_3_20__ssec_1_6_1__para_b
        -- (b) kindergartens supervised or guided by the Ministry.
        `kindergartens supervised or guided by the Ministry (music)`

§§ `1.7–1.8 Dance and physical education`

@ref akn:chp_3__sec_3_20__ssec_1_7_1 akn:chp_3__sec_3_20__ssec_1_8_1
GIVEN `part of the school's curriculum in the basic grades, middle or upper division` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `dance or PE teaching is recognised` `part of the school's curriculum in the basic grades, middle or upper division` IF
    `part of the school's curriculum in the basic grades, middle or upper division`

@ref akn:chp_3__sec_3_20__ssec_1_8_2
GIVEN `a kindergarten class in a school's young division` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `PE teaching in a kindergarten class is recognised` `a kindergarten class in a school's young division` IF
    `a kindergarten class in a school's young division`

@ref akn:chp_3__sec_3_20__ssec_1_8_3
GIVEN `weekly PE hours in the school` IS A NUMBER, `position fraction of both roles` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `work in the school sports club is recognised` `weekly PE hours in the school` `position fraction of both roles` IF
    `weekly PE hours in the school` AT LEAST 4 AND `position fraction of both roles` AT LEAST 1/3

§§ `1.9 התמחות בחינוך החברתי-קהילתי`

-- 1.9.1: in the social-community field the internship year combines
-- teaching the trained subject with youth work in the sub-field trained for.
@ref akn:chp_3__sec_3_20__ssec_1_9_1
GIVEN `teaches the trained subject` IS A BOOLEAN, `works with youth in the trained sub-field` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the social-community internship combines its two parts` `teaches the trained subject` `works with youth in the trained sub-field` IF
    `teaches the trained subject` AND `works with youth in the trained sub-field`

@ref akn:chp_3__sec_3_20__ssec_1_9_2
GIVEN `the internship is in the social-community field` IS A BOOLEAN
GIVETH A `licence the internship is a condition of`
DECIDE `the licence the internship counts toward` `the internship is in the social-community field` IS
    IF `the internship is in the social-community field`
    THEN `a youth-guidance licence, from the society and youth administration`
    ELSE `a teaching licence, from the senior division of teaching personnel`

-- F-3.20-a: "the total hours of work in teaching reach together at least a
-- third of a position" — teaching alone, or teaching and youth guidance
-- together? The reading adopted: together.
@ref akn:chp_3__sec_3_20__ssec_1_9_3
GIVEN `teaching position fraction` IS A NUMBER, `youth-guidance position fraction` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `a split year is recognised` `teaching position fraction` `youth-guidance position fraction` IF
    `teaching position fraction` PLUS `youth-guidance position fraction` AT LEAST 1/3

GIVEN `teaching position fraction` IS A NUMBER, `youth-guidance position fraction` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `a split year is recognised, teaching alone counted` `teaching position fraction` `youth-guidance position fraction` IF
    `teaching position fraction` AT LEAST 1/3

@ref akn:chp_3__sec_3_20__ssec_1_9_4
GIVEN `teaching year's fraction` IS A NUMBER, `guidance year's fraction` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `an internship split over two years is recognised` `teaching year's fraction` `guidance year's fraction` IF
    `teaching year's fraction` AT LEAST 1/3 AND `guidance year's fraction` AT LEAST 1/3

@ref akn:chp_3__sec_3_20__ssec_1_9_5
GIVEN `the internship is in the social-community field` IS A BOOLEAN,
      `prior approval of the district head of the society and youth administration or a representative` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a social-community internship may proceed` `the internship is in the social-community field` `prior approval of the district head of the society and youth administration or a representative` IF
    `the internship is in the social-community field` IMPLIES `prior approval of the district head of the society and youth administration or a representative`

@ref akn:chp_3__sec_3_20__ssec_1_9_6
GIVEN `regular, permanent educational activity in the social-community field` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `an institution fit for "youth and community" guidance` `regular, permanent educational activity in the social-community field` IF
    `regular, permanent educational activity in the social-community field`

@ref akn:chp_3__sec_3_20__ssec_1_9_7
`the approved "youth and community" frameworks` MEANS
    LIST
        @ref akn:chp_3__sec_3_20__ssec_1_9_7__para_a
        -- (a) youth departments of local authorities and municipalities.
        `youth departments of local authorities and municipalities`,
        @ref akn:chp_3__sec_3_20__ssec_1_9_7__para_b
        -- (b) youth departments of community centres.
        `youth departments of community centres`,
        @ref akn:chp_3__sec_3_20__ssec_1_9_7__para_c
        -- (c) youth movements.
        `youth movements`,
        @ref akn:chp_3__sec_3_20__ssec_1_9_7__para_d
        -- (d) youth houses.
        `youth houses`,
        @ref akn:chp_3__sec_3_20__ssec_1_9_7__para_e
        -- (e) community schools.
        `community schools`,
        @ref akn:chp_3__sec_3_20__ssec_1_9_7__para_f
        -- (f) voluntary extra-curricular frameworks in schools and boarding schools.
        `voluntary extra-curricular frameworks in schools and boarding schools`,
        @ref akn:chp_3__sec_3_20__ssec_1_9_7__para_g
        -- (g) summer camps.
        `summer camps`

@ref akn:chp_3__sec_3_20__ssec_1_9_8
`the approved "youth advancement" frameworks` MEANS
    LIST
        @ref akn:chp_3__sec_3_20__ssec_1_9_8__para_a
        -- (a) youth-advancement units of local authorities.
        `youth-advancement units of local authorities`,
        @ref akn:chp_3__sec_3_20__ssec_1_9_8__para_b
        -- (b) HILA centres.
        `HILA centres`,
        @ref akn:chp_3__sec_3_20__ssec_1_9_8__para_c
        -- (c) projects in schools and boarding schools against dropping out, violence or addiction.
        `projects against dropping out, violence or addiction`

@ref akn:chp_3__sec_3_20__ssec_1_9_9 akn:chp_3__sec_3_20__ssec_1_9_10
`the approved של"ח and social-education frameworks` MEANS
    LIST `schools running של"ח and knowledge of the land`, `schools running social-education coordination`

@ref akn:chp_3__sec_3_20__ssec_1_9_11
GIVEN `for youth of middle-school age and up` IS A BOOLEAN, `days` IS A NUMBER,
      `with overnight stay` IS A BOOLEAN, `varied study, creative and social activities` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `summer activity counts toward the social-community internship` `for youth of middle-school age and up` `days` `with overnight stay` `varied study, creative and social activities` IF
    `for youth of middle-school age and up` AND `days` AT LEAST 3 AND `with overnight stay` AND `varied study, creative and social activities`

§§ `2 נוהלי ההפניה להתמחות בהוראה`

@ref akn:chp_3__sec_3_20__ssec_2_1
GIVETH A DEONTIC `3.20 party` `internship action`
DECIDE `the referral toward the last year of study` IS
    PARTY `the teaching-staff movement branch` MUST `issue the internship referral`

-- 2.2: valid three years from issue; to use it later, apply for renewal.
-- Time in years from the issue.
@ref akn:chp_3__sec_3_20__ssec_2_2
GIVEN `years since the referral was issued` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the referral is valid` `years since the referral was issued` IF
    `years since the referral was issued` AT MOST 3

@ref akn:chp_3__sec_3_20__ssec_2_2
GIVEN `years since the referral was issued` IS A NUMBER
GIVETH A DEONTIC `3.20 party` `internship action`
DECIDE `renewing an expired referral` `years since the referral was issued` IS
    IF `the referral is valid` `years since the referral was issued`
    THEN FULFILLED
    ELSE PARTY `the intern` MAY `apply for renewal of the referral`

@ref akn:chp_3__sec_3_20__ssec_2_3
GIVEN `a regular student at a teacher-training college` IS A BOOLEAN, `confirmation that the earlier years' obligations are met` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `may use the referral in the last year of study` `a regular student at a teacher-training college` `confirmation that the earlier years' obligations are met` IF
    `a regular student at a teacher-training college` AND `confirmation that the earlier years' obligations are met`

§§ `3 נוהלי הכניסה לעבודה בשנת ההתמחות`

@ref akn:chp_3__sec_3_20__ssec_3_1
GIVEN `the first year the candidate works in teaching` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the internship year` `the first year the candidate works in teaching` IF
    `the first year the candidate works in teaching`

@ref akn:chp_3__sec_3_20__ssec_3_2
GIVEN `in the upper division` IS A BOOLEAN
GIVETH A `where the candidate applies`
DECIDE `where to apply with the referral` `in the upper division` IS
    IF `in the upper division` THEN `the school principal (upper division)` ELSE `the district`

@ref akn:chp_3__sec_3_20__ssec_3_3
GIVEN `pre-primary, primary or middle school` IS A BOOLEAN,
      `signed by the supervision` IS A BOOLEAN, `signed by the district personnel branch` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the placement is approved` `pre-primary, primary or middle school` `signed by the supervision` `signed by the district personnel branch` IF
    `pre-primary, primary or middle school` IMPLIES (`signed by the supervision` AND `signed by the district personnel branch`)

-- 3.4: at once on entering work (WITHIN 0 days), with all seven details.
@ref akn:chp_3__sec_3_20__ssec_3_4
`the details owed to the internship coordinator` MEANS
    LIST
        @ref akn:chp_3__sec_3_20__ssec_3_4__para_a
        -- (a) the name of the kindergarten, school or institution.
        `the name of the kindergarten, school or institution`,
        @ref akn:chp_3__sec_3_20__ssec_3_4__para_b
        -- (b) its address and telephone number.
        `its address and telephone`,
        @ref akn:chp_3__sec_3_20__ssec_3_4__para_c
        -- (c) the name of the kindergarten supervisor, the principal or the institution's head.
        `the name of the supervisor or principal`,
        @ref akn:chp_3__sec_3_20__ssec_3_4__para_d
        -- (d) the mentor's name and identity number.
        `the mentor's name and identity number`,
        @ref akn:chp_3__sec_3_20__ssec_3_4__para_e
        -- (e) the scope of employment.
        `the scope of employment`,
        @ref akn:chp_3__sec_3_20__ssec_3_4__para_f
        -- (f) the age layer.
        `the age layer`,
        @ref akn:chp_3__sec_3_20__ssec_3_4__para_g
        -- (g) the subjects, fields of employment and further roles.
        `the subjects, fields of employment and further roles`

@ref akn:chp_3__sec_3_20__ssec_3_4
GIVETH A DEONTIC `3.20 party` `internship action`
DECIDE `notifying the internship coordinator` IS
    PARTY `the intern`
    MUST  `notify the internship coordinator of entering work` d
          PROVIDED all (GIVEN x YIELD elem x d) `the details owed to the internship coordinator`
    WITHIN 0
    LEST BREACH BY `the intern` BECAUSE "section 3.20.3.4: the coordinator is told at once on entering work, with every listed detail"

§§ `4 חובות המתמחה בהוראה`

@ref akn:chp_3__sec_3_20__ssec_4_1
GIVEN `keeps the institution's procedures` IS A BOOLEAN, `meets the role's demands` IS A BOOLEAN, `fulfils every teacher's duties there` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `meets the duties toward the employer` `keeps the institution's procedures` `meets the role's demands` `fulfils every teacher's duties there` IF
    `keeps the institution's procedures` AND `meets the role's demands` AND `fulfils every teacher's duties there`

-- 4.2.1-4.2.3: the workshop, during the internship year (time in school
-- months, the year being 12), at least 2 weekly hours; a workshop before or
-- after the year does not count.
@ref akn:chp_3__sec_3_20__ssec_4_2_1 akn:chp_3__sec_3_20__ssec_4_2_2
GIVETH A DEONTIC `3.20 party` `internship action`
DECIDE `the internship workshop` IS
    PARTY `the intern`
    MUST  `take part in the internship workshop`
    WITHIN 12
    LEST BREACH BY `the intern` BECAUSE "section 3.20.4.2: every intern takes part in an internship workshop during the internship year"

@ref akn:chp_3__sec_3_20__ssec_4_2_2 akn:chp_3__sec_3_20__ssec_4_2_3
GIVEN `during the internship year` IS A BOOLEAN, `weekly hours of the workshop` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the workshop counts` `during the internship year` `weekly hours of the workshop` IF
    `during the internship year` AND `weekly hours of the workshop` AT LEAST 2

@ref akn:chp_3__sec_3_20__ssec_4_2_4
GIVEN `a regular student interning alongside the last year` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the workshop counts toward the degree and certificate` `a regular student interning alongside the last year` IF
    `a regular student interning alongside the last year`

@ref akn:chp_3__sec_3_20__ssec_4_2_5
`the forms the workshop evaluation may take` MEANS LIST `verbal`, `by the training institution's rules`

@ref akn:chp_3__sec_3_20__ssec_4_2_6
GIVEN `holds a degree and a teaching certificate` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the workshop counts toward the in-service training allowance` `holds a degree and a teaching certificate` IF
    `holds a degree and a teaching certificate`

§§ `5 הזכויות הפרופסיונליות של המתמחה בהוראה`

@ref akn:chp_3__sec_3_20__ssec_5_1_1 akn:chp_3__sec_3_20__ssec_5_1_2/p1 akn:chp_3__sec_3_20__ssec_5_1_2/p2 akn:chp_3__sec_3_20__ssec_5_1_3
GIVEN `interning alongside the last year of study` IS A BOOLEAN,
      `in the social-community field` IS A BOOLEAN,
      `shows the training institution's confirmation` IS A BOOLEAN,
      `years since the confirmation was issued` IS A NUMBER,
      `finished studying and produced the certificate` IS A BOOLEAN
GIVETH AN `intern's pay`
DECIDE `the intern is paid as` `interning alongside the last year of study` `in the social-community field` `shows the training institution's confirmation` `years since the confirmation was issued` `finished studying and produced the certificate` IS
    IF     `interning alongside the last year of study`
       AND `shows the training institution's confirmation`
       AND `years since the confirmation was issued` AT MOST 2
       AND NOT `finished studying and produced the certificate`
    THEN IF `in the social-community field` THEN `senior certified instructor` ELSE `senior certified teacher`
    ELSE `by the degree held`

@ref akn:chp_3__sec_3_20__ssec_5_2
GIVEN y IS AN `internship year`, `full months employed` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the internship year counts as a year of seniority` y `full months employed` IF
    `full months employed` AT LEAST 6 AND y's `position fraction` AT LEAST 1/3

@ref akn:chp_3__sec_3_20__ssec_5_3
GIVEN `met the internship's obligations` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the internship year is the first trial year toward tenure` `met the internship's obligations` IF
    `met the internship's obligations`

@ref akn:chp_3__sec_3_20__ssec_5_4
GIVETH A BOOLEAN
DECIDE `the internship year counts as a work year for incentives` IS TRUE

@ref akn:chp_3__sec_3_20__ssec_5_5_1 akn:chp_3__sec_3_20__ssec_5_5_2
GIVEN `holds a degree and a teaching certificate` IS A BOOLEAN,
      `interned alongside the last year of study` IS A BOOLEAN,
      `met the internship's obligations` IS A BOOLEAN,
      `employed in teaching the year after` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the internship year counts for repaying conditional loans` `holds a degree and a teaching certificate` `interned alongside the last year of study` `met the internship's obligations` `employed in teaching the year after` IF
    `met the internship's obligations`
    AND (   `holds a degree and a teaching certificate`
         OR (`interned alongside the last year of study` AND `employed in teaching the year after`))

@ref akn:chp_3__sec_3_20__ssec_5_5_3/p1
GIVEN `interning alongside the last year of study` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `entitled to a conditional loan as a teaching student` `interning alongside the last year of study` IF
    `interning alongside the last year of study`

-- akn:chp_3__sec_3_20__ssec_5_5_3/p2 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_20__ssec_5_5_3/p3 Source (אסמכתא): a Director-General's circular.

-- Examples.
`an intern on a third of a position for seven months` MEANS
    `internship year` WITH
        `position fraction`                    IS 1/3
        `months worked in the year`            IS 7
        `two periods of at least three months` IS FALSE
        `only single days`                     IS FALSE
        `in the trained age layer and subjects` IS TRUE
        `framework`                            IS `middle school, grades 7-9`
        `share in specially approved settings` IS 0

#ASSERT `the duration is recognised` `an intern on a third of a position for seven months`
#ASSERT `the scope is at least a third of a position` `an intern on a third of a position for seven months`
#ASSERT `an approved framework` `middle school, grades 7-9`
#ASSERT NOT `needs the internship branch's special approval` `an intern on a third of a position for seven months`
#ASSERT `the internship year counts as a year of seniority` `an intern on a third of a position for seven months` 7
#ASSERT `the intern is paid as` TRUE FALSE TRUE 1 FALSE EQUALS `senior certified teacher`

#TRACE `notifying the internship coordinator` AT 0 WITH
    PARTY `the intern` DOES `notify the internship coordinator of entering work` (LIST `the name of the kindergarten, school or institution`, `its address and telephone`, `the name of the supervisor or principal`, `the mentor's name and identity number`, `the scope of employment`, `the age layer`, `the subjects, fields of employment and further roles`) AT 0

-- F-3.20-a: a fifth of a position in teaching and a fifth in youth
-- guidance — the two readings of 1.9.3 answer differently.
`the two readings of 1.9.3 differ for a fifth and a fifth` MEANS
    NOT (`a split year is recognised` 0.2 0.2 EQUALS `a split year is recognised, teaching alone counted` 0.2 0.2)
#ASSERT `the two readings of 1.9.3 differ for a fifth and a fifth`
