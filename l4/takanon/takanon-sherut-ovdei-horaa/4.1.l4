-- תקנון שירות עובדי הוראה, פרק 4, §4.1 יחידת עבודה וחופשת הקיץ
-- The work unit of a teacher in a special-education primary school, and
-- when its summer holiday begins.

IMPORT prelude
IMPORT daydate
IMPORT common

§ `4.1 יחידת עבודה וחופשת הקיץ`

@desc A teacher's weekly hours in a special-education primary school, by grades.
DECLARE `special primary timetable` HAS
    `weekly teaching hours in grades 1-6` IS A NUMBER
    `weekly teaching hours in grades 7-8` IS A NUMBER

@desc A ninth grade attached to a primary school, as section 4.1.2 asks about it.
DECLARE `attached ninth grade` HAS
    `attached to a primary school` IS A BOOLEAN
    `within the reform`            IS A BOOLEAN @desc the class is within the school-structure reform (חטיבות ביניים)

§§ `4.1.1 יחידת עבודה`

-- akn:chp_4__sec_4_1__hc_2__para_1/p1 The paragraph's heading ("יחידת עבודה").

@ref akn:chp_4__sec_4_1__hc_2__para_1/p2
GIVETH A NUMBER
DECIDE `weekly hours in a special primary work unit` IS 30

@ref akn:chp_4__sec_4_1__hc_2__para_1/p3
GIVETH A NUMBER
DECIDE `weekly hours of the position grades 7-8 are reckoned by` IS 24

-- The two paragraphs together: grades 1-6 hours are thirtieths of a
-- position, grades 7-8 hours twenty-fourths.
@ref akn:chp_4__sec_4_1__hc_2__para_1/p2 akn:chp_4__sec_4_1__hc_2__para_1/p3
GIVEN t IS A `special primary timetable`
GIVETH A NUMBER
DECIDE `special primary position fraction` t IS
      t's `weekly teaching hours in grades 1-6` DIVIDED BY `weekly hours in a special primary work unit`
    PLUS t's `weekly teaching hours in grades 7-8` DIVIDED BY `weekly hours of the position grades 7-8 are reckoned by`

§§ `4.1.2 חופשת הקיץ`

-- akn:chp_4__sec_4_1__hc_2__para_2/p1 The paragraph's heading ("חופשת הקיץ").

@ref akn:chp_4__sec_4_1__hc_2__para_2/p2
GIVEN `the calendar year` IS A NUMBER
GIVETH A DATE
DECIDE `the summer holiday of a special primary school begins` `the calendar year` IS
    Date 1 7 `the calendar year`

@ref akn:chp_4__sec_4_1__hc_2__para_2/p3
GIVEN c IS AN `attached ninth grade`
GIVETH A BOOLEAN
DECIDE `ends the year with the rest of the school` c IF
    c's `attached to a primary school` AND NOT c's `within the reform`

-- akn:chp_4__sec_4_1__hc_3/p1 Source (אסמכתא): a Director-General's circular.
-- akn:chp_4__sec_4_1__hc_3/p2 Source (אסמכתא): a Director-General's circular.

#ASSERT `special primary position fraction` (`special primary timetable` WITH `weekly teaching hours in grades 1-6` IS 15, `weekly teaching hours in grades 7-8` IS 12) EQUALS 1
#ASSERT `the summer holiday of a special primary school begins` 2027 EQUALS Date 1 7 2027
