        `bought a flat in the northern district` IS `bought in the north`
        `registered address changed to the south` IS FALSE
        `assigned for the whole school year`    IS TRUE
        `northern position fraction`            IS 1
        `filed this year's rent request with lease and identity card` IS TRUE
        `monthly rent paid in the south`        IS 400
        `paid directly by the Ministry`         IS FALSE
        `approved by the southern incentives department` IS TRUE
        `joined a training fund in the ordinary way` IS TRUE
        `applied with the fund's joining confirmation` IS TRUE
        `salary the fund deduction is taken from` IS 10000

`a northern teacher in Rahat` MEANS `a northern teacher in Rahat who bought in the north` FALSE
#ASSERT `monthly northern rent refund` `a northern teacher in Rahat` `the monthly northern rent amount in התשס"ג` FALSE EQUALS 400
