-- akn:chp_1א___sec_1_15__ssec_4_5/p613 The heading of §1.15.2's sources (אסמכתא); no rule.
-- akn:chp_1א___sec_1_15__ssec_4_5/p614 The source of §1.15.2: a Director-General's circular; no rule.

-- Worked examples. Nothing below is from a payslip: every amount, salary,
-- fare and rent is a round PLACEHOLDER, because the takanon leaves them to
-- the salary tables, the fund rules and the year's settings.

GIVEN `work locality` IS A STRING, `lowest fraction` IS A NUMBER, `annual fraction` IS A NUMBER
GIVETH AN `incentives claimant`
DECIDE `a primary teacher living in Ofakim` `work locality` `lowest fraction` `annual fraction` IS
    `incentives claimant` WITH
        `claimant grading`             IS `the teaching-staff grading`
        `claimant role`                IS `teacher`
        `claimant teaches at`          IS `primary education`
        `holds a primary teaching certificate`            IS TRUE
        `holds a permanent post-primary teaching licence` IS FALSE
        `holds a teaching certificate` IS TRUE
        `holds an academic degree`     IS FALSE
        `locality of residence`        IS "אופקים"
        `locality of work`             IS `work locality`
        `employed by`                  IS `the Ministry directly`
        `appears in the school profile` IS FALSE
        `the department head decides the claimant eligible` IS FALSE
        `lowest position fraction in the year` IS `lowest fraction`
        `annual position fraction`     IS `annual fraction`
        `claimant is a veteran`        IS FALSE

`a teacher living and working in Ofakim` MEANS `a primary teacher living in Ofakim` "אופקים" 0.6 0.8

#ASSERT `eligible for incentives` `a teacher living and working in Ofakim`
#ASSERT `incentives share for the position` `a teacher living and working in Ofakim` EQUALS 0.8
#ASSERT `seniority recognised for pay` `a teacher living and working in Ofakim` 10 TRUE EQUALS 14
#ASSERT `seniority recognised for pay` `a teacher living and working in Ofakim` 10 FALSE EQUALS 10
#ASSERT NOT `eligible for incentives` (`a primary teacher living in Ofakim` "באר שבע" 0.6 0.8)

-- An educational psychologist in Ofakim with a degree and no teaching level.
`a psychologist in Ofakim` MEANS
    `incentives claimant` WITH
        `claimant grading`             IS `the academic grading`
        `claimant role`                IS `educational psychologist`
        `claimant teaches at`          IS `no teaching level`
        `holds a primary teaching certificate`            IS FALSE
        `holds a permanent post-primary teaching licence` IS FALSE
        `holds a teaching certificate` IS FALSE
        `holds an academic degree`     IS TRUE
        `locality of residence`        IS "אופקים"
        `locality of work`             IS "אופקים"
        `employed by`                  IS `the Ministry directly`
        `appears in the school profile` IS FALSE
        `the department head decides the claimant eligible` IS FALSE
        `lowest position fraction in the year` IS 1
        `annual position fraction`     IS 1
        `claimant is a veteran`        IS FALSE
#ASSERT `eligible for incentives` `a psychologist in Ofakim`

-- F-1.15-d: the two readings of condition א part on her.
`condition א's readings differ for a psychologist` MEANS
    `meets condition א` `a psychologist in Ofakim`
    AND NOT `meets condition א read as qualification alone` `a psychologist in Ofakim`
#ASSERT `condition א's readings differ for a psychologist`

-- F-1.15-e: 80% of a position for half the year and 20% for the other
-- half averages 50% of an annual position, but is not half a position
-- throughout.
`a claimant at half an annual position, unevenly` MEANS
    `a primary teacher living in Ofakim` "אופקים" 0.2 0.5
`the half-position condition's readings differ` MEANS
    `meets the half-position condition read as an annual average` `a claimant at half an annual position, unevenly`
    AND NOT `meets the half-position condition` `a claimant at half an annual position, unevenly`
#ASSERT `the half-position condition's readings differ`

-- §1.2: a veteran in a locality of annex B keeps the incentives through
-- התשס"ד and loses them after it.
#ASSERT `continued by the court rulings` "אבטליון" TRUE 100
#ASSERT `cancelled under §1.2` "אבטליון" TRUE 400
#ASSERT NOT `cancelled under §1.2` "אבטליון" FALSE 400
#ASSERT `the division handles the request` `rent participation` 200
#ASSERT NOT `the division handles the request` `rent participation` 300
#ASSERT `the division handles the request` `training-fund contributions` 300

-- §4.1: a placeholder salary scale rising 100 a year.
GIVEN n IS A NUMBER
GIVETH A NUMBER
DECIDE `a placeholder salary scale` n IS 5000 PLUS 100 TIMES n
#ASSERT `monthly worth of the seniority advancement` `a placeholder salary scale` 10 EQUALS 400
#ASSERT `monthly worth of the seniority advancement` `a placeholder salary scale` 34 EQUALS 400
#ASSERT `monthly worth of the grade advancement` `a placeholder salary scale` 3 TRUE EQUALS 200

-- §4.2: an Open University student on two courses and four weekly hours.
`an Open University student` MEANS
    `tuition claim` WITH
        `institution recognised by the Council for Higher Education` IS TRUE
        `programme approved by the division`   IS TRUE
        `weekly study hours`                   IS 4
        `field is a school subject or general education` IS TRUE
        `studies toward a degree`              IS TRUE
        `request filed at the district office on its form` IS TRUE
        `receives a teacher-training hours grant` IS TRUE
        `at an Israeli branch of a foreign university` IS FALSE
        `studies abroad`                       IS FALSE
        `at the Open University`               IS TRUE
        `Open University courses toward a degree this year` IS 2
        `tuition charged`                      IS 10000
        `registration fees, exam fees and arrears` IS 500
        `annual tuition`                       IS 10000
        `school year studied begins on`        IS 0
#ASSERT `tuition participation` `a teacher living and working in Ofakim` `an Open University student` EQUALS 7500

-- F-1.15-j: the readings of note 3 part on her.
`the study-load readings differ for an Open University student` MEANS
    `meets the study-load condition` `an Open University student`
    AND NOT `meets the study-load condition read as both` `an Open University student`
#ASSERT `the study-load readings differ for an Open University student`

-- §4.3: a local-authority flat at a rent above Amidar's.
GIVEN `the landlord` IS A `kind of landlord`
GIVETH A `rent claim`
DECIDE `a flat let by` `the landlord` IS
    `rent claim` WITH
        `annual rent paid`                      IS 24000
        `landlord`                              IS `the landlord`
        `annual Amidar rent in the locality`    IS 18000
        `maximum participation for the year`    IS 30000
        `in a locality of housing distress`     IS FALSE
        `rate set by the committee`             IS 0
        `owns another flat in the locality or the zone` IS FALSE
        `receives rent participation from another body` IS FALSE
        `rents from a first-degree relative`    IS FALSE
        `months rented in the school year`      IS 12
        `sold a flat inside the zone since התשנ"ח` IS FALSE

`a local-authority flat` MEANS `a flat let by` `a local authority`
#ASSERT `annual rent participation` `a teacher living and working in Ofakim` `a local-authority flat` EQUALS 19200
#ASSERT `annual rent participation` `a teacher living and working in Ofakim` (`a flat let by` `the free market`) EQUALS 0

-- F-1.15-i: what the 80% is of decides the amount.
`the rent bases differ` MEANS
