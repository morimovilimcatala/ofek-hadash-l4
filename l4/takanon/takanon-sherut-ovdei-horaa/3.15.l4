-- תקנון שירות עובדי הוראה, פרק 3, §3.15 מורה לחינוך ריתמי-מוסיקלי
-- The rhythmics teacher: work unit and reporting, hiring, salary grade and
-- seniority, the teaching standard, and the split allowance, travel
-- expenses and instrument fee.

IMPORT prelude
IMPORT common

§ `3.15 מורה לחינוך ריתמי-מוסיקלי`

@desc A rhythmics teacher's education and service, as section 3.15.3 asks about them.
DECLARE `rhythmics teacher record` HAS
    `graduate of a teachers' seminary for music`          IS A BOOLEAN
    `twelve years of schooling on entering the seminary`  IS A BOOLEAN
    `finished a music-educators' seminary or rhythmics track by תשכ"ח` IS A BOOLEAN
    `certified teacher or certified kindergarten teacher` IS A BOOLEAN
    `seminary graduate with a Dalcroze course from תשכ"ח on` IS A BOOLEAN @desc a seminary graduate who took a course in the Dalcroze method (or one found equivalent), in Israel or abroad, from תשכ"ח onward
    `matriculation`                                       IS A BOOLEAN
    `twelve years of schooling`                           IS A BOOLEAN
    `finished a Dalcroze course by תשכ"ח`                 IS A BOOLEAN @desc a course in the Dalcroze method (or one found equivalent), finished by תשכ"ח
    `finished a Dalcroze course`                          IS A BOOLEAN @desc a course in the Dalcroze method (or one found equivalent), whenever finished
    `years teaching rhythmics`                            IS A NUMBER

DECLARE `rhythmics grade` IS ONE OF
    `the grade of a certified teacher`
    `the grade of an uncertified teacher`
    `a grade by education`

@desc A period of a rhythmics teacher's past work, as section 3.15.3(3) counts it.
DECLARE `past work period` HAS
    `length in years`                      IS A NUMBER
    `in institutions under Ministry supervision` IS A BOOLEAN @desc schools and kindergartens under the supervision of the Ministry of Education
    `weekly hours`                         IS A NUMBER
    `confirmed by the supervision or owner` IS A BOOLEAN

@desc A month of a rhythmics teacher's work, as section 3.15.6 asks about it.
DECLARE `rhythmics year` HAS
    `workplaces`                IS A NUMBER
    `position fraction`         IS A NUMBER
    `uses her own accordion or organ` IS A BOOLEAN
    `monthly fee for one position` IS A NUMBER @desc the monthly instrument fee for one full position; an input, set outside the takanon
    `the month is in the summer break` IS A BOOLEAN

DECLARE `rhythmics lesson companion` IS ONE OF
    `the kindergarten teacher, taking part`
    `the class teacher, present`

DECLARE `rhythmics action` IS ONE OF
    `require more than 24/30 of a position`
    `use the rhythmics standard for another subject or purpose`
    `split the class into groups for rhythmics`
    `give both weekly lessons on one day`
    `report the work on the attendance form`
    `report kindergarten work to the district office on its form` HAS
        `every kindergarten teacher signed her line` IS A BOOLEAN
        `the rhythmics teacher signed`              IS A BOOLEAN
    `give the medical certificate to one institution and letters to the others`
    `transfer the Ministry's share of the salary to the kindergarten's owner`
    `pay travel expenses` HAS `amount of travel` IS A NUMBER
    `place the rhythmics teacher in as few institutions as it can, at reasonable travel distances`

-- akn:chp_3__sec_3_15/p2 The page's table-of-contents heading ("התכנים בעמוד").
-- akn:chp_3__sec_3_15/p3 Table of contents: the title of 3.15.1.
-- akn:chp_3__sec_3_15/p4 Table of contents: the title of 3.15.2.
-- akn:chp_3__sec_3_15/p5 Table of contents: the title of 3.15.3.
-- akn:chp_3__sec_3_15/p6 Table of contents: the title of 3.15.4.
-- akn:chp_3__sec_3_15/p7 Table of contents: the title of 3.15.6.

§§ `3.15.1 יחידת עבודה`

@ref akn:chp_3__sec_3_15__ssec_3_15_1/p1
GIVETH A NUMBER
DECIDE `weekly hours in a rhythmics work unit` IS 30

-- (2): not obliged beyond 24/30 of a position; entitled to a full one,
-- subject to the rules of official primary education (a named input).
-- Where those rules do not allow it, the text gives her no other right.
@ref akn:chp_3__sec_3_15__ssec_3_15_1/p2
GIVEN `the teacher consents` IS A BOOLEAN
GIVETH A DEONTIC Party `rhythmics action`
DECIDE `no more than 24/30 of a position without consent` `the teacher consents` IS
    IF `the teacher consents`
    THEN FULFILLED
    ELSE PARTY `the employer` SHANT `require more than 24/30 of a position`

@ref akn:chp_3__sec_3_15__ssec_3_15_1/p2
GIVEN `the primary-education rules allow a full position` IS A BOOLEAN @desc the rules for teaching employees in official primary education allow the full position asked for
GIVETH A BOOLEAN
DECIDE `entitled to work a full position` `the primary-education rules allow a full position` IF
    `the primary-education rules allow a full position`

-- (3): a lesson lasts 45 minutes; in a kindergarten, 15 of those 45 are
-- given to preparing the lesson and the arrangements it needs.
@ref akn:chp_3__sec_3_15__ssec_3_15_1/p3
GIVETH A NUMBER
DECIDE `minutes of a rhythmics lesson` IS 45

GIVEN `in a kindergarten` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `minutes of the lesson given to preparation and arrangements` `in a kindergarten` IS
    IF `in a kindergarten` THEN 15 ELSE 0

@ref akn:chp_3__sec_3_15__ssec_3_15_1/p4
GIVEN `lessons given` IS A NUMBER
GIVETH A NUMBER
DECIDE `paid working hours` `lessons given` IS `lessons given`

-- akn:chp_3__sec_3_15__ssec_3_15_1/p5 A heading ("דיווח על העבודה", reporting the work) over the paragraphs below.

@ref akn:chp_3__sec_3_15__ssec_3_15_1/p6
GIVETH A DEONTIC Party `rhythmics action`
DECIDE `reporting school work` IS
    PARTY `the teaching employee` MUST `report the work on the attendance form`

-- (2): the teacher reports her kindergarten work on the form the district
-- office gives out; every kindergarten teacher signs her own line, the
-- teacher signs, and the form goes to the district office as the form and
-- the office direct.
@ref akn:chp_3__sec_3_15__ssec_3_15_1/p7 akn:chp_3__sec_3_15__ssec_3_15_1/p9
GIVETH A DEONTIC Party `rhythmics action`
DECIDE `reporting kindergarten work` IS
    PARTY `the teaching employee`
    MUST  `report kindergarten work to the district office on its form` k t PROVIDED k AND t

-- What the report includes, "among other things": these at least.
@ref akn:chp_3__sec_3_15__ssec_3_15_1/p8
GIVEN r IS A `kindergarten report`
GIVETH A BOOLEAN
DECIDE `the kindergarten report includes what the text lists` r IF
    r's `lists the kindergartens and their addresses`
    AND r's `lists the kindergarten teachers' names`
    AND r's `lists the days and hours in each kindergarten`

DECLARE `kindergarten report` HAS
    `lists the kindergartens and their addresses`   IS A BOOLEAN
    `lists the kindergarten teachers' names`        IS A BOOLEAN
    `lists the days and hours in each kindergarten` IS A BOOLEAN

@ref akn:chp_3__sec_3_15__ssec_3_15_1/p10
GIVEN `prefers to stay a non-state employee` IS A BOOLEAN,
      `most of the kindergarten's children are of compulsory age` IS A BOOLEAN
GIVETH A DEONTIC Party `rhythmics action`
DECIDE `the Ministry's share for a non-state rhythmics teacher` `prefers to stay a non-state employee` `most of the kindergarten's children are of compulsory age` IS
    IF `prefers to stay a non-state employee` AND `most of the kindergarten's children are of compulsory age`
    THEN PARTY `the Ministry of Education`
         MUST  `transfer the Ministry's share of the salary to the kindergarten's owner`
    ELSE FULFILLED

@ref akn:chp_3__sec_3_15__ssec_3_15_1/p11
GIVEN `absent through illness or the like` IS A BOOLEAN
GIVETH A DEONTIC Party `rhythmics action`
DECIDE `reporting an absence` `absent through illness or the like` IS
    IF `absent through illness or the like`
    THEN PARTY `the teaching employee`
         MUST  `give the medical certificate to one institution and letters to the others`
    ELSE FULFILLED

-- akn:chp_3__sec_3_15__ssec_3_15_1/p12 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_15__ssec_3_15_1/p13 Source (אסמכתא): a Director-General's circular.
-- akn:chp_3__sec_3_15__ssec_3_15_1/p14 Source (אסמכתא): a Director-General's circular.

§§ `3.15.2 קבלה לעבודה`

@ref akn:chp_3__sec_3_15__ssec_3_15_2__para_1
GIVETH A BOOLEAN
DECIDE `hiring, rights and benefits are as for any primary teacher` IS TRUE

-- akn:chp_3__sec_3_15__ssec_3_15_2/p1 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_15__ssec_3_15_2/p2 Source (אסמכתא): a Director-General's circular.

§§ `3.15.3 קביעת דרגת וותק`

@ref akn:chp_3__sec_3_15__ssec_3_15_3__para_1/p1
GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `entitled to the grade of a certified teacher` t IF
    `route 1(a)` t OR `route 1(b)` t OR `route 1(c)` t OR `route 1(d)` t

@ref akn:chp_3__sec_3_15__ssec_3_15_3__para_1__subpara_a
GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `route 1(a)` t IF t's `graduate of a teachers' seminary for music`

@ref akn:chp_3__sec_3_15__ssec_3_15_3__para_1__subpara_b
GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `route 1(b)` t IF
    t's `twelve years of schooling on entering the seminary` AND t's `finished a music-educators' seminary or rhythmics track by תשכ"ח`

@ref akn:chp_3__sec_3_15__ssec_3_15_3__para_1__subpara_c
GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `route 1(c)` t IF
    t's `certified teacher or certified kindergarten teacher` AND t's `seminary graduate with a Dalcroze course from תשכ"ח on`

@ref akn:chp_3__sec_3_15__ssec_3_15_3__para_1__subpara_d
GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `route 1(d)` t IF
        (t's `matriculation` OR t's `twelve years of schooling`)
    AND t's `finished a Dalcroze course by תשכ"ח`
    AND t's `years teaching rhythmics` AT LEAST 7

@ref akn:chp_3__sec_3_15__ssec_3_15_3__para_2__subpara_a
GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `deemed an uncertified teacher` t IF
        t's `matriculation`
    AND t's `finished a Dalcroze course`
    AND t's `years teaching rhythmics` LESS THAN 7

-- (b) covers every teacher not entitled to the certified grade; the
-- teacher (a) deems uncertified is one of them, and her grade by education
-- is the uncertified teacher's grade (a) names, so (a) is applied first.
-- F-3.15-b: (a) names no exception for a teacher entitled under (1); the
-- reading adopted is that (1) governs her, as (b)'s own words say of (2).
@ref akn:chp_3__sec_3_15__ssec_3_15_3__para_2__subpara_b
GIVEN t IS A `rhythmics teacher record`
GIVETH A `rhythmics grade`
DECIDE `rhythmics salary grade` t IS
    IF `entitled to the grade of a certified teacher` t
    THEN `the grade of a certified teacher`
    ELSE IF `deemed an uncertified teacher` t
         THEN `the grade of an uncertified teacher`
         ELSE `a grade by education`

-- F-3.15-a: (a) counts full seniority for work in supervised institutions
-- of at least 10 weekly hours, (b) half for work in institutions not under
-- supervision; work in supervised institutions under 10 hours is in
-- neither. The reading adopted counts it for nothing. F-3.15-c: (a) asks
-- for confirmations and (b) does not; the reading adopted is as printed,
-- so unconfirmed work counts under (b) and not under (a).
@ref akn:chp_3__sec_3_15__ssec_3_15_3__para_3__subpara_a akn:chp_3__sec_3_15__ssec_3_15_3__para_3__subpara_b
GIVEN p IS A `past work period`
GIVETH A NUMBER
DECIDE `seniority for a past period` p IS
    IF p's `in institutions under Ministry supervision`
    THEN IF p's `weekly hours` AT LEAST 10 AND p's `confirmed by the supervision or owner`
         THEN p's `length in years`
         ELSE 0
    ELSE p's `length in years` DIVIDED BY 2

GIVEN p IS A `past work period`
GIVETH A BOOLEAN
DECIDE `a sub-clause of 3.15.3(3) governs the period` p IF
       (p's `in institutions under Ministry supervision` AND p's `weekly hours` AT LEAST 10)
    OR NOT p's `in institutions under Ministry supervision`

@ref akn:chp_3__sec_3_15__ssec_3_15_3__para_3__subpara_c
GIVEN t IS A `rhythmics teacher record`, `years of work` IS A NUMBER
GIVETH A NUMBER
DECIDE `seniority of a teacher under 1(d)` t `years of work` IS
    IF `route 1(d)` t
    THEN max 0 (`years of work` MINUS 3)
    ELSE `years of work`

-- akn:chp_3__sec_3_15__ssec_3_15_3/p1 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_15__ssec_3_15_3/p2 Source (אסמכתא): a Director-General's circular.

§§ `3.15.4 תקן`

-- (1): the standard, for now, is 2 weekly lessons for grade 1 and for a
-- kindergarten class most of whose children are of compulsory age; the
-- Ministry does not bear the cost of rhythmics in another kindergarten class.
@ref akn:chp_3__sec_3_15__ssec_3_15_4__para_1
GIVEN `grade 1 or a kindergarten class` IS A BOOLEAN,
      `a kindergarten class without a compulsory-age majority` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `the rhythmics teaching standard, in weekly lessons` `grade 1 or a kindergarten class` `a kindergarten class without a compulsory-age majority` IS
    IF `grade 1 or a kindergarten class` AND NOT `a kindergarten class without a compulsory-age majority`
    THEN 2
    ELSE 0

@ref akn:chp_3__sec_3_15__ssec_3_15_4__para_2
GIVETH A DEONTIC Party `rhythmics action`
DECIDE `the standard is for rhythmics only` IS
    PARTY `the school principal` SHANT `use the rhythmics standard for another subject or purpose`

@ref akn:chp_3__sec_3_15__ssec_3_15_4__para_3
GIVETH A DEONTIC Party `rhythmics action`
DECIDE `no splitting into groups` IS
    PARTY `the school principal` SHANT `split the class into groups for rhythmics`

@ref akn:chp_3__sec_3_15__ssec_3_15_4__para_4
GIVETH A DEONTIC Party `rhythmics action`
DECIDE `not both lessons on one day` IS
    PARTY `the school principal` SHANT `give both weekly lessons on one day`

-- (5): in a kindergarten the kindergarten teacher takes part in the
-- lesson; in a school the class teacher is present; a class teacher's
-- absence does not cancel the lesson. (What a kindergarten teacher's
-- absence does is not said, and nothing here decides it.)
@ref akn:chp_3__sec_3_15__ssec_3_15_4__para_5
GIVEN `in a kindergarten` IS A BOOLEAN
GIVETH A `rhythmics lesson companion`
DECIDE `who is with the class at the rhythmics lesson` `in a kindergarten` IS
    IF `in a kindergarten` THEN `the kindergarten teacher, taking part` ELSE `the class teacher, present`

@ref akn:chp_3__sec_3_15__ssec_3_15_4__para_5
GIVEN `the class teacher is absent` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `a school rhythmics lesson is held` `the class teacher is absent` IF TRUE

-- akn:chp_3__sec_3_15__ssec_3_15_4/p1 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_15__ssec_3_15_4/p2 Source (אסמכתא): a Director-General's circular.

§§ `3.15.6 גמולים`

@ref akn:chp_3__sec_3_15__ssec_3_15_6_1__para_1
GIVEN y IS A `rhythmics year`
GIVETH A BOOLEAN
DECIDE `entitled to the split allowance for over-splitting` y IF
    y's `workplaces` AT LEAST 3

-- (2): the Ministry's best efforts — an undertaking of effort, not of
-- result: as few institutions as it can, at reasonable travel distances.
@ref akn:chp_3__sec_3_15__ssec_3_15_6_1__para_2
GIVETH A DEONTIC Party `rhythmics action`
DECIDE `the Ministry does its best in placing the rhythmics teacher` IS
    PARTY `the Ministry of Education`
    MUST  `place the rhythmics teacher in as few institutions as it can, at reasonable travel distances`

-- akn:chp_3__sec_3_15__ssec_3_15_6_1/p1 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_15__ssec_3_15_6_1/p2 Source (אסמכתא): a Director-General's circular.

-- Real travel expenses at public-transport fares, between institutions
-- included, paid on the basis of a request form.
@ref akn:chp_3__sec_3_15__ssec_3_15_6_2__para_1
GIVEN `public-transport fares of the journeys` IS A NUMBER @desc the fares of all journeys, between institutions included; an input
      , `she submitted a request form` IS A BOOLEAN
GIVETH A DEONTIC Party `rhythmics action`
DECIDE `travel expenses on request` `public-transport fares of the journeys` `she submitted a request form` IS
    IF `she submitted a request form`
    THEN PARTY `the employer`
         MUST  `pay travel expenses` a PROVIDED a AT LEAST `public-transport fares of the journeys`
    ELSE FULFILLED

-- akn:chp_3__sec_3_15__ssec_3_15_6_2/p1 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_15__ssec_3_15_6_2/p2 Source (אסמכתא): a Director-General's circular.

@ref akn:chp_3__sec_3_15__ssec_3_15_6_3__para_1
GIVEN y IS A `rhythmics year`
GIVETH A NUMBER
DECIDE `instrument fee` y IS
    IF y's `uses her own accordion or organ`
    THEN IF y's `the month is in the summer break`
         THEN 0
         ELSE y's `monthly fee for one position` TIMES min (y's `position fraction`) 1
    ELSE 0

-- akn:chp_3__sec_3_15__ssec_3_15_6_3/p1 Heading of the source list (אסמכתא).
-- akn:chp_3__sec_3_15__ssec_3_15_6_3/p2 Source (אסמכתא): a Director-General's circular, the collective agreement of 15.5.89 and a circular.

-- Examples (placeholder figures).
`a matriculated teacher with a Dalcroze course and 5 years` MEANS
    `rhythmics teacher record` WITH
        `graduate of a teachers' seminary for music`          IS FALSE
        `twelve years of schooling on entering the seminary`  IS FALSE
        `finished a music-educators' seminary or rhythmics track by תשכ"ח` IS FALSE
        `certified teacher or certified kindergarten teacher` IS FALSE
        `seminary graduate with a Dalcroze course from תשכ"ח on` IS FALSE
        `matriculation`                                       IS TRUE
        `twelve years of schooling`                           IS TRUE
        `finished a Dalcroze course by תשכ"ח`                 IS FALSE
        `finished a Dalcroze course`                          IS TRUE
        `years teaching rhythmics`                            IS 5

#ASSERT `rhythmics salary grade` `a matriculated teacher with a Dalcroze course and 5 years` EQUALS `the grade of an uncertified teacher`
#ASSERT `seniority for a past period` (`past work period` WITH `length in years` IS 4, `in institutions under Ministry supervision` IS FALSE, `weekly hours` IS 12, `confirmed by the supervision or owner` IS TRUE) EQUALS 2
#ASSERT `instrument fee` (`rhythmics year` WITH `workplaces` IS 3, `position fraction` IS 0.5, `uses her own accordion or organ` IS TRUE, `monthly fee for one position` IS 100, `the month is in the summer break` IS FALSE) EQUALS 50

#TRACE `not both lessons on one day` AT 0 WITH
    PARTY `the school principal` DOES `give both weekly lessons on one day` AT 3

-- F-3.15-a: supervised work of under 10 weekly hours falls under neither
-- sub-clause of 3.15.3(3).
`supervised work of 8 weekly hours is under neither sub-clause` MEANS
    NOT `a sub-clause of 3.15.3(3) governs the period` (`past work period` WITH `length in years` IS 3, `in institutions under Ministry supervision` IS TRUE, `weekly hours` IS 8, `confirmed by the supervision or owner` IS TRUE)
#ASSERT `supervised work of 8 weekly hours is under neither sub-clause`

§§ `Property checks`

-- The section's rules over their whole finite space: every rhythmics
-- teacher (a graduate of a music teachers' seminary or not, twelve years
-- of schooling on entering a seminary or not, a seminary or track finished
-- by תשכ"ח or not, certified or not, a seminary graduate or not, a
-- Dalcroze course never, by תשכ"ח or from it on, matriculation or not,
-- twelve years of schooling or not, 0 to 10 years teaching rhythmics —
-- 4,224 teachers); every past period of 0 to 5 years, under supervision
-- or not, of 0 to 30 weekly hours, confirmed or not; 0 to 10 years of work;
-- 0 to 5 workplaces; positions of 0 to 2 by quarters, with a fee of 100 (a
-- placeholder), in the summer break or not.

`both booleans` MEANS LIST TRUE, FALSE
`the positions checked` MEANS map (GIVEN k YIELD k DIVIDED BY 4) (range 0 8)

-- A Dalcroze course: 0 never, 1 finished by תשכ"ח, 2 from תשכ"ח on. The
-- course fields follow from it, so no teacher holds a course "by תשכ"ח"
-- she never finished.
GIVEN music IS A BOOLEAN, entering IS A BOOLEAN, track IS A BOOLEAN, certified IS A BOOLEAN,
      seminary IS A BOOLEAN, dalcroze IS A NUMBER, matric IS A BOOLEAN, twelve IS A BOOLEAN, yrs IS A NUMBER
GIVETH A `rhythmics teacher record`
DECIDE `a checked rhythmics teacher` music entering track certified seminary dalcroze matric twelve yrs IS
    `rhythmics teacher record` WITH
        `graduate of a teachers' seminary for music`          IS music
        `twelve years of schooling on entering the seminary`  IS entering
        `finished a music-educators' seminary or rhythmics track by תשכ"ח` IS track
        `certified teacher or certified kindergarten teacher` IS certified
        `seminary graduate with a Dalcroze course from תשכ"ח on` IS seminary AND dalcroze EQUALS 2
        `matriculation`                                       IS matric
        `twelve years of schooling`                           IS twelve
        `finished a Dalcroze course by תשכ"ח`                 IS dalcroze EQUALS 1
        `finished a Dalcroze course`                          IS dalcroze AT LEAST 1
        `years teaching rhythmics`                            IS yrs

GIVEN prop IS A FUNCTION FROM `rhythmics teacher record` TO BOOLEAN
GIVETH A BOOLEAN
DECIDE `holds for every rhythmics teacher` prop IF
    all (GIVEN music YIELD
            all (GIVEN entering YIELD
                    all (GIVEN track YIELD
                            all (GIVEN certified YIELD
                                    all (GIVEN seminary YIELD
                                            all (GIVEN dalcroze YIELD
                                                    all (GIVEN matric YIELD
                                                            all (GIVEN twelve YIELD
                                                                    all (GIVEN yrs YIELD
                                                                            prop (`a checked rhythmics teacher` music entering track certified seminary dalcroze matric twelve yrs))
                                                                        (range 0 10))
                                                                `both booleans`)
                                                        `both booleans`)
                                                (range 0 2))
                                        `both booleans`)
                                `both booleans`)
                        `both booleans`)
                `both booleans`)
        `both booleans`

-- 1(d) and 2(a) never meet: the one needs 7 years and more, the other
-- fewer. 3(c): the seniority of a teacher under 1(d) is never negative and
-- never more than her years, and is 3 less wherever she has 3.
GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `1(d) and 2(a) are apart, and 3(c) is bounded` t IF
        NOT (`route 1(d)` t AND `deemed an uncertified teacher` t)
    AND all (GIVEN w YIELD
                    `seniority of a teacher under 1(d)` t w AT LEAST 0
                AND `seniority of a teacher under 1(d)` t w AT MOST w
                AND ((NOT `route 1(d)` t) OR w LESS THAN 3
                     OR `seniority of a teacher under 1(d)` t w EQUALS w MINUS 3))
            (range 0 10)
#ASSERT `holds for every rhythmics teacher` `1(d) and 2(a) are apart, and 3(c) is bounded`

-- F-3.15-b: (1) and 2(a) both decide a teacher exactly when she is
-- entitled to the certified grade and also has matriculation, a Dalcroze
-- course and fewer than 7 years; the grade then follows (1).
GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `(1) and 2(a) meet exactly on a certified-grade teacher 2(a) also describes` t IF
        `(1) and 2(a) meet on` t EQUALS `2(a) describes a matriculated Dalcroze teacher under 7 years from (1)` t
    AND `the certified grade follows (1)` t

GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `(1) and 2(a) meet on` t IF
        `entitled to the grade of a certified teacher` t
    AND `deemed an uncertified teacher` t

GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `2(a) describes a matriculated Dalcroze teacher under 7 years from (1)` t IF
        (`route 1(a)` t OR `route 1(b)` t OR `route 1(c)` t)
    AND t's `matriculation`
    AND t's `finished a Dalcroze course`
    AND t's `years teaching rhythmics` LESS THAN 7

GIVEN t IS A `rhythmics teacher record`
GIVETH A BOOLEAN
DECIDE `the certified grade follows (1)` t IF
        (NOT `entitled to the grade of a certified teacher` t)
    OR `rhythmics salary grade` t EQUALS `the grade of a certified teacher`
#ASSERT `holds for every rhythmics teacher` `(1) and 2(a) meet exactly on a certified-grade teacher 2(a) also describes`

`a certified teacher with a Dalcroze course from תשכ"ח on, matriculation and 5 years` MEANS
    `a checked rhythmics teacher` FALSE FALSE FALSE TRUE TRUE 2 TRUE TRUE 5

`(1) gives the certified grade to a teacher 2(a) deems uncertified` MEANS
        `route 1(c)` `a certified teacher with a Dalcroze course from תשכ"ח on, matriculation and 5 years`
    AND `deemed an uncertified teacher` `a certified teacher with a Dalcroze course from תשכ"ח on, matriculation and 5 years`
#ASSERT `(1) gives the certified grade to a teacher 2(a) deems uncertified`

-- 3 over every past period: the seniority is never negative and never
-- more than the period. Against monotonicity, the same work counts for
-- less under the Ministry's supervision than outside it exactly where the
-- period has any length and is under 10 weekly hours (F-3.15-a) or not
-- confirmed (F-3.15-c).
GIVEN len IS A NUMBER, sup IS A BOOLEAN, hours IS A NUMBER, conf IS A BOOLEAN
GIVETH A `past work period`
DECIDE `a checked past period` len sup hours conf IS
    `past work period` WITH
        `length in years`                      IS len
        `in institutions under Ministry supervision` IS sup
        `weekly hours`                         IS hours
        `confirmed by the supervision or owner` IS conf

#ASSERT all (GIVEN len YIELD
                all (GIVEN hours YIELD
                        all (GIVEN conf YIELD
                                    all (GIVEN sup YIELD
                                                `seniority for a past period` (`a checked past period` len sup hours conf) AT LEAST 0
                                            AND `seniority for a past period` (`a checked past period` len sup hours conf) AT MOST len
                                            AND (NOT `a sub-clause of 3.15.3(3) governs the period` (`a checked past period` len sup hours conf))
                                                EQUALS (sup AND hours LESS THAN 10))
                                        `both booleans`
                                AND (   `seniority for a past period` (`a checked past period` len TRUE hours conf)
                                     LESS THAN `seniority for a past period` (`a checked past period` len FALSE hours conf))
                                    EQUALS (len GREATER THAN 0 AND (hours LESS THAN 10 OR NOT conf)))
                            `both booleans`)
                    (range 0 30))
            (range 0 5)

`four unconfirmed years of 12 weekly hours` MEANS `a checked past period` 4 TRUE 12 FALSE
`the same four years outside supervision` MEANS `a checked past period` 4 FALSE 12 FALSE

`an unconfirmed period counts for more outside supervision than under it` MEANS
        `seniority for a past period` `four unconfirmed years of 12 weekly hours` EQUALS 0
    AND `seniority for a past period` `the same four years outside supervision` EQUALS 2
#ASSERT `an unconfirmed period counts for more outside supervision than under it`

-- 3.15.1(3): the preparation is part of the lesson, never more than it.
#ASSERT all (GIVEN k YIELD
                `minutes of the lesson given to preparation and arrangements` k AT MOST `minutes of a rhythmics lesson`)
            `both booleans`

-- 3.15.6.1: the split allowance never lapses as the workplaces grow.
#ASSERT all (GIVEN n YIELD
                    `entitled to the split allowance for over-splitting` (`rhythmics year` WITH `workplaces` IS n, `position fraction` IS 1, `uses her own accordion or organ` IS FALSE, `monthly fee for one position` IS 100, `the month is in the summer break` IS FALSE)
                    EQUALS (n AT LEAST 3))
            (range 0 5)

-- 3.15.6.3 over every position, instrument and month: the fee is never
-- negative, never more than one position's, nothing in the summer break or
-- without her own instrument, and never less for a larger position.
GIVEN f IS A NUMBER, own IS A BOOLEAN, summer IS A BOOLEAN
GIVETH A `rhythmics year`
DECIDE `a checked rhythmics month` f own summer IS
    `rhythmics year` WITH
        `workplaces`                IS 1
        `position fraction`         IS f
        `uses her own accordion or organ` IS own
        `monthly fee for one position` IS 100
        `the month is in the summer break` IS summer

#ASSERT all (GIVEN f YIELD
                all (GIVEN own YIELD
                        all (GIVEN summer YIELD
                                    `instrument fee` (`a checked rhythmics month` f own summer) AT LEAST 0
                                AND `instrument fee` (`a checked rhythmics month` f own summer) AT MOST 100
                                AND ((own AND NOT summer) OR `instrument fee` (`a checked rhythmics month` f own summer) EQUALS 0)
                                AND `instrument fee` (`a checked rhythmics month` (f PLUS 0.25) own summer)
                                    AT LEAST `instrument fee` (`a checked rhythmics month` f own summer))
                            `both booleans`)
                    `both booleans`)
            `the positions checked`
