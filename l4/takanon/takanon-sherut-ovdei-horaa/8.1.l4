-- תקנון שירות עובדי הוראה, פרק 8, §8.1 מורים וגננות בתפקידי הדרכה
-- Teachers and kindergarten teachers in guidance roles: the work unit and
-- schedule, the teaching they must keep, leave, appointment and its term,
-- the guide's role, seniority, and the guidance, per-diem, car, telephone
-- and kindergarten allowances.

IMPORT prelude
IMPORT common

GIVEN d IS A DATE, e IS A DATE
GIVETH A BOOLEAN
DECIDE d `is on or after` e IF
    DATE_SERIAL d AT LEAST DATE_SERIAL e

§ `8.1 מורים וגננות בתפקידי הדרכה`

@desc The actors section 8.1 names that the takanon's common vocabulary does not.
DECLARE `8.1 party` IS ONE OF
    `a takanon party`               HAS `who` IS A Party
    `the guide's superior`          @desc the guide's line superior (הממונה)
    `the appointing signatory`      @desc whoever signed the letter of appointment, or one authorised by him for this purpose
    `the guidance bureau`           @desc לשכת ההדרכה
    `the ministry's accountant`     @desc חשב המשרד

DECLARE `8.1 action` IS ONE OF
    `work on a day not assigned`
    `report the work on the per-diem form`
    `approve the report`
    `work a permanent split position`
    `teach in a school` HAS `teaching days a week` IS A NUMBER
    `use the annual leave` HAS `days used` IS A NUMBER
    `carry leave over`
    `encourage development and mentoring frameworks for guides during their work`
    `examine the possibility of a kilometre quota under private-car terms`
    `make pension-fund contributions on the guidance allowance`

@desc The sectors of education section 8.1 distinguishes.
DECLARE `guide's sector` IS ONE OF
    `state`, `state-religious`, `Druze`, `Arab`

@desc A guide's employment in the role, for the term rules of section 8.1.2.2.
DECLARE `guidance term` HAS
    `years in the role`                 IS A NUMBER
    `years in the role consecutively`   IS A NUMBER
    `guidance position fraction`        IS A NUMBER
    `kind`                              IS A `kind of guidance`
    `trained suitably in the last five years` IS A BOOLEAN
    `extension approved by the district manager or the bureau head` IS A BOOLEAN
    `the ministry's accountant consents` IS A BOOLEAN
    `guidance in teaching subjects or educational topics` IS A BOOLEAN

DECLARE `guide's role action` IS ONE OF
    `carry out` HAS `role duty carried out` IS A `guide's role duty`
    `adapt the guidance to the institution's needs`


-- akn:chp_8__sec_8_1/p2 Heading of section 8.1.1 ("יחידת עבודה וחופשות").

§§ `8.1.1 יחידת עבודה וחופשות`

@ref akn:chp_8__sec_8_1/p3
GIVETH A NUMBER
DECIDE `guide's weekly work unit` IS 42.5

@desc One row of section 8.1.1's schedule: days of guidance a week, the share of the position, and hours a day.
DECLARE `guidance days row` HAS
    `guidance days`   IS A NUMBER
    `position share`  IS A NUMBER
    `hours a day`     IS A NUMBER

@ref akn:chp_8__sec_8_1/p4
`one day of guidance` MEANS `guidance days row` 1 (1/6) 7
@ref akn:chp_8__sec_8_1/p5
`two days of guidance` MEANS `guidance days row` 2 (2/6) 7
@ref akn:chp_8__sec_8_1/p6
`three days of guidance` MEANS `guidance days row` 3 (3/6) 7
@ref akn:chp_8__sec_8_1/p7
`four days of guidance` MEANS `guidance days row` 4 (4/6) 7
@ref akn:chp_8__sec_8_1/p8
`five days of guidance` MEANS `guidance days row` 5 (5/5) 8.5

-- A full position of teaching and guidance is assigned over 5 days, or 6
-- if the teacher agrees.
@ref akn:chp_8__sec_8_1/p9
GIVEN `agrees to six days` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `days a full position is assigned over` `agrees to six days` IS
    IF `agrees to six days` THEN 6 ELSE 5

-- A guide assigned on certain days works only on those days. One forced to
-- do part of the role on a day he is not assigned reports it on the
-- per-diem form, and his superior may approve the report only where the
-- case was not foreseeable in advance. The text sets no time for either.
@ref akn:chp_8__sec_8_1/p9
GIVEN `forced to do part of the role on that day` IS A BOOLEAN, `the case was foreseeable in advance` IS A BOOLEAN
GIVETH A DEONTIC `8.1 party` `8.1 action`
DECIDE `work on a day the guide is not assigned` `forced to do part of the role on that day` `the case was foreseeable in advance` IS
    IF `forced to do part of the role on that day`
    THEN PARTY `a takanon party` `the teaching employee`
         MUST  `report the work on the per-diem form`
         HENCE (IF `the case was foreseeable in advance`
                THEN PARTY `the guide's superior`
                     SHANT `approve the report`
                     LEST BREACH BY `the guide's superior` BECAUSE "section 8.1.1.1: only work in a case not foreseeable in advance may be approved"
                ELSE PARTY `the guide's superior`
                     MAY   `approve the report`)
    ELSE PARTY `a takanon party` `the teaching employee`
         SHANT `work on a day not assigned`
         LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "section 8.1.1.1: a guide works only on the days he is assigned"

-- A guide who asks to work permanently in a split position beyond his
-- assigned days needs the prior approval of whoever signed the letter of
-- appointment (or one he authorised for this alone), in coordination with
-- the direct professional superior.
@ref akn:chp_8__sec_8_1/p9
GIVEN `approved in advance by the appointment's signatory in coordination with the direct professional superior` IS A BOOLEAN
GIVETH A DEONTIC `8.1 party` `8.1 action`
DECIDE `a permanent split position beyond the assigned days` `approved in advance by the appointment's signatory in coordination with the direct professional superior` IS
    IF `approved in advance by the appointment's signatory in coordination with the direct professional superior`
    THEN PARTY `a takanon party` `the teaching employee`
         MAY   `work a permanent split position`
    ELSE PARTY `a takanon party` `the teaching employee`
         SHANT `work a permanent split position`
         LEST  BREACH BY `a takanon party` `the teaching employee` BECAUSE "section 8.1.1.1: a permanent split position needs approval in advance"

@desc The kinds of guidance section 8.1.1(2) distinguishes: the four it exempts from teaching, and any other.
@ref akn:chp_8__sec_8_1/p10
DECLARE `kind of guidance` IS ONE OF
    `ordinary guidance`
    @ref akn:chp_8__sec_8_1/p11
    `guidance in assistive or remedial-differential teaching`
    @ref akn:chp_8__sec_8_1/p12
    `guiding a kindergarten teacher in a guidance role`
    @ref akn:chp_8__sec_8_1/p13
    `guidance in special subjects that are not teaching subjects`
    @ref akn:chp_8__sec_8_1/p14
    `guidance in a sabbatical or study year`

@ref akn:chp_8__sec_8_1/p10
GIVEN k IS A `kind of guidance`
GIVETH A BOOLEAN
DECIDE `must also teach` k IF
    k EQUALS `ordinary guidance`

-- At least two days a week (1/3 of a position) of actual teaching in a
-- school alongside the guidance, except for the four kinds above. The duty
-- is a weekly measure, not a deadline.
@ref akn:chp_8__sec_8_1/p10
GIVEN k IS A `kind of guidance`
GIVETH A DEONTIC `8.1 party` `8.1 action`
DECIDE `the guide keeps teaching` k IS
    IF `must also teach` k
    THEN PARTY `a takanon party` `the teaching employee`
         MUST  `teach in a school` d PROVIDED d AT LEAST 2
    ELSE FULFILLED

-- 26 leave days a year and 10 holiday days, pro rata to the position.
@ref akn:chp_8__sec_8_1/p15
GIVEN `position fraction` IS A NUMBER
GIVETH A NUMBER
DECIDE `guide's annual leave days` `position fraction` IS
    26 TIMES `position fraction`

@ref akn:chp_8__sec_8_1/p15
DECLARE `guide's holiday` IS ONE OF
    `Rosh Hashana eve`, `Yom Kippur eve`, `Sukkot eve`, `Passover eve`, `Shavuot eve`,
    `the intermediate days of Passover`

@ref akn:chp_8__sec_8_1/p15
GIVEN `position fraction` IS A NUMBER
GIVETH A NUMBER
DECIDE `guide's holiday leave days` `position fraction` IS
    10 TIMES `position fraction`

-- The annual leave is used by 31 August — the twelfth school month — and
-- cannot be carried over, the role being temporary; the prohibition on
-- carrying it has no time limit.
@ref akn:chp_8__sec_8_1/p15
GIVEN `position fraction` IS A NUMBER
GIVETH A DEONTIC `8.1 party` `8.1 action`
DECIDE `use the leave by 31 August` `position fraction` IS
    (PARTY `a takanon party` `the teaching employee`
     MAY   `use the annual leave` d PROVIDED d AT MOST `guide's annual leave days` `position fraction`
     WITHIN `month number` August)
    RAND
    (PARTY `a takanon party` `the teaching employee`
     SHANT `carry leave over`
     LEST BREACH BY `a takanon party` `the teaching employee` BECAUSE "section 8.1.1.3: a guide's leave cannot be accumulated")

-- akn:chp_8__sec_8_1/p16 Heading of the source list (אסמכתא).
-- akn:chp_8__sec_8_1/p17 Source: director-general's circulars.

§§§ `8.1.1 The schedule read as a whole (F-8.1-a)`

`the guidance-days schedule` MEANS
    LIST `one day of guidance`, `two days of guidance`, `three days of guidance`,
         `four days of guidance`, `five days of guidance`

-- The share of the position is read off the fraction column (F-8.1-a).
GIVEN days IS A NUMBER
GIVETH A NUMBER
DECIDE `position share for guidance days` days IS
    sum (map (GIVEN r YIELD r's `position share`)
             (filter (GIVEN r YIELD r's `guidance days` EQUALS days) `the guidance-days schedule`))

-- F-8.1-a: a day is 1/6 of the position by the fraction column, but 7 hours
-- of a 42.5-hour unit by the hours column; and five days of 8.5 hours make
-- the full 42.5 while four of 7 make 4/6 of it.
GIVEN r IS A `guidance days row`
GIVETH A NUMBER
DECIDE `share by the hours column` r IS
    r's `guidance days` TIMES r's `hours a day` DIVIDED BY `guide's weekly work unit`

`a day of guidance is 1/6 of the position by one column and 7/42.5 by the other` MEANS
    NOT (`share by the hours column` `one day of guidance` EQUALS `one day of guidance`'s `position share`)
#ASSERT `a day of guidance is 1/6 of the position by one column and 7/42.5 by the other`

-- The five-day row agrees with the unit: 5 x 8.5 = 42.5.
#ASSERT `share by the hours column` `five days of guidance` EQUALS 1

§§ `8.1.2 מינוי`

-- akn:chp_8__sec_8_1/p18 Heading of section 8.1.2 ("מינוי").

@desc A candidate for a guidance role, as section 8.1.2 screens one.
DECLARE `guidance candidate` HAS
    `specialised in the professional and pedagogical field` IS A BOOLEAN
    `years of teaching`                                    IS A NUMBER
    `holds at least a first degree in the broad field`     IS A BOOLEAN
    `holds training recognised by the guidance bureau`     IS A BOOLEAN
    `committed to a recognised training course`            IS A BOOLEAN
    `new to guidance`                                      IS A BOOLEAN
    `approved by the exceptional-employment committee`     IS A BOOLEAN

@ref akn:chp_8__sec_8_1/p19 akn:chp_8__sec_8_1/p20 akn:chp_8__sec_8_1/p21 akn:chp_8__sec_8_1/p22
GIVEN c IS A `guidance candidate`
GIVETH A BOOLEAN
DECIDE `passes the guidance screening` c IF
        c's `specialised in the professional and pedagogical field`
    AND c's `years of teaching` AT LEAST 4
    AND c's `holds at least a first degree in the broad field`
    AND c's `holds training recognised by the guidance bureau`

-- The guidance bureau is the body that examines and approves training
-- programmes for the role.
@ref akn:chp_8__sec_8_1/p23
GIVETH AN `8.1 party`
DECIDE `who approves training programmes for guides` IS `the guidance bureau`

@ref akn:chp_8__sec_8_1/p24
GIVEN c IS A `guidance candidate`
GIVETH A BOOLEAN
DECIDE `a preferred candidate` c IF
    c's `committed to a recognised training course`

@ref akn:chp_8__sec_8_1/p25
DECLARE `training-course focus` IS ONE OF
    `approaches and attitudes`
    `guidance skills`
    `knowledge of the field of specialisation`

@ref akn:chp_8__sec_8_1/p26
GIVETH A DEONTIC `8.1 party` `8.1 action`
DECIDE `the system encourages guides' development` IS
    PARTY `a takanon party` `the Ministry of Education`
    MUST  `encourage development and mentoring frameworks for guides during their work`

-- (ד): a district guide is hired BY the district manager, in coordination
-- with the subject's chief supervisor or the field's head, and in
-- state-religious education with the approval of its head; in the Druze and
-- Arab sectors with the consent of those in charge of them. A national
-- guide is hired with the consent of the supervisor in charge of the
-- subject or field and of the guidance bureau's head, for the pedagogical
-- secretariat.
@desc Who takes part in hiring a guide, and in what capacity (section 8.1.2.1(d)).
@ref akn:chp_8__sec_8_1/p27 akn:chp_8__sec_8_1/p28 akn:chp_8__sec_8_1/p29
DECLARE `part in hiring a guide` IS ONE OF
    `the district manager, who hires`
    `the subject's chief supervisor or the field's head, in coordination`
    `the head of state-religious education, who approves`
    `those in charge of the sector, with whose consent`
    `the supervisor in charge of the subject or field, who consents`
    `the head of the guidance bureau, who consents for the pedagogical secretariat`

@ref akn:chp_8__sec_8_1/p27 akn:chp_8__sec_8_1/p28 akn:chp_8__sec_8_1/p29
GIVEN `national guide` IS A BOOLEAN, s IS A `guide's sector`
GIVETH A LIST OF `part in hiring a guide`
DECIDE `who takes part in hiring a guide` `national guide` s IS
    IF `national guide`
    THEN LIST `the supervisor in charge of the subject or field, who consents`, `the head of the guidance bureau, who consents for the pedagogical secretariat`
    ELSE CONSIDER s
         WHEN `state`           THEN LIST `the district manager, who hires`, `the subject's chief supervisor or the field's head, in coordination`
         WHEN `state-religious` THEN LIST `the district manager, who hires`, `the subject's chief supervisor or the field's head, in coordination`, `the head of state-religious education, who approves`
         WHEN `Druze`           THEN LIST `the district manager, who hires`, `the subject's chief supervisor or the field's head, in coordination`, `those in charge of the sector, with whose consent`
         WHEN `Arab`            THEN LIST `the district manager, who hires`, `the subject's chief supervisor or the field's head, in coordination`, `those in charge of the sector, with whose consent`

-- From תשנ"ח a new guide holds at least a first degree; an experienced guide
-- without one goes to the committee for exceptional employment of guides.
@ref akn:chp_8__sec_8_1/p30
GIVEN c IS A `guidance candidate`
GIVETH A BOOLEAN
DECIDE `meets the degree rule from 1997-98` c IF
        c's `holds at least a first degree in the broad field`
    OR ((NOT c's `new to guidance`) AND c's `approved by the exceptional-employment committee`)

@ref akn:chp_8__sec_8_1/p31
GIVETH A BOOLEAN
DECIDE `work in a guidance role is partial and temporary` IF TRUE

@ref akn:chp_8__sec_8_1/p31
GIVETH A NUMBER
DECIDE `length of one guidance appointment in years` IS 1

@ref akn:chp_8__sec_8_1/p32
GIVETH A BOOLEAN
DECIDE `a guidance appointment carries tenure` IS FALSE

-- F-8.1-c: (a) caps the employment at "more than 6 years", (b) speaks of
-- "more than six CONSECUTIVE years", (c) of "six consecutive school years".
-- Reading adopted: the cap is on consecutive years.
@ref akn:chp_8__sec_8_1/p33
GIVEN t IS A `guidance term`
GIVETH A BOOLEAN
DECIDE `an extension beyond six years is allowed` t IF
        t's `extension approved by the district manager or the bureau head`
    AND t's `the ministry's accountant consents`
    AND t's `guidance in teaching subjects or educational topics`
    AND t's `trained suitably in the last five years`

@ref akn:chp_8__sec_8_1/p31
GIVEN t IS A `guidance term`
GIVETH A BOOLEAN
DECIDE `the employment is within the term rules` t IF
    t's `years in the role consecutively` AT MOST 6 OR `an extension beyond six years is allowed` t

GIVEN t IS A `guidance term`
GIVETH A BOOLEAN
DECIDE `the employment is within the term rules if the cap counts all years` t IF
    t's `years in the role` AT MOST 6 OR `an extension beyond six years is allowed` t

`a guide of eight years in two spells of four` MEANS
    `guidance term` WITH
        `years in the role`               IS 8
        `years in the role consecutively` IS 4
        `guidance position fraction`      IS 0.5
        `kind`                            IS `ordinary guidance`
        `trained suitably in the last five years` IS FALSE
        `extension approved by the district manager or the bureau head` IS FALSE
        `the ministry's accountant consents` IS FALSE
        `guidance in teaching subjects or educational topics` IS TRUE

`the six-year cap gives two answers for a guide of broken service` MEANS
    NOT (`the employment is within the term rules` `a guide of eight years in two spells of four`
         EQUALS `the employment is within the term rules if the cap counts all years` `a guide of eight years in two spells of four`)
#ASSERT `the six-year cap gives two answers for a guide of broken service`

-- Sections 13-15 of the Civil Service (Appointments) Law do not apply to a
-- guide posted for a fixed term of at most six consecutive school years,
-- provided the guidance is at most half the position (unless it is
-- assistive or remedial-differential teaching).
@ref akn:chp_8__sec_8_1/p34
GIVEN t IS A `guidance term`
GIVETH A BOOLEAN
DECIDE `sections 13 to 15 of the appointments law do not apply` t IF
        t's `years in the role consecutively` AT MOST 6
    AND (   t's `guidance position fraction` AT MOST 0.5
         OR t's `kind` EQUALS `guidance in assistive or remedial-differential teaching`)

@desc The committee that decides on appointing a guide for more than one consecutive year.
@ref akn:chp_8__sec_8_1/p35 akn:chp_8__sec_8_1/p36 akn:chp_8__sec_8_1/p37
DECLARE `multi-year committee member` IS ONE OF
    `the district guidance referent, as chair`
    `the head of the guidance bureau, as chair`
    `the guide's direct supervisor`
    `a further person set by the district manager`
    `a further person set by the chair`
    `the sector's representative`

@ref akn:chp_8__sec_8_1/p35 akn:chp_8__sec_8_1/p36 akn:chp_8__sec_8_1/p37
GIVEN `national guide` IS A BOOLEAN, `in a sector` IS A BOOLEAN @desc state-religious, Arab or Druze education
GIVETH A LIST OF `multi-year committee member`
DECIDE `the multi-year appointment committee` `national guide` `in a sector` IS
    LET core MEANS
        IF `national guide`
        THEN LIST `the head of the guidance bureau, as chair`, `the guide's direct supervisor`, `a further person set by the chair`
        ELSE LIST `the district guidance referent, as chair`, `the guide's direct supervisor`, `a further person set by the district manager`
    IN IF `in a sector`
       THEN append core (LIST `the sector's representative`)
       ELSE core

-- akn:chp_8__sec_8_1/p38 Heading of the source list (אסמכתא).
-- akn:chp_8__sec_8_1/p39 Source: a special director-general's circular.
-- akn:chp_8__sec_8_1/p40 Source: a director-general's circular.
-- akn:chp_8__sec_8_1/p41 Source: a director-general's circular.
-- akn:chp_8__sec_8_1/p42 Source: Yalkut HaPirsumim 4737 of 15.3.99.
-- akn:chp_8__sec_8_1/p43 Source: Yalkut HaPirsumim 4011.

§§ `8.1.3 הגדרת תפקידים`

-- akn:chp_8__sec_8_1/p44 Heading of section 8.1.3 ("הגדרת תפקידים").
-- akn:chp_8__sec_8_1/p45 Heading ("הגדרות") of the two definitions below.

@ref akn:chp_8__sec_8_1/p46 akn:chp_8__sec_8_1/p47
DECLARE `who the guidance circular means` IS ONE OF
    `a teacher or kindergarten teacher in a guidance role`  @desc "מורה" includes a kindergarten teacher; "מדריך" stands for a teacher or kindergarten teacher in a guidance role

@desc The purposes of guidance (section 8.1.3(1), "מהות ההדרכה").
@ref akn:chp_8__sec_8_1/p48
DECLARE `purpose of guidance` IS ONE OF
    @ref akn:chp_8__sec_8_1/p49
    `improve the quality of teaching and pupils' achievements, in basic skills and curricula`
    @ref akn:chp_8__sec_8_1/p50
    `advance new programmes and alternative methods, and help correct shortcomings`
    @ref akn:chp_8__sec_8_1/p51
    `strengthen teachers' autonomy by partnership, not by supervision`

@desc The topics the guidance system works in (section 8.1.3(2), "נושאי ההדרכה").
@ref akn:chp_8__sec_8_1/p52
DECLARE `guidance topic` IS ONE OF
    @ref akn:chp_8__sec_8_1__ssec_2_1/p1
    `subjects, curricula and teaching methods`
    @ref akn:chp_8__sec_8_1__ssec_2_1/p2
    `study, organisational and educational-values topics, informal education included`
    @ref akn:chp_8__sec_8_1__ssec_2_1/p3
    `teachers' personal and team development for school pedagogical policy`

@ref akn:chp_8__sec_8_1__ssec_2_2
DECLARE `stage of education` IS ONE OF
    `pre-primary`, `primary`, `post-primary`

@ref akn:chp_8__sec_8_1__ssec_2_2
GIVEN s IS A `stage of education`, k IS A `guide's sector`
GIVETH A BOOLEAN
DECIDE `guidance is given at` s k IF TRUE

-- Guidance is given separately in state-religious education (and in the
-- Druze and Arab sectors) where its curriculum differs or the subject has a
-- separate chief supervisor.
@ref akn:chp_8__sec_8_1__ssec_2_3
GIVEN `curriculum differs` IS A BOOLEAN, `separate chief supervisor` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `guidance is given separately` `curriculum differs` `separate chief supervisor` IF
    `curriculum differs` OR `separate chief supervisor`

@desc The guide's duties (section 8.1.3(3.1)).
@ref akn:chp_8__sec_8_1__ssec_3_1_1
DECLARE `guide's role duty` IS ONE OF
    `teachers' professional-pedagogical development, toward autonomy`
    @ref akn:chp_8__sec_8_1__ssec_3_1_2
    `tools to identify and diagnose educational needs`
    @ref akn:chp_8__sec_8_1__ssec_3_1_3
    `help teachers know the curriculum and adapt methods to it`
    @ref akn:chp_8__sec_8_1__ssec_3_1_4
    `help absorb and advance new and immigrant teachers`
    @ref akn:chp_8__sec_8_1__ssec_3_1_5
    `foster the use of didactic aids`
    @ref akn:chp_8__sec_8_1__ssec_3_1_6
    `encourage initiative and innovation`

-- Each duty is the guide's. The text sets no time for them.
@ref akn:chp_8__sec_8_1__ssec_3_1_1 akn:chp_8__sec_8_1__ssec_3_1_2 akn:chp_8__sec_8_1__ssec_3_1_3 akn:chp_8__sec_8_1__ssec_3_1_4 akn:chp_8__sec_8_1__ssec_3_1_5 akn:chp_8__sec_8_1__ssec_3_1_6
GIVEN d IS A `guide's role duty`
GIVETH A DEONTIC Party `guide's role action`
DECIDE `the guide's role` d IS
    PARTY `the teaching employee`
    MUST  `carry out` x PROVIDED x EQUALS d

@desc The guide's ways of working (section 8.1.3(3.2)): the means of the guidance, not further duties.
@ref akn:chp_8__sec_8_1__ssec_3_2_1
DECLARE `guide's way of working` IS ONE OF
    `individual and group guidance`
    @ref akn:chp_8__sec_8_1__ssec_3_2_2
    `open demonstration lessons with guidance discussion`
    @ref akn:chp_8__sec_8_1__ssec_3_2_3
    `plan and run study days`
    @ref akn:chp_8__sec_8_1__ssec_3_2_4
    `foster teams of peer teachers`
    @ref akn:chp_8__sec_8_1__ssec_3_2_5
    `encourage cooperation between institutions (a school cluster)`
    @ref akn:chp_8__sec_8_1__ssec_3_2_6
    `create awareness of and ties to resources inside and outside the ministry`

-- Guidance is differential, varied in fields and methods, and adapted as
-- far as possible to the institutions' needs.
@ref akn:chp_8__sec_8_1__ssec_3_2_6/p1
GIVETH A DEONTIC Party `guide's role action`
DECIDE `differential guidance` IS
    PARTY `the teaching employee`
    MUST  `adapt the guidance to the institution's needs`

-- akn:chp_8__sec_8_1__ssec_3_2_6/p2 Heading of the source list (אסמכתא).
-- akn:chp_8__sec_8_1__ssec_3_2_6/p3 Source: a special director-general's circular.

§§ `8.1.5 ותק בהדרכה`

@ref akn:chp_8__sec_8_1__ssec_8_1_5/p1
GIVEN `guidance position fraction` IS A NUMBER, `completes the position with teaching` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `the year counts as guidance seniority` `guidance position fraction` `completes the position with teaching` IF
    `guidance position fraction` AT LEAST 1/6 AND `completes the position with teaching`

-- akn:chp_8__sec_8_1__ssec_8_1_5/p2 Heading of the source list (אסמכתא).
-- akn:chp_8__sec_8_1__ssec_8_1_5/p3 Source: a director-general's circular.

§§ `8.1.6 גמולים`

§§§ `8.1.6.1 גמול הדרכה וגמול הכשרות`

@desc A teacher in a guidance role in one month, as section 8.1.6.1 asks about it.
DECLARE `guide` HAS
    `personal combined salary`        IS A NUMBER @desc an input
    `guidance position fraction`      IS A NUMBER
    `actually in the role`            IS A BOOLEAN
    `holds an academic degree`        IS A BOOLEAN
    `years in guidance since 1.9.83`  IS A NUMBER
    `a pensioner`                     IS A BOOLEAN
    `instructor table rate`           IS A NUMBER @desc the rate section 8.3.6's table sets for an instructor; that table is not in the text, so an input

-- The salary itself follows the teachers' table by education and
-- seniority (outside this section); the guidance allowance is on top and is
-- paid only while the role is actually held.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_1/p1
GIVEN g IS A `guide`
GIVETH A BOOLEAN
DECIDE `the guidance allowance is paid this month` g IF
    g's `actually in the role`

-- 43% of the personal combined salary, pro rata to the guidance position
-- up to one full position; fixed, not growing with seniority.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_1/p2
GIVEN g IS A `guide`
GIVETH A NUMBER
DECIDE `guidance allowance at 43%` g IS
    0.43 TIMES g's `personal combined salary` TIMES min (g's `guidance position fraction`) 1

@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_1/p2
GIVEN `the month` IS A DATE
GIVETH A BOOLEAN
DECIDE `the 43% applies in` `the month` IF
    `the month` `is on or after` (DATE_FROM_DMY 1 1 2001)

-- A guide with an academic degree, more than two years in guidance
-- (counted from 1.9.83, a limit that does not bind pensioners) and at least
-- 1/6 of a position "is entitled to the teacher-instructor allowance at the
-- rate set for an instructor" (section 8.3.6's table); and to the
-- qualifications allowance on the teaching part.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_1/p3
GIVEN g IS A `guide`
GIVETH A BOOLEAN
DECIDE `qualifies for the instructor rate` g IF
        g's `holds an academic degree`
    AND (g's `years in guidance since 1.9.83` GREATER THAN 2 OR g's `a pensioner`)
    AND g's `guidance position fraction` AT LEAST 1/6

@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_1/p3
GIVEN g IS A `guide`
GIVETH A NUMBER
DECIDE `guidance allowance at the instructor rate` g IS
    g's `instructor table rate` TIMES g's `personal combined salary` TIMES min (g's `guidance position fraction`) 1

@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_1/p3
GIVEN `the month` IS A DATE
GIVETH A BOOLEAN
DECIDE `the instructor-rate entitlement runs in` `the month` IF
    `the month` `is on or after` (DATE_FROM_DMY 1 9 1989)

-- "עובד הוראה כאמור": the qualifying guide also receives the
-- qualifications allowance (גמול הכשרות) on the teaching part of his work.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_1/p3
GIVEN g IS A `guide`
GIVETH A BOOLEAN
DECIDE `receives the qualifications allowance on the teaching part of his work` g IF
    `qualifies for the instructor rate` g

-- F-8.1-b: for a guide who qualifies under paragraph 1's third part, the
-- second part fixes 43% and the third part the instructor's table rate.
-- Reading adopted: the fixed 43% (from 1.1.01) governs, the teacher-
-- instructor allowance the third part names being fixed at 43% by section 8.2.6.
GIVEN g IS A `guide`
GIVETH A NUMBER
DECIDE `guidance allowance` g IS
    IF `the guidance allowance is paid this month` g
    THEN `guidance allowance at 43%` g
    ELSE 0

`a guide with a degree and five years` MEANS
    `guide` WITH
        `personal combined salary`       IS 10000
        `guidance position fraction`     IS 0.5
        `actually in the role`           IS TRUE
        `holds an academic degree`       IS TRUE
        `years in guidance since 1.9.83` IS 5
        `a pensioner`                    IS FALSE
        `instructor table rate`          IS 0.5

`the 43% and the instructor rate give a qualified guide different allowances` MEANS
        `qualifies for the instructor rate` `a guide with a degree and five years`
    AND NOT (`guidance allowance at 43%` `a guide with a degree and five years`
             EQUALS `guidance allowance at the instructor rate` `a guide with a degree and five years`)
#ASSERT `the 43% and the instructor rate give a qualified guide different allowances`

-- From 1.9.94 the guidance allowance enters the pension-determining salary
-- of a guide who received it for the last two years before retiring and
-- worked at least 1/3 of a position in the role; employers in an
-- accumulating pension fund also pay contributions on it.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_2
GIVEN `day of retirement` IS A DATE, `years received before retiring` IS A NUMBER, `guidance position fraction` IS A NUMBER
GIVETH A BOOLEAN
DECIDE `the guidance allowance enters the pension salary` `day of retirement` `years received before retiring` `guidance position fraction` IF
        (`day of retirement` `is on or after` (DATE_FROM_DMY 1 9 1994))
    AND `years received before retiring` AT LEAST 2
    AND `guidance position fraction` AT LEAST 1/3

-- An employer whose teaching employees are insured in an accumulating
-- pension fund also contributes to the fund on these allowances.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_2
GIVEN `the employees are insured in an accumulating pension fund` IS A BOOLEAN
GIVETH A DEONTIC `8.1 party` `8.1 action`
DECIDE `contributions on the guidance allowance` `the employees are insured in an accumulating pension fund` IS
    IF `the employees are insured in an accumulating pension fund`
    THEN PARTY `a takanon party` `the employer`
         MUST  `make pension-fund contributions on the guidance allowance`
    ELSE FULFILLED

-- From 1.9.01 service in a 1/6 guidance position counts for pension if the
-- total of teaching and guidance is at least 1/3 of a position and the
-- guide worked the last two years before retiring.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_3
GIVEN `day of retirement` IS A DATE, `guidance position fraction` IS A NUMBER, `total position fraction` IS A NUMBER, `worked the last two years` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `sixth-position guidance counts for pension` `day of retirement` `guidance position fraction` `total position fraction` `worked the last two years` IF
        (`day of retirement` `is on or after` (DATE_FROM_DMY 1 9 2001))
    AND `guidance position fraction` AT LEAST 1/6
    AND `total position fraction` AT LEAST 1/3
    AND `worked the last two years`

-- A guide not entitled to have the guidance allowance in the pension
-- salary, who held the role lawfully at retirement, receives the
-- qualifications allowance as a pension component for the guidance part too.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_1__para_4
GIVEN `allowance enters the pension salary` IS A BOOLEAN, `held the role lawfully at retirement` IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `qualifications allowance counts in pension for the guidance part` `allowance enters the pension salary` `held the role lawfully at retirement` IF
    (NOT `allowance enters the pension salary`) AND `held the role lawfully at retirement`

-- akn:chp_8__sec_8_1__ssec_8_1_6_1/p1 Heading of the source list (אסמכתא).
-- akn:chp_8__sec_8_1__ssec_8_1_6_1/p2 Source: a special director-general's circular.
-- akn:chp_8__sec_8_1__ssec_8_1_6_1/p3 Source: collective agreement of 18.12.01.
-- akn:chp_8__sec_8_1__ssec_8_1_6_1/p4 Source: collective agreement of 23.12.90.
-- akn:chp_8__sec_8_1__ssec_8_1_6_1/p5 Source: collective agreement of 15.5.89 and a supreme parity committee decision.
-- akn:chp_8__sec_8_1__ssec_8_1_6_1/p6 Source: a supreme parity committee decision of 21.4.85.
-- akn:chp_8__sec_8_1__ssec_8_1_6_1/p7 Source: collective agreement of 19.9.94 and wage-unit letters.
-- akn:chp_8__sec_8_1__ssec_8_1_6_1/p8 Source: a parity meeting summary of 30.7.01 and a circular.
-- akn:chp_8__sec_8_1__ssec_8_1_6_1/p9 Source: a clarification of the conditions-of-service department.

§§§ `8.1.6.2 אש"ל`

@ref akn:chp_8__sec_8_1__ssec_8_1_6_2/p1
GIVEN `civil-service per-diem for the guidance work` IS A NUMBER @desc the per-diem expenses at the rates customary for state employees; an input
GIVETH A NUMBER
DECIDE `guide's per-diem expenses` `civil-service per-diem for the guidance work` IS
    `civil-service per-diem for the guidance work`

-- akn:chp_8__sec_8_1__ssec_8_1_6_2/p2 Heading of the source list (אסמכתא).
-- akn:chp_8__sec_8_1__ssec_8_1_6_2/p3 Source: a director-general's circular.

§§§ `8.1.6.3 רכב`

-- In special cases, by criteria to be set, the possibility of approving a
-- kilometre quota for a car owner under private-car terms "shall be
-- examined": the examination is due, its outcome is not given. The text
-- names no examiner and sets no time; the Ministry is read as examining.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_3__para_1
GIVEN `a special case under the criteria to be set` IS A BOOLEAN
GIVETH A DEONTIC `8.1 party` `8.1 action`
DECIDE `examining a kilometre quota` `a special case under the criteria to be set` IS
    IF `a special case under the criteria to be set`
    THEN PARTY `a takanon party` `the Ministry of Education`
         MUST  `examine the possibility of a kilometre quota under private-car terms`
    ELSE FULFILLED

@ref akn:chp_8__sec_8_1__ssec_8_1_6_3__para_2
GIVEN `owns a car` IS A BOOLEAN, `paid by a set quota` IS A BOOLEAN,
      `global-payment tariff per kilometre` IS A NUMBER @desc the "global payment" tariff; an input
GIVETH A NUMBER
DECIDE `guide's monthly car payment` `owns a car` `paid by a set quota` `global-payment tariff per kilometre` IS
    IF `owns a car` AND NOT `paid by a set quota`
    THEN 200 TIMES `global-payment tariff per kilometre`
    ELSE 0

-- akn:chp_8__sec_8_1__ssec_8_1_6_3/p1 Heading of the source list (אסמכתא).
-- akn:chp_8__sec_8_1__ssec_8_1_6_3/p2 Source: a director-general's circular.
-- akn:chp_8__sec_8_1__ssec_8_1_6_3/p3 Source: a special director-general's circular.

§§§ `8.1.6.4 גמול טלפונים`

@ref akn:chp_8__sec_8_1__ssec_8_1_6_4/p1
GIVEN `the month` IS A DATE
GIVETH A BOOLEAN
DECIDE `section 8.1.6.4 applies in` `the month` IF
    `the month` `is on or after` (DATE_FROM_DMY 1 4 2000)

-- On top of the telephone allowance all teachers receive, an amount by the
-- days of guidance (in shekels a month).
@ref akn:chp_8__sec_8_1__ssec_8_1_6_4__para_1 akn:chp_8__sec_8_1__ssec_8_1_6_4__para_1/p2 akn:chp_8__sec_8_1__ssec_8_1_6_4__para_1/p3 akn:chp_8__sec_8_1__ssec_8_1_6_4__para_1/p4 akn:chp_8__sec_8_1__ssec_8_1_6_4__para_1/p5 akn:chp_8__sec_8_1__ssec_8_1_6_4__para_1/p6
GIVEN days IS A NUMBER
GIVETH A NUMBER
DECIDE `guide's additional telephone amount` days IS
    BRANCH IF days AT LEAST 4 THEN 36.45
           IF days EQUALS 3   THEN 23
           IF days EQUALS 2   THEN 12.15
           IF days EQUALS 1   THEN 7.29
           OTHERWISE 0

-- A 50% addition on calls for a guide living where every call is long-distance.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_4__para_2
GIVEN `long-distance call charges` IS A NUMBER, `every call from home is long-distance` IS A BOOLEAN
GIVETH A NUMBER
DECIDE `long-distance addition` `long-distance call charges` `every call from home is long-distance` IS
    IF `every call from home is long-distance`
    THEN 0.5 TIMES `long-distance call charges`
    ELSE 0

@ref akn:chp_8__sec_8_1__ssec_8_1_6_4__para_3
GIVETH A BOOLEAN
DECIDE `any earlier telephone arrangement for guides still applies` IS FALSE

-- akn:chp_8__sec_8_1__ssec_8_1_6_4/p2 Heading of the source list (אסמכתא).
-- akn:chp_8__sec_8_1__ssec_8_1_6_4/p3 Source: a director-general's circular.
-- akn:chp_8__sec_8_1__ssec_8_1_6_4/p4 Source: a director-general's circular.
-- akn:chp_8__sec_8_1__ssec_8_1_6_4/p5 Source: an accountant-general's circular.

§§§ `8.1.6.5 גמול לגננות בתפקיד הדרכה`

@desc A kindergarten teacher with a kindergarten-coordination allowance who is appointed to a guidance role.
DECLARE `kindergarten guide` HAS
    `kindergarten coordination allowance` IS A NUMBER @desc the allowance she held before the appointment; an input
    `guidance allowance`                  IS A NUMBER @desc the guidance allowance of a teacher in a guidance role; an input
    `actually fills the guidance role`    IS A BOOLEAN
    `years in the role full-time before retiring` IS A NUMBER

-- F-8.1-d: "the difference between this allowance and the guidance
-- allowance" says nothing of a coordination allowance larger than the
-- guidance allowance. Reading adopted: the difference is then nothing.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_5__para_1
GIVEN k IS A `kindergarten guide`
GIVETH A NUMBER
DECIDE `the difference` k IS
    max 0 (k's `guidance allowance` MINUS k's `kindergarten coordination allowance`)

`a kindergarten guide whose coordination allowance is the larger` MEANS
    `kindergarten guide` WITH
        `kindergarten coordination allowance` IS 1500
        `guidance allowance`                  IS 1000
        `actually fills the guidance role`    IS TRUE
        `years in the role full-time before retiring` IS 0

`the guidance allowance can fall below the coordination allowance, where the text names no difference` MEANS
    `a kindergarten guide whose coordination allowance is the larger`'s `guidance allowance`
        LESS THAN `a kindergarten guide whose coordination allowance is the larger`'s `kindergarten coordination allowance`
#ASSERT `the guidance allowance can fall below the coordination allowance, where the text names no difference`

@ref akn:chp_8__sec_8_1__ssec_8_1_6_5__para_1
GIVEN k IS A `kindergarten guide`
GIVETH A NUMBER
DECIDE `kindergarten guide's allowances` k IS
    k's `kindergarten coordination allowance` PLUS `the difference` k

@ref akn:chp_8__sec_8_1__ssec_8_1_6_5__para_2
GIVETH A BOOLEAN
DECIDE `guidance years count as management seniority for the coordination allowance` IS TRUE

-- The difference is a temporary supplement for actually holding the role,
-- not counted for severance, pension or retirement benefits — except for a
-- full-time guide of at least 2 years before retiring, for pension.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_5__para_3 akn:chp_8__sec_8_1__ssec_8_1_6_5__para_4
GIVEN k IS A `kindergarten guide`
GIVETH A BOOLEAN
DECIDE `the difference counts in the pension salary` k IF
    k's `years in the role full-time before retiring` AT LEAST 2

@ref akn:chp_8__sec_8_1__ssec_8_1_6_5__para_3
GIVETH A BOOLEAN
DECIDE `the difference counts for severance or retirement benefits` IS FALSE

-- The difference is a temporary supplement, paid for actually filling the role.
@ref akn:chp_8__sec_8_1__ssec_8_1_6_5__para_3
GIVEN k IS A `kindergarten guide`
GIVETH A BOOLEAN
DECIDE `the difference is paid` k IF
    k's `actually fills the guidance role`

-- akn:chp_8__sec_8_1__ssec_8_1_6_5/p1 Heading of the source list (אסמכתא).
-- akn:chp_8__sec_8_1__ssec_8_1_6_5/p2 Source: a director-general's circular.
-- akn:chp_8__sec_8_1__ssec_8_1_6_5/p3 Source: collective agreement of 19.9.94.

§§ `Worked examples`

-- Examples. Salaries and rates are placeholders.
#ASSERT `guidance allowance` `a guide with a degree and five years` EQUALS 2150
#ASSERT `position share for guidance days` 3 EQUALS 0.5
#ASSERT `guide's additional telephone amount` 5 EQUALS 36.45
#ASSERT `kindergarten guide's allowances` (`kindergarten guide` WITH `kindergarten coordination allowance` IS 1000, `guidance allowance` IS 1500, `actually fills the guidance role` IS TRUE, `years in the role full-time before retiring` IS 1) EQUALS 1500

#TRACE `the guide keeps teaching` `ordinary guidance` AT 0 WITH
    PARTY `a takanon party` `the teaching employee` DOES `teach in a school` 2 AT 1
#TRACE `the guide keeps teaching` `ordinary guidance` AT 0 WITH
    PARTY `a takanon party` `the teaching employee` DOES `teach in a school` 1 AT 1
#TRACE `use the leave by 31 August` 1 AT 0 WITH
    PARTY `a takanon party` `the teaching employee` DOES `use the annual leave` 26 AT 11
