-- Tests of sections 8, 9, 13 and 25 of l4/laws/collective-agreements-law.l4
-- (MMS-601); the sections encoded before keep their assertions beside them.

IMPORT prelude
IMPORT `collective-agreements-law`

§ `בדיקות חוק הסכמים קיבוציים`

-- §8: accession to an existing agreement makes a special agreement.
#ASSERT `the kind an accession makes under section 8` `signing a letter of accession to an existing special collective agreement` EQUALS `a special collective agreement`
#ASSERT `is exempt from stamp duty under section 9` TRUE

-- §13: no notice — it goes on; notice three months ahead where the
-- agreement sets none — it ends; one month ahead — it goes on.
#ASSERT `goes on as an agreement for an unfixed period under section 13` TRUE FALSE 0 FALSE 0
#ASSERT NOT `goes on as an agreement for an unfixed period under section 13` TRUE TRUE 3 FALSE 0
#ASSERT `goes on as an agreement for an unfixed period under section 13` TRUE TRUE 1 FALSE 0
#ASSERT `goes on as an agreement for an unfixed period under section 13` TRUE TRUE 3 TRUE 4

-- §25: only a general agreement is extended.
#ASSERT `the Minister may extend it under section 25` `a general collective agreement` TRUE
#ASSERT NOT `the Minister may extend it under section 25` `a special collective agreement` TRUE
