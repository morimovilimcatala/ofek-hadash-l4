+-- | Parse a module as the LSP does (GetMixfixRegistry, GetParsedAst): a
+-- first pass without hints finds the module's imports and its own mixfix
+-- keywords ...
+firstPass :: NormalizedUri -> Text -> Either [Text] (Module Name)
+firstPass uri source = case execProgramParserWithHints emptyMixfixHintRegistry uri source of
+  Left errs -> Left (map (\(PError msg _ _ _) -> msg) (toList errs))
+  Right (parsed, _warnings) -> Right parsed
+
+-- | ... and the final pass knows its own keywords and those of every module
+-- it imports, once they are resolved. Returns the module and those keywords.
+finalPass :: [ResolvedImport] -> NormalizedUri -> Text -> Module Name -> Either [Text] (Module Name, MixfixHintRegistry)
+finalPass imports uri source firstParsed =
+  let hints = buildMixfixHintRegistry firstParsed <> mconcat (map (.riHints) imports)
+  in case execProgramParserWithHints hints uri source of
+       Left errs -> Left (map (\(PError msg _ _ _) -> msg) (toList errs))
+       Right (parsed, _warnings) -> Right (parsed, hints)
+
