+-- | An evaluation trace as JSON: each node is the steps its expression
+-- took (each with the traces of the sub-expressions it forced) and the
+-- value it reached, printed as `l4 run` prints them.
+traceToJson :: EvalTrace -> Aeson.Value
+traceToJson (Trace mlabel steps v) = Aeson.object
+  [ "label" .= fmap prettyLayout mlabel
+  , "steps" .= [ Aeson.object ["expr" .= prettyLayout e, "subs" .= map traceToJson subs]
+               | (e, subs) <- steps ]
+  , "value" .= docText (printExceptionOrNF v)
+  , "error" .= either (const True) (const False) v
+  ]
+
